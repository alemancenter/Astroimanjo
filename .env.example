# Copy this file to .env and fill in real values. In production builds, src/lib/api.ts
# fails fast at startup if any of these are missing — see that file for why.

# Base URL of the Go backend API (no trailing slash before /api).
PUBLIC_API_URL=https://api.imanjo.com/api

# Public URL this frontend is served from. Used for canonical URLs, JSON-LD, sitemaps, and
# OG tags — must match the real production domain, not a dev/staging placeholder.
PUBLIC_SITE_URL=https://imanjo.com

# Shared secret sent as the X-Frontend-Key header on every backend request — proves the
# request came from this frontend server, not directly from a browser. Never expose this to
# client-side code; only read it from server-side code (Astro frontmatter or src/pages/api/**).
FRONTEND_API_KEY=
