    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.5.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fast-uri": "3.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
