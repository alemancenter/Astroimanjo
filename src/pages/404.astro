---
import Layout from '../layouts/Layout.astro';
import '../styles/misc-pages.css';
---

<Layout title="الصفحة غير موجودة" description="الصفحة التي تبحث عنها غير موجودة." noindex>
	<div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
		<div class="mx-auto mb-6 flex size-24 items-center justify-center rounded-[2rem] bg-royal-50 text-4xl font-black text-royal-600 ring-1 ring-royal-100 dark:bg-royal-950 dark:text-royal-300 dark:ring-royal-900">404</div>
		<h1 class="mb-3 text-3xl font-extrabold text-graphite-950 dark:text-white">الصفحة غير موجودة</h1>
		<p class="mb-8 leading-7 text-graphite-600 dark:text-graphite-300">
			يبدو أن الصفحة التي تبحث عنها غير موجودة أو تم نقلها.
		</p>
		<a
			href="/"
			class="btn-primary"
		>
			العودة للرئيسية
		</a>
	</div>
</Layout>
