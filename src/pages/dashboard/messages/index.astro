---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DashboardAlert from '../../../components/ui/DashboardAlert.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';
import { assetUrl } from '../../../lib/assets';

const guard = await requireDashboard(Astro);
if ('redirect' in guard) return guard.redirect;
const { user } = guard;

const token = Astro.cookies.get('token')?.value;
const query = Astro.url.searchParams;
const allowedTabs = new Set(['inbox', 'sent', 'drafts']);
const requestedTab = query.get('tab') || 'inbox';
const tab = allowedTabs.has(requestedTab) ? requestedTab : 'inbox';
const search = (query.get('q') || '').trim();
const importantOnly = query.get('important') === '1';
const page = Math.max(1, Number(query.get('page')) || 1);
const endpoint = tab === 'sent' ? '/dashboard/messages/sent' : tab === 'drafts' ? '/dashboard/messages/drafts' : '/dashboard/messages/inbox';
const authOptions = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };

const [messagesResult, statsResult, recipientsResult] = await Promise.all([
	apiFetch<any[]>(endpoint, { ...authOptions, params: { q: search || undefined, important: importantOnly || undefined, page, per_page: 20 } }),
	apiFetch<Record<string, number>>('/dashboard/messages/stats', authOptions),
	apiFetch<any[]>('/user/search', { ...authOptions, params: { q: '' } }),
]);

const messages = Array.isArray(messagesResult.data) ? messagesResult.data : [];
const meta = messagesResult.meta;
const stats = statsResult.data ?? { inbox: tab === 'inbox' ? meta?.total ?? messages.length : 0, unread: 0, sent: tab === 'sent' ? meta?.total ?? messages.length : 0, drafts: tab === 'drafts' ? meta?.total ?? messages.length : 0, important: 0, today: 0 };
const initialRecipients = (Array.isArray(recipientsResult.data) ? recipientsResult.data : []).filter((recipient: any) => String(recipient.id) !== String(user.id));
const redirectTo = `${Astro.url.pathname}${Astro.url.search}`;
const numberFormat = new Intl.NumberFormat('ar-EG');
const dateTimeFormat = new Intl.DateTimeFormat('ar-EG', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' });
const formatDateTime = (value: string) => { const date = new Date(value); return Number.isNaN(date.getTime()) ? '—' : dateTimeFormat.format(date); };
const excerpt = (value: string, max = 145) => { const clean = String(value || '').replace(/\s+/g, ' ').trim(); return clean.length > max ? `${clean.slice(0, max).trim()}…` : clean; };
const initials = (name: string) => (name || 'مستخدم').trim().split(/\s+/).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
const messageParty = (message: any) => tab === 'inbox' ? message.sender : message.recipient;
const filterUrl = (nextTab: string, important = importantOnly) => {
	const url = new URL(Astro.url);
	url.searchParams.set('tab', nextTab);
	if (important) url.searchParams.set('important', '1'); else url.searchParams.delete('important');
	url.searchParams.delete('page');
	return `${url.pathname}${url.search}`;
};
const tabs = [
	{ key: 'inbox', label: 'الوارد', count: Number(stats.inbox || 0), icon: 'inbox' },
	{ key: 'sent', label: 'المرسلة', count: Number(stats.sent || 0), icon: 'sent' },
	{ key: 'drafts', label: 'المسودات', count: Number(stats.drafts || 0), icon: 'draft' },
];
---

<DashboardLayout title="الرسائل الداخلية" user={user}>
	<div class="messages-page">
		<DashboardAlert />

		<header class="messages-header">
			<div><span>التواصل الداخلي</span><h1>مركز الرسائل</h1><p>تبادل الرسائل مع أعضاء المنصة، ومتابعة الوارد والمسودات من مساحة واحدة منظمة.</p></div>
			<button type="button" data-focus-compose><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>كتابة رسالة</button>
		</header>

		<section class="messages-summary" aria-label="ملخص الرسائل">
			<div class="message-summary-card is-blue"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v14H4zM4 7l8 6 8-6"/></svg></i><div><small>صندوق الوارد</small><strong>{numberFormat.format(Number(stats.inbox || 0))}</strong><span>{numberFormat.format(Number(stats.unread || 0))} غير مقروءة</span></div></div>
			<div class="message-summary-card is-green"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m22 2-7 20-4-9-9-4Z"/><path d="m22 2-11 11"/></svg></i><div><small>الرسائل المرسلة</small><strong>{numberFormat.format(Number(stats.sent || 0))}</strong><span>رسالة تم إرسالها</span></div></div>
			<div class="message-summary-card is-orange"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l3 3v15H6zM9 11h6m-6 4h4"/></svg></i><div><small>المسودات</small><strong>{numberFormat.format(Number(stats.drafts || 0))}</strong><span>بانتظار الإكمال</span></div></div>
			<div class="message-summary-card is-graphite"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z"/></svg></i><div><small>الرسائل المهمة</small><strong>{numberFormat.format(Number(stats.important || 0))}</strong><span>{numberFormat.format(Number(stats.today || 0))} رسالة اليوم</span></div></div>
		</section>

		<div class="messages-workspace">
			<main class="messages-inbox">
				<section class="messages-toolbar">
					<nav aria-label="صناديق الرسائل">{tabs.map((item) => <a href={filterUrl(item.key)} class:list={{ 'is-active': tab === item.key }} aria-current={tab === item.key ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">{item.icon === 'inbox' ? <><path d="M4 5h16v14H4zM4 7l8 6 8-6"/></> : item.icon === 'sent' ? <><path d="m22 2-7 20-4-9-9-4Z"/><path d="m22 2-11 11"/></> : <><path d="M6 3h9l3 3v15H6zM9 11h6m-6 4h4"/></>}</svg><span>{item.label}</span><strong>{numberFormat.format(item.count)}</strong></a>)}</nav>
					<form method="get" action="/dashboard/messages" class="messages-filter-form"><input type="hidden" name="tab" value={tab}/><label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" name="q" value={search} placeholder="ابحث بالاسم أو البريد أو موضوع الرسالة..." aria-label="البحث في الرسائل"/></label><button type="submit">بحث</button><a href={filterUrl(tab, !importantOnly)} class:list={{ 'is-active': importantOnly }}><svg viewBox="0 0 24 24" fill={importantOnly ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.8"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z"/></svg>المهمة</a>{(search || importantOnly) && <a href={`/dashboard/messages?tab=${tab}`} class="messages-clear">مسح</a>}</form>
				</section>

				{!messagesResult.ok ? <section class="messages-state is-error"><i>!</i><h2>تعذّر تحميل الرسائل</h2><p>{messagesResult.message || 'تحقق من اتصال الخادم ثم أعد المحاولة.'}</p><a href={redirectTo}>إعادة المحاولة</a></section> : messages.length === 0 ? <section class="messages-state"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v14H4zM4 7l8 6 8-6"/></svg></i><h2>{search ? 'لا توجد رسائل مطابقة' : importantOnly ? 'لا توجد رسائل مهمة هنا' : tab === 'inbox' ? 'صندوق الوارد فارغ' : tab === 'sent' ? 'لا توجد رسائل مرسلة' : 'لا توجد مسودات'}</h2><p>{search || importantOnly ? 'جرّب تعديل البحث أو مسح عوامل التصفية.' : 'ستظهر الرسائل الجديدة في هذا القسم.'}</p>{(search || importantOnly) && <a href={`/dashboard/messages?tab=${tab}`}>عرض جميع الرسائل</a>}</section> : <section class="messages-list-card">
					<header><div><h2>{tab === 'inbox' ? 'الرسائل الواردة' : tab === 'sent' ? 'الرسائل المرسلة' : 'المسودات المحفوظة'}</h2><p>{numberFormat.format(meta?.total ?? messages.length)} رسالة في هذا القسم</p></div><span>صفحة {numberFormat.format(meta?.current_page ?? page)} من {numberFormat.format(meta?.last_page ?? 1)}</span></header>
					<div class="messages-list">{messages.map((message: any) => { const party = messageParty(message) || {}; const photo = assetUrl(party.profile_photo_path, 80); return <article class:list={['message-row', { 'is-unread': tab === 'inbox' && !message.read }]}>
						<div class="message-avatar">{photo ? <img src={photo} alt="" loading="lazy"/> : <span class={`tone-${Number(message.id) % 4}`}>{initials(party.name)}</span>}<i class:list={{ 'is-visible': tab === 'inbox' && !message.read }}></i></div>
						<button type="button" class="message-content" data-open-message data-message-name={party.name || 'مستخدم'} data-message-email={party.email || ''} data-message-subject={message.subject || 'دون موضوع'} data-message-body={message.body || ''} data-message-date={formatDateTime(message.created_at)} data-message-direction={tab === 'inbox' ? 'واردة' : tab === 'sent' ? 'مرسلة' : 'مسودة'}><span><strong>{party.name || 'مستخدم غير معروف'}</strong>{party.email && <small dir="ltr">{party.email}</small>}</span><h3>{message.subject || 'دون موضوع'}</h3><p>{excerpt(message.body) || 'لا يوجد نص لهذه الرسالة.'}</p><time datetime={message.created_at}>{formatDateTime(message.created_at)}</time></button>
						<div class="message-badges">{tab === 'inbox' && <span class:list={{ 'is-unread': !message.read }}>{message.read ? 'مقروءة' : 'جديدة'}</span>}{message.is_important && <span class="is-important">مهمة</span>}{tab === 'drafts' && <span class="is-draft">مسودة</span>}</div>
						<div class="message-actions">{tab === 'inbox' && !message.read && <form method="post" action={`/api/dashboard/messages/${message.id}/read`}><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" title="تعليم كمقروءة"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m4 12 4 4L18 6"/></svg></button></form>}<form method="post" action={`/api/dashboard/messages/${message.id}/important`}><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" class:list={{ 'is-important': message.is_important }} title={message.is_important ? 'إلغاء التمييز' : 'تمييز كمهمة'}><svg viewBox="0 0 24 24" fill={message.is_important ? 'currentColor' : 'none'} stroke="currentColor"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z"/></svg></button></form><form method="post" action={`/api/dashboard/messages/${message.id}/delete`} data-confirm-delete><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" class="is-delete" title="حذف الرسالة"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg></button></form></div>
					</article>; })}</div>
				</section>}
				{meta && meta.last_page > 1 && <Pagination currentPage={meta.current_page} lastPage={meta.last_page} url={Astro.url}/>} 
			</main>

			<aside class="message-compose-card" id="message-compose-card">
				<header><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></i><div><span>رسالة جديدة</span><h2>اكتب رسالتك</h2><p>ابحث عن العضو بالاسم أو البريد.</p></div></header>
				<form method="post" action="/api/dashboard/messages/send" data-compose-form><input type="hidden" name="redirect_to" value={redirectTo}/><input type="hidden" name="recipient_id" data-recipient-id/>
					<label class="recipient-field"><span>المستلم</span><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10" cy="8" r="3"/><path d="M4 20c.5-4 2.5-6 6-6s5.5 2 6 6m1-10h5m-2.5-2.5v5"/></svg><input type="search" placeholder="اكتب اسم العضو أو بريده..." autocomplete="off" data-recipient-search/></div><div class="recipient-results" data-recipient-results hidden>{initialRecipients.map((recipient: any) => <button type="button" class="recipient-option" data-recipient-option data-id={recipient.id} data-name={recipient.name} data-email={recipient.email}><span>{initials(recipient.name)}</span><div><strong>{recipient.name}</strong><small dir="ltr">{recipient.email}</small></div></button>)}</div><small data-recipient-hint>اختر عضوًا من نتائج البحث.</small></label>
					<label><span>موضوع الرسالة</span><input type="text" name="subject" required maxlength="255" placeholder="اكتب موضوعًا واضحًا..."/></label>
					<label><span>نص الرسالة</span><textarea name="body" rows="8" required maxlength="5000" placeholder="اكتب رسالتك هنا..." data-message-body></textarea><small class="compose-counter"><b data-body-count>0</b> / 5000</small></label>
					<footer><button type="submit" formaction="/api/dashboard/messages/draft" formnovalidate data-save-draft><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h12l2 2v14H5zM8 4v6h8V4M8 20v-6h8v6"/></svg>حفظ مسودة</button><button type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m22 2-7 20-4-9-9-4Z"/><path d="m22 2-11 11"/></svg>إرسال الرسالة</button></footer>
				</form>
			</aside>
		</div>
	</div>

	<dialog class="message-reader-dialog" id="message-reader-dialog" aria-labelledby="message-reader-title"><div class="message-reader-card"><header><div class="message-reader-avatar" data-reader-avatar>م</div><div><span data-reader-direction>رسالة</span><h2 id="message-reader-title" data-reader-subject>موضوع الرسالة</h2><p><strong data-reader-name>المستخدم</strong><small data-reader-email dir="ltr"></small></p></div><button type="button" data-close-reader aria-label="إغلاق"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header><div class="message-reader-meta"><span>تاريخ الرسالة</span><time data-reader-date></time></div><div class="message-reader-body" data-reader-body></div><footer><button type="button" data-close-reader>إغلاق</button></footer></div></dialog>

	<dialog class="message-delete-dialog" id="message-delete-dialog" aria-labelledby="message-delete-title"><div class="message-delete-card"><button type="button" data-close-delete aria-label="إغلاق"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m6 6 12 12M18 6 6 18"/></svg></button><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg></i><span>تأكيد الحذف</span><h2 id="message-delete-title">حذف هذه الرسالة؟</h2><p>سيتم حذف الرسالة من صندوقك، ولن تظهر ضمن الرسائل مرة أخرى.</p><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 9v4m0 4h.01M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/></svg><span><strong>تنبيه مهم</strong> لا يمكن التراجع عن هذه العملية.</span></div><footer><button type="button" data-close-delete>إلغاء</button><button type="button" data-confirm-delete-action>حذف الرسالة</button></footer></div></dialog>

	<script>
		const readerDialog = document.getElementById('message-reader-dialog') as HTMLDialogElement | null;
		document.querySelectorAll<HTMLElement>('[data-open-message]').forEach((button) => button.addEventListener('click', () => { if (!readerDialog) return; const set = (selector: string, value: string) => { const element = readerDialog.querySelector<HTMLElement>(selector); if (element) element.textContent = value; }; set('[data-reader-direction]', button.dataset.messageDirection || 'رسالة'); set('[data-reader-subject]', button.dataset.messageSubject || 'دون موضوع'); set('[data-reader-name]', button.dataset.messageName || 'مستخدم'); set('[data-reader-email]', button.dataset.messageEmail || ''); set('[data-reader-date]', button.dataset.messageDate || ''); set('[data-reader-body]', button.dataset.messageBody || 'لا يوجد نص للرسالة.'); set('[data-reader-avatar]', (button.dataset.messageName || 'م').trim().charAt(0)); readerDialog.showModal(); }));
		document.querySelectorAll('[data-close-reader]').forEach((button) => button.addEventListener('click', () => readerDialog?.close()));
		readerDialog?.addEventListener('click', (event) => { if (event.target === readerDialog) readerDialog.close(); });

		const deleteDialog = document.getElementById('message-delete-dialog') as HTMLDialogElement | null;
		let pendingDeleteForm: HTMLFormElement | null = null;
		document.querySelectorAll<HTMLFormElement>('[data-confirm-delete]').forEach((form) => form.addEventListener('submit', (event) => { if (form.dataset.confirmed === 'true') return; event.preventDefault(); pendingDeleteForm = form; deleteDialog?.showModal(); }));
		document.querySelectorAll('[data-close-delete]').forEach((button) => button.addEventListener('click', () => deleteDialog?.close()));
		deleteDialog?.addEventListener('click', (event) => { if (event.target === deleteDialog) deleteDialog.close(); });
		deleteDialog?.addEventListener('close', () => { pendingDeleteForm = null; });
		deleteDialog?.querySelector('[data-confirm-delete-action]')?.addEventListener('click', () => { if (!pendingDeleteForm) return; const form = pendingDeleteForm; form.dataset.confirmed = 'true'; form.requestSubmit(); });

		const recipientSearch = document.querySelector<HTMLInputElement>('[data-recipient-search]');
		const recipientID = document.querySelector<HTMLInputElement>('[data-recipient-id]');
		const recipientResults = document.querySelector<HTMLElement>('[data-recipient-results]');
		const recipientHint = document.querySelector<HTMLElement>('[data-recipient-hint]');
		let recipientTimer: number | undefined;
		const selectRecipient = (id: string, name: string, email: string) => { if (recipientID) recipientID.value = id; if (recipientSearch) { recipientSearch.value = name; recipientSearch.setCustomValidity(''); } if (recipientHint) recipientHint.textContent = `${email} · العضو #${id}`; if (recipientResults) recipientResults.hidden = true; };
		const bindRecipientOptions = () => recipientResults?.querySelectorAll<HTMLButtonElement>('[data-recipient-option]').forEach((button) => button.addEventListener('click', () => selectRecipient(button.dataset.id || '', button.dataset.name || '', button.dataset.email || '')));
		bindRecipientOptions();
		const renderRecipients = (items: any[]) => { if (!recipientResults) return; recipientResults.replaceChildren(); items.forEach((item) => { const button = document.createElement('button'); button.type = 'button'; button.className = 'recipient-option'; button.dataset.recipientOption = ''; button.dataset.id = String(item.id); button.dataset.name = String(item.name || 'مستخدم'); button.dataset.email = String(item.email || ''); const avatar = document.createElement('span'); avatar.textContent = String(item.name || 'م').trim().charAt(0); const text = document.createElement('div'); const name = document.createElement('strong'); name.textContent = String(item.name || 'مستخدم'); const email = document.createElement('small'); email.dir = 'ltr'; email.textContent = String(item.email || ''); text.append(name, email); button.append(avatar, text); recipientResults.append(button); }); recipientResults.hidden = items.length === 0; bindRecipientOptions(); };
		recipientSearch?.addEventListener('focus', () => { if (recipientResults?.childElementCount) recipientResults.hidden = false; });
		recipientSearch?.addEventListener('input', () => { if (recipientID) recipientID.value = ''; if (recipientHint) recipientHint.textContent = 'اختر عضوًا من نتائج البحث.'; window.clearTimeout(recipientTimer); recipientTimer = window.setTimeout(async () => { const value = recipientSearch.value.trim(); if (value.length < 2) { if (recipientResults) recipientResults.hidden = !recipientResults.childElementCount; return; } try { const response = await fetch(`/api/dashboard/messages/recipients?q=${encodeURIComponent(value)}`); const json = await response.json(); renderRecipients(Array.isArray(json?.data) ? json.data : []); } catch { if (recipientHint) recipientHint.textContent = 'تعذّر البحث عن الأعضاء الآن.'; } }, 250); });
		document.addEventListener('click', (event) => { if (recipientResults && !recipientResults.contains(event.target as Node) && event.target !== recipientSearch) recipientResults.hidden = true; });
		const composeForm = document.querySelector<HTMLFormElement>('[data-compose-form]');
		composeForm?.addEventListener('submit', (event) => { if (!recipientID?.value) { event.preventDefault(); recipientSearch?.setCustomValidity('اختر مستلمًا من نتائج البحث.'); recipientSearch?.reportValidity(); recipientSearch?.focus(); } });
		document.querySelector('[data-focus-compose]')?.addEventListener('click', () => { document.getElementById('message-compose-card')?.scrollIntoView({ behavior: 'smooth', block: 'center' }); window.setTimeout(() => recipientSearch?.focus(), 350); });
		const bodyField = document.querySelector<HTMLTextAreaElement>('[data-message-body]'); const bodyCount = document.querySelector<HTMLElement>('[data-body-count]'); bodyField?.addEventListener('input', () => { if (bodyCount) bodyCount.textContent = String(bodyField.value.length); });
	</script>

	<style>
		.messages-page{--mi:#102a43;--mm:#718096;--ml:#dfe6ee;max-width:1400px;margin-inline:auto;padding-bottom:2rem}.messages-header{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1rem}.messages-header>div>span{display:block;margin-bottom:.2rem;color:#1a4d8f;font-size:.75rem;font-weight:850}.messages-header h1{margin:0;color:#061a3a;font-size:clamp(1.5rem,1.2rem + .8vw,2rem);font-weight:950}.messages-header p{margin:.3rem 0 0;color:var(--mm);font-size:.8rem}.messages-header>button{display:inline-flex;min-height:2.55rem;align-items:center;gap:.4rem;border:1px solid #16427d;border-radius:.55rem;background:#1a4d8f;padding:.48rem .8rem;color:#fff;font-family:inherit;font-size:.73rem;font-weight:850}.messages-header>button svg{width:.92rem;height:.92rem}
