---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import ContentAuditScanNav from '../../../../components/dashboard/ContentAuditScanNav.astro';
import { requireDashboard } from '../../../../lib/auth';
import { apiFetch } from '../../../../lib/api';
import { getCountryById } from '../../../../lib/countries';

const guard = await requireDashboard(Astro, 'manage content audit');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const token = Astro.cookies.get('token')?.value;
const currentCountry = getCountryById(Astro.locals.countryId);
const historyPage = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const auth = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };

const runsResult = await apiFetch<any[]>('/dashboard/content-audit/runs', { ...auth, params: { page: historyPage, per_page: 12 } });
const runs: any[] = Array.isArray(runsResult.data) ? runsResult.data : [];
const selectedRunID = Math.max(0, Number(Astro.url.searchParams.get('run') || runs[0]?.id || 0));
const [selectedRunResult, findingsResult] = selectedRunID ? await Promise.all([
	apiFetch<any>(`/dashboard/content-audit/runs/${selectedRunID}`, auth),
	apiFetch<any[]>(`/dashboard/content-audit/runs/${selectedRunID}/findings`, { ...auth, params: { per_page: 50 } }),
]) : [{ ok: true, data: null }, { ok: true, data: [], meta: null }];
const selectedRun: any = selectedRunResult.data;
const findings: any[] = Array.isArray(findingsResult.data) ? findingsResult.data : [];
const currentRun = runs.find((run: any) => run.status === 'running');
const allOk = runsResult.ok;
const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success');
const cleanUrl = new URL(Astro.url); cleanUrl.searchParams.delete('error'); cleanUrl.searchParams.delete('success');
const redirectTo = `${cleanUrl.pathname}${cleanUrl.search}`;

const nf = new Intl.NumberFormat('ar-EG');
const df = new Intl.DateTimeFormat('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
const formatDate = (value?: string | null) => value ? df.format(new Date(value)) : '—';
const labelType = (type: string) => type === 'article' ? 'مقال' : type === 'post' ? 'منشور' : 'الكل';
const runStatus: Record<string, string> = { running: 'قيد التنفيذ', completed: 'مكتمل', failed: 'فشل', queued: 'في الانتظار', cancelling: 'جارٍ الإلغاء', cancelled: 'ملغى' };
const successMessages: Record<string, string> = { audit_started: 'بدأ تدقيق المحتوى في الخلفية.' };
const pageHref = (targetPage: number) => { const u = new URL(Astro.url); u.searchParams.set('page', String(targetPage)); u.searchParams.delete('success'); u.searchParams.delete('error'); return `${u.pathname}?${u.searchParams.toString()}`; };
const runHref = (id: number) => { const u = new URL(Astro.url); u.searchParams.set('run', String(id)); u.searchParams.delete('success'); u.searchParams.delete('error'); return `${u.pathname}?${u.searchParams.toString()}`; };
---

<DashboardLayout title="الفحص الشامل" user={user}>
	<div class="audit-page">
		{error && <div class="audit-alert is-error" role="alert"><i>!</i><div><strong>تعذّر تنفيذ العملية</strong><span>{error}</span></div><a href={redirectTo}>×</a></div>}
		{success && <div class="audit-alert is-success" role="status"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m5 12 4 4L19 6"/></svg></i><div><strong>تمت العملية بنجاح</strong><span>{successMessages[success] || 'تم حفظ التغييرات.'}</span></div><a href={redirectTo}>×</a></div>}

		<header class="audit-hero">
			<div class="audit-hero-copy"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>نظام قواعد ثابتة قديم — منفصل عن الذكاء الاصطناعي</span><h1>الفحص الشامل القديم</h1><p>يفحص هذا النظام {currentCountry.name} بقواعد ثابتة مكتوبة مسبقًا (لا يستدعي أي نموذج ذكاء اصطناعي) وينتج سجلًا تاريخيًا للملاحظات. للتحليل المدعوم بالذكاء الاصطناعي راجع <a href="/dashboard/content-audit">مركز تدقيق المحتوى</a>.</p></div>
			<div class="audit-hero-actions"><form method="post" action="/api/dashboard/content-audit/run"><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" disabled={!!currentRun}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 9a7 7 0 0 1 12-2l2 2M4 15l2 2a7 7 0 0 0 12-2"/></svg>{currentRun ? 'التدقيق يعمل الآن' : 'تشغيل تدقيق شامل'}</button></form></div>
		</header>

		<ContentAuditScanNav active="scan" />

		{!allOk ? <section class="audit-empty is-error"><i>!</i><h2>تعذّر تحميل سجل التدقيق</h2><p>تحقق من اتصال الخادم ثم أعد المحاولة.</p><a href={redirectTo}>إعادة المحاولة</a></section> : <div class="history-section">
			<aside class="runs-sidebar"><header><span>التشغيلات السابقة</span><h2>سجل التدقيق</h2></header><div>{runs.map((run:any)=><a href={runHref(run.id)} class:list={{'is-active':selectedRunID===Number(run.id)}}><i class:list={[`is-${run.status}`]}></i><div><strong>تدقيق #{nf.format(run.id)}</strong><span>{formatDate(run.started_at)}</span></div><b>{nf.format(run.findings_count||0)}</b></a>)}{!runs.length&&<p>لا يوجد سجل بعد.</p>}</div>{runsResult.meta&&runsResult.meta.last_page>1&&<nav><a href={pageHref(Math.max(1,runsResult.meta.current_page-1))} class:list={{'is-disabled':runsResult.meta.current_page<=1}}>السابق</a><span>{nf.format(runsResult.meta.current_page)}/{nf.format(runsResult.meta.last_page)}</span><a href={pageHref(Math.min(runsResult.meta.last_page,runsResult.meta.current_page+1))} class:list={{'is-disabled':runsResult.meta.current_page>=runsResult.meta.last_page}}>التالي</a></nav>}</aside>
			<main class="run-detail">{selectedRun?<><header><div><span>تفاصيل العملية #{nf.format(selectedRun.id)}</span><h2>{runStatus[selectedRun.status]||selectedRun.status}</h2><p>{selectedRun.triggered_by==='manual'?'بدأها أحد مسؤولي المنصة':'بدأها المجدول التلقائي'} في {formatDate(selectedRun.started_at)}</p></div><div><span class:list={['run-badge',`is-${selectedRun.status}`]}>{runStatus[selectedRun.status]||selectedRun.status}</span>{selectedRun.status==='completed'&&<a href={`/api/dashboard/content-audit/runs/${selectedRun.id}/export`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v12m-4-4 4 4 4-4M5 19h14"/></svg>تصدير CSV</a>}</div></header><section class="run-metrics"><div><span>الملاحظات</span><strong>{nf.format(selectedRun.findings_count||0)}</strong></div><div><span>بدأ في</span><strong>{formatDate(selectedRun.started_at)}</strong></div><div><span>انتهى في</span><strong>{formatDate(selectedRun.finished_at)}</strong></div></section>{selectedRun.error_message&&<div class="run-error"><strong>سبب الفشل</strong><span>{selectedRun.error_message}</span></div>}<div class="findings-list"><header><h3>ملاحظات هذه العملية</h3><span>{nf.format(findingsResult.meta?.total??findings.length)} نتيجة</span></header>{findings.map((finding:any)=><article><span class:list={['finding-risk',`is-${finding.risk}`]}>{finding.risk}</span><div><span>{labelType(finding.type)} #{finding.id}</span><h4>{finding.title}</h4><p>{finding.reason}</p><small><b>الإجراء المقترح:</b> {finding.recommended_action||'مراجعة يدوية'}</small></div>{finding.url&&<a href={finding.url} target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 5h5v5m0-5-8 8M19 13v6H5V5h6"/></svg></a>}</article>)}{!findings.length&&<p class="empty-line">لا توجد ملاحظات مسجلة لهذه العملية.</p>}</div></>:<section class="audit-empty"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i><h2>اختر عملية تدقيق</h2><p>ستظهر تفاصيلها وملاحظاتها هنا.</p></section>}</main>
		</div>}
	</div>

	<style>
		.audit-page{--au-blue:#1a4d8f;--au-green:#0f8464;--au-orange:#e8a244;--au-red:#c43d49;--au-ink:#18283d;--au-muted:#68788d;--au-line:#dce4ed;direction:rtl}.audit-page *{box-sizing:border-box}.audit-alert{display:flex;align-items:center;gap:.7rem;margin-bottom:.8rem;border:1px solid;border-radius:.8rem;padding:.7rem .85rem}.audit-alert>i{display:grid;width:2rem;height:2rem;place-items:center;border-radius:.5rem;font-style:normal;font-weight:900}.audit-alert svg{width:1rem;height:1rem}.audit-alert div{display:grid}.audit-alert strong{font-size:.84rem}.audit-alert span{font-size:.74rem}.audit-alert a{margin-inline-start:auto;color:inherit;font-size:1.2rem}.audit-alert.is-error{border-color:#efc8cc;background:#fff6f7;color:#a62f3b}.audit-alert.is-success{border-color:#bce5d7;background:#f2fbf7;color:#087255}
		.audit-hero{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.75rem;border:1px solid var(--au-line);border-radius:1rem;background:#fff;padding:1.15rem 1.25rem;box-shadow:0 3px 12px rgb(23 43 77/.05)}.audit-hero-copy>span{display:flex;align-items:center;gap:.35rem;color:var(--au-blue);font-size:.72rem;font-weight:850}.audit-hero-copy>span svg{width:1rem;height:1rem}.audit-hero h1{margin:.22rem 0 .15rem;color:var(--au-ink);font-size:1.48rem;font-weight:950}.audit-hero p{max-width:47rem;margin:0;color:var(--au-muted);font-size:.8rem;line-height:1.75}.audit-hero p a{color:var(--au-blue);font-weight:850}.audit-hero-actions form button{display:flex;min-height:2.55rem;align-items:center;gap:.35rem;border:1px solid #17457e;border-radius:.52rem;background:var(--au-blue);padding:.4rem .7rem;color:#fff;font-family:inherit;font-size:.68rem;font-weight:900;white-space:nowrap}.audit-hero-actions button:disabled{cursor:not-allowed;opacity:.65}.audit-hero-actions svg{width:.9rem;height:.9rem;stroke-width:2}
		.audit-empty{display:grid;min-height:18rem;place-items:center;align-content:center;border:1px dashed #d8e1eb;border-radius:.72rem;background:#fafbfd;text-align:center}.audit-empty>i{display:grid;width:3rem;height:3rem;place-items:center;border-radius:50%;background:#eaf1fa;color:var(--au-blue);font-style:normal;font-weight:950}.audit-empty svg{width:1.3rem;height:1.3rem}.audit-empty h2{margin:.55rem 0 .12rem;color:var(--au-ink);font-size:.86rem}.audit-empty p{margin:0;color:var(--au-muted);font-size:.65rem}.audit-empty a{margin-top:.5rem;color:var(--au-blue);font-size:.6rem;font-weight:850}.audit-empty.is-error>i{background:#ffeaec;color:var(--au-red)}.empty-line{padding:.8rem;color:var(--au-muted);font-size:.65rem;text-align:center}
		.history-section{display:grid;grid-template-columns:17rem minmax(0,1fr);align-items:start;gap:.65rem}.runs-sidebar{overflow:hidden;border:1px solid var(--au-line);border-radius:.82rem;background:#fff;box-shadow:0 3px 10px rgb(23 43 77/.04)}.runs-sidebar>header{border-bottom:1px solid #edf1f5;padding:.75rem}.runs-sidebar>header>span{color:var(--au-blue);font-size:.62rem;font-weight:850}.runs-sidebar h2{margin:.08rem 0 0;color:var(--au-ink);font-size:.9rem;font-weight:950}.runs-sidebar>div{display:grid}.runs-sidebar>div>a{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.4rem;border-bottom:1px solid #eff2f5;padding:.55rem .7rem}.runs-sidebar>div>a.is-active{background:#f3f7fc}.runs-sidebar a>i{width:.4rem;height:.4rem;border-radius:50%;background:#9ca8b5}.runs-sidebar a>i.is-completed{background:var(--au-green)}.runs-sidebar a>i.is-running{background:var(--au-blue)}.runs-sidebar a>i.is-failed{background:var(--au-red)}.runs-sidebar a>div{display:grid}.runs-sidebar a strong{color:var(--au-ink);font-size:.61rem}.runs-sidebar a span{color:var(--au-muted);font-size:.51rem}.runs-sidebar a>b{color:#65758a;font-size:.56rem}.runs-sidebar>nav{display:flex;align-items:center;justify-content:space-between;padding:.55rem}.runs-sidebar>nav a{color:var(--au-blue);font-size:.55rem;font-weight:850}.runs-sidebar>nav a.is-disabled{pointer-events:none;opacity:.4}.runs-sidebar>nav span{color:var(--au-muted);font-size:.52rem}.run-detail{border:1px solid var(--au-line);border-radius:.82rem;background:#fff;box-shadow:0 3px 10px rgb(23 43 77/.04);padding:.85rem}.run-detail>header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edf1f5;padding-bottom:.65rem}.run-detail>header>div:first-child>span{color:var(--au-blue);font-size:.61rem;font-weight:850}.run-detail h2{margin:.08rem 0;color:var(--au-ink);font-size:.95rem}.run-detail>header p{margin:0;color:var(--au-muted);font-size:.6rem}.run-detail>header>div:last-child{display:flex;align-items:center;gap:.35rem}.run-detail>header a{display:flex;align-items:center;gap:.25rem;border:1px solid #cad7e5;border-radius:.38rem;padding:.3rem .45rem;color:var(--au-blue);font-size:.55rem;font-weight:850}.run-detail>header svg{width:.7rem;height:.7rem}.run-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem;padding:.65rem 0}.run-metrics div{border:1px solid #e5ebf1;border-radius:.44rem;padding:.45rem}.run-metrics span{display:block;color:var(--au-muted);font-size:.53rem}.run-metrics strong{color:var(--au-ink);font-size:.62rem}.run-error{display:grid;border:1px solid #efc9cd;border-radius:.45rem;background:#fff6f7;padding:.45rem;color:var(--au-red)}.run-error strong{font-size:.6rem}.run-error span{font-size:.54rem}.run-badge{border-radius:.32rem;background:#f0f3f6;padding:.23rem .38rem;color:#65758a!important;font-size:.54rem!important;font-weight:850}.run-badge.is-completed{background:#e4f5ee;color:var(--au-green)!important}.run-badge.is-running{background:#e7f0fa;color:var(--au-blue)!important}.run-badge.is-failed{background:#ffeaec;color:var(--au-red)!important}.findings-list>header{display:flex;justify-content:space-between;padding:.5rem 0}.findings-list h3{margin:0;color:var(--au-ink);font-size:.72rem}.findings-list>header span{color:var(--au-muted);font-size:.57rem}.findings-list>article{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.5rem;border-top:1px solid #edf1f5;padding:.58rem 0}.finding-risk{align-self:start;border-radius:.32rem;background:#f0f3f6;padding:.23rem .35rem;color:#68788c;font-size:.5rem;font-weight:850}.finding-risk.is-high,.finding-risk.is-critical{background:#ffeaec;color:var(--au-red)}.finding-risk.is-medium{background:#fff0df;color:#a96817}.findings-list article>div{display:grid}.findings-list article>div>span{color:var(--au-blue);font-size:.49rem;font-weight:850}.findings-list h4{margin:.06rem 0;color:var(--au-ink);font-size:.64rem}.findings-list p{margin:0;color:var(--au-muted);font-size:.56rem}.findings-list small{margin-top:.18rem;color:#7e8b9b;font-size:.52rem}.findings-list article>a{display:grid;width:1.8rem;height:1.8rem;place-items:center;border:1px solid #d8e2ec;border-radius:.38rem;color:var(--au-blue)}.findings-list article>a svg{width:.7rem;height:.7rem}
		.dark .audit-page{--au-ink:#f4f7fb;--au-muted:#9eacc0;--au-line:#30445d}.dark .audit-hero,.dark .runs-sidebar,.dark .run-detail{border-color:#30445d;background:#0f2547;color:#cbd5e1}.dark .runs-sidebar>div>a.is-active{background:#122b4b}.dark .runs-sidebar>header,.dark .run-detail>header,.dark .findings-list>article{border-color:#29405c}
		@media(max-width:780px){.audit-hero{align-items:stretch;flex-direction:column}.audit-hero-actions form button{width:100%;justify-content:center}.history-section{grid-template-columns:1fr}}
		@media(max-width:480px){.audit-hero{padding:.9rem}.audit-hero h1{font-size:1.25rem}.run-metrics{grid-template-columns:1fr}}
	</style>
</DashboardLayout>
