---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import ContentAuditAINav from '../../../components/dashboard/ContentAuditAINav.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';
import { getCountryById } from '../../../lib/countries';

const guard = await requireDashboard(Astro, 'manage content audit');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const token = Astro.cookies.get('token')?.value;
const currentCountry = getCountryById(Astro.locals.countryId);
const auth = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };

const [readinessResult, queueResult, costsResult, batchesResult] = await Promise.all([
	apiFetch<any>('/dashboard/content-audit/adsense-readiness', { ...auth, params: { country: currentCountry.code, type: 'all', page: 1, per_page: 20 } }),
	apiFetch<any[]>('/dashboard/content-audit/ai/review-queue', { ...auth, params: { page: 1, per_page: 1, status: 'previewed' } }),
	apiFetch<any>('/dashboard/content-audit/ai/model-costs', { ...auth, params: { days: 7 } }),
	apiFetch<any[]>('/dashboard/content-audit/ai/batch-jobs', auth),
]);

const readinessData = readinessResult.data ?? {};
const summary = readinessData.summary ?? {};
const readinessItems: any[] = Array.isArray(readinessData.items) ? readinessData.items : [];
const costSummary = costsResult.data?.summary ?? {};
const batches: any[] = Array.isArray(batchesResult.data) ? batchesResult.data : [];
const activeBatch = batches.find((job: any) => ['queued', 'running', 'cancelling'].includes(job.status));
const total = Number(summary.total || 0);
const ready = Number(summary.ready || 0);
const review = Number(summary.review || 0);
const weak = Number(summary.weak || 0);
const noIndex = Number(summary.no_index || 0);
const adsEligible = Number(summary.ads_eligible || 0);
const readinessRate = total ? Math.round(ready / total * 100) : 0;
const adsRate = total ? Math.round(adsEligible / total * 100) : 0;
const urgentItems = readinessItems.filter((item: any) => item.level !== 'ready').slice(0, 6);
const allOk = readinessResult.ok && queueResult.ok && costsResult.ok && batchesResult.ok;
const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success');
const cleanUrl = new URL(Astro.url); cleanUrl.searchParams.delete('error'); cleanUrl.searchParams.delete('success');
const redirectTo = `${cleanUrl.pathname}${cleanUrl.search}`;

const nf = new Intl.NumberFormat('ar-EG');
const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 3, maximumFractionDigits: 4 });
const successMessages: Record<string, string> = { audit_started: 'بدأ تدقيق المحتوى في الخلفية.', batch_started: 'تم إنشاء دفعة التحليل الذكي.', batch_cancelled: 'تم إرسال طلب إلغاء الدفعة.', fix_applied: 'تم اعتماد الإصلاح وتحديث المحتوى.', fix_rejected: 'تم رفض مقترح الإصلاح.' };
---

<DashboardLayout title="تدقيق المحتوى" user={user}>
	<div class="audit-page">
		{error && <div class="audit-alert is-error" role="alert"><i>!</i><div><strong>تعذّر تنفيذ العملية</strong><span>{error}</span></div><a href={redirectTo}>×</a></div>}
		{success && <div class="audit-alert is-success" role="status"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m5 12 4 4L19 6"/></svg></i><div><strong>تمت العملية بنجاح</strong><span>{successMessages[success] || 'تم حفظ التغييرات.'}</span></div><a href={redirectTo}>×</a></div>}

		<header class="audit-hero">
			<div class="audit-hero-copy"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d="m9 12 2 2 4-5"/></svg>نظام الذكاء الاصطناعي لتدقيق المحتوى</span><h1>مركز تدقيق المحتوى</h1><p>جاهزية AdSense وجودة المحتوى وقرارات الذكاء الاصطناعي في منصة {currentCountry.name}. للأدوات الحتمية (فساد، تشابه، جرد، فحص شامل قديم) راجع <a href="/dashboard/content-audit/scan">الأدوات الحتمية</a> — نظام منفصل بلا تكلفة نموذج لغوي.</p></div>
			<div class="audit-hero-actions"><a href="/dashboard/content-audit/ai-operations"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v18M5 8h14M5 16h14"/></svg>دفعة تحليل ذكية</a></div>
		</header>

		<ContentAuditAINav active="overview" />

		<section class="audit-kpis">
			<article><i class="is-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8m-8 4h5"/></svg></i><div><span>إجمالي المحتوى</span><strong>{nf.format(total)}</strong><small>مقالات ومنشورات</small></div></article>
			<article><i class="is-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m5 12 4 4L19 6"/></svg></i><div><span>جاهز للنشر</span><strong>{nf.format(readinessRate)}%</strong><small>{nf.format(ready)} عنصر</small></div></article>
			<article><i class="is-orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 9v4m0 4h.01M4 20h16L12 4z"/></svg></i><div><span>بحاجة لتدخل</span><strong>{nf.format(review + weak)}</strong><small>{nf.format(weak)} ضعيف</small></div></article>
			<article><i class="is-red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 5l14 14M19 5 5 19"/></svg></i><div><span>غير قابل للفهرسة</span><strong>{nf.format(noIndex)}</strong><small>يحتاج معالجة</small></div></article>
			<article><i class="is-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16v10H4zM8 12h8"/></svg></i><div><span>مؤهل للإعلانات</span><strong>{nf.format(adsRate)}%</strong><small>{nf.format(adsEligible)} عنصر</small></div></article>
			<article><i class="is-dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5h16v14H4zM8 9h8m-8 4h5"/></svg></i><div><span>طابور AI</span><strong>{nf.format(queueResult.meta?.total ?? 0)}</strong><small>بانتظار القرار</small></div></article>
		</section>

		{!allOk ? <section class="audit-empty is-error"><i>!</i><h2>تعذّر تحميل بعض بيانات التدقيق</h2><p>تحقق من اتصال الخادم ثم أعد المحاولة.</p><a href={redirectTo}>إعادة المحاولة</a></section> : <div class="audit-overview">
			<section class="audit-card readiness-card"><header><div><span>الصورة العامة</span><h2>توزيع جاهزية المحتوى</h2></div><b>{nf.format(readinessRate)}%</b></header><div class="readiness-meter"><i><b class="ready" style={`width:${total ? ready / total * 100 : 0}%`}></b><b class="review" style={`width:${total ? review / total * 100 : 0}%`}></b><b class="weak" style={`width:${total ? weak / total * 100 : 0}%`}></b></i><div><span><b class="dot-ready"></b>جاهز <strong>{nf.format(ready)}</strong></span><span><b class="dot-review"></b>مراجعة <strong>{nf.format(review)}</strong></span><span><b class="dot-weak"></b>ضعيف <strong>{nf.format(weak)}</strong></span></div></div><div class="readiness-insight"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v18M5 8h14M5 16h14"/></svg><p><strong>{adsRate >= 75 ? 'الوضع الإعلاني جيد' : 'توجد فجوة في الجاهزية الإعلانية'}</strong><span>{nf.format(total - adsEligible)} عنصرًا لا يحقق شروط عرض الإعلانات حاليًا.</span></p><a href="/dashboard/content-audit/readiness">فتح التقرير</a></div></section>
			<section class="audit-card urgent-card"><header><div><span>الأولوية الآن</span><h2>محتوى يحتاج تدخلك</h2></div><a href="/dashboard/content-audit/readiness">عرض الكل</a></header><div>{urgentItems.map((item: any) => <a href={item.url} target="_blank"><span class:list={['score-chip', `is-${item.level}`]}>{nf.format(item.score)}</span><div><strong>{item.title}</strong><small>{item.type === 'article' ? 'مقال' : 'منشور'} · {item.issues?.[0] || 'بحاجة للمراجعة'}</small></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 5h5v5m0-5-8 8M19 13v6H5V5h6"/></svg></a>)}{!urgentItems.length && <p class="empty-line">لا توجد عناصر عاجلة في الصفحة الحالية.</p>}</div></section>
			<section class="audit-card operations-card"><header><div><span>المعالجة الذكية</span><h2>حالة العمليات</h2></div><span class:list={['operation-state', activeBatch && 'is-live']}><i></i>{activeBatch ? 'دفعة نشطة' : 'لا توجد دفعات نشطة'}</span></header>{activeBatch ? <div class="active-batch"><div><strong>{activeBatch.preset?.replaceAll('_',' ') || 'دفعة تحسين'}</strong><span>{activeBatch.content_type === 'article' ? 'مقالات' : activeBatch.content_type === 'post' ? 'منشورات' : 'الكل'} · استراتيجية {activeBatch.model_strategy}</span></div><b>{nf.format(Number(activeBatch.progress || 0))}%</b><i><span style={`width:${Math.min(100, Number(activeBatch.progress || 0))}%`}></span></i><footer><span>{nf.format(activeBatch.processed_items || 0)} من {nf.format(activeBatch.total_items || 0)} تمت معالجتها</span><a href="/dashboard/content-audit/ai-operations">التفاصيل</a></footer></div> : <div class="no-batch"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v18M5 8h14M5 16h14"/></svg></i><p><strong>جاهز للتحليل</strong><span>ابدأ دفعة آمنة تنشئ معاينات إصلاح دون تطبيق تلقائي.</span></p><a href="/dashboard/content-audit/ai-operations">إنشاء دفعة</a></div>}</section>
			<section class="audit-card cost-card"><header><div><span>آخر 7 أيام</span><h2>استهلاك نماذج AI</h2></div><b>{money.format(Number(costSummary.estimated_cost_usd || 0))}</b></header><div class="cost-metrics"><div><span>الطلبات</span><strong>{nf.format(costSummary.total_runs || 0)}</strong></div><div><span>الناجحة</span><strong>{nf.format(costSummary.success_runs || 0)}</strong></div><div><span>الرموز</span><strong>{nf.format(Number(costSummary.input_tokens || 0) + Number(costSummary.output_tokens || 0))}</strong></div><div><span>متوسط الزمن</span><strong>{nf.format(Math.round(Number(costSummary.avg_duration_ms || 0)))} ms</strong></div></div><a href="/dashboard/content-audit/ai-operations">عرض تفاصيل النماذج</a></section>
		</div>}
	</div>

	<style>
		.audit-page{--au-blue:#1a4d8f;--au-green:#0f8464;--au-orange:#e8a244;--au-red:#c43d49;--au-ink:#18283d;--au-muted:#68788d;--au-line:#dce4ed;direction:rtl}.audit-page *{box-sizing:border-box}.audit-alert{display:flex;align-items:center;gap:.7rem;margin-bottom:.8rem;border:1px solid;border-radius:.8rem;padding:.7rem .85rem}.audit-alert>i{display:grid;width:2rem;height:2rem;place-items:center;border-radius:.5rem;font-style:normal;font-weight:900}.audit-alert svg{width:1rem;height:1rem}.audit-alert div{display:grid}.audit-alert strong{font-size:.84rem}.audit-alert span{font-size:.74rem}.audit-alert a{margin-inline-start:auto;color:inherit;font-size:1.2rem}.audit-alert.is-error{border-color:#efc8cc;background:#fff6f7;color:#a62f3b}.audit-alert.is-success{border-color:#bce5d7;background:#f2fbf7;color:#087255}
		.audit-hero{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.75rem;border:1px solid var(--au-line);border-radius:1rem;background:#fff;padding:1.15rem 1.25rem;box-shadow:0 3px 12px rgb(23 43 77/.05)}.audit-hero-copy>span{display:flex;align-items:center;gap:.35rem;color:var(--au-blue);font-size:.72rem;font-weight:850}.audit-hero-copy>span svg{width:1rem;height:1rem}.audit-hero h1{margin:.22rem 0 .15rem;color:var(--au-ink);font-size:1.48rem;font-weight:950}.audit-hero p{max-width:47rem;margin:0;color:var(--au-muted);font-size:.8rem;line-height:1.75}.audit-hero p a{color:var(--au-blue);font-weight:850}.audit-hero-actions{display:flex;gap:.45rem}.audit-hero-actions>a{display:flex;min-height:2.55rem;align-items:center;gap:.35rem;border:1px solid #17457e;border-radius:.52rem;background:var(--au-blue);padding:.4rem .7rem;color:#fff;font-family:inherit;font-size:.68rem;font-weight:900;white-space:nowrap}.audit-hero-actions svg{width:.9rem;height:.9rem;stroke-width:2}
		.audit-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.55rem;margin-bottom:.7rem}.audit-kpis article{display:flex;min-width:0;align-items:center;gap:.55rem;border:1px solid var(--au-line);border-radius:.72rem;background:#fff;padding:.7rem;box-shadow:0 2px 8px rgb(23 43 77/.035)}.audit-kpis article>i{display:grid;width:2.35rem;height:2.35rem;flex:none;place-items:center;border-radius:.6rem}.audit-kpis svg{width:1rem;height:1rem;stroke-width:1.9}.audit-kpis .is-blue{background:#eaf1fa;color:var(--au-blue)}.audit-kpis .is-green{background:#e4f5ee;color:var(--au-green)}.audit-kpis .is-orange{background:#fff1de;color:#b66d13}.audit-kpis .is-red{background:#ffeaec;color:var(--au-red)}.audit-kpis .is-violet{background:#f0eafd;color:#6e42bd}.audit-kpis .is-dark{background:#edf0f4;color:#415167}.audit-kpis article>div{display:grid;min-width:0;gap:.03rem}.audit-kpis span{color:var(--au-muted);font-size:.6rem}.audit-kpis strong{color:var(--au-ink);font-size:1.05rem;font-weight:950}.audit-kpis small{overflow:hidden;color:#8a96a5;font-size:.53rem;text-overflow:ellipsis;white-space:nowrap}
		.audit-overview{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr) 18rem;gap:.65rem}.audit-card{border:1px solid var(--au-line);border-radius:.82rem;background:#fff;box-shadow:0 3px 10px rgb(23 43 77/.04);padding:.85rem}.audit-card>header{display:flex;align-items:center;justify-content:space-between;gap:.6rem;border-bottom:1px solid #edf1f5;padding-bottom:.6rem}.audit-card>header span{color:var(--au-blue);font-size:.62rem;font-weight:850}.audit-card h2{margin:.08rem 0 0;color:var(--au-ink);font-size:.9rem;font-weight:950}.audit-card>header>a{color:var(--au-blue);font-size:.62rem;font-weight:850}.readiness-card{grid-column:1/3}.readiness-card>header>b{color:var(--au-green);font-size:1.25rem}.readiness-meter{padding-top:.75rem}.readiness-meter>i{display:flex;height:.75rem;overflow:hidden;border-radius:99rem;background:#edf1f5}.readiness-meter>i>b{height:100%}.readiness-meter .ready{background:var(--au-green)}.readiness-meter .review{background:var(--au-orange)}.readiness-meter .weak{background:var(--au-red)}.readiness-meter>div{display:flex;gap:1rem;margin-top:.55rem}.readiness-meter>div>span{display:flex;align-items:center;gap:.3rem;color:var(--au-muted);font-size:.63rem}.readiness-meter>div b{width:.45rem;height:.45rem;border-radius:50%}.dot-ready{background:var(--au-green)}.dot-review{background:var(--au-orange)}.dot-weak{background:var(--au-red)}.readiness-meter>div strong{color:var(--au-ink)}.readiness-insight{display:flex;align-items:center;gap:.5rem;margin-top:.7rem;border-radius:.55rem;background:#f5f8fc;padding:.55rem;color:var(--au-blue)}.readiness-insight>svg{width:1.1rem;height:1.1rem;flex:none}.readiness-insight p{display:grid;margin:0}.readiness-insight p strong{font-size:.65rem}.readiness-insight p span{color:var(--au-muted);font-size:.58rem}.readiness-insight a{margin-inline-start:auto;font-size:.6rem;font-weight:850}.urgent-card{grid-column:3}.urgent-card>div{display:grid}.urgent-card>div>a{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:.45rem;border-bottom:1px solid #eff2f5;padding:.5rem 0}.urgent-card>div>a:last-child{border:0}.score-chip{display:grid;width:2rem;height:2rem;place-items:center;border-radius:.48rem;background:#fff0e0;color:#a86413;font-size:.62rem;font-weight:900}.score-chip.is-weak{background:#ffeaec;color:#b23340}.urgent-card a>div{display:grid;min-width:0}.urgent-card a strong{overflow:hidden;color:var(--au-ink);font-size:.65rem;text-overflow:ellipsis;white-space:nowrap}.urgent-card a small{overflow:hidden;color:var(--au-muted);font-size:.55rem;text-overflow:ellipsis;white-space:nowrap}.urgent-card a>svg{width:.75rem;height:.75rem;color:#8390a0}.operation-state{display:flex!important;align-items:center;gap:.25rem!important;color:#8290a0!important}.operation-state i{width:.4rem;height:.4rem;border-radius:50%;background:#aab4bf}.operation-state.is-live{color:var(--au-green)!important}.operation-state.is-live i{background:var(--au-green);box-shadow:0 0 0 .14rem #ddf4eb}.active-batch{display:grid;gap:.5rem;padding-top:.65rem}.active-batch>div{display:flex;justify-content:space-between}.active-batch>div>div{display:grid}.active-batch strong{color:var(--au-ink);font-size:.68rem}.active-batch span{color:var(--au-muted);font-size:.57rem}.active-batch>div>b{color:var(--au-blue);font-size:.8rem}.active-batch>i{height:.45rem;overflow:hidden;border-radius:99rem;background:#edf1f5}.active-batch>i>span{display:block;height:100%;border-radius:inherit;background:var(--au-blue)}.active-batch footer{display:flex;justify-content:space-between}.active-batch footer a{color:var(--au-blue);font-size:.58rem;font-weight:850}.no-batch{display:flex;align-items:center;gap:.45rem;padding-top:.7rem}.no-batch>i{display:grid;width:2.3rem;height:2.3rem;flex:none;place-items:center;border-radius:.55rem;background:#eaf1fa;color:var(--au-blue)}.no-batch svg{width:1rem;height:1rem}.no-batch p{display:grid;margin:0}.no-batch strong{color:var(--au-ink);font-size:.65rem}.no-batch span{color:var(--au-muted);font-size:.56rem}.no-batch a{margin-inline-start:auto;border:1px solid #ced9e6;border-radius:.4rem;background:#fff;padding:.3rem .5rem;color:var(--au-blue);font-family:inherit;font-size:.57rem;font-weight:850}.cost-card>header>b{color:var(--au-green);font-size:.78rem}.cost-metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:.35rem;padding-top:.65rem}.cost-metrics div{border:1px solid #edf1f5;border-radius:.4rem;padding:.38rem}.cost-metrics span{display:block;color:var(--au-muted);font-size:.54rem}.cost-metrics strong{color:var(--au-ink);font-size:.68rem}.cost-card>a{display:block;margin-top:.5rem;color:var(--au-blue);font-size:.58rem;font-weight:850;text-align:left}.empty-line{padding:.8rem;color:var(--au-muted);font-size:.65rem;text-align:center}
		.audit-empty{display:grid;min-height:18rem;place-items:center;align-content:center;border:1px dashed #d8e1eb;border-radius:.72rem;background:#fafbfd;text-align:center}.audit-empty>i{display:grid;width:3rem;height:3rem;place-items:center;border-radius:50%;background:#eaf1fa;color:var(--au-blue);font-style:normal;font-weight:950}.audit-empty svg{width:1.3rem;height:1.3rem}.audit-empty h2{margin:.55rem 0 .12rem;color:var(--au-ink);font-size:.86rem}.audit-empty p{margin:0;color:var(--au-muted);font-size:.65rem}.audit-empty a{margin-top:.5rem;color:var(--au-blue);font-size:.6rem;font-weight:850}.audit-empty.is-error>i{background:#ffeaec;color:var(--au-red)}
		.dark .audit-page{--au-ink:#f4f7fb;--au-muted:#9eacc0;--au-line:#30445d}.dark .audit-hero,.dark .audit-kpis article,.dark .audit-card{border-color:#30445d;background:#0f2547;color:#cbd5e1}.dark .readiness-insight{background:#122b4b}.dark .audit-card>header{border-color:#29405c}
		@media(max-width:1200px){.audit-kpis{grid-template-columns:repeat(3,1fr)}.audit-overview{grid-template-columns:repeat(2,1fr)}.readiness-card{grid-column:1/-1}.urgent-card{grid-column:auto}}
		@media(max-width:780px){.audit-hero{align-items:stretch;flex-direction:column}.audit-hero-actions{display:grid;grid-template-columns:1fr}.audit-hero-actions>a{width:100%;justify-content:center}.audit-overview{grid-template-columns:1fr}.readiness-card,.urgent-card{grid-column:auto}}
		@media(max-width:480px){.audit-kpis{grid-template-columns:repeat(2,1fr)}.audit-hero{padding:.9rem}.audit-hero h1{font-size:1.25rem}}
	</style>
</DashboardLayout>
