---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';
import { getCountryById } from '../../../lib/countries';

const guard = await requireDashboard(Astro, 'manage content audit');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const token = Astro.cookies.get('token')?.value;
const currentCountry = getCountryById(Astro.locals.countryId);
const allowedTabs = ['overview', 'readiness', 'ai', 'history'];
const tab = allowedTabs.includes(Astro.url.searchParams.get('tab') || '') ? String(Astro.url.searchParams.get('tab')) : 'overview';
const readinessPage = Math.max(1, Number(Astro.url.searchParams.get('rp') || 1));
const queuePage = Math.max(1, Number(Astro.url.searchParams.get('qp') || 1));
const historyPage = Math.max(1, Number(Astro.url.searchParams.get('hp') || 1));
const contentType = String(Astro.url.searchParams.get('type') || 'all');
const level = String(Astro.url.searchParams.get('level') || '');
const search = String(Astro.url.searchParams.get('q') || '').trim();
const queueStatus = String(Astro.url.searchParams.get('queue_status') || 'previewed');
const queueType = String(Astro.url.searchParams.get('queue_type') || 'all');
const queueSearch = String(Astro.url.searchParams.get('queue_q') || '').trim();
const costDays = Math.max(1, Math.min(90, Number(Astro.url.searchParams.get('days') || 7)));
const auth = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };

const [readinessResult, runsResult, queueResult, costsResult, batchesResult] = await Promise.all([
	apiFetch<any>('/dashboard/content-audit/adsense-readiness', { ...auth, params: { country: currentCountry.code, type: contentType, level, q: search, page: readinessPage, per_page: 20 } }),
	apiFetch<any[]>('/dashboard/content-audit/runs', { ...auth, params: { page: historyPage, per_page: 12 } }),
	apiFetch<any[]>('/dashboard/content-audit/ai/review-queue', { ...auth, params: { page: queuePage, per_page: 10, status: queueStatus, content_type: queueType, q: queueSearch } }),
	apiFetch<any>('/dashboard/content-audit/ai/model-costs', { ...auth, params: { days: costDays } }),
	apiFetch<any[]>('/dashboard/content-audit/ai/batch-jobs', auth),
]);

const readinessData = readinessResult.data ?? {};
const summary = readinessData.summary ?? {};
const readinessItems: any[] = Array.isArray(readinessData.items) ? readinessData.items : [];
const readinessMeta = readinessData.meta ?? {};
const runs: any[] = Array.isArray(runsResult.data) ? runsResult.data : [];
const queue: any[] = Array.isArray(queueResult.data) ? queueResult.data : [];
const costSummary = costsResult.data?.summary ?? {};
const costModels: any[] = Array.isArray(costsResult.data?.models) ? costsResult.data.models : [];
const batches: any[] = Array.isArray(batchesResult.data) ? batchesResult.data : [];
const activeBatch = batches.find((job: any) => ['queued', 'running', 'cancelling'].includes(job.status));
const selectedRunID = Math.max(0, Number(Astro.url.searchParams.get('run') || runs[0]?.id || 0));
const [selectedRunResult, findingsResult] = selectedRunID ? await Promise.all([
	apiFetch<any>(`/dashboard/content-audit/runs/${selectedRunID}`, auth),
	apiFetch<any[]>(`/dashboard/content-audit/runs/${selectedRunID}/findings`, { ...auth, params: { per_page: 50 } }),
]) : [{ ok: true, data: null }, { ok: true, data: [], meta: null }];
const selectedRun: any = selectedRunResult.data;
const findings: any[] = Array.isArray(findingsResult.data) ? findingsResult.data : [];
const total = Number(summary.total || 0);
const ready = Number(summary.ready || 0);
const review = Number(summary.review || 0);
const weak = Number(summary.weak || 0);
const noIndex = Number(summary.no_index || 0);
const adsEligible = Number(summary.ads_eligible || 0);
const readinessRate = total ? Math.round(ready / total * 100) : 0;
const adsRate = total ? Math.round(adsEligible / total * 100) : 0;
const urgentItems = readinessItems.filter((item: any) => item.level !== 'ready').slice(0, 6);
const currentRun = runs.find((run: any) => run.status === 'running');
const allOk = readinessResult.ok && runsResult.ok && queueResult.ok && costsResult.ok && batchesResult.ok;
const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success');
const cleanUrl = new URL(Astro.url); cleanUrl.searchParams.delete('error'); cleanUrl.searchParams.delete('success');
const redirectTo = `${cleanUrl.pathname}${cleanUrl.search}`;

const nf = new Intl.NumberFormat('ar-EG');
const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 3, maximumFractionDigits: 4 });
const df = new Intl.DateTimeFormat('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
const formatDate = (value?: string | null) => value ? df.format(new Date(value)) : '—';
const tabUrl = (name: string) => `/dashboard/content-audit?tab=${name}`;
const labelType = (type: string) => type === 'article' ? 'مقال' : type === 'post' ? 'منشور' : 'الكل';
const levelLabels: Record<string, string> = { ready: 'جاهز', review: 'يحتاج مراجعة', weak: 'ضعيف' };
const runStatus: Record<string, string> = { running: 'قيد التنفيذ', completed: 'مكتمل', failed: 'فشل', queued: 'في الانتظار', cancelling: 'جارٍ الإلغاء', cancelled: 'ملغى' };
const decisionLabels: Record<string, string> = { approved: 'معتمد', needs_fix: 'يحتاج إصلاح', restricted_ads: 'إعلانات مقيدة', rejected: 'مرفوض' };
const successMessages: Record<string, string> = { audit_started: 'بدأ تدقيق المحتوى في الخلفية.', batch_started: 'تم إنشاء دفعة التحليل الذكي.', batch_cancelled: 'تم إرسال طلب إلغاء الدفعة.', fix_applied: 'تم اعتماد الإصلاح وتحديث المحتوى.', fix_rejected: 'تم رفض مقترح الإصلاح.' };
const pageHref = (key: string, page: number, targetTab: string) => { const u = new URL(Astro.url); u.searchParams.set('tab', targetTab); u.searchParams.set(key, String(page)); u.searchParams.delete('success'); u.searchParams.delete('error'); return `${u.pathname}?${u.searchParams.toString()}`; };
const runHref = (id: number) => { const u = new URL(Astro.url); u.searchParams.set('tab', 'history'); u.searchParams.set('run', String(id)); u.searchParams.delete('success'); u.searchParams.delete('error'); return `${u.pathname}?${u.searchParams.toString()}`; };
---

<DashboardLayout title="تدقيق المحتوى" user={user}>
	<div class="audit-page">
		{error && <div class="audit-alert is-error" role="alert"><i>!</i><div><strong>تعذّر تنفيذ العملية</strong><span>{error}</span></div><a href={redirectTo}>×</a></div>}
		{success && <div class="audit-alert is-success" role="status"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m5 12 4 4L19 6"/></svg></i><div><strong>تمت العملية بنجاح</strong><span>{successMessages[success] || 'تم حفظ التغييرات.'}</span></div><a href={redirectTo}>×</a></div>}

		<header class="audit-hero">
			<div class="audit-hero-copy"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d="m9 12 2 2 4-5"/></svg>الجودة والسياسات والجاهزية الإعلانية</span><h1>مركز تدقيق المحتوى</h1><p>لوحة تشغيل متكاملة لمراجعة جودة المحتوى، جاهزية AdSense، قرارات الذكاء الاصطناعي وإصلاحات التحرير في منصة {currentCountry.name}.</p></div>
			<div class="audit-hero-actions"><button type="button" data-open-batch><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v18M5 8h14M5 16h14"/></svg>دفعة تحليل ذكية</button><form method="post" action="/api/dashboard/content-audit/run"><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" disabled={!!currentRun}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 9a7 7 0 0 1 12-2l2 2M4 15l2 2a7 7 0 0 0 12-2"/></svg>{currentRun ? 'التدقيق يعمل الآن' : 'تشغيل تدقيق شامل'}</button></form></div>
		</header>

		<section class="audit-kpis">
			<article><i class="is-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8m-8 4h5"/></svg></i><div><span>إجمالي المحتوى</span><strong>{nf.format(total)}</strong><small>{labelType(contentType)}</small></div></article>
			<article><i class="is-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m5 12 4 4L19 6"/></svg></i><div><span>جاهز للنشر</span><strong>{nf.format(readinessRate)}%</strong><small>{nf.format(ready)} عنصر</small></div></article>
			<article><i class="is-orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 9v4m0 4h.01M4 20h16L12 4z"/></svg></i><div><span>بحاجة لتدخل</span><strong>{nf.format(review + weak)}</strong><small>{nf.format(weak)} ضعيف</small></div></article>
			<article><i class="is-red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 5l14 14M19 5 5 19"/></svg></i><div><span>غير قابل للفهرسة</span><strong>{nf.format(noIndex)}</strong><small>يحتاج معالجة</small></div></article>
			<article><i class="is-violet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16v10H4zM8 12h8"/></svg></i><div><span>مؤهل للإعلانات</span><strong>{nf.format(adsRate)}%</strong><small>{nf.format(adsEligible)} عنصر</small></div></article>
			<article><i class="is-dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5h16v14H4zM8 9h8m-8 4h5"/></svg></i><div><span>طابور AI</span><strong>{nf.format(queueResult.meta?.total ?? queue.length)}</strong><small>بانتظار القرار</small></div></article>
		</section>

		<nav class="audit-tabs" aria-label="أقسام مركز التدقيق"><a href={tabUrl('overview')} class:list={{ 'is-active': tab === 'overview' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 13h6V4H4zm10 7h6V11h-6zM4 20h6v-3H4zm10-13h6V4h-6z"/></svg><span>الملخص التنفيذي</span></a><a href={tabUrl('readiness')} class:list={{ 'is-active': tab === 'readiness' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8m-8 4h5"/></svg><span>جاهزية المحتوى</span><strong>{nf.format(total)}</strong></a><a href={tabUrl('ai')} class:list={{ 'is-active': tab === 'ai' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M6 6l2 2m8 8 2 2m0-12-2 2M8 16l-2 2"/></svg><span>عمليات الذكاء الاصطناعي</span><strong>{nf.format(batches.length)}</strong></a><a href={tabUrl('history')} class:list={{ 'is-active': tab === 'history' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>سجل التدقيق</span><strong>{nf.format(runsResult.meta?.total ?? runs.length)}</strong></a></nav>

		{!allOk && tab === 'overview' ? <section class="audit-empty is-error"><i>!</i><h2>تعذّر تحميل بعض بيانات التدقيق</h2><p>تحقق من اتصال الخادم ثم أعد المحاولة.</p><a href={redirectTo}>إعادة المحاولة</a></section> : tab === 'overview' ? <div class="audit-overview">
			<section class="audit-card readiness-card"><header><div><span>الصورة العامة</span><h2>توزيع جاهزية المحتوى</h2></div><b>{nf.format(readinessRate)}%</b></header><div class="readiness-meter"><i><b class="ready" style={`width:${total ? ready / total * 100 : 0}%`}></b><b class="review" style={`width:${total ? review / total * 100 : 0}%`}></b><b class="weak" style={`width:${total ? weak / total * 100 : 0}%`}></b></i><div><span><b class="dot-ready"></b>جاهز <strong>{nf.format(ready)}</strong></span><span><b class="dot-review"></b>مراجعة <strong>{nf.format(review)}</strong></span><span><b class="dot-weak"></b>ضعيف <strong>{nf.format(weak)}</strong></span></div></div><div class="readiness-insight"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v18M5 8h14M5 16h14"/></svg><p><strong>{adsRate >= 75 ? 'الوضع الإعلاني جيد' : 'توجد فجوة في الجاهزية الإعلانية'}</strong><span>{nf.format(total - adsEligible)} عنصرًا لا يحقق شروط عرض الإعلانات حاليًا.</span></p><a href={tabUrl('readiness')}>فتح التقرير</a></div></section>
			<section class="audit-card urgent-card"><header><div><span>الأولوية الآن</span><h2>محتوى يحتاج تدخلك</h2></div><a href={tabUrl('readiness')}>عرض الكل</a></header><div>{urgentItems.map((item: any) => <a href={item.url} target="_blank"><span class:list={['score-chip', `is-${item.level}`]}>{nf.format(item.score)}</span><div><strong>{item.title}</strong><small>{labelType(item.type)} · {item.issues?.[0] || 'بحاجة للمراجعة'}</small></div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 5h5v5m0-5-8 8M19 13v6H5V5h6"/></svg></a>)}{!urgentItems.length && <p class="empty-line">لا توجد عناصر عاجلة في الصفحة الحالية.</p>}</div></section>
			<section class="audit-card operations-card"><header><div><span>المعالجة الذكية</span><h2>حالة العمليات</h2></div><span class:list={['operation-state', activeBatch && 'is-live']}><i></i>{activeBatch ? 'دفعة نشطة' : 'لا توجد دفعات نشطة'}</span></header>{activeBatch ? <div class="active-batch"><div><strong>{activeBatch.preset?.replaceAll('_',' ') || 'دفعة تحسين'}</strong><span>{labelType(activeBatch.content_type)} · استراتيجية {activeBatch.model_strategy}</span></div><b>{nf.format(Number(activeBatch.progress || 0))}%</b><i><span style={`width:${Math.min(100, Number(activeBatch.progress || 0))}%`}></span></i><footer><span>{nf.format(activeBatch.processed_items || 0)} من {nf.format(activeBatch.total_items || 0)} تمت معالجتها</span><a href={tabUrl('ai')}>التفاصيل</a></footer></div> : <div class="no-batch"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v18M5 8h14M5 16h14"/></svg></i><p><strong>جاهز للتحليل</strong><span>ابدأ دفعة آمنة تنشئ معاينات إصلاح دون تطبيق تلقائي.</span></p><button type="button" data-open-batch>إنشاء دفعة</button></div>}</section>
			<section class="audit-card cost-card"><header><div><span>آخر {nf.format(costDays)} أيام</span><h2>استهلاك نماذج AI</h2></div><b>{money.format(Number(costSummary.estimated_cost_usd || 0))}</b></header><div class="cost-metrics"><div><span>الطلبات</span><strong>{nf.format(costSummary.total_runs || 0)}</strong></div><div><span>الناجحة</span><strong>{nf.format(costSummary.success_runs || 0)}</strong></div><div><span>الرموز</span><strong>{nf.format(Number(costSummary.input_tokens || 0) + Number(costSummary.output_tokens || 0))}</strong></div><div><span>متوسط الزمن</span><strong>{nf.format(Math.round(Number(costSummary.avg_duration_ms || 0)))} ms</strong></div></div><a href={tabUrl('ai')}>عرض تفاصيل النماذج</a></section>
			<section class="audit-card runs-card"><header><div><span>سجل التشغيل</span><h2>آخر عمليات التدقيق</h2></div><a href={tabUrl('history')}>السجل الكامل</a></header><div>{runs.slice(0,5).map((run:any)=><a href={runHref(run.id)}><i class:list={[`is-${run.status}`]}></i><div><strong>عملية تدقيق #{nf.format(run.id)}</strong><span>{run.triggered_by === 'manual' ? 'تشغيل يدوي' : 'تشغيل مجدول'} · {formatDate(run.started_at)}</span></div><b>{nf.format(run.findings_count || 0)} ملاحظة</b><span class:list={['run-badge',`is-${run.status}`]}>{runStatus[run.status] || run.status}</span></a>)}{!runs.length && <p class="empty-line">لم يتم تشغيل أي تدقيق بعد.</p>}</div></section>
			<section class="audit-card guardrails-card"><header><div><span>حوكمة التحرير</span><h2>نظام إصلاح آمن</h2></div></header><ul><li><i>1</i><p><strong>تحليل المحتوى</strong><span>قياس السياسة وSEO واللغة والبنية.</span></p></li><li><i>2</i><p><strong>إنشاء معاينة</strong><span>مقارنة الأصل والمقترح دون تعديل مباشر.</span></p></li><li><i>3</i><p><strong>اعتماد بشري</strong><span>لا يُطبّق أي إصلاح قبل موافقة الإدارة.</span></p></li></ul></section>
		</div> : tab === 'readiness' ? <section class="readiness-section">
			<header class="section-heading"><div><span>فحص قابلية النشر والربح</span><h2>تقرير جاهزية المحتوى</h2><p>حلّل الجودة النصية، الوصف، المرفقات، الفهرسة وشروط عرض الإعلانات.</p></div><span class="results-count">{nf.format(readinessMeta.filtered_total ?? readinessItems.length)} نتيجة</span></header>
			<form class="audit-filters" method="get" action="/dashboard/content-audit"><input type="hidden" name="tab" value="readiness"/><label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" name="q" value={search} placeholder="ابحث بعنوان المحتوى..."/></label><select name="type"><option value="all">كل المحتوى</option><option value="article" selected={contentType==='article'}>المقالات</option><option value="post" selected={contentType==='post'}>المنشورات</option></select><select name="level"><option value="">كل المستويات</option><option value="weak" selected={level==='weak'}>ضعيف</option><option value="review" selected={level==='review'}>يحتاج مراجعة</option><option value="ready" selected={level==='ready'}>جاهز</option></select><button type="submit">تطبيق</button>{(search || level || contentType!=='all') && <a href={tabUrl('readiness')}>مسح</a>}</form>
			{readinessItems.length ? <div class="readiness-table-wrap"><table><thead><tr><th>المحتوى</th><th>درجة الجودة</th><th>المؤشرات</th><th>أبرز المشكلات</th><th>الفهرسة</th><th>الإعلانات</th><th></th></tr></thead><tbody>{readinessItems.map((item:any)=><tr><td><div class="content-cell"><span>{labelType(item.type)}</span><strong>{item.title}</strong><small>#{nf.format(item.id)} · {item.status === 'published' ? 'منشور' : 'غير منشور'}</small></div></td><td><div class:list={['audit-score',`is-${item.level}`]} style={`--score:${item.score}`}><strong>{nf.format(item.score)}</strong><i><span></span></i><small>{levelLabels[item.level] || item.level}</small></div></td><td><div class="content-metrics"><span><b>{nf.format(item.word_count || 0)}</b> كلمة</span><span><b>{nf.format(item.files_count || 0)}</b> مرفق</span></div></td><td><div class="issue-list">{(item.issues || []).slice(0,2).map((issue:string)=><span>{issue}</span>)}{!(item.issues||[]).length && <span class="is-clean">لا توجد مشكلات</span>}</div></td><td><span class:list={['boolean-badge',item.should_index&&'is-yes']}><i></i>{item.should_index?'مفهرس':'غير مفهرس'}</span></td><td><span class:list={['boolean-badge',item.should_show_ads&&'is-yes']}><i></i>{item.should_show_ads?'مؤهل':'غير مؤهل'}</span></td><td><a class="open-content" href={item.url} target="_blank" title="فتح المحتوى"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 5h5v5m0-5-8 8M19 13v6H5V5h6"/></svg></a></td></tr>)}</tbody></table></div> : <section class="audit-empty"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8"/></svg></i><h2>لا توجد نتائج مطابقة</h2><p>غيّر الفلاتر أو شغّل تدقيقًا جديدًا.</p></section>}
			{readinessMeta.last_page>1 && <nav class="audit-pagination"><a href={pageHref('rp',Math.max(1,readinessMeta.current_page-1),'readiness')} class:list={{'is-disabled':readinessMeta.current_page<=1}}>السابق</a><span>صفحة <strong>{nf.format(readinessMeta.current_page)}</strong> من {nf.format(readinessMeta.last_page)}</span><a href={pageHref('rp',Math.min(readinessMeta.last_page,readinessMeta.current_page+1),'readiness')} class:list={{'is-disabled':readinessMeta.current_page>=readinessMeta.last_page}}>التالي</a></nav>}
		</section> : tab === 'ai' ? <div class="ai-section">
			<section class="audit-card batch-manager"><header><div><span>التشغيل الدفعي</span><h2>دفعات التحليل والتحسين</h2></div><button type="button" data-open-batch><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg>دفعة جديدة</button></header><div class="batch-list">{batches.slice(0,8).map((job:any)=><article><div class="batch-top"><span class:list={['batch-status',`is-${job.status}`]}><i></i>{runStatus[job.status]||job.status}</span><time>{formatDate(job.created_at)}</time></div><div class="batch-title"><div><strong>{job.preset?.replaceAll('_',' ') || 'تحسين محتوى'}</strong><span>{labelType(job.content_type)} · {job.model_strategy} · حد {nf.format(job.limit)}</span></div><b>{nf.format(job.progress||0)}%</b></div><i class="batch-progress"><span style={`width:${Math.min(100,Number(job.progress||0))}%`}></span></i><footer><span><b>{nf.format(job.successful_items||0)}</b> ناجح</span><span><b>{nf.format(job.failed_items||0)}</b> فشل</span><span><b>{nf.format(job.pending_items||0)}</b> متبقي</span>{['queued','running'].includes(job.status)&&<form method="post" action={`/api/dashboard/content-audit/batches/${job.id}/cancel`} data-confirm data-confirm-title="إلغاء دفعة التحليل؟" data-confirm-message="سيتم إيقاف معالجة العناصر المتبقية، مع الاحتفاظ بالنتائج المكتملة." data-confirm-label="إلغاء الدفعة"><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit">إلغاء</button></form>}</footer></article>)}{!batches.length&&<p class="empty-line">لا توجد دفعات تحليل بعد.</p>}</div></section>
			<section class="audit-card review-queue"><header><div><span>قرار بشري مطلوب</span><h2>طابور معاينات الإصلاح</h2></div><strong>{nf.format(queueResult.meta?.total??queue.length)}</strong></header><form class="queue-filters" method="get" action="/dashboard/content-audit"><input type="hidden" name="tab" value="ai"/><input type="search" name="queue_q" value={queueSearch} placeholder="ابحث في المعاينات..."/><select name="queue_status"><option value="previewed" selected={queueStatus==='previewed'}>بانتظار المراجعة</option><option value="applied" selected={queueStatus==='applied'}>مطبقة</option><option value="rejected" selected={queueStatus==='rejected'}>مرفوضة</option><option value="all" selected={queueStatus==='all'}>كل الحالات</option></select><select name="queue_type"><option value="all">كل المحتوى</option><option value="article" selected={queueType==='article'}>مقالات</option><option value="post" selected={queueType==='post'}>منشورات</option></select><button type="submit">تصفية</button></form><div class="queue-list">{queue.map((item:any)=><article><div class="queue-score"><strong>{nf.format(item.score||0)}</strong><span>درجة</span></div><div class="queue-copy"><span>{labelType(item.content_type)} #{item.content_id} · {decisionLabels[item.decision]||item.decision}</span><h3>{item.original_title}</h3><p>{item.fix_summary||'تم إنشاء مقترح تحسين لهذا المحتوى.'}</p><small>{item.model||'نموذج غير محدد'} · {nf.format(item.processing_time_ms||0)} ms</small></div><div class="queue-actions"><span class:list={['risk-tag',`is-${item.adsense_risk}`]}>خطر {item.adsense_risk||'غير محدد'}</span><button type="button" data-open-preview data-preview-id={String(item.id)}>معاينة المقارنة</button></div></article>)}{!queue.length&&<p class="empty-line">لا توجد معاينات مطابقة لهذا الفلتر.</p>}</div>{queueResult.meta&&queueResult.meta.last_page>1&&<nav class="audit-pagination"><a href={pageHref('qp',Math.max(1,queueResult.meta.current_page-1),'ai')} class:list={{'is-disabled':queueResult.meta.current_page<=1}}>السابق</a><span>صفحة <strong>{nf.format(queueResult.meta.current_page)}</strong> من {nf.format(queueResult.meta.last_page)}</span><a href={pageHref('qp',Math.min(queueResult.meta.last_page,queueResult.meta.current_page+1),'ai')} class:list={{'is-disabled':queueResult.meta.current_page>=queueResult.meta.last_page}}>التالي</a></nav>}</section>
			<section class="audit-card model-costs"><header><div><span>التكلفة والاعتمادية</span><h2>أداء نماذج الذكاء الاصطناعي</h2></div><form method="get" action="/dashboard/content-audit"><input type="hidden" name="tab" value="ai"/><select name="days" onchange="this.form.submit()"><option value="7" selected={costDays===7}>7 أيام</option><option value="30" selected={costDays===30}>30 يومًا</option><option value="90" selected={costDays===90}>90 يومًا</option></select></form></header><div class="model-summary"><div><span>التكلفة</span><strong>{money.format(Number(costSummary.estimated_cost_usd||0))}</strong></div><div><span>إجمالي الطلبات</span><strong>{nf.format(costSummary.total_runs||0)}</strong></div><div><span>نسبة النجاح</span><strong>{Number(costSummary.total_runs||0)?nf.format(Math.round(Number(costSummary.success_runs||0)/Number(costSummary.total_runs)*100)):0}%</strong></div><div><span>متوسط الاستجابة</span><strong>{nf.format(Math.round(Number(costSummary.avg_duration_ms||0)))} ms</strong></div></div><div class="model-table"><table><thead><tr><th>النموذج</th><th>الاستراتيجية</th><th>المهمة</th><th>الطلبات</th><th>النجاح</th><th>الرموز</th><th>التكلفة</th></tr></thead><tbody>{costModels.slice(0,10).map((model:any)=><tr><td><strong dir="ltr">{model.model||'—'}</strong></td><td>{model.model_strategy||'—'}</td><td>{model.task_type||'—'}</td><td>{nf.format(model.runs||0)}</td><td><span class:list={['success-rate',Number(model.runs||0)>0&&Number(model.success_runs||0)/Number(model.runs)>=.9&&'is-good']}>{Number(model.runs||0)?nf.format(Math.round(Number(model.success_runs||0)/Number(model.runs)*100)):0}%</span></td><td>{nf.format(Number(model.input_tokens||0)+Number(model.output_tokens||0))}</td><td>{money.format(Number(model.estimated_cost_usd||0))}</td></tr>)}</tbody></table>{!costModels.length&&<p class="empty-line">لا توجد استدعاءات مسجلة في الفترة المختارة.</p>}</div></section>
		</div> : <div class="history-section">
			<aside class="runs-sidebar"><header><span>التشغيلات السابقة</span><h2>سجل التدقيق</h2></header><div>{runs.map((run:any)=><a href={runHref(run.id)} class:list={{'is-active':selectedRunID===Number(run.id)}}><i class:list={[`is-${run.status}`]}></i><div><strong>تدقيق #{nf.format(run.id)}</strong><span>{formatDate(run.started_at)}</span></div><b>{nf.format(run.findings_count||0)}</b></a>)}{!runs.length&&<p>لا يوجد سجل بعد.</p>}</div>{runsResult.meta&&runsResult.meta.last_page>1&&<nav><a href={pageHref('hp',Math.max(1,runsResult.meta.current_page-1),'history')} class:list={{'is-disabled':runsResult.meta.current_page<=1}}>السابق</a><span>{nf.format(runsResult.meta.current_page)}/{nf.format(runsResult.meta.last_page)}</span><a href={pageHref('hp',Math.min(runsResult.meta.last_page,runsResult.meta.current_page+1),'history')} class:list={{'is-disabled':runsResult.meta.current_page>=runsResult.meta.last_page}}>التالي</a></nav>}</aside>
			<main class="run-detail">{selectedRun?<><header><div><span>تفاصيل العملية #{nf.format(selectedRun.id)}</span><h2>{runStatus[selectedRun.status]||selectedRun.status}</h2><p>{selectedRun.triggered_by==='manual'?'بدأها أحد مسؤولي المنصة':'بدأها المجدول التلقائي'} في {formatDate(selectedRun.started_at)}</p></div><div><span class:list={['run-badge',`is-${selectedRun.status}`]}>{runStatus[selectedRun.status]||selectedRun.status}</span>{selectedRun.status==='completed'&&<a href={`/api/dashboard/content-audit/runs/${selectedRun.id}/export`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v12m-4-4 4 4 4-4M5 19h14"/></svg>تصدير CSV</a>}</div></header><section class="run-metrics"><div><span>الملاحظات</span><strong>{nf.format(selectedRun.findings_count||0)}</strong></div><div><span>بدأ في</span><strong>{formatDate(selectedRun.started_at)}</strong></div><div><span>انتهى في</span><strong>{formatDate(selectedRun.finished_at)}</strong></div></section>{selectedRun.error_message&&<div class="run-error"><strong>سبب الفشل</strong><span>{selectedRun.error_message}</span></div>}<div class="findings-list"><header><h3>ملاحظات هذه العملية</h3><span>{nf.format(findingsResult.meta?.total??findings.length)} نتيجة</span></header>{findings.map((finding:any)=><article><span class:list={['finding-risk',`is-${finding.risk}`]}>{finding.risk}</span><div><span>{labelType(finding.type)} #{finding.id}</span><h4>{finding.title}</h4><p>{finding.reason}</p><small><b>الإجراء المقترح:</b> {finding.recommended_action||'مراجعة يدوية'}</small></div>{finding.url&&<a href={finding.url} target="_blank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 5h5v5m0-5-8 8M19 13v6H5V5h6"/></svg></a>}</article>)}{!findings.length&&<p class="empty-line">لا توجد ملاحظات مسجلة لهذه العملية.</p>}</div></>:<section class="audit-empty"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i><h2>اختر عملية تدقيق</h2><p>ستظهر تفاصيلها وملاحظاتها هنا.</p></section>}</main>
		</div>}
	</div>

	<dialog id="batch-dialog" class="batch-dialog" aria-labelledby="batch-title"><form method="post" action="/api/dashboard/content-audit/batches/start"><header><div><span>تشغيل آمن بمعاينة أولية</span><h2 id="batch-title">إنشاء دفعة تحليل ذكية</h2><p>حدد النطاق والاستراتيجية؛ لن يُطبّق أي تعديل دون مراجعتك.</p></div><button type="button" data-close-batch>×</button></header><input type="hidden" name="country_code" value={currentCountry.code}/><input type="hidden" name="redirect_to" value={redirectTo}/><div class="batch-form"><label><span>نوع المحتوى</span><select name="content_type"><option value="all">المقالات والمنشورات</option><option value="article">المقالات فقط</option><option value="post">المنشورات فقط</option></select></label><label><span>الأولوية الذكية</span><select name="preset"><option value="weak_first">الأضعف أولًا</option><option value="indexed_weak">الضعيف المفهرس</option><option value="short_file_pages">صفحات قصيرة ذات ملفات</option><option value="custom_filter">فلتر مخصص</option></select></label><label><span>طريقة التنفيذ</span><select name="mode"><option value="fix_preview">تحليل وإنشاء معاينة</option><option value="analyze_only">تحليل فقط</option><option value="full_review">مراجعة شاملة</option></select></label><label><span>استراتيجية النموذج</span><select name="model_strategy"><option value="balanced">متوازنة</option><option value="economy">اقتصادية</option><option value="quality">جودة عالية</option><option value="final_review">مراجعة نهائية</option></select></label><label><span>عدد العناصر</span><input type="number" name="limit" min="1" max="500" value="20"/></label><label><span>المعالجة المتوازية</span><input type="number" name="concurrency" min="1" max="6" value="2"/></label><label class="is-wide"><span>بحث اختياري</span><input type="search" name="q" placeholder="تضييق النطاق بعنوان محدد..."/></label><input type="hidden" name="level" value="weak"/></div><aside><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d="m9 12 2 2 4-5"/></svg><p><strong>حماية التحرير مفعلة</strong><span>ستُنشأ معاينات يمكن قبولها أو رفضها عنصرًا عنصرًا.</span></p></aside><footer><button type="button" data-close-batch>إلغاء</button><button type="submit">بدء الدفعة</button></footer></form></dialog>

	<dialog id="preview-dialog" class="preview-dialog" aria-labelledby="preview-title"><div><header><div><span>معاينة الإصلاح بالذكاء الاصطناعي</span><h2 id="preview-title" data-preview-title>تحميل المقارنة...</h2><p data-preview-summary></p></div><button type="button" data-close-preview>×</button></header><div class="preview-loading" data-preview-loading><i></i><span>جارٍ تحميل النسخة الأصلية والمقترحة...</span></div><div class="preview-content" data-preview-content hidden><section><header><span>النسخة الحالية</span><b>قبل</b></header><h3 data-original-title></h3><pre data-original-content></pre></section><section><header><span>النسخة المقترحة</span><b>بعد</b></header><h3 data-fixed-title></h3><pre data-fixed-content></pre></section></div><label class="review-note" data-review-note-wrap hidden><span>ملاحظة القرار</span><textarea rows="2" data-review-note placeholder="أضف سبب الاعتماد أو الرفض اختياريًا..."></textarea></label><footer data-preview-actions hidden><button type="button" data-reject-preview>رفض المقترح</button><button type="button" data-apply-preview>اعتماد وتطبيق الإصلاح</button></footer><form method="post" action="/api/dashboard/content-audit/fixes/apply" data-apply-form><input type="hidden" name="fix_preview_id"/><input type="hidden" name="note"/><input type="hidden" name="redirect_to" value={redirectTo}/></form><form method="post" action="/api/dashboard/content-audit/fixes/reject" data-reject-form><input type="hidden" name="fix_preview_id"/><input type="hidden" name="note"/><input type="hidden" name="redirect_to" value={redirectTo}/></form></div></dialog>

	<dialog id="audit-confirm" class="audit-confirm" aria-labelledby="confirm-title"><div><button type="button" data-close-confirm>×</button><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 9v4m0 4h.01M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/></svg></i><span>تأكيد الإجراء</span><h2 id="confirm-title" data-confirm-dialog-title></h2><p data-confirm-dialog-message></p><aside><strong>راجع القرار جيدًا</strong><small>قد يؤثر هذا الإجراء في المحتوى أو سير المعالجة.</small></aside><footer><button type="button" data-close-confirm>تراجع</button><button type="button" data-confirm-action>تأكيد</button></footer></div></dialog>

	<script>
		const batchDialog=document.getElementById('batch-dialog') as HTMLDialogElement|null;document.querySelectorAll('[data-open-batch]').forEach(b=>b.addEventListener('click',()=>batchDialog?.showModal()));document.querySelectorAll('[data-close-batch]').forEach(b=>b.addEventListener('click',()=>batchDialog?.close()));batchDialog?.addEventListener('click',e=>{if(e.target===batchDialog)batchDialog.close()});
		const confirmDialog=document.getElementById('audit-confirm') as HTMLDialogElement|null;let pendingForm:HTMLFormElement|null=null;const confirmAction=(form:HTMLFormElement,title:string,message:string,label:string)=>{pendingForm=form;const t=confirmDialog?.querySelector<HTMLElement>('[data-confirm-dialog-title]');const m=confirmDialog?.querySelector<HTMLElement>('[data-confirm-dialog-message]');const a=confirmDialog?.querySelector<HTMLButtonElement>('[data-confirm-action]');if(t)t.textContent=title;if(m)m.textContent=message;if(a)a.textContent=label;confirmDialog?.showModal()};document.querySelectorAll<HTMLFormElement>('[data-confirm]').forEach(form=>form.addEventListener('submit',e=>{if(form.dataset.confirmed==='true')return;e.preventDefault();confirmAction(form,form.dataset.confirmTitle||'هل تريد المتابعة؟',form.dataset.confirmMessage||'',form.dataset.confirmLabel||'تأكيد')}));document.querySelectorAll('[data-close-confirm]').forEach(b=>b.addEventListener('click',()=>{pendingForm=null;confirmDialog?.close()}));confirmDialog?.querySelector('[data-confirm-action]')?.addEventListener('click',()=>{const f=pendingForm;pendingForm=null;confirmDialog?.close();if(f){f.dataset.confirmed='true';f.requestSubmit()}});
		const previewDialog=document.getElementById('preview-dialog') as HTMLDialogElement|null;const applyForm=previewDialog?.querySelector<HTMLFormElement>('[data-apply-form]');const rejectForm=previewDialog?.querySelector<HTMLFormElement>('[data-reject-form]');const note=previewDialog?.querySelector<HTMLTextAreaElement>('[data-review-note]');const setText=(selector:string,value:string)=>{const node=previewDialog?.querySelector<HTMLElement>(selector);if(node)node.textContent=value||'—'};document.querySelectorAll<HTMLButtonElement>('[data-open-preview]').forEach(button=>button.addEventListener('click',async()=>{const id=button.dataset.previewId||'';previewDialog?.showModal();previewDialog?.querySelector<HTMLElement>('[data-preview-loading]')?.removeAttribute('hidden');previewDialog?.querySelector<HTMLElement>('[data-preview-content]')?.setAttribute('hidden','');previewDialog?.querySelector<HTMLElement>('[data-preview-actions]')?.setAttribute('hidden','');previewDialog?.querySelector<HTMLElement>('[data-review-note-wrap]')?.setAttribute('hidden','');try{const response=await fetch(`/api/dashboard/content-audit/fix-preview/${id}`);const json=await response.json();if(!response.ok||json?.success===false)throw new Error(json?.message||'تعذّر تحميل المعاينة');const p=json.data||{};setText('[data-preview-title]',p.fixed_title||p.original_title||'معاينة الإصلاح');setText('[data-preview-summary]',p.fix_summary||'قارن النسختين قبل اتخاذ القرار.');setText('[data-original-title]',p.original_title);setText('[data-original-content]',p.original_content);setText('[data-fixed-title]',p.fixed_title);setText('[data-fixed-content]',p.fixed_content);applyForm?.querySelector<HTMLInputElement>('[name="fix_preview_id"]')?.setAttribute('value',String(p.id||id));rejectForm?.querySelector<HTMLInputElement>('[name="fix_preview_id"]')?.setAttribute('value',String(p.id||id));previewDialog?.querySelector<HTMLElement>('[data-preview-loading]')?.setAttribute('hidden','');previewDialog?.querySelector<HTMLElement>('[data-preview-content]')?.removeAttribute('hidden');previewDialog?.querySelector<HTMLElement>('[data-preview-actions]')?.removeAttribute('hidden');previewDialog?.querySelector<HTMLElement>('[data-review-note-wrap]')?.removeAttribute('hidden')}catch(error){setText('[data-preview-title]','تعذّر تحميل المعاينة');setText('[data-preview-summary]',error instanceof Error?error.message:'حدث خطأ غير متوقع');previewDialog?.querySelector<HTMLElement>('[data-preview-loading]')?.setAttribute('hidden','')}}));document.querySelectorAll('[data-close-preview]').forEach(b=>b.addEventListener('click',()=>previewDialog?.close()));previewDialog?.querySelector('[data-apply-preview]')?.addEventListener('click',()=>{if(!applyForm)return;const n=applyForm.querySelector<HTMLInputElement>('[name="note"]');if(n)n.value=note?.value||'';previewDialog.close();confirmAction(applyForm,'اعتماد الإصلاح وتحديث المحتوى؟','سيتم استبدال عنوان ومحتوى النسخة الحالية بالنص المقترح بعد هذه الخطوة.','اعتماد وتطبيق')});previewDialog?.querySelector('[data-reject-preview]')?.addEventListener('click',()=>{if(!rejectForm)return;const n=rejectForm.querySelector<HTMLInputElement>('[name="note"]');if(n)n.value=note?.value||'';previewDialog.close();confirmAction(rejectForm,'رفض مقترح الإصلاح؟','سيتم إغلاق المعاينة كمرفوضة مع الاحتفاظ بالمحتوى الحالي دون تغيير.','رفض المقترح')});
	</script>

	<style>
