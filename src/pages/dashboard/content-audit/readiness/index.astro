---
import { requireDashboard } from '../../../../lib/auth';
const guard = await requireDashboard(Astro, 'manage content audit');
if ('redirect' in guard) return guard.redirect;
const query = new URLSearchParams(Astro.url.searchParams);
query.set('tab', 'content');
return Astro.redirect(`/dashboard/quality${query.size ? `?${query.toString()}` : ''}`, 302);
