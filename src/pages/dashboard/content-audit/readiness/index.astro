---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import ContentAuditAINav from '../../../../components/dashboard/ContentAuditAINav.astro';
import { requireDashboard } from '../../../../lib/auth';
import { apiFetch } from '../../../../lib/api';
import { getCountryById } from '../../../../lib/countries';

const guard = await requireDashboard(Astro, 'manage content audit');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const token = Astro.cookies.get('token')?.value;
const currentCountry = getCountryById(Astro.locals.countryId);
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const contentType = String(Astro.url.searchParams.get('type') || 'all');
const level = String(Astro.url.searchParams.get('level') || '');
const search = String(Astro.url.searchParams.get('q') || '').trim();
const auth = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };

const readinessResult = await apiFetch<any>('/dashboard/content-audit/adsense-readiness', { ...auth, params: { country: currentCountry.code, type: contentType, level, q: search, page, per_page: 20 } });
const readinessData = readinessResult.data ?? {};
const summary = readinessData.summary ?? {};
const readinessItems: any[] = Array.isArray(readinessData.items) ? readinessData.items : [];
const readinessMeta = readinessData.meta ?? {};
const total = Number(summary.total || 0);

const nf = new Intl.NumberFormat('ar-EG');
const labelType = (type: string) => type === 'article' ? 'مقال' : type === 'post' ? 'منشور' : 'الكل';
const levelLabels: Record<string, string> = { ready: 'جاهز', review: 'يحتاج مراجعة', weak: 'ضعيف' };
const pageHref = (targetPage: number) => { const u = new URL(Astro.url); u.searchParams.set('page', String(targetPage)); return `${u.pathname}?${u.searchParams.toString()}`; };
---

<DashboardLayout title="جاهزية المحتوى" user={user}>
	<div class="audit-page">
		<header class="audit-hero">
			<div class="audit-hero-copy"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8m-8 4h5"/></svg>فحص قابلية النشر والربح</span><h1>تقرير جاهزية المحتوى</h1><p>حلّل الجودة النصية، الوصف، المرفقات، الفهرسة وشروط عرض الإعلانات لكل مقال ومنشور في {currentCountry.name}. هذه الصفحة للعرض فقط — عناصر "لم يخضع المحتوى لتدقيق الجودة بعد" تُحل بتشغيل فحص، ومقترحات الإصلاح التفصيلية بالذكاء الاصطناعي من الصفحة المخصصة لها.</p></div>
			<div class="audit-hero-actions"><a href="/dashboard/content-audit/scan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 9a7 7 0 0 1 12-2l2 2M4 15l2 2a7 7 0 0 0 12-2"/></svg>تشغيل فحص شامل</a><a href="/dashboard/content-audit/ai-operations" class="is-secondary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v18M5 8h14M5 16h14"/></svg>دفعة تحليل ذكية</a></div>
		</header>

		<ContentAuditAINav active="readiness" />

		{!readinessResult.ok ? <section class="audit-empty is-error"><i>!</i><h2>تعذّر تحميل تقرير الجاهزية</h2><p>تحقق من اتصال الخادم ثم أعد المحاولة.</p><a href={Astro.url.pathname}>إعادة المحاولة</a></section> : <section class="readiness-section">
			<header class="section-heading"><div><span>النتائج</span><h2>{nf.format(total)} عنصر مفهرس</h2></div><span class="results-count">{nf.format(readinessMeta.filtered_total ?? readinessItems.length)} نتيجة</span></header>
			<form class="audit-filters" method="get" action="/dashboard/content-audit/readiness"><label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" name="q" value={search} placeholder="ابحث بعنوان المحتوى..."/></label><select name="type"><option value="all">كل المحتوى</option><option value="article" selected={contentType==='article'}>المقالات</option><option value="post" selected={contentType==='post'}>المنشورات</option></select><select name="level"><option value="">كل المستويات</option><option value="weak" selected={level==='weak'}>ضعيف</option><option value="review" selected={level==='review'}>يحتاج مراجعة</option><option value="ready" selected={level==='ready'}>جاهز</option></select><button type="submit">تطبيق</button>{(search || level || contentType!=='all') && <a href="/dashboard/content-audit/readiness">مسح</a>}</form>
			{readinessItems.length ? <div class="readiness-table-wrap"><table><thead><tr><th>المحتوى</th><th>درجة الجودة</th><th>المؤشرات</th><th>أبرز المشكلات</th><th>الفهرسة</th><th>الإعلانات</th><th></th></tr></thead><tbody>{readinessItems.map((item:any)=><tr><td><div class="content-cell"><span>{labelType(item.type)}</span><strong>{item.title}</strong><small>#{nf.format(item.id)} · {item.status === 'published' ? 'منشور' : 'غير منشور'}</small></div></td><td><div class:list={['audit-score',`is-${item.level}`]} style={`--score:${item.score}`}><strong>{nf.format(item.score)}</strong><i><span></span></i><small>{levelLabels[item.level] || item.level}{!item.audited && item.score > 0 && <em class="baseline-tag" title="درجة أولية من الفحص الحتمي — لم تُراجَع بالذكاء الاصطناعي بعد">· فحص حتمي</em>}</small></div></td><td><div class="content-metrics"><span><b>{nf.format(item.word_count || 0)}</b> كلمة</span><span><b>{nf.format(item.files_count || 0)}</b> مرفق</span></div></td><td><div class="issue-list">{(item.issues || []).slice(0,2).map((issue:string)=><span>{issue}</span>)}{!(item.issues||[]).length && <span class="is-clean">لا توجد مشكلات</span>}</div></td><td><span class:list={['boolean-badge',item.should_index&&'is-yes']}><i></i>{item.should_index?'مفهرس':'غير مفهرس'}</span></td><td><span class:list={['boolean-badge',item.should_show_ads&&'is-yes']}><i></i>{item.should_show_ads?'مؤهل':'غير مؤهل'}</span></td><td><a class="open-content" href={item.url} target="_blank" title="فتح المحتوى"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 5h5v5m0-5-8 8M19 13v6H5V5h6"/></svg></a></td></tr>)}</tbody></table></div> : <section class="audit-empty"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8"/></svg></i><h2>لا توجد نتائج مطابقة</h2><p>غيّر الفلاتر أو شغّل تدقيقًا جديدًا.</p></section>}
			{readinessMeta.last_page>1 && <nav class="audit-pagination"><a href={pageHref(Math.max(1,readinessMeta.current_page-1))} class:list={{'is-disabled':readinessMeta.current_page<=1}}>السابق</a><span>صفحة <strong>{nf.format(readinessMeta.current_page)}</strong> من {nf.format(readinessMeta.last_page)}</span><a href={pageHref(Math.min(readinessMeta.last_page,readinessMeta.current_page+1))} class:list={{'is-disabled':readinessMeta.current_page>=readinessMeta.last_page}}>التالي</a></nav>}
		</section>}
	</div>

	<style>
		.audit-page{--au-blue:#1a4d8f;--au-green:#0f8464;--au-orange:#e8a244;--au-red:#c43d49;--au-ink:#18283d;--au-muted:#68788d;--au-line:#dce4ed;direction:rtl}.audit-page *{box-sizing:border-box}
		.audit-hero{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.75rem;border:1px solid var(--au-line);border-radius:1rem;background:#fff;padding:1.15rem 1.25rem;box-shadow:0 3px 12px rgb(23 43 77/.05)}.audit-hero-copy>span{display:flex;align-items:center;gap:.35rem;color:var(--au-blue);font-size:.72rem;font-weight:850}.audit-hero-copy>span svg{width:1rem;height:1rem}.audit-hero h1{margin:.22rem 0 .15rem;color:var(--au-ink);font-size:1.48rem;font-weight:950}.audit-hero p{max-width:47rem;margin:0;color:var(--au-muted);font-size:.8rem;line-height:1.75}.audit-hero-actions{display:flex;flex:none;flex-direction:column;gap:.4rem}.audit-hero-actions>a{display:flex;min-height:2.4rem;align-items:center;gap:.35rem;border:1px solid #17457e;border-radius:.52rem;background:var(--au-blue);padding:.4rem .7rem;color:#fff;font-family:inherit;font-size:.66rem;font-weight:900;white-space:nowrap}.audit-hero-actions>a.is-secondary{border-color:#ccd8e6;background:#fff;color:var(--au-blue)}.audit-hero-actions svg{width:.9rem;height:.9rem;stroke-width:2}
		.readiness-section{border:1px solid var(--au-line);border-radius:.82rem;background:#fff;box-shadow:0 3px 10px rgb(23 43 77/.04);padding:.9rem}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:.7rem;margin-bottom:.7rem}.section-heading span:first-child{color:var(--au-blue);font-size:.62rem;font-weight:850}.section-heading h2{margin:.08rem 0 0;color:var(--au-ink);font-size:.9rem;font-weight:950}.results-count{border:1px solid #dce4ed;border-radius:.42rem;background:#f8fafc;padding:.35rem .5rem;color:#5b6f86;font-size:.62rem;font-weight:850}.audit-filters{display:flex;align-items:center;gap:.4rem;margin-bottom:.7rem;border:1px solid #e0e7ee;border-radius:.6rem;background:#f8fafc;padding:.5rem}.audit-filters label{display:flex;min-width:18rem;flex:1;align-items:center;gap:.35rem;border:1px solid #d9e2ec;border-radius:.42rem;background:#fff;padding:0 .5rem}.audit-filters label svg{width:.85rem;height:.85rem;color:#8794a5}.audit-filters input,.audit-filters select{height:2.2rem;border:0;background:transparent;color:var(--au-ink);font-family:inherit;font-size:.65rem;outline:0}.audit-filters input{width:100%}.audit-filters select{min-width:8.5rem;border:1px solid #d9e2ec;border-radius:.42rem;background:#fff;padding:0 .45rem}.audit-filters>button,.audit-filters>a{display:grid;min-height:2.2rem;place-items:center;border-radius:.42rem;padding:.25rem .65rem;font-family:inherit;font-size:.62rem;font-weight:850}.audit-filters>button{border:1px solid var(--au-blue);background:var(--au-blue);color:#fff}.audit-filters>a{border:1px solid #d9e2ec;background:#fff;color:#63758a}.readiness-table-wrap{overflow-x:auto;border:1px solid #e0e7ee;border-radius:.58rem}.readiness-table-wrap table{width:100%;border-collapse:collapse;white-space:nowrap}.readiness-table-wrap th{background:#f8fafc;padding:.52rem .58rem;color:#718096;font-size:.57rem;text-align:right}.readiness-table-wrap td{border-top:1px solid #edf1f5;padding:.56rem .58rem;color:#53667d;font-size:.6rem}.content-cell{display:grid;max-width:18rem}.content-cell>span{color:var(--au-blue);font-size:.53rem;font-weight:850}.content-cell strong{overflow:hidden;color:var(--au-ink);font-size:.66rem;text-overflow:ellipsis}.content-cell small{color:#8a96a5;font-size:.52rem}.audit-score{display:grid;grid-template-columns:auto 3rem;align-items:center;gap:.1rem .35rem}.audit-score strong{grid-row:1/3;color:var(--au-ink);font-size:.78rem}.audit-score>i{height:.35rem;overflow:hidden;border-radius:99rem;background:#edf1f5}.audit-score>i>span{display:block;width:calc(var(--score)*1%);height:100%;background:var(--au-orange)}.audit-score.is-ready>i>span{background:var(--au-green)}.audit-score.is-weak>i>span{background:var(--au-red)}.audit-score small{font-size:.51rem}.baseline-tag{display:inline-block;margin-inline-start:.2rem;color:#6e42bd;font-style:normal}.content-metrics{display:flex;gap:.3rem}.content-metrics span{border-radius:.3rem;background:#f2f5f8;padding:.25rem .35rem;font-size:.54rem}.content-metrics b{color:var(--au-ink)}.issue-list{display:grid;gap:.15rem;max-width:14rem}.issue-list span{overflow:hidden;color:#8d5d23;font-size:.53rem;text-overflow:ellipsis}.issue-list .is-clean{color:var(--au-green)}.boolean-badge{display:flex;align-items:center;gap:.25rem;color:#8591a0;font-size:.55rem;font-weight:850}.boolean-badge i{width:.4rem;height:.4rem;border-radius:50%;background:#aeb7c1}.boolean-badge.is-yes{color:var(--au-green)}.boolean-badge.is-yes i{background:var(--au-green)}.open-content{display:grid;width:1.8rem;height:1.8rem;place-items:center;border:1px solid #d8e2ec;border-radius:.4rem;color:var(--au-blue)}.open-content svg{width:.75rem;height:.75rem}.audit-pagination{display:flex;align-items:center;justify-content:center;gap:.65rem;margin-top:.7rem}.audit-pagination a{display:grid;min-width:4rem;min-height:2.15rem;place-items:center;border:1px solid #d8e2ec;border-radius:.42rem;background:#fff;color:var(--au-blue);font-size:.6rem;font-weight:850}.audit-pagination a.is-disabled{pointer-events:none;opacity:.4}.audit-pagination span{color:var(--au-muted);font-size:.59rem}.audit-pagination strong{color:var(--au-ink)}
		.audit-empty{display:grid;min-height:18rem;place-items:center;align-content:center;border:1px dashed #d8e1eb;border-radius:.72rem;background:#fafbfd;text-align:center}.audit-empty>i{display:grid;width:3rem;height:3rem;place-items:center;border-radius:50%;background:#eaf1fa;color:var(--au-blue);font-style:normal;font-weight:950}.audit-empty svg{width:1.3rem;height:1.3rem}.audit-empty h2{margin:.55rem 0 .12rem;color:var(--au-ink);font-size:.86rem}.audit-empty p{margin:0;color:var(--au-muted);font-size:.65rem}.audit-empty a{margin-top:.5rem;color:var(--au-blue);font-size:.6rem;font-weight:850}.audit-empty.is-error>i{background:#ffeaec;color:var(--au-red)}
		.dark .audit-page{--au-ink:#f4f7fb;--au-muted:#9eacc0;--au-line:#30445d}.dark .audit-hero,.dark .readiness-section,.dark .audit-filters input,.dark .audit-filters select{border-color:#30445d;background:#0f2547;color:#cbd5e1}.dark .audit-filters{background:#122b4b}.dark .readiness-table-wrap th{background:#122b4b}.dark .readiness-table-wrap td{border-color:#29405c}
		@media(max-width:780px){.audit-hero{align-items:stretch;flex-direction:column}.audit-hero-actions{flex-direction:row}.audit-hero-actions>a{flex:1;justify-content:center}.audit-filters{align-items:stretch;flex-wrap:wrap}.audit-filters label{min-width:100%}.audit-filters select{flex:1}.section-heading{align-items:flex-start;flex-direction:column}}
	</style>
</DashboardLayout>
