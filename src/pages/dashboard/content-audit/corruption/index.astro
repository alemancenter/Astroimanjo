---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { isAdmin, requireDashboard } from '../../../../lib/auth';
import { apiFetch } from '../../../../lib/api';
import { getCountryById } from '../../../../lib/countries';

const guard = await requireDashboard(Astro);
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
if (!isAdmin(user)) {
	return Astro.redirect(`/dashboard?error=${encodeURIComponent('هذه الصفحة متاحة فقط للسوبر أدمن والأدمن.')}`);
}

const token = Astro.cookies.get('token')?.value;
const currentCountry = getCountryById(Astro.locals.countryId);
const requestedType = String(Astro.url.searchParams.get('type') || 'all').toLowerCase();
const contentType = ['all', 'article', 'post'].includes(requestedType) ? requestedType : 'all';
const search = String(Astro.url.searchParams.get('q') || '').trim();
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const auth = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };
const result = await apiFetch<any>('/dashboard/content-audit/corruption', {
	...auth,
	params: { country: currentCountry.code, type: contentType, q: search, page, per_page: 25 },
});

const data = result.data ?? {};
const items: any[] = Array.isArray(data.items) ? data.items : [];
const summary = data.summary ?? {};
const meta = data.meta ?? {};
const totalPages = Math.max(0, Number(meta.total_pages || 0));
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
const cleanUrl = new URL(Astro.url);
cleanUrl.searchParams.delete('success');
cleanUrl.searchParams.delete('error');
const redirectTo = `${cleanUrl.pathname}${cleanUrl.search}`;

const nf = new Intl.NumberFormat('ar-EG');
const df = new Intl.DateTimeFormat('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
const typeLabel = (type: string) => type === 'article' ? 'مقال' : 'منشور';
const fieldLabel: Record<string, string> = {
	title: 'العنوان',
	content: 'المحتوى',
	meta_description: 'الوصف التعريفي',
	keywords: 'الكلمات المفتاحية',
};
const pageHref = (target: number) => {
	const u = new URL(Astro.url);
	u.searchParams.set('page', String(target));
	u.searchParams.delete('success');
	u.searchParams.delete('error');
	return `${u.pathname}?${u.searchParams.toString()}`;
};
---

<DashboardLayout title="مراقبة فساد المحتوى" user={user} description="كشف رموز الاستبدال غير المحلولة في المقالات والمنشورات وإدارتها من لوحة التحكم.">
	<div class="mx-auto max-w-[1500px] space-y-6">
		{error && (
			<div class="flex items-start justify-between gap-4 rounded-2xl border border-red-200 bg-red-50 p-4 text-red-800 dark:border-red-900/60 dark:bg-red-950/40 dark:text-red-200" role="alert">
				<div><strong class="block text-sm font-extrabold">تعذّر تنفيذ العملية</strong><span class="mt-1 block text-sm">{error}</span></div>
				<a href={redirectTo} class="font-black" aria-label="إغلاق">×</a>
			</div>
		)}
		{success === 'ai_started' && (
			<div class="flex items-start justify-between gap-4 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-200" role="status">
				<div><strong class="block text-sm font-extrabold">تم تشغيل تدقيق AI</strong><span class="mt-1 block text-sm">تم إنشاء قرار تدقيق جديد للعنصر. يبقى الحظر الحتمي فعالًا ما دامت رموز الاستبدال موجودة في المصدر.</span></div>
				<a href={redirectTo} class="font-black" aria-label="إغلاق">×</a>
			</div>
		)}

		<header class="overflow-hidden rounded-3xl border border-graphite-200 bg-white shadow-sm dark:border-graphite-800 dark:bg-graphite-900">
			<div class="grid gap-6 p-6 lg:grid-cols-[1fr_auto] lg:items-center lg:p-8">
				<div>
					<div class="mb-3 flex flex-wrap items-center gap-2">
						<span class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1.5 text-xs font-extrabold text-red-700 dark:bg-red-950/50 dark:text-red-300">
							<span class="size-2 rounded-full bg-red-500"></span> حارس حتمي قبل SEO وAdSense
						</span>
						<span class="rounded-full bg-graphite-100 px-3 py-1.5 text-xs font-extrabold text-graphite-600 dark:bg-graphite-800 dark:text-graphite-300">Admin + Super Admin فقط</span>
					</div>
					<h1 class="text-2xl font-black text-graphite-950 sm:text-3xl dark:text-white">مراقبة فساد رموز الاستبدال</h1>
					<p class="mt-3 max-w-3xl text-sm leading-7 text-graphite-600 dark:text-graphite-300">يفحص النظام المصدر الحالي للمقالات والمنشورات بحثًا عن الرموز غير المحلولة مثل <code dir="ltr" class="rounded bg-graphite-100 px-1.5 py-0.5 font-mono text-red-700 dark:bg-graphite-800 dark:text-red-300">$1</code> و <code dir="ltr" class="rounded bg-graphite-100 px-1.5 py-0.5 font-mono text-red-700 dark:bg-graphite-800 dark:text-red-300">${1}</code>. أي صفحة مصابة تُمنع تلقائيًا من الإعلانات والأرشفة وSitemap إلى أن يتم إصلاح النص الفعلي.</p>
				</div>
				<div class="flex flex-wrap gap-2 lg:justify-end">
					<a href="/dashboard/content-audit" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-graphite-200 bg-white px-4 text-sm font-extrabold text-graphite-700 transition hover:border-royal-300 hover:text-royal-700 dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-200">مركز تدقيق المحتوى</a>
					<a href={redirectTo} class="inline-flex min-h-11 items-center justify-center rounded-xl bg-royal-600 px-4 text-sm font-extrabold text-white transition hover:bg-royal-700">إعادة الفحص الآن</a>
				</div>
			</div>
		</header>

		<section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5" aria-label="ملخص الفساد المكتشف">
			<article class="rounded-2xl border border-graphite-200 bg-white p-5 dark:border-graphite-800 dark:bg-graphite-900"><span class="text-xs font-bold text-graphite-500">العناصر المصابة</span><strong class="mt-2 block text-3xl font-black text-red-600 dark:text-red-400">{nf.format(Number(summary.total || 0))}</strong><small class="mt-1 block text-xs text-graphite-400">مقال أو منشور</small></article>
			<article class="rounded-2xl border border-graphite-200 bg-white p-5 dark:border-graphite-800 dark:bg-graphite-900"><span class="text-xs font-bold text-graphite-500">المقالات</span><strong class="mt-2 block text-3xl font-black text-graphite-900 dark:text-white">{nf.format(Number(summary.articles || 0))}</strong><small class="mt-1 block text-xs text-graphite-400">نتائج المقالات</small></article>
			<article class="rounded-2xl border border-graphite-200 bg-white p-5 dark:border-graphite-800 dark:bg-graphite-900"><span class="text-xs font-bold text-graphite-500">المنشورات</span><strong class="mt-2 block text-3xl font-black text-graphite-900 dark:text-white">{nf.format(Number(summary.posts || 0))}</strong><small class="mt-1 block text-xs text-graphite-400">نتائج المنشورات</small></article>
			<article class="rounded-2xl border border-graphite-200 bg-white p-5 dark:border-graphite-800 dark:bg-graphite-900"><span class="text-xs font-bold text-graphite-500">منشور للعامة</span><strong class="mt-2 block text-3xl font-black text-orange-600 dark:text-orange-400">{nf.format(Number(summary.published || 0))}</strong><small class="mt-1 block text-xs text-graphite-400">الأولوية الأولى للإصلاح</small></article>
			<article class="rounded-2xl border border-graphite-200 bg-white p-5 dark:border-graphite-800 dark:bg-graphite-900"><span class="text-xs font-bold text-graphite-500">إجمالي الرموز</span><strong class="mt-2 block text-3xl font-black text-violet-600 dark:text-violet-400">{nf.format(Number(summary.matches || 0))}</strong><small class="mt-1 block text-xs text-graphite-400">مواضع تحتاج مراجعة</small></article>
		</section>

		<section class="rounded-2xl border border-graphite-200 bg-white p-4 shadow-sm dark:border-graphite-800 dark:bg-graphite-900">
			<form method="get" class="grid gap-3 lg:grid-cols-[220px_1fr_auto_auto] lg:items-end">
				<label class="block"><span class="mb-1.5 block text-xs font-extrabold text-graphite-600 dark:text-graphite-300">نوع المحتوى</span><select name="type" class="h-11 w-full rounded-xl border border-graphite-200 bg-white px-3 text-sm font-bold text-graphite-800 outline-none focus:border-royal-500 dark:border-graphite-700 dark:bg-graphite-950 dark:text-white"><option value="all" selected={contentType === 'all'}>الكل</option><option value="article" selected={contentType === 'article'}>المقالات</option><option value="post" selected={contentType === 'post'}>المنشورات</option></select></label>
				<label class="block"><span class="mb-1.5 block text-xs font-extrabold text-graphite-600 dark:text-graphite-300">بحث بالعنوان أو الرقم</span><input name="q" value={search} placeholder="مثال: 169 أو عنوان المقال" class="h-11 w-full rounded-xl border border-graphite-200 bg-white px-3 text-sm text-graphite-800 outline-none placeholder:text-graphite-400 focus:border-royal-500 dark:border-graphite-700 dark:bg-graphite-950 dark:text-white" /></label>
				<button type="submit" class="h-11 rounded-xl bg-graphite-900 px-5 text-sm font-extrabold text-white transition hover:bg-black dark:bg-white dark:text-graphite-950">تطبيق الفلاتر</button>
				<a href="/dashboard/content-audit/corruption" class="inline-flex h-11 items-center justify-center rounded-xl border border-graphite-200 px-4 text-sm font-extrabold text-graphite-600 transition hover:bg-graphite-50 dark:border-graphite-700 dark:text-graphite-300 dark:hover:bg-graphite-800">مسح الفلاتر</a>
			</form>
		</section>

		{!result.ok ? (
			<section class="rounded-3xl border border-red-200 bg-red-50 p-10 text-center dark:border-red-900/60 dark:bg-red-950/30"><div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-red-100 text-xl font-black text-red-700 dark:bg-red-900/50 dark:text-red-300">!</div><h2 class="mt-4 text-lg font-black text-red-900 dark:text-red-100">تعذّر تحميل فحص الفساد</h2><p class="mt-2 text-sm text-red-700 dark:text-red-300">{result.message || 'تحقق من اتصال Backend ثم أعد المحاولة.'}</p></section>
		) : items.length === 0 ? (
			<section class="rounded-3xl border border-emerald-200 bg-emerald-50 p-10 text-center dark:border-emerald-900/60 dark:bg-emerald-950/30"><div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-emerald-100 text-xl font-black text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-300">✓</div><h2 class="mt-4 text-lg font-black text-emerald-900 dark:text-emerald-100">لا توجد نتائج مصابة ضمن هذا الفلتر</h2><p class="mt-2 text-sm text-emerald-700 dark:text-emerald-300">الفحص الحالي لم يجد رموز استبدال غير محلولة في العناصر المعروضة.</p></section>
		) : (
			<section class="overflow-hidden rounded-3xl border border-graphite-200 bg-white shadow-sm dark:border-graphite-800 dark:bg-graphite-900">
				<header class="flex flex-wrap items-center justify-between gap-3 border-b border-graphite-100 p-5 dark:border-graphite-800"><div><span class="text-xs font-bold text-red-600 dark:text-red-400">قائمة المعالجة</span><h2 class="mt-1 text-lg font-black text-graphite-950 dark:text-white">المحتوى الذي يحتاج إصلاحًا</h2></div><span class="rounded-full bg-graphite-100 px-3 py-1.5 text-xs font-extrabold text-graphite-600 dark:bg-graphite-800 dark:text-graphite-300">{nf.format(Number(meta.total || items.length))} نتيجة</span></header>
				<div class="divide-y divide-graphite-100 dark:divide-graphite-800">
					{items.map((item: any) => (
						<article class="p-5 lg:p-6">
							<div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_340px]">
								<div class="min-w-0">
									<div class="flex flex-wrap items-center gap-2 text-xs font-bold"><span class:list={['rounded-full px-2.5 py-1', item.type === 'article' ? 'bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300' : 'bg-violet-50 text-violet-700 dark:bg-violet-950/50 dark:text-violet-300']}>{typeLabel(item.type)} #{item.id}</span><span class:list={['rounded-full px-2.5 py-1', item.published ? 'bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-300' : 'bg-graphite-100 text-graphite-600 dark:bg-graphite-800 dark:text-graphite-300']}>{item.published ? 'منشور — محجوب من الأرشفة' : 'مسودة'}</span><span class="rounded-full bg-orange-50 px-2.5 py-1 text-orange-700 dark:bg-orange-950/50 dark:text-orange-300">{nf.format(Number(item.match_count || 0))} رمز</span></div>
									<h3 class="mt-3 text-base font-black leading-7 text-graphite-950 dark:text-white">{item.title || 'بدون عنوان'}</h3>
									<p class="mt-1 text-xs text-graphite-400">آخر تعديل: {item.updated_at ? df.format(new Date(item.updated_at)) : '—'}</p>
									<div class="mt-4 space-y-2">
										{(Array.isArray(item.matches) ? item.matches : []).map((match: any) => (
											<div class="rounded-xl border border-red-100 bg-red-50/60 p-3 dark:border-red-900/50 dark:bg-red-950/20">
												<div class="flex flex-wrap items-center gap-2"><code dir="ltr" class="rounded-lg bg-red-600 px-2 py-1 font-mono text-xs font-black text-white">{match.token}</code><span class="text-xs font-extrabold text-red-800 dark:text-red-200">{fieldLabel[match.field] || match.field}</span><span class="text-[11px] text-red-500">موضع {nf.format(Number(match.offset || 0))}</span></div>
												<p class="mt-2 break-words text-sm leading-6 text-graphite-700 dark:text-graphite-300" dir="rtl">{match.snippet}</p>
											</div>
										))}
									</div>
								</div>
								<aside class="rounded-2xl border border-graphite-100 bg-graphite-50 p-4 dark:border-graphite-800 dark:bg-graphite-950/50">
									<h4 class="text-xs font-black text-graphite-700 dark:text-graphite-200">إجراءات المعالجة</h4>
									<p class="mt-2 text-xs leading-6 text-graphite-500">لا يقوم النظام باستبدال الرمز تلقائيًا لأن النص الأصلي المفقود غير معروف. راجع المحتوى في المحرر، ثم أعد الفحص.</p>
									<div class="mt-4 grid gap-2 sm:grid-cols-2 xl:grid-cols-1">
										<a href={item.edit_url} class="inline-flex min-h-10 items-center justify-center rounded-xl bg-royal-600 px-3 text-xs font-extrabold text-white hover:bg-royal-700">فتح المحرر وإصلاح النص</a>
										<a href={item.public_url} target="_blank" rel="noopener" class="inline-flex min-h-10 items-center justify-center rounded-xl border border-graphite-200 bg-white px-3 text-xs font-extrabold text-graphite-700 hover:border-royal-300 hover:text-royal-700 dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-200">عرض الصفحة العامة</a>
										<form method="post" action="/api/dashboard/content-audit/corruption/analyze">
											<input type="hidden" name="type" value={item.type} />
											<input type="hidden" name="id" value={item.id} />
											<input type="hidden" name="country" value={currentCountry.code} />
											<input type="hidden" name="redirect_to" value={redirectTo} />
											<button type="submit" class="inline-flex min-h-10 w-full items-center justify-center rounded-xl border border-violet-200 bg-violet-50 px-3 text-xs font-extrabold text-violet-700 hover:bg-violet-100 dark:border-violet-900/60 dark:bg-violet-950/30 dark:text-violet-300">تشغيل تدقيق AI للعنصر</button>
										</form>
									</div>
								</aside>
							</div>
						</article>
					))}
				</div>
			</section>
		)}

		{totalPages > 1 && (
			<nav class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-graphite-200 bg-white p-4 dark:border-graphite-800 dark:bg-graphite-900" aria-label="صفحات نتائج الفساد">
				<span class="text-xs font-bold text-graphite-500">الصفحة {nf.format(page)} من {nf.format(totalPages)}</span>
				<div class="flex gap-2"><a href={pageHref(Math.max(1, page - 1))} aria-disabled={page <= 1} class:list={['inline-flex h-10 items-center rounded-xl border px-4 text-xs font-extrabold', page <= 1 ? 'pointer-events-none border-graphite-100 text-graphite-300 dark:border-graphite-800 dark:text-graphite-700' : 'border-graphite-200 text-graphite-700 hover:border-royal-300 dark:border-graphite-700 dark:text-graphite-200']}>السابق</a><a href={pageHref(Math.min(totalPages, page + 1))} aria-disabled={page >= totalPages} class:list={['inline-flex h-10 items-center rounded-xl border px-4 text-xs font-extrabold', page >= totalPages ? 'pointer-events-none border-graphite-100 text-graphite-300 dark:border-graphite-800 dark:text-graphite-700' : 'border-graphite-200 text-graphite-700 hover:border-royal-300 dark:border-graphite-700 dark:text-graphite-200']}>التالي</a></div>
			</nav>
		)}

		<section class="rounded-2xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-900/60 dark:bg-amber-950/20">
			<h2 class="text-sm font-black text-amber-900 dark:text-amber-100">سياسة الأمان في 2G</h2>
			<p class="mt-2 text-sm leading-7 text-amber-800 dark:text-amber-200">الكاشف لا يحاول تخمين النص المفقود ولا ينفذ Replace آليًا. عند اكتشاف رمز مؤكد، يتولى Content Quality Gate إيقاف الإعلانات والأرشفة، ويستبعد مولّد Sitemap الصفحة المنشورة. بعد إصلاح النص من المحرر وإعادة تحميل هذه الصفحة، تختفي النتيجة فورًا ويعود قرار الجودة الطبيعي للتحكم.</p>
		</section>
	</div>
</DashboardLayout>
