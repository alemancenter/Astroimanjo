---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DashboardAlert from '../../../components/ui/DashboardAlert.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { requireDashboard, hasPermission } from '../../../lib/auth';
import { apiFetch, apiFetchList } from '../../../lib/api';
import { getCountryById } from '../../../lib/countries';

const guard = await requireDashboard(Astro);
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const canManage = hasPermission(user, 'manage notifications');
const countryCode = getCountryById(Astro.locals.countryId).code;

const token = Astro.cookies.get('token')?.value;
const authOptions = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };
const params = Astro.url.searchParams;
const allowedStatuses = new Set(['all', 'unread', 'read']);
const requestedStatus = params.get('status') || 'all';
const status = allowedStatuses.has(requestedStatus) ? requestedStatus : 'all';
const search = (params.get('q') || '').trim();
const page = Math.max(1, Number(params.get('page')) || 1);

const [notificationsResult, statsResult] = await Promise.all([
	apiFetch<any[]>('/dashboard/notifications', { ...authOptions, params: { q: search || undefined, status: status === 'all' ? undefined : status, page, per_page: 20 } }),
	apiFetch<Record<string, number>>('/dashboard/notifications/stats', authOptions),
]);
const rolesResult = canManage ? await apiFetchList<any>('/dashboard/roles', { ...authOptions, params: { per_page: 200 } }) : null;

const parseData = (data: any) => {
	if (data && typeof data === 'object') return data;
	if (typeof data === 'string') { try { return JSON.parse(data); } catch { return {}; } }
	return {};
};
const items = (Array.isArray(notificationsResult.data) ? notificationsResult.data : []).map((item: any) => ({ ...item, data: parseData(item.data) }));
const meta = notificationsResult.meta;
const fallbackUnread = items.filter((item: any) => !item.read_at).length;
const stats = statsResult.data ?? { total: meta?.total ?? items.length, unread: fallbackUnread, read: items.length - fallbackUnread, today: 0 };
const roles = rolesResult?.items ?? [];
const resultTotal = meta?.total ?? items.length;
const redirectTo = `${Astro.url.pathname}${Astro.url.search}`;
const numberFormat = new Intl.NumberFormat('ar-EG');
const dateTimeFormat = new Intl.DateTimeFormat('ar-EG', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
const formatDateTime = (value: string) => { const date = new Date(value); return Number.isNaN(date.getTime()) ? '—' : dateTimeFormat.format(date); };
const excerpt = (value: string, max = 165) => { const clean = String(value || '').replace(/\s+/g, ' ').trim(); return clean.length > max ? `${clean.slice(0, max).trim()}…` : clean; };
const safeActionUrl = (value: unknown) => {
	const url = String(value || '').trim();
	if (!url) return null;
	if (url.startsWith('/') && !url.startsWith('//')) return url;
	try { const parsed = new URL(url); return ['http:', 'https:'].includes(parsed.protocol) ? parsed.toString() : null; }
	catch { return null; }
};
const publicActionUrl = (value: unknown) => {
	const storedUrl = String(value || '').trim();
	let legacyPath = storedUrl;
	let legacyCountryCode = countryCode;
	try {
		const parsed = new URL(storedUrl, Astro.url.origin);
		if (storedUrl.startsWith('/') || parsed.origin === Astro.url.origin) {
			legacyPath = parsed.pathname;
			const storedCountry = parsed.searchParams.get('country');
			if (storedCountry) legacyCountryCode = getCountryById(storedCountry).code;
		}
	} catch {}
	const articleMatch = legacyPath.match(/^\/dashboard\/articles\/(?:edit\/)?(\d+)(?:\/edit)?\/?$/i);
	if (articleMatch) return `/${legacyCountryCode}/lesson/articles/${articleMatch[1]}`;
	const postMatch = legacyPath.match(/^\/dashboard\/posts\/(?:edit\/)?(\d+)(?:\/edit)?\/?$/i);
	if (postMatch) return `/${legacyCountryCode}/posts/${postMatch[1]}`;
	if (/^\/dashboard\/articles\/?$/i.test(legacyPath)) return `/${legacyCountryCode}/articles`;
	if (/^\/dashboard\/posts\/?$/i.test(legacyPath)) return `/${legacyCountryCode}/posts`;
	return safeActionUrl(storedUrl);
};
const notificationMeta = (typeValue: string) => {
	const type = String(typeValue || '').toLowerCase();
	if (type.includes('contact')) return { kind: 'contact', label: 'رسالة تواصل' };
	if (type.includes('newmessage') || type.includes('message')) return { kind: 'message', label: 'رسالة داخلية' };
	if (type.includes('article')) return { kind: 'article', label: 'المقالات' };
	if (type.includes('post')) return { kind: 'post', label: 'المنشورات' };
	if (type.includes('subscription') || type.includes('teacher')) return { kind: 'subscription', label: 'الاشتراكات' };
	if (type.includes('broadcast')) return { kind: 'broadcast', label: 'إشعار إداري' };
	if (type.includes('role') || type.includes('security')) return { kind: 'system', label: 'النظام والأمان' };
	return { kind: 'general', label: 'إشعار عام' };
};
const filterUrl = (nextStatus: string) => {
	const url = new URL(Astro.url);
	url.searchParams.set('status', nextStatus);
	url.searchParams.delete('page');
	return `${url.pathname}${url.search}`;
};
const statusTabs = [
	{ value: 'all', label: 'جميع الإشعارات', count: Number(stats.total ?? 0) },
	{ value: 'unread', label: 'غير المقروءة', count: Number(stats.unread ?? 0) },
	{ value: 'read', label: 'المقروءة', count: Number(stats.read ?? 0) },
];
---

<DashboardLayout title="الإشعارات" user={user}>
	<div class="notifications-page">
		<DashboardAlert />

		<header class="notifications-header">
			<div><span class="notifications-eyebrow">التنبيهات والمتابعة</span><h1>مركز الإشعارات</h1><p>تابع آخر أنشطة المنصة ونظّم الإشعارات التي تحتاج إلى مراجعتك.</p></div>
			<div class="notifications-header-actions">
				{Number(stats.unread ?? 0) > 0 && <form method="post" action="/api/dashboard/notifications/mark-all-read"><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" class="notifications-read-all"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 12 4 4L17 6m-7 6 4 4 7-7"/></svg>تعليم الكل كمقروء</button></form>}
				{canManage && <button type="button" class="notifications-compose-button" data-open-compose><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>إشعار جديد</button>}
			</div>
		</header>

		<section class="notifications-summary" aria-label="ملخص الإشعارات">
			<div class="notification-summary-card is-blue"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></span><div><small>إجمالي الإشعارات</small><strong>{numberFormat.format(Number(stats.total ?? 0))}</strong><p>إشعار في حسابك</p></div></div>
			<div class="notification-summary-card is-orange"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><circle cx="19" cy="5" r="3" fill="currentColor" stroke="none"/></svg></span><div><small>بانتظار القراءة</small><strong>{numberFormat.format(Number(stats.unread ?? 0))}</strong><p>تحتاج إلى المراجعة</p></div></div>
			<div class="notification-summary-card is-green"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 12 4 4L18 6m-7 6 4 4 6-7"/></svg></span><div><small>تمت قراءتها</small><strong>{numberFormat.format(Number(stats.read ?? 0))}</strong><p>إشعار تمت متابعته</p></div></div>
			<div class="notification-summary-card is-graphite"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 3v3m14-3v3M4 8h16v12H4zM8 12h3m2 0h3m-8 4h3"/></svg></span><div><small>إشعارات اليوم</small><strong>{numberFormat.format(Number(stats.today ?? 0))}</strong><p>وصلت منذ بداية اليوم</p></div></div>
		</section>

		<section class="notifications-filter-card">
			<form method="get" action="/dashboard/notifications" class="notifications-filter-form"><input type="hidden" name="status" value={status}/><label class="notifications-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" name="q" value={search} placeholder="ابحث في عنوان الإشعار أو نصه أو نوعه..." aria-label="البحث في الإشعارات"/></label><button type="submit">بحث</button>{search && <a href={`/dashboard/notifications?status=${status}`}>مسح البحث</a>}</form>
			<div class="notifications-result-count"><strong>{numberFormat.format(resultTotal)}</strong><span>نتيجة</span></div>
		</section>

		<nav class="notifications-status-tabs" aria-label="تصفية الإشعارات حسب القراءة">{statusTabs.map((tab) => <a href={filterUrl(tab.value)} class:list={{ 'is-active': status === tab.value }} aria-current={status === tab.value ? 'page' : undefined}><span>{tab.label}</span><strong>{numberFormat.format(tab.count)}</strong></a>)}</nav>

		{!notificationsResult.ok ? (
			<section class="notifications-state is-error"><span>!</span><h2>تعذّر تحميل الإشعارات</h2><p>{notificationsResult.message || 'تحقق من اتصال الخادم ثم أعد المحاولة.'}</p><a href={redirectTo}>إعادة المحاولة</a></section>
		) : items.length === 0 ? (
			<section class="notifications-state"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></span><h2>{search ? 'لا توجد إشعارات مطابقة' : status === 'unread' ? 'لا توجد إشعارات غير مقروءة' : 'لا توجد إشعارات'}</h2><p>{search ? 'جرّب عبارة بحث أقصر أو امسح عوامل التصفية.' : 'ستظهر تنبيهات النظام والأنشطة الجديدة هنا.'}</p>{(search || status !== 'all') && <a href="/dashboard/notifications">عرض جميع الإشعارات</a>}</section>
		) : (
			<section class="notifications-list-card">
				<div class="notifications-list-heading"><div><h2>سجل الإشعارات</h2><p>الإشعارات غير المقروءة مميزة ويمكن متابعتها مباشرة.</p></div><div class="notifications-heading-tools">{canManage && <label class="notifications-select-page"><input type="checkbox" id="notifications-select-all"/><span>تحديد الصفحة</span></label>}<span>صفحة {numberFormat.format(meta?.current_page ?? page)} من {numberFormat.format(meta?.last_page ?? 1)}</span></div></div>
				{canManage && <form id="notifications-bulk-form" method="post" action="/api/dashboard/notifications/bulk" class="notifications-bulk-bar" data-notifications-bulk hidden><input type="hidden" name="redirect_to" value={redirectTo}/><input type="hidden" name="action" value="delete"/><div><strong id="notifications-selected-count">0</strong><span>إشعار محدد</span></div><button type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg>حذف المحدد</button></form>}
				<div class="notifications-list">{items.map((notification: any) => {
					const itemMeta = notificationMeta(notification.type);
					const actionUrl = publicActionUrl(notification.data?.action_url);
					return <article class:list={['notification-row', `is-${itemMeta.kind}`, { 'is-unread': !notification.read_at, 'has-selection': canManage }]}>
						{canManage && <label class="notification-row-select" title="تحديد الإشعار"><input type="checkbox" name="ids" value={notification.id} form="notifications-bulk-form" class="notification-select-checkbox" aria-label={`تحديد ${notification.data?.title || 'الإشعار'}`}/><span></span></label>}
						<div class="notification-row-icon">
							{itemMeta.kind === 'contact' || itemMeta.kind === 'message' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v14H4zM4 7l8 6 8-6"/></svg> : itemMeta.kind === 'article' || itemMeta.kind === 'post' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l3 3v15H6zM9 10h6m-6 4h6m-6 4h4"/></svg> : itemMeta.kind === 'subscription' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18v12H3zM7 10h5m-5 4h3m7-5v6"/></svg> : itemMeta.kind === 'broadcast' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 13 12-5v10L4 13Zm0 0v5m12-7a5 5 0 0 1 0 4"/></svg> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>}
						</div>
						<div class="notification-row-content"><div class="notification-row-title"><h3>{notification.data?.title || 'إشعار دون عنوان'}</h3>{!notification.read_at && <span><i></i>جديد</span>}</div><p>{excerpt(notification.data?.message) || 'لا يوجد نص مرفق بهذا الإشعار.'}</p><div class="notification-row-meta"><span class={`notification-type is-${itemMeta.kind}`}>{itemMeta.label}</span><time datetime={notification.created_at}>{formatDateTime(notification.created_at)}</time></div></div>
						<div class="notification-row-actions">
							{actionUrl && <a href={actionUrl} target={actionUrl.startsWith('http') ? '_blank' : undefined} rel={actionUrl.startsWith('http') ? 'noopener' : undefined} class="notification-open-action"><span>فتح</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m9 18 6-6-6-6"/></svg></a>}
							{!notification.read_at && <form method="post" action={`/api/dashboard/notifications/${notification.id}/read`}><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" class="notification-read-action" title="تعليم كمقروء"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 12 4 4L17 6m-7 6 4 4 7-7"/></svg></button></form>}
							{canManage && <form method="post" action={`/api/dashboard/notifications/${notification.id}/delete`} data-confirm-delete><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" class="notification-delete-action" title="حذف الإشعار"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg></button></form>}
						</div>
					</article>;
				})}</div>
			</section>
		)}

		{meta && meta.last_page > 1 && <Pagination currentPage={meta.current_page} lastPage={meta.last_page} url={Astro.url}/>} 
	</div>

	{canManage && <dialog id="delete-notification-dialog" class="notification-delete-dialog" aria-labelledby="notification-delete-title" aria-describedby="notification-delete-description">
		<div class="notification-delete-card">
			<button type="button" class="notification-delete-close" data-close-delete aria-label="إغلاق نافذة تأكيد الحذف"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
			<div class="notification-delete-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg></div>
			<span class="notification-delete-eyebrow">تأكيد الحذف</span>
			<h2 id="notification-delete-title" data-delete-title>حذف الإشعار المحدد؟</h2>
			<p id="notification-delete-description" data-delete-description>سيتم حذف هذا الإشعار نهائيًا من سجل الإشعارات.</p>
			<div class="notification-delete-warning"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4m0 4h.01M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/></svg><span><strong>تنبيه مهم</strong> لا يمكن التراجع عن هذه العملية بعد تنفيذها.</span></div>
			<footer><button type="button" data-close-delete>إلغاء</button><button type="button" data-confirm-delete-action><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg><span>حذف نهائي</span></button></footer>
		</div>
	</dialog>}

	{canManage && <dialog id="compose-notification-dialog" class="notification-compose-dialog">
		<div class="notification-compose-card">
			<header><div><span>إدارة الإشعارات</span><h2>إرسال إشعار جديد</h2><p>اختر الجمهور واكتب رسالة واضحة ومباشرة.</p></div><button type="button" data-close-compose aria-label="إغلاق"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
			<form method="post" action="/api/dashboard/notifications/broadcast" data-broadcast-form><input type="hidden" name="redirect_to" value={redirectTo}/>
				<div class="notification-compose-grid">
					<div class="notification-compose-fields">
						<label><span>الجمهور المستهدف</span><select name="audience" data-audience><option value="all">جميع المستخدمين</option><option value="role">دور محدد</option></select></label>
						<label data-role-field hidden><span>الدور</span><select name="role"><option value="">اختر الدور</option>{roles.map((role: any) => <option value={role.name}>{role.name}</option>)}</select>{rolesResult && !rolesResult.ok && <small>تعذّر تحميل الأدوار؛ يمكنك الإرسال لجميع المستخدمين.</small>}</label>
						<label><span>عنوان الإشعار</span><input type="text" name="title" required maxlength="120" placeholder="مثال: تحديث مهم في المنصة" data-compose-title/></label>
						<label><span>نص الإشعار</span><textarea name="message" rows="5" required maxlength="500" placeholder="اكتب نصًا مختصرًا يوضح المطلوب من المستخدم..." data-compose-message></textarea><small><b data-message-count>0</b> / 500 حرف</small></label>
						<label><span>رابط الإجراء <em>اختياري</em></span><input type="text" name="action_url" dir="ltr" placeholder="/articles/123 أو https://..."/></label>
					</div>
					<aside class="notification-compose-preview"><span>معاينة الإشعار</span><div><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></i><section><strong data-preview-title>عنوان الإشعار</strong><p data-preview-message>سيظهر نص الإشعار هنا كما سيراه المستخدم.</p><small>الآن</small></section></div></aside>
				</div>
				<footer><button type="button" data-close-compose>إلغاء</button><button type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m22 2-7 20-4-9-9-4Z"/><path d="m22 2-11 11"/></svg>إرسال الإشعار</button></footer>
			</form>
		</div>
	</dialog>}

	<script>
		const deleteDialog = document.getElementById('delete-notification-dialog') as HTMLDialogElement | null;
		const deleteDialogTitle = deleteDialog?.querySelector<HTMLElement>('[data-delete-title]');
		const deleteDialogDescription = deleteDialog?.querySelector<HTMLElement>('[data-delete-description]');
		const deleteConfirmButton = deleteDialog?.querySelector<HTMLButtonElement>('[data-confirm-delete-action]');
		const deleteConfirmLabel = deleteConfirmButton?.querySelector<HTMLElement>('span');
		let pendingDeleteForm: HTMLFormElement | null = null;
		const arabicNumber = new Intl.NumberFormat('ar');
		const openDeleteConfirmation = (form: HTMLFormElement, count = 1) => {
			if (!deleteDialog) return;
			pendingDeleteForm = form;
			const isBulk = count > 1;
			if (deleteDialogTitle) deleteDialogTitle.textContent = isBulk ? `حذف ${arabicNumber.format(count)} إشعارًا محددًا؟` : 'حذف هذا الإشعار؟';
			if (deleteDialogDescription) deleteDialogDescription.textContent = isBulk ? `سيتم حذف ${arabicNumber.format(count)} إشعارًا نهائيًا من سجل الإشعارات.` : 'سيتم حذف هذا الإشعار نهائيًا من سجل الإشعارات.';
			if (deleteConfirmButton) deleteConfirmButton.disabled = false;
			if (deleteConfirmLabel) deleteConfirmLabel.textContent = isBulk ? `حذف ${arabicNumber.format(count)} إشعارًا` : 'حذف نهائي';
			deleteDialog.showModal();
		};
		document.querySelectorAll<HTMLFormElement>('[data-confirm-delete]').forEach((form) => form.addEventListener('submit', (event) => {
			if (form.dataset.deleteConfirmed === 'true') return;
			event.preventDefault();
			openDeleteConfirmation(form);
		}));
		deleteDialog?.querySelectorAll<HTMLElement>('[data-close-delete]').forEach((button) => button.addEventListener('click', () => deleteDialog.close()));
		deleteDialog?.addEventListener('click', (event) => { if (event.target === deleteDialog) deleteDialog.close(); });
		deleteDialog?.addEventListener('close', () => { pendingDeleteForm = null; });
		deleteConfirmButton?.addEventListener('click', () => {
			if (!pendingDeleteForm) return;
			const form = pendingDeleteForm;
			form.dataset.deleteConfirmed = 'true';
			deleteConfirmButton.disabled = true;
			if (deleteConfirmLabel) deleteConfirmLabel.textContent = 'جارٍ الحذف...';
			form.requestSubmit();
		});
		const notificationChecks = Array.from(document.querySelectorAll<HTMLInputElement>('.notification-select-checkbox'));
		const notificationSelectAll = document.getElementById('notifications-select-all') as HTMLInputElement | null;
		const notificationBulkForm = document.querySelector<HTMLFormElement>('[data-notifications-bulk]');
		const notificationSelectedCount = document.getElementById('notifications-selected-count');
		const updateNotificationSelection = () => { const count = notificationChecks.filter((check) => check.checked).length; if (notificationBulkForm) notificationBulkForm.hidden = count === 0; if (notificationSelectedCount) notificationSelectedCount.textContent = String(count); if (notificationSelectAll) { notificationSelectAll.checked = notificationChecks.length > 0 && count === notificationChecks.length; notificationSelectAll.indeterminate = count > 0 && count < notificationChecks.length; } };
		notificationSelectAll?.addEventListener('change', () => { notificationChecks.forEach((check) => { check.checked = notificationSelectAll.checked; }); updateNotificationSelection(); });
		notificationChecks.forEach((check) => check.addEventListener('change', updateNotificationSelection));
