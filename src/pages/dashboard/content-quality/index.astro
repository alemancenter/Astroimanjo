---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';
import { getCountryById, COUNTRIES } from '../../../lib/countries';

const guard = await requireDashboard(Astro, ['manage content audit', 'manage seo']);
if ('redirect' in guard) return guard.redirect;
const { user } = guard;

const token = Astro.cookies.get('token')?.value;
const auth = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };
const country = getCountryById(Astro.locals.countryId);
const params = Astro.url.searchParams;
const rawTab = params.get('tab');
const tab = rawTab === 'search' ? 'search' : rawTab === 'adsense' ? 'adsense' : 'content';
const page = Math.max(1, Number(params.get('page') || 1));
const risk = String(params.get('risk') || 'all');
const type = String(params.get('type') || 'all');
const status = String(params.get('status') || 'all');
const q = String(params.get('q') || '').trim();
const flashSuccess = params.get('success');
const flashError = params.get('error');

// Only the active tab's data is fetched — no blind calls into the other tabs.
let result: any = { ok: true, data: {} };
let gscProps: any[] = [];
let gscConfigured = false;
let gscAnalytics: Record<string, any> = {};
let adsense: any = { ok: true, data: {} };
if (tab === 'content') {
	result = await apiFetch<any>('/dashboard/content-quality', { ...auth, params: { country: country.code, type, status, q, page, per_page: 25 } });
} else if (tab === 'adsense') {
	adsense = await apiFetch<any>('/dashboard/content-audit/adsense-readiness', { ...auth, params: { country: country.code, type, q, page, per_page: 30 } });
} else {
	const propsRes = await apiFetch<any[]>('/dashboard/gsc/properties', auth);
	gscProps = Array.isArray(propsRes.data) ? propsRes.data : [];
	gscConfigured = propsRes.ok;
	const configuredCodes = gscProps.filter((p) => p?.site_url).map((p) => p.country_code);
	const analyticsResults = await Promise.all(
		configuredCodes.map((cc: string) => apiFetch<any>('/dashboard/gsc/analytics', { ...auth, params: { country_code: cc, days: 30 } })),
	);
	configuredCodes.forEach((cc: string, i: number) => { if (analyticsResults[i]?.ok) gscAnalytics[cc] = analyticsResults[i].data; });
}
const propByCode = new Map(gscProps.map((p) => [p.country_code, p]));

const data = result.data ?? {};
const summary = data.summary ?? { total: 0, good: 0, needs_work: 0, problem: 0 };
const items: any[] = Array.isArray(data.items) ? data.items : [];
const meta = data.meta ?? { current_page: 1, last_page: 1 };

// AdSense compliance view
const adData = adsense.data ?? {};
const adSummary = adData.summary ?? {};
const RISK_RANK: Record<string, number> = { critical: 0, high: 1, medium: 2, unknown: 3, low: 4 };
let adItems: any[] = Array.isArray(adData.items) ? adData.items : [];
if (risk !== 'all') adItems = adItems.filter((it) => (it.adsense_risk || 'unknown') === risk);
adItems = [...adItems].sort((a, b) => (RISK_RANK[a.adsense_risk] ?? 3) - (RISK_RANK[b.adsense_risk] ?? 3));
const adMeta = adData.meta ?? { current_page: 1, last_page: 1 };
const DECISION: Record<string, { label: string; cls: string }> = {
	approved: { label: 'مقبول', cls: 'is-good' },
	needs_fix: { label: 'يحتاج إصلاحًا', cls: 'is-warn' },
	restricted_ads: { label: 'إعلانات مقيّدة', cls: 'is-warn' },
	rejected: { label: 'مرفوض', cls: 'is-bad' },
	unaudited: { label: 'لم يُدقَّق', cls: 'is-muted' },
};
const RISK: Record<string, { label: string; cls: string }> = {
	critical: { label: 'حرج', cls: 'is-bad' },
	high: { label: 'مرتفع', cls: 'is-bad' },
	medium: { label: 'متوسط', cls: 'is-warn' },
	low: { label: 'منخفض', cls: 'is-good' },
	unknown: { label: '—', cls: 'is-muted' },
};

const nf = new Intl.NumberFormat('ar-EG');
const STATUS = {
	good: { label: 'جيّد', cls: 'is-good', icon: '✓' },
	needs_work: { label: 'يحتاج تحسين', cls: 'is-warn', icon: '!' },
	problem: { label: 'مشكلة', cls: 'is-bad', icon: '✕' },
} as const;
const editorHref = (it: any) => (it.type === 'post' ? `/dashboard/posts/${it.id}/edit` : `/dashboard/articles/${it.id}/edit`);
const GOOGLE_INDEX: Record<string, { label: string; ok: boolean }> = {
	indexed: { label: 'مفهرس', ok: true },
	not_indexed: { label: 'غير مفهرس', ok: false },
	crawled_not_indexed: { label: 'زُحف بلا فهرسة', ok: false },
	discovered_not_crawled: { label: 'لم يُزحف', ok: false },
};
const pageHref = (target: number) => {
	const u = new URL(Astro.url);
	u.searchParams.set('page', String(target));
	return `${u.pathname}?${u.searchParams.toString()}`;
};
const hasFilter = type !== 'all' || status !== 'all' || q !== '';
---

<DashboardLayout title="صحة المحتوى" user={user}>
	<div class="ch-page">
		<header class="ch-hero">
			<div>
				<span>مراجعة واحدة لكل مقال ومنشور</span>
				<h1>صحة المحتوى</h1>
				<p>راجع المحتوى في {country.name}، وافتح المحرر لتصحيحه. التحليل مساعد اختياري، والنتائج الداخلية لا تمثل قرار Google.</p>
			</div>
			<a class="ch-hero-link" href="/dashboard/quality?tab=content">مراجعة التفاصيل</a>
			<a class="ch-hero-link" href="/dashboard/content-audit/ai-operations">اقتراحات بانتظار الاعتماد</a>
		</header>

		<nav class="ch-tabs">
			<a href="/dashboard/content-quality" class:list={{ 'is-active': tab === 'content' }}>المحتوى</a>
			<a href="/dashboard/content-quality?tab=adsense" class:list={{ 'is-active': tab === 'adsense' }}>توافق AdSense</a>
			<a href="/dashboard/content-quality?tab=search" class:list={{ 'is-active': tab === 'search' }}>الفهرسة و Google</a>
		</nav>

		{flashSuccess === 'autofix' ? (
			<div class="ch-flash is-ok">بدأ إنشاء اقتراحات الأوصاف. راجعها منفردة في طابور الاقتراحات قبل الاعتماد.</div>
		) : flashSuccess === 'audit-all' ? (
			<div class="ch-flash is-ok">بدأ التدقيق الشامل بالذكاء في الخلفية — قد يستغرق عدة دقائق حسب حجم المحتوى. أعد التحميل لاحقًا لرؤية الحالات المحدَّثة.</div>
		) : flashSuccess === 'index-sync' ? (
			<div class="ch-flash is-ok">بدأت مزامنة حالة الفهرسة من Google في الخلفية.</div>
		) : flashSuccess ? (
			<div class="ch-flash is-ok">تمت العملية بنجاح.</div>
		) : null}
		{flashError && <div class="ch-flash is-err">{flashError}</div>}

		{tab === 'content' && (
		<Fragment>
		<div class="ch-actions">
			<form method="post" action="/api/dashboard/content-quality/audit-all" class="ch-action-card" data-confirm="سيبدأ تدقيق الجودة بالذكاء لكل مقال/منشور لم يُدقَّق بعد (حتى 500 عنصر). يعمل في الخلفية وقد يستغرق وقتًا. متابعة؟">
				<div><b>تدقيق شامل بالذكاء</b><span>تحليل مساعد للمحتوى غير المدقّق؛ نتائجه مؤشرات داخلية للمراجعة.</span></div>
				<button type="submit">بدء التدقيق الشامل</button>
			</form>
			{summary.needs_work + summary.problem > 0 && (
				<form method="post" action="/api/dashboard/content-quality/autofix" class="ch-action-card" data-confirm="سيولّد النظام اقتراحات للأوصاف الناقصة. ستراجع كل اقتراح قبل اعتماده. متابعة؟">
					<div><b>اقتراح أوصاف للمراجعة</b><span>مساعدة اختيارية؛ تُحفظ الاقتراحات منفصلة حتى اعتمادها.</span></div>
					<button type="submit">إنشاء الاقتراحات</button>
				</form>
			)}
		</div>
		<div class="ch-summary">
			<a class="ch-stat is-good" href="?status=good"><strong>{nf.format(summary.good)}</strong><span>جيّد</span></a>
			<a class="ch-stat is-warn" href="?status=needs_work"><strong>{nf.format(summary.needs_work)}</strong><span>يحتاج تحسين</span></a>
			<a class="ch-stat is-bad" href="?status=problem"><strong>{nf.format(summary.problem)}</strong><span>مشكلة</span></a>
			<a class="ch-stat" href="?"><strong>{nf.format(summary.total)}</strong><span>الإجمالي</span></a>
		</div>

		<form class="ch-filters" method="get">
			<label><input type="search" name="q" value={q} placeholder="ابحث بعنوان المحتوى…" /></label>
			<select name="type">
				<option value="all">كل الأنواع</option>
				<option value="article" selected={type === 'article'}>مقالات</option>
				<option value="post" selected={type === 'post'}>منشورات</option>
			</select>
			<select name="status">
				<option value="all">كل الحالات</option>
				<option value="problem" selected={status === 'problem'}>مشكلة</option>
				<option value="needs_work" selected={status === 'needs_work'}>يحتاج تحسين</option>
				<option value="good" selected={status === 'good'}>جيّد</option>
			</select>
			<button type="submit">تطبيق</button>
			{hasFilter && <a href={Astro.url.pathname}>مسح</a>}
		</form>

		{!result.ok ? (
			<section class="ch-empty is-error"><i>!</i><h2>تعذّر تحميل صحة المحتوى</h2><p>تحقق من اتصال الخادم ثم أعد المحاولة.</p><a href={Astro.url.pathname}>إعادة المحاولة</a></section>
		) : items.length === 0 ? (
			<section class="ch-empty"><i>✓</i><h2>لا نتائج</h2><p>{hasFilter ? 'غيّر الفلاتر.' : 'لا يوجد محتوى بعد.'}</p></section>
		) : (
			<div class="ch-table-wrap">
				<table class="ch-table">
					<thead><tr><th>المحتوى</th><th>الحالة</th><th>المشكلات</th><th>الدرجة</th><th></th></tr></thead>
					<tbody>
						{items.map((it) => {
							const s = STATUS[it.status as keyof typeof STATUS] ?? STATUS.needs_work;
							return (
								<tr data-item={JSON.stringify({ ...it, editor: editorHref(it) })} tabindex="0">
									<td class="ch-title">
										<span class={`ch-badge ${it.type === 'post' ? 'is-post' : 'is-article'}`}>{it.type === 'post' ? 'منشور' : 'مقال'}</span>
										<b>{it.title || `#${it.id}`}</b>
										{!it.published && <span class="ch-draft">مسودة</span>}
									</td>
									<td>
										<span class={`ch-status ${s.cls}`}><i>{s.icon}</i>{s.label}</span>
										{GOOGLE_INDEX[it.google_index] && <span class={`ch-gidx ${GOOGLE_INDEX[it.google_index].ok ? 'is-ok' : 'is-no'}`}>{GOOGLE_INDEX[it.google_index].label}</span>}
									</td>
									<td class="ch-issues">{(it.issues || []).slice(0, 3).map((x: any) => <span>{x.label}</span>)}{(it.issues || []).length > 3 && <span class="ch-more">+{(it.issues || []).length - 3}</span>}{(it.issues || []).length === 0 && <span class="ch-none">—</span>}</td>
									<td><span class={`ch-score ${it.score >= 80 ? 'is-good' : it.score >= 50 ? 'is-warn' : 'is-bad'}`}>{it.score}</span></td>
									<td><button type="button" class="ch-open" data-open>معالجة</button></td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
		)}

		{meta.last_page > 1 && (
			<nav class="ch-pagination">
				<a href={pageHref(Math.max(1, meta.current_page - 1))} class:list={{ 'is-off': meta.current_page <= 1 }}>السابق</a>
				<span>صفحة <strong>{nf.format(meta.current_page)}</strong> من {nf.format(meta.last_page)}</span>
				<a href={pageHref(Math.min(meta.last_page, meta.current_page + 1))} class:list={{ 'is-off': meta.current_page >= meta.last_page }}>التالي</a>
			</nav>
		)}
		</Fragment>
		)}

		{tab === 'search' && (
		<div class="ch-gsc">
			{!gscConfigured && (
				<div class="ch-flash is-warn">
					ربط Google Search Console غير مُفعّل على الخادم (<code>GSC_ENABLED</code> أو مفتاح الحساب الخدمي). بعد ضبطه أعد تشغيل الخدمة.
				</div>
			)}
			<section class="ch-gsc-block">
				<h2>خصائص Search Console لكل دولة</h2>
				<p class="ch-gsc-hint">أدخل معرّف الخاصية (مثل <code>sc-domain:imanjo.com</code>)، ثم أضف حساب الخدمة <code>imanjo@imanjo-505218.iam.gserviceaccount.com</code> كمستخدم على الخاصية في Search Console.</p>
				<div class="ch-gsc-grid">
					{COUNTRIES.map((c) => {
						const p: any = propByCode.get(c.code);
						return (
							<form method="post" action="/api/dashboard/content-quality/gsc-property" class="ch-gsc-card">
								<div class="ch-gsc-card-head"><b>{c.name}</b>{p?.site_url ? <span class="ch-tag is-ok">مُعدّة</span> : <span class="ch-tag">غير مُعدّة</span>}</div>
								<input type="hidden" name="country_code" value={c.code} />
								<input type="text" name="site_url" value={p?.site_url || 'sc-domain:imanjo.com'} placeholder="sc-domain:imanjo.com" dir="ltr" />
								<div class="ch-gsc-card-actions">
									<button type="submit">حفظ</button>
									<button type="submit" formaction="/api/dashboard/content-quality/gsc-sync" disabled={!p?.site_url || !gscConfigured}>مزامنة الأداء</button>
								</div>
								{gscAnalytics[c.code] && (
									<div class="ch-gsc-stats">
										<span>نقرات <b>{nf.format(Number(gscAnalytics[c.code]?.totals?.clicks ?? gscAnalytics[c.code]?.clicks ?? 0))}</b></span>
										<span>ظهور <b>{nf.format(Number(gscAnalytics[c.code]?.totals?.impressions ?? gscAnalytics[c.code]?.impressions ?? 0))}</b></span>
									</div>
								)}
							</form>
						);
					})}
				</div>
			</section>

			<section class="ch-gsc-block">
				<h2>اختبار الاتصال</h2>
				<p class="ch-gsc-hint">فحص فوري لرابط واحد للتأكد من صحة الربط.</p>
				<div class="ch-gsc-test">
					<select data-test-country>
						{COUNTRIES.map((c) => <option value={c.code}>{c.name}</option>)}
					</select>
					<input type="url" data-test-url placeholder="https://imanjo.com/jo/..." dir="ltr" />
					<button type="button" data-test-run>فحص</button>
				</div>
				<div class="ch-gsc-test-result" data-test-result hidden></div>
			</section>

			<section class="ch-gsc-block">
				<h2>حالة الفهرسة في Google</h2>
				<p class="ch-gsc-hint">جلب ما تعرضه Google فعليًا لكل مقال/منشور منشور ({country.name})، ويظهر كشارة في تبويب «المحتوى».</p>
				<form method="post" action="/api/dashboard/content-quality/gsc-index-sync">
					<button type="submit" class="ch-gsc-syncbtn" disabled={!gscConfigured}>مزامنة حالة الفهرسة من Google</button>
				</form>
			</section>

			<section class="ch-gsc-block">
				<h2>الخرائط والإعدادات</h2>
				<div class="ch-gsc-links">
					<a href="/dashboard/sitemap">خريطة الموقع</a>
					<a href="/dashboard/settings#seo">إعدادات SEO والفهرسة (IndexNow / robots)</a>
				</div>
			</section>
		</div>
		)}

		{tab === 'adsense' && (
		<Fragment>
			<p class="ch-ad-intro">تحليل سياسات Google AdSense لكل مقال ومنشور في {country.name}: القرار، مستوى الخطر، والعبارات/المشكلات غير المتوافقة. يعتمد على نتائج «التدقيق الشامل بالذكاء» — شغّله من تبويب «المحتوى» إن لم تكن هناك بيانات.</p>
			<div class="ch-summary">
				<div class="ch-stat is-bad"><strong>{nf.format(Number(adSummary.weak || 0))}</strong><span>غير مؤهّل للإعلانات</span></div>
				<div class="ch-stat is-good"><strong>{nf.format(Number(adSummary.ads_eligible || 0))}</strong><span>مؤهّل</span></div>
				<div class="ch-stat is-warn"><strong>{nf.format(Number(adSummary.unaudited || 0))}</strong><span>لم يُدقَّق</span></div>
				<div class="ch-stat"><strong>{nf.format(Number(adSummary.total || 0))}</strong><span>الإجمالي</span></div>
			</div>
			<form class="ch-filters" method="get">
				<input type="hidden" name="tab" value="adsense" />
				<label><input type="search" name="q" value={q} placeholder="ابحث بعنوان المحتوى…" /></label>
				<select name="risk">
					<option value="all">كل مستويات الخطر</option>
					<option value="critical" selected={risk === 'critical'}>حرج</option>
					<option value="high" selected={risk === 'high'}>مرتفع</option>
					<option value="medium" selected={risk === 'medium'}>متوسط</option>
				</select>
				<button type="submit">تطبيق</button>
			</form>
			{!adsense.ok ? (
				<section class="ch-empty is-error"><i>!</i><h2>تعذّر تحميل تحليل AdSense</h2><p>تأكّد من نشر الباك-إند وتشغيل التدقيق.</p></section>
			) : adItems.length === 0 ? (
				<section class="ch-empty"><i>✓</i><h2>لا نتائج</h2><p>شغّل «التدقيق الشامل بالذكاء» من تبويب المحتوى، أو غيّر الفلاتر.</p></section>
			) : (
				<div class="ch-table-wrap">
					<table class="ch-table">
						<thead><tr><th>المحتوى</th><th>القرار</th><th>الخطر</th><th>المشكلات</th><th></th></tr></thead>
						<tbody>
							{adItems.map((it) => {
								const d = DECISION[it.decision] ?? DECISION.unaudited;
								const r = RISK[it.adsense_risk] ?? RISK.unknown;
								const probs: string[] = (it.problems || []).map((p: any) => p.label).concat(it.gate_reasons || []).filter(Boolean).slice(0, 3);
								return (
									<tr data-ad={JSON.stringify({ id: it.id, type: it.type, title: it.title, editor: it.type === 'post' ? `/dashboard/posts/${it.id}/edit` : `/dashboard/articles/${it.id}/edit` })} tabindex="0">
										<td class="ch-title"><span class={`ch-badge ${it.type === 'post' ? 'is-post' : 'is-article'}`}>{it.type === 'post' ? 'منشور' : 'مقال'}</span><b>{it.title || `#${it.id}`}</b></td>
										<td><span class={`ch-status ${d.cls}`}>{d.label}</span></td>
										<td><span class={`ch-status ${r.cls}`}>{r.label}</span></td>
										<td class="ch-issues">{probs.length ? probs.map((p) => <span>{p}</span>) : <span class="ch-none">—</span>}</td>
										<td><button type="button" class="ch-open" data-ad-open>تفاصيل</button></td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			)}
			{adMeta.last_page > 1 && (
				<nav class="ch-pagination">
					<a href={pageHref(Math.max(1, adMeta.current_page - 1))} class:list={{ 'is-off': adMeta.current_page <= 1 }}>السابق</a>
					<span>صفحة <strong>{nf.format(adMeta.current_page)}</strong> من {nf.format(adMeta.last_page)}</span>
					<a href={pageHref(Math.min(adMeta.last_page, adMeta.current_page + 1))} class:list={{ 'is-off': adMeta.current_page >= adMeta.last_page }}>التالي</a>
				</nav>
			)}
		</Fragment>
		)}
	</div>

	<div class="ch-drawer" data-drawer hidden>
		<div class="ch-drawer-backdrop" data-close></div>
		<aside class="ch-drawer-panel" role="dialog" aria-label="تفاصيل صحة المحتوى">
			<header><b data-d-title></b><button type="button" data-close aria-label="إغلاق">✕</button></header>
			<div class="ch-drawer-status" data-d-status></div>
			<ul class="ch-drawer-issues" data-d-issues></ul>
			<div class="ch-drawer-msg" data-d-msg hidden></div>
			<div class="ch-drawer-actions">
				<button type="button" class="ch-drawer-ai" data-d-audit hidden>بدء تدقيق الجودة</button>
				<button type="button" class="ch-drawer-ai" data-d-ai hidden>مراجعة SEO في المحرر</button>
				<a class="ch-drawer-editor" data-d-editor href="#">فتح المحرر</a>
			</div>
		</aside>
	</div>

	<div class="ch-drawer" data-addrawer hidden>
		<div class="ch-drawer-backdrop" data-adclose></div>
		<aside class="ch-drawer-panel" role="dialog" aria-label="تفاصيل توافق AdSense">
			<header><b data-ad-title></b><button type="button" data-adclose aria-label="إغلاق">✕</button></header>
			<div class="ch-drawer-status" data-ad-verdict></div>
			<p class="ch-ad-summary" data-ad-summary hidden></p>
			<div class="ch-ad-section" data-ad-issues-wrap hidden><b>مشكلات السياسة</b><ul class="ch-drawer-issues" data-ad-issues></ul></div>
			<div class="ch-ad-section" data-ad-sugg-wrap hidden><b>توصيات</b><ul class="ch-ad-sugg" data-ad-sugg></ul></div>
			<div class="ch-drawer-msg" data-ad-msg hidden></div>
			<div class="ch-drawer-actions">
				<button type="button" class="ch-drawer-ai" data-ad-recheck>إعادة التدقيق بالذكاء</button>
				<a class="ch-drawer-editor" data-ad-editor href="#">فتح المحرر</a>
			</div>
		</aside>
	</div>

	<script>
		const drawer = document.querySelector<HTMLElement>('[data-drawer]');
		const dTitle = document.querySelector<HTMLElement>('[data-d-title]');
		const dStatus = document.querySelector<HTMLElement>('[data-d-status]');
		const dIssues = document.querySelector<HTMLUListElement>('[data-d-issues]');
		const dEditor = document.querySelector<HTMLAnchorElement>('[data-d-editor]');
		const dAi = document.querySelector<HTMLButtonElement>('[data-d-ai]');
		const dAudit = document.querySelector<HTMLButtonElement>('[data-d-audit]');
		const dMsg = document.querySelector<HTMLElement>('[data-d-msg]');
		const STATUS_TXT: Record<string, string> = { good: 'جيّد', needs_work: 'يحتاج تحسين', problem: 'مشكلة' };
		const FIX_TXT: Record<string, string> = { ai: 'يُصلَح بالذكاء', audit: 'يبدأ بتدقيق الجودة', editor: 'يُعالَج في المحرر', manual: 'يحتاج قرارًا يدويًا' };
		let current: any = null;

		const open = (raw: string) => {
			if (!drawer || !dTitle || !dStatus || !dIssues || !dEditor) return;
			try { current = JSON.parse(raw); } catch { return; }
			const it = current;
			dTitle.textContent = it.title || `#${it.id}`;
			dStatus.className = `ch-drawer-status is-${it.status}`;
			dStatus.textContent = `${STATUS_TXT[it.status] || it.status} — الدرجة ${it.score}/100`;
			dIssues.replaceChildren(...(it.issues || []).map((x: any) => {
				const li = document.createElement('li');
				li.className = `is-${x.severity}`;
				const label = document.createElement('span');
				label.textContent = x.label;
				const fix = document.createElement('small');
				fix.textContent = FIX_TXT[x.fix] || '';
				li.append(label, fix);
				return li;
			}));
			if (!(it.issues || []).length) {
				const li = document.createElement('li');
				li.className = 'is-empty';
				li.textContent = 'لا مشكلات — هذا المحتوى بحالة جيدة.';
				dIssues.append(li);
			}
			if (dMsg) { dMsg.hidden = true; dMsg.textContent = ''; }
			if (dAi) dAi.hidden = !(it.issues || []).some((x: any) => x.fix === 'ai');
			if (dAudit) dAudit.hidden = !(it.issues || []).some((x: any) => x.fix === 'audit');
			dEditor.href = it.editor;
			drawer.hidden = false;
			document.body.style.overflow = 'hidden';
		};
		const close = () => { if (drawer) { drawer.hidden = true; document.body.style.overflow = ''; } };

		const runFix = async (button: HTMLButtonElement, endpoint: string, busy: string, idle: string) => {
			if (!current || !dMsg) return;
			button.disabled = true;
			const original = button.textContent;
			button.textContent = busy;
			dMsg.hidden = true;
			try {
				const res = await fetch(endpoint, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ content_type: current.type, id: current.id }),
				});
				const json = await res.json();
				if (!res.ok || !json?.success) throw new Error(json?.message || 'تعذّرت العملية');
				dMsg.className = 'ch-drawer-msg is-ok';
				dMsg.textContent = `${idle} — تم. أعد تحميل الصفحة لتحديث القائمة.`;
				dMsg.hidden = false;
				button.hidden = true;
				setTimeout(() => location.reload(), 1400);
			} catch (error) {
				dMsg.className = 'ch-drawer-msg is-err';
				dMsg.textContent = error instanceof Error ? error.message : 'تعذّرت العملية';
				dMsg.hidden = false;
				button.disabled = false;
				button.textContent = original || idle;
			}
		};

		dAi?.addEventListener('click', () => { if (current) location.assign(current.editor); });
		dAudit?.addEventListener('click', () => runFix(dAudit, '/api/dashboard/content-quality/audit', 'جارِ التدقيق…', 'بدء تدقيق الجودة'));

		document.querySelectorAll<HTMLTableRowElement>('tr[data-item]').forEach((row) => {
			const raw = row.dataset.item || '';
			row.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('a')) open(raw); });
			row.addEventListener('keydown', (e) => { if (e.key === 'Enter') open(raw); });
		});
		document.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

		document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
			form.addEventListener('submit', (e) => { if (!window.confirm(form.dataset.confirm || '')) e.preventDefault(); });
		});

		// AdSense compliance drawer
		const adDrawer = document.querySelector<HTMLElement>('[data-addrawer]');
		if (adDrawer) {
			const adTitle = document.querySelector<HTMLElement>('[data-ad-title]');
			const adVerdict = document.querySelector<HTMLElement>('[data-ad-verdict]');
			const adSummary = document.querySelector<HTMLElement>('[data-ad-summary]');
			const adIssuesWrap = document.querySelector<HTMLElement>('[data-ad-issues-wrap]');
			const adIssues = document.querySelector<HTMLUListElement>('[data-ad-issues]');
			const adSuggWrap = document.querySelector<HTMLElement>('[data-ad-sugg-wrap]');
			const adSugg = document.querySelector<HTMLUListElement>('[data-ad-sugg]');
			const adEditor = document.querySelector<HTMLAnchorElement>('[data-ad-editor]');
			const adRecheck = document.querySelector<HTMLButtonElement>('[data-ad-recheck]');
			const adMsg = document.querySelector<HTMLElement>('[data-ad-msg]');
			let adCurrent: any = null;
			const adClose = () => { adDrawer.hidden = true; document.body.style.overflow = ''; };
			const SEV: Record<string, string> = { critical: 'حرج', high: 'مرتفع', medium: 'متوسط', low: 'منخفض' };

			const adOpen = async (raw: string) => {
				try { adCurrent = JSON.parse(raw); } catch { return; }
				if (adTitle) adTitle.textContent = adCurrent.title || `#${adCurrent.id}`;
				if (adEditor) adEditor.href = adCurrent.editor;
				if (adMsg) adMsg.hidden = true;
				if (adVerdict) { adVerdict.className = 'ch-drawer-status'; adVerdict.textContent = 'جارِ التحميل…'; }
				[adSummary, adIssuesWrap, adSuggWrap].forEach((el) => { if (el) el.hidden = true; });
				adDrawer.hidden = false;
				document.body.style.overflow = 'hidden';
				try {
					const res = await fetch(`/api/dashboard/content-quality/decision?type=${adCurrent.type}&id=${adCurrent.id}`);
					const json = await res.json();
					const d = json?.data?.decision;
					if (!json?.data?.exists || !d) {
						if (adVerdict) { adVerdict.className = 'ch-drawer-status is-needs_work'; adVerdict.textContent = 'لم يُدقَّق بعد — اضغط «إعادة التدقيق بالذكاء».'; }
						return;
					}
					const DEC: Record<string, string> = { approved: 'مقبول', needs_fix: 'يحتاج إصلاحًا', restricted_ads: 'إعلانات مقيّدة', rejected: 'مرفوض' };
					const RSK: Record<string, string> = { critical: 'حرج', high: 'مرتفع', medium: 'متوسط', low: 'منخفض', unknown: '—' };
					if (adVerdict) {
						const bad = d.decision === 'rejected' || d.adsense_risk === 'critical' || d.adsense_risk === 'high';
						adVerdict.className = `ch-drawer-status ${bad ? 'is-problem' : d.decision === 'approved' ? 'is-good' : 'is-needs_work'}`;
						adVerdict.textContent = `القرار: ${DEC[d.decision] || d.decision} · الخطر: ${RSK[d.adsense_risk] || d.adsense_risk}`;
					}
					if (adSummary && d.summary) { adSummary.textContent = d.summary; adSummary.hidden = false; }
					const issues = Array.isArray(d.issues) ? d.issues : [];
					if (adIssues) {
						adIssues.replaceChildren(...issues.map((x: any) => {
							const li = document.createElement('li');
							li.className = `is-${x.severity === 'critical' || x.severity === 'high' ? 'high' : x.severity === 'medium' ? 'medium' : 'low'}`;
							const label = document.createElement('span');
							label.textContent = `${SEV[x.severity] || x.severity ? '[' + (SEV[x.severity] || x.severity) + '] ' : ''}${x.message}`;
							li.append(label);
							if (x.evidence) { const s = document.createElement('small'); s.textContent = `الدليل: ${x.evidence}`; li.append(s); }
							return li;
						}));
					}
					if (adIssuesWrap) adIssuesWrap.hidden = issues.length === 0;
					const sugg = Array.isArray(d.suggestions) ? d.suggestions : [];
					if (adSugg) adSugg.replaceChildren(...sugg.map((x: any) => { const li = document.createElement('li'); li.textContent = x.message; return li; }));
					if (adSuggWrap) adSuggWrap.hidden = sugg.length === 0;
				} catch {
					if (adVerdict) { adVerdict.className = 'ch-drawer-status is-problem'; adVerdict.textContent = 'تعذّر تحميل التفاصيل.'; }
				}
			};

			document.querySelectorAll<HTMLTableRowElement>('tr[data-ad]').forEach((row) => {
				const raw = row.dataset.ad || '';
				row.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('a')) adOpen(raw); });
				row.addEventListener('keydown', (e) => { if (e.key === 'Enter') adOpen(raw); });
			});
			document.querySelectorAll('[data-adclose]').forEach((el) => el.addEventListener('click', adClose));
			document.addEventListener('keydown', (e) => { if (e.key === 'Escape') adClose(); });

			adRecheck?.addEventListener('click', async () => {
				if (!adCurrent || !adMsg) return;
				adRecheck.disabled = true; adRecheck.textContent = 'جارِ التدقيق…';
				adMsg.hidden = true;
				try {
					const res = await fetch('/api/dashboard/content-quality/audit', {
						method: 'POST', headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ content_type: adCurrent.type, id: adCurrent.id }),
					});
					const json = await res.json();
					if (!res.ok || !json?.success) throw new Error(json?.message || 'تعذّر التدقيق');
					adMsg.className = 'ch-drawer-msg is-ok'; adMsg.textContent = 'تم التدقيق — أعد فتح التفاصيل لرؤية النتيجة.'; adMsg.hidden = false;
				} catch (error) {
					adMsg.className = 'ch-drawer-msg is-err'; adMsg.textContent = error instanceof Error ? error.message : 'تعذّر التدقيق'; adMsg.hidden = false;
				} finally {
					adRecheck.disabled = false; adRecheck.textContent = 'إعادة التدقيق بالذكاء';
				}
			});
		}

		// GSC connection test (search tab)
		const testBtn = document.querySelector<HTMLButtonElement>('[data-test-run]');
		testBtn?.addEventListener('click', async () => {
			const cc = document.querySelector<HTMLSelectElement>('[data-test-country]')?.value || '';
			const url = document.querySelector<HTMLInputElement>('[data-test-url]')?.value.trim() || '';
			const box = document.querySelector<HTMLElement>('[data-test-result]');
			if (!box) return;
			if (!url) { box.className = 'ch-gsc-test-result is-err'; box.textContent = 'أدخل رابطًا.'; box.hidden = false; return; }
			testBtn.disabled = true; testBtn.textContent = 'جارِ الفحص…';
			try {
				const res = await fetch(`/api/dashboard/content-quality/gsc-test?country_code=${encodeURIComponent(cc)}&url=${encodeURIComponent(url)}`);
				const json = await res.json();
				if (!res.ok || !json?.success) throw new Error(json?.message || 'فشل الفحص');
				const d = json.data || {};
				box.className = 'ch-gsc-test-result is-ok';
				box.textContent = `الحالة: ${d.index_status || '—'} · التغطية: ${d.coverage_state || '—'} · robots.txt: ${d.robots_txt_state || '—'}`;
			} catch (error) {
				box.className = 'ch-gsc-test-result is-err';
				box.textContent = error instanceof Error ? error.message : 'فشل الفحص';
			} finally {
				box.hidden = false; testBtn.disabled = false; testBtn.textContent = 'فحص';
			}
		});
	</script>

	<style>
		.ch-page{--c-blue:#1a4d8f;--c-ink:#18283d;--c-muted:#68788d;--c-line:#dce4ed;--c-good:#0f8464;--c-warn:#b56b15;--c-bad:#c43d49;direction:rtl}
		.ch-page *{box-sizing:border-box}
		.ch-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:.75rem;border:1px solid var(--c-line);border-radius:1rem;background:#fff;padding:1.1rem 1.2rem;box-shadow:0 3px 12px rgb(23 43 77/.05)}
		.ch-hero-link{flex:none;border:1px solid #b9cee7;border-radius:.5rem;background:#fff;padding:.4rem .7rem;color:var(--c-blue);font-size:.62rem;font-weight:850;text-decoration:none;white-space:nowrap}
		.ch-hero>div>span{color:var(--c-blue);font-size:.72rem;font-weight:850}
		.ch-hero h1{margin:.2rem 0 .15rem;color:var(--c-ink);font-size:1.45rem;font-weight:950}
		.ch-hero p{max-width:47rem;margin:0;color:var(--c-muted);font-size:.8rem;line-height:1.75}
		.ch-tabs{display:flex;gap:.4rem;margin-bottom:.7rem;border-bottom:1px solid var(--c-line)}
		.ch-tabs a{padding:.5rem .9rem;border-bottom:2px solid transparent;color:var(--c-muted);font-size:.7rem;font-weight:850;text-decoration:none}
		.ch-tabs a.is-active{color:var(--c-blue);border-bottom-color:var(--c-blue)}
		.ch-flash{margin-bottom:.7rem;border-radius:.5rem;padding:.55rem .7rem;font-size:.62rem;font-weight:800}
		.ch-flash.is-ok{background:#dff3eb;color:#08765a}.ch-flash.is-err{background:#fde7e9;color:#a3283a}.ch-flash.is-warn{background:#fdf0dc;color:#8a4f0f}
		.ch-flash code{font-family:ui-monospace,monospace;font-size:.9em}
		.ch-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:.6rem;margin-bottom:.7rem}
		.ch-action-card{display:flex;align-items:center;justify-content:space-between;gap:.8rem;border:1px solid #cfe0d6;border-radius:.65rem;background:#f4faf6;padding:.65rem .85rem}
		.ch-action-card div{display:grid;gap:.1rem}
		.ch-action-card b{color:#1c5b40;font-size:.66rem;font-weight:900}
		.ch-action-card span{color:#5b7a68;font-size:.56rem;line-height:1.6}
		.ch-action-card button{flex:none;min-height:2.2rem;border:1px solid #17457e;border-radius:.45rem;background:var(--c-blue);color:#fff;padding:0 .8rem;font-family:inherit;font-size:.6rem;font-weight:850;cursor:pointer;white-space:nowrap}
		.ch-gsc{display:grid;gap:.8rem}
		.ch-gsc-block{border:1px solid var(--c-line);border-radius:.75rem;background:#fff;padding:.9rem}
		.ch-gsc-block h2{margin:0 0 .15rem;color:var(--c-ink);font-size:.85rem;font-weight:900}
		.ch-gsc-hint{margin:0 0 .6rem;color:var(--c-muted);font-size:.6rem;line-height:1.7}
		.ch-gsc-hint code{font-family:ui-monospace,monospace;background:#f1f4f8;border-radius:.25rem;padding:.05rem .25rem;font-size:.9em;direction:ltr;display:inline-block}
		.ch-gsc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}
		.ch-gsc-card{display:grid;gap:.4rem;border:1px solid #e4eaf0;border-radius:.55rem;padding:.6rem}
		.ch-gsc-card-head{display:flex;align-items:center;justify-content:space-between}
		.ch-gsc-card-head b{color:var(--c-ink);font-size:.7rem}
		.ch-tag{border-radius:.3rem;background:#f1f2f4;padding:.1rem .4rem;font-size:.52rem;color:#8794a5;font-weight:800}
		.ch-tag.is-ok{background:#dff3eb;color:#08765a}
		.ch-gsc-card input{height:2.1rem;border:1px solid #d9e2ec;border-radius:.4rem;padding:0 .5rem;font-family:inherit;font-size:.62rem}
		.ch-gsc-card-actions{display:flex;gap:.35rem}
		.ch-gsc-card-actions button{flex:1;min-height:2rem;border:1px solid #b9cee7;border-radius:.4rem;background:#fff;color:var(--c-blue);font-family:inherit;font-size:.58rem;font-weight:850;cursor:pointer}
		.ch-gsc-card-actions button[type=submit]:first-child{background:var(--c-blue);color:#fff;border-color:#17457e}
		.ch-gsc-card-actions button:disabled{opacity:.45;cursor:not-allowed}
		.ch-gsc-stats{display:flex;gap:.7rem;font-size:.56rem;color:var(--c-muted)}
		.ch-gsc-stats b{color:var(--c-ink)}
		.ch-gsc-test{display:flex;gap:.4rem;flex-wrap:wrap}
		.ch-gsc-test select,.ch-gsc-test input{height:2.2rem;border:1px solid #d9e2ec;border-radius:.4rem;padding:0 .5rem;font-family:inherit;font-size:.62rem}
		.ch-gsc-test input{flex:1;min-width:14rem}
		.ch-gsc-test button{min-height:2.2rem;border:1px solid var(--c-blue);border-radius:.4rem;background:var(--c-blue);color:#fff;padding:0 .9rem;font-family:inherit;font-size:.6rem;font-weight:850;cursor:pointer}
		.ch-gsc-test-result{margin-top:.5rem;border-radius:.4rem;padding:.45rem .6rem;font-size:.6rem;font-weight:700}
		.ch-gsc-test-result.is-ok{background:#dff3eb;color:#08765a}.ch-gsc-test-result.is-err{background:#fde7e9;color:#a3283a}
		.ch-gsc-links{display:flex;gap:.5rem;flex-wrap:wrap}
		.ch-gsc-links a{border:1px solid #b9cee7;border-radius:.42rem;background:#fff;padding:.4rem .7rem;color:var(--c-blue);font-size:.6rem;font-weight:850;text-decoration:none}
		.ch-ad-intro{margin:0 0 .7rem;border:1px solid var(--c-line);border-radius:.6rem;background:#fff;padding:.6rem .8rem;color:var(--c-muted);font-size:.62rem;line-height:1.8}
		.ch-status.is-muted{background:#f1f2f4;color:#8794a5}
		.ch-ad-summary{border-radius:.45rem;background:#f6f9fc;padding:.5rem .6rem;color:var(--c-ink);font-size:.62rem;line-height:1.8}
		.ch-ad-section>b{display:block;margin-bottom:.25rem;color:var(--c-ink);font-size:.66rem;font-weight:900}
		.ch-ad-sugg{display:grid;gap:.3rem;margin:0;padding:0;list-style:none}
		.ch-ad-sugg li{border:1px solid #e6ebf1;border-radius:.4rem;padding:.4rem .5rem;color:var(--c-ink);font-size:.62rem;line-height:1.7}
		.ch-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin-bottom:.7rem}
		.ch-stat{display:grid;gap:.1rem;border:1px solid var(--c-line);border-radius:.7rem;background:#fff;padding:.7rem .85rem;text-decoration:none}
		.ch-stat strong{color:var(--c-ink);font-size:1.35rem;font-weight:950}
		.ch-stat span{color:var(--c-muted);font-size:.62rem;font-weight:800}
		.ch-stat.is-good strong{color:var(--c-good)}.ch-stat.is-warn strong{color:var(--c-warn)}.ch-stat.is-bad strong{color:var(--c-bad)}
		.ch-filters{display:flex;align-items:center;gap:.4rem;margin-bottom:.7rem;border:1px solid #e0e7ee;border-radius:.6rem;background:#f8fafc;padding:.5rem;flex-wrap:wrap}
		.ch-filters label{display:flex;min-width:16rem;flex:1;align-items:center;border:1px solid #d9e2ec;border-radius:.42rem;background:#fff;padding:0 .55rem}
		.ch-filters input{width:100%;height:2.2rem;border:0;background:transparent;color:var(--c-ink);font-family:inherit;font-size:.65rem;outline:0}
		.ch-filters select{height:2.2rem;min-width:8rem;border:1px solid #d9e2ec;border-radius:.42rem;background:#fff;padding:0 .45rem;font-family:inherit;font-size:.65rem;color:var(--c-ink)}
		.ch-filters>button{min-height:2.2rem;border:1px solid var(--c-blue);border-radius:.42rem;background:var(--c-blue);padding:.25rem .8rem;color:#fff;font-family:inherit;font-size:.62rem;font-weight:850;cursor:pointer}
		.ch-filters>a{min-height:2.2rem;display:grid;place-items:center;border:1px solid #d9e2ec;border-radius:.42rem;background:#fff;padding:.25rem .65rem;color:#63758a;font-size:.62rem;font-weight:850}
		.ch-table-wrap{overflow-x:auto;border:1px solid var(--c-line);border-radius:.82rem;background:#fff}
		.ch-table{width:100%;border-collapse:collapse;font-size:.72rem}
		.ch-table th{padding:.6rem .8rem;color:var(--c-muted);font-size:.62rem;font-weight:850;text-align:right;border-bottom:1px solid var(--c-line)}
		.ch-table td{padding:.55rem .8rem;border-bottom:1px solid #eef2f6;vertical-align:middle}
		.ch-table tbody tr{cursor:pointer}
		.ch-table tbody tr:hover{background:#f6f9fc}
		.ch-table tbody tr:focus-visible{outline:2px solid var(--c-blue);outline-offset:-2px}
		.ch-title{display:flex;align-items:center;gap:.4rem;min-width:16rem}
		.ch-title b{color:var(--c-ink);font-weight:800}
