---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardAlert from '../../components/ui/DashboardAlert.astro';
import DashboardNavIcon from '../../components/dashboard/DashboardNavIcon.astro';
import CountrySwitcher from '../../components/CountrySwitcher.astro';
import { requireDashboard, hasPermission, isAdmin } from '../../lib/auth';
import { apiFetch } from '../../lib/api';
import { getCountryById } from '../../lib/countries';

const guard = await requireDashboard(Astro);
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const countryId = Astro.locals.countryId;
const cookieHeader = `token=${Astro.cookies.get('token')?.value}`;
const currentCountry = getCountryById(countryId);
const canMonitor = isAdmin(user) || hasPermission(user, 'manage monitoring') || hasPermission(user, 'manage performance');
const canSecurity = isAdmin(user) || hasPermission(user, 'manage security');
const canTeacher = isAdmin(user) || hasPermission(user, 'manage teacher subscriptions');
const unavailable = Promise.resolve({ ok: false, data: null, message: '', meta: null, status: 403 });

const [summaryResult, contentResult, visitorResult, liveResult, cacheResult, responseResult, securityOverviewResult, securityStatsResult, teacherResult] = await Promise.all([
	apiFetch<any>('/dashboard', { countryId, cookieHeader }),
	apiFetch<any>('/dashboard/content-analytics', { countryId, cookieHeader }),
	canMonitor ? apiFetch<any>('/dashboard/visitor-analytics', { countryId, cookieHeader, params: { days: 7 } }) : unavailable,
	canMonitor ? apiFetch<any>('/dashboard/performance/live', { countryId, cookieHeader }) : unavailable,
	canMonitor ? apiFetch<any>('/dashboard/performance/cache', { countryId, cookieHeader }) : unavailable,
	canMonitor ? apiFetch<any>('/dashboard/performance/response-time', { countryId, cookieHeader }) : unavailable,
	canSecurity ? apiFetch<any>('/dashboard/security/overview', { countryId, cookieHeader }) : unavailable,
	canSecurity ? apiFetch<any>('/dashboard/security/stats', { countryId, cookieHeader }) : unavailable,
	canTeacher ? apiFetch<any>('/dashboard/teacher-subscriptions/dashboard', { countryId, cookieHeader }) : unavailable,
]);

const summary = summaryResult.data || {};
const totals = summary.totals || {};
const trends = summary.trends || {};
const analytics = summary.analytics || {};
const content = contentResult.data || {};
const visitor = visitorResult.data || {};
const visitorStats = visitor.visitor_stats || {};
const userStats = visitor.user_stats || {};
const live = liveResult.data || {};
const cache = cacheResult.data || {};
const response = responseResult.data || {};
const securityOverview = securityOverviewResult.data || {};
const securityStats = securityStatsResult.data || {};
const teacher = teacherResult.data || {};
const teacherStats = teacher.stats || {};
const recentActivities: any[] = Array.isArray(summary.recentActivities) ? summary.recentActivities : [];
const onlineUsers: any[] = Array.isArray(summary.onlineUsers) ? summary.onlineUsers : [];

const numberValue = (...values: unknown[]) => {
	for (const value of values) {
		const parsed = Number(value);
		if (Number.isFinite(parsed)) return parsed;
	}
	return 0;
};
const number = new Intl.NumberFormat('ar-EG');
const decimal = new Intl.NumberFormat('ar-EG', { maximumFractionDigits: 1 });
const formatNumber = (value: unknown) => number.format(numberValue(value));
const formatPercent = (value: unknown) => `${decimal.format(Math.abs(numberValue(value)))}%`;
const formatBytes = (value: unknown) => {
	const bytes = numberValue(value);
	if (!bytes) return '0 بايت';
	if (bytes < 1024) return `${number.format(bytes)} بايت`;
	if (bytes < 1024 ** 2) return `${decimal.format(bytes / 1024)} كيلوبايت`;
	if (bytes < 1024 ** 3) return `${decimal.format(bytes / 1024 ** 2)} ميجابايت`;
	return `${decimal.format(bytes / 1024 ** 3)} جيجابايت`;
};
const formatDateTime = (value: unknown) => {
	const date = new Date(String(value || ''));
	return Number.isNaN(date.getTime()) ? 'حديثًا' : date.toLocaleString('ar-EG', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
};
const trendValue = (trend: any) => numberValue(trend?.percentage, trend);
const trendDown = (trend: any) => trend?.trend === 'down' || trendValue(trend) < 0;

const dates: string[] = Array.isArray(analytics.dates) ? analytics.dates.slice(-7) : [];
const labels = dates.map((value, index) => {
	const date = new Date(String(value).length > 10 ? String(value) : `${value}T00:00:00`);
	return Number.isNaN(date.getTime()) ? String(index + 1) : date.toLocaleDateString('ar-EG', { weekday: 'short' });
});
const series: { articles: number[]; posts: number[]; comments: number[] } = {
	articles: (Array.isArray(analytics.articles) ? analytics.articles : []).slice(-7).map(Number),
	posts: (Array.isArray(analytics.news) ? analytics.news : []).slice(-7).map(Number),
	comments: (Array.isArray(analytics.comments) ? analytics.comments : []).slice(-7).map(Number),
};
const seriesLength = Math.max(labels.length, series.articles.length, series.posts.length, series.comments.length, 1);
const normalizeSeries = (values: number[]) => Array.from({ length: seriesLength }, (_, index) => numberValue(values[index]));
series.articles = normalizeSeries(series.articles);
series.posts = normalizeSeries(series.posts);
series.comments = normalizeSeries(series.comments);
const chartMax = Math.max(1, ...series.articles, ...series.posts, ...series.comments);
const linePoints = (values: number[], width = 720, height = 205) => values.map((value, index) => {
	const x = values.length <= 1 ? width / 2 : (index / (values.length - 1)) * width;
	const y = height - (value / chartMax) * (height - 26) - 10;
	return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
const articlePoints = linePoints(series.articles);
const postPoints = linePoints(series.posts);
const commentPoints = linePoints(series.comments);
const articleArea = `M0 215 L${articlePoints.replaceAll(' ', ' L')} L720 215 Z`;

const visitorChart: any[] = Array.isArray(visitor.chart_data) ? visitor.chart_data.slice(-7) : [];
const visitorMax = Math.max(1, ...visitorChart.map((item) => numberValue(item.pageViews, item.views, item.visits)));
const publishedArticles = numberValue(content.published_articles);
const draftArticles = numberValue(content.draft_articles);
const contentTotal = publishedArticles + draftArticles;
const publishRatio = contentTotal > 0 ? Math.round((publishedArticles / contentTotal) * 100) : 0;
const memoryPercent = Math.round(numberValue(live.memory?.usage_percentage, live.memory?.percentage));
const cacheRatio = Math.round(numberValue(cache.hit_ratio));
const avgResponse = numberValue(response.average_ms);
const platformHealthy = summaryResult.ok && (!canMonitor || (liveResult.ok && cacheResult.ok && responseResult.ok));

const kpis = [
	{ label: 'إجمالي المقالات', value: totals.articles, note: `${formatNumber(publishedArticles)} مقال منشور`, href: '/dashboard/articles', icon: 'article', tone: 'blue', trend: trends.articles, permission: 'manage articles' },
	{ label: 'المنشورات', value: totals.news, note: 'الأخبار والمحتوى العام', href: '/dashboard/posts', icon: 'post', tone: 'violet', trend: trends.news, permission: 'manage posts' },
	{ label: 'المستخدمون', value: numberValue(totals.users, userStats.total), note: `${formatNumber(userStats.new_today)} تسجيل جديد اليوم`, href: '/dashboard/users', icon: 'users', tone: 'orange', trend: trends.users, permission: 'manage users' },
	{ label: 'النشطون الآن', value: numberValue(visitorStats.current, totals.online_users), note: `${formatNumber(visitorStats.current_members)} عضو · ${formatNumber(visitorStats.current_guests)} زائر`, href: '/dashboard/users', icon: 'dashboard', tone: 'green', trend: { percentage: visitorStats.change, trend: numberValue(visitorStats.change) < 0 ? 'down' : 'up' }, permission: 'manage users' },
].filter((item) => isAdmin(user) || hasPermission(user, item.permission));

const healthCards = [
	{ label: 'زمن الاستجابة', value: canMonitor && responseResult.ok ? `${formatNumber(avgResponse)} ms` : 'غير متاح', note: avgResponse <= 150 ? 'استجابة ممتازة' : avgResponse <= 500 ? 'استجابة مقبولة' : 'تحتاج إلى متابعة', pct: Math.min(100, (avgResponse / 1000) * 100), tone: avgResponse > 500 ? 'red' : avgResponse > 150 ? 'orange' : 'green', icon: 'dashboard', href: '/dashboard/redis' },
	{ label: 'ذاكرة التطبيق', value: canMonitor && liveResult.ok ? `${formatNumber(memoryPercent)}%` : 'غير متاح', note: canMonitor && liveResult.ok ? `${formatBytes(live.memory?.used)} مستخدم` : 'صلاحية المراقبة مطلوبة', pct: memoryPercent, tone: memoryPercent > 85 ? 'red' : memoryPercent > 65 ? 'orange' : 'blue', icon: 'files', href: '/dashboard/security' },
	{ label: 'كفاءة Redis', value: canMonitor && cacheResult.ok ? `${formatNumber(cacheRatio)}%` : 'غير متاح', note: canMonitor && cacheResult.ok ? `${cache.cache_size || '0 B'} حجم الكاش` : 'صلاحية المراقبة مطلوبة', pct: cacheRatio, tone: cacheRatio >= 70 ? 'green' : cacheRatio > 0 ? 'orange' : 'dark', icon: 'database', href: '/dashboard/redis' },
	{ label: 'تنبيهات الأمن', value: canSecurity && securityOverviewResult.ok ? formatNumber(securityOverview.last_24h_events) : 'غير متاح', note: canSecurity ? `${formatNumber(securityStats.blocked_ips)} عنوان محظور` : 'صلاحية الأمن مطلوبة', pct: Math.min(100, numberValue(securityOverview.last_24h_events)), tone: numberValue(securityStats.critical_logs) > 0 ? 'red' : 'green', icon: 'security', href: '/dashboard/security' },
];

const topItems = [
	...((Array.isArray(content.top_articles) ? content.top_articles : []).map((item: any) => ({ id: item.id, title: item.title || 'مقال بدون عنوان', type: 'مقال', views: numberValue(item.visit_count, item.views), href: `/dashboard/articles/${item.id}/edit` }))),
	...((Array.isArray(content.top_posts) ? content.top_posts : []).map((item: any) => ({ id: item.id, title: item.title || 'منشور بدون عنوان', type: 'منشور', views: numberValue(item.views, item.visit_count), href: `/dashboard/posts/${item.id}/edit` }))),
].sort((a, b) => b.views - a.views).slice(0, 5);

const quickActions = [
	{ label: 'إضافة مقال', note: 'محتوى تعليمي جديد', href: '/dashboard/articles/new', icon: 'article', tone: 'blue', permission: 'manage articles' },
	{ label: 'إضافة منشور', note: 'خبر أو إعلان عام', href: '/dashboard/posts/new', icon: 'post', tone: 'green', permission: 'manage posts' },
	{ label: 'تدقيق المحتوى', note: 'الجودة وجاهزية AdSense', href: '/dashboard/content-audit', icon: 'audit', tone: 'orange', permission: 'manage content audit' },
	{ label: 'إدارة الملفات', note: 'المرفقات والتنزيلات', href: '/dashboard/files', icon: 'files', tone: 'violet', permission: 'manage files' },
	{ label: 'مركز الأمان', note: 'التنبيهات والعناوين', href: '/dashboard/security', icon: 'security', tone: 'red', permission: 'manage security' },
	{ label: 'إعدادات المنصة', note: 'البريد والتكاملات', href: '/dashboard/settings', icon: 'settings', tone: 'dark', permission: 'manage settings' },
].filter((item) => isAdmin(user) || hasPermission(user, item.permission));

const activityIcon = (type: unknown) => String(type || '').toLowerCase().includes('comment') ? 'comments' : String(type || '').toLowerCase().includes('news') ? 'post' : 'article';
---

<DashboardLayout title="لوحة القيادة" description="مركز إدارة المنصة ومؤشرات الأداء" user={user}>
	<div class="dashboard-home">
		<DashboardAlert />
		{!summaryResult.ok && <div class="dashboard-alert" role="alert"><i>!</i><div><strong>تعذّر جلب جزء من بيانات لوحة القيادة</strong><span>{summaryResult.message || 'تحقق من اتصال الباك إند ثم أعد تحديث الصفحة.'}</span></div><button type="button" onclick="window.location.reload()">إعادة المحاولة</button></div>}

		<header class="dashboard-hero">
			<div class="hero-copy">
				<div class="hero-badges"><span><svg viewBox="0 0 24 24"><path d="M4 19V9m5 10V5m6 14v-7m5 7V3"/></svg>مركز إدارة المنصة</span><b class:list={{ online: platformHealthy }}><i></i>{platformHealthy ? 'الأنظمة تعمل بصورة طبيعية' : 'بعض المؤشرات غير متاحة'}</b></div>
				<h1>لوحة القيادة</h1>
				<p>صورة تنفيذية مباشرة لنشاط منصة {currentCountry.name}، تجمع المحتوى والزوار والأداء والتنبيهات في مكان واحد.</p>
			</div>
			<div class="hero-actions">
				<div class="country-control"><span>قاعدة البيانات</span><CountrySwitcher /></div>
				<button type="button" class="refresh-button" onclick="window.location.reload()"><svg viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 9a7 7 0 0 1 12-2l2 2M4 15l2 2a7 7 0 0 0 12-2"/></svg><span>تحديث البيانات</span></button>
				<a href="/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M14 5h5v5m0-5-8 8M19 13v6H5V5h6"/></svg><span>عرض الموقع</span></a>
			</div>
		</header>

		<section class="kpi-grid" aria-label="المؤشرات الرئيسية">
			{kpis.map((item) => <a href={item.href} class={`kpi-card is-${item.tone}`}>
				<header><span>{item.label}</span><i><DashboardNavIcon name={item.icon} class="size-5" /></i></header>
				<div class="kpi-value"><strong>{formatNumber(item.value)}</strong>{trendValue(item.trend) !== 0 && <b class:list={{ down: trendDown(item.trend) }}>{trendDown(item.trend) ? '↓' : '↑'} {formatPercent(trendValue(item.trend))}</b>}</div>
				<footer><span>{item.note}</span><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></footer>
			</a>)}
		</section>

		<section class="health-strip" aria-label="صحة التشغيل">
			{healthCards.map((item) => <a href={item.href} class={`health-card is-${item.tone}`}>
				<i><DashboardNavIcon name={item.icon} class="size-4" /></i>
				<div><span>{item.label}</span><strong>{item.value}</strong><small>{item.note}</small></div>
				<aside><b style={`height:${Math.max(4, Math.min(100, item.pct))}%`}></b></aside>
			</a>)}
		</section>

		<div class="primary-grid">
			<section class="panel activity-chart-panel">
				<header class="panel-heading"><div><span>آخر سبعة أيام</span><h2>نبض المحتوى</h2><p>حركة إنشاء المقالات والمنشورات والتعليقات يومًا بيوم.</p></div><div class="chart-legend"><span><i class="blue"></i>المقالات</span><span><i class="green"></i>المنشورات</span><span><i class="orange"></i>التعليقات</span></div></header>
				<div class="large-chart">
					<svg viewBox="0 0 720 230" role="img" aria-label="نشاط المحتوى خلال سبعة أيام" preserveAspectRatio="none"><defs><linearGradient id="activityArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1A4D8F" stop-opacity=".2"/><stop offset="100%" stop-color="#1A4D8F" stop-opacity="0"/></linearGradient></defs><g class="chart-grid"><line x1="0" x2="720" y1="35" y2="35"/><line x1="0" x2="720" y1="95" y2="95"/><line x1="0" x2="720" y1="155" y2="155"/><line x1="0" x2="720" y1="215" y2="215"/></g><path d={articleArea} fill="url(#activityArea)" stroke="none"/><polyline points={articlePoints} class="article-line"/><polyline points={postPoints} class="post-line"/><polyline points={commentPoints} class="comment-line"/></svg>
					<div class="chart-labels">{Array.from({ length: seriesLength }, (_, index) => <span>{labels[index] || `يوم ${number.format(index + 1)}`}</span>)}</div>
				</div>
				<footer class="chart-totals"><div><i class="blue"></i><span>مقالات الأسبوع</span><strong>{formatNumber(series.articles.reduce((sum, value) => sum + value, 0))}</strong></div><div><i class="green"></i><span>منشورات الأسبوع</span><strong>{formatNumber(series.posts.reduce((sum, value) => sum + value, 0))}</strong></div><div><i class="orange"></i><span>تعليقات الأسبوع</span><strong>{formatNumber(series.comments.reduce((sum, value) => sum + value, 0))}</strong></div></footer>
			</section>

			<aside class="panel live-panel">
				<header class="panel-heading"><div><span>متابعة مباشرة</span><h2>الزوار الآن</h2><p>نشاط المستخدمين خلال الدقائق الأخيرة.</p></div><b class="live-badge"><i></i>مباشر</b></header>
				<div class="live-total"><div class="live-ring"><span><strong>{canMonitor ? formatNumber(visitorStats.current) : '—'}</strong><small>متصل الآن</small></span></div><div class="live-breakdown"><div><span>الأعضاء</span><strong>{canMonitor ? formatNumber(visitorStats.current_members) : '—'}</strong></div><div><span>الزوار</span><strong>{canMonitor ? formatNumber(visitorStats.current_guests) : '—'}</strong></div><div><span>زيارات اليوم</span><strong>{canMonitor ? formatNumber(visitorStats.total_combined_today || visitorStats.total_today) : '—'}</strong></div></div></div>
				<div class="visitor-bars" aria-label="زيارات الأيام الأخيرة">{visitorChart.length ? visitorChart.map((item) => { const views = numberValue(item.pageViews, item.views, item.visits); return <div title={`${formatNumber(views)} مشاهدة`}><b style={`height:${Math.max(7, (views / visitorMax) * 100)}%`}></b><span>{String(item.name || '').slice(0, 3) || '—'}</span></div>; }) : Array.from({ length: 7 }, () => <div><b style="height:7%"></b><span>—</span></div>)}</div>
				{onlineUsers.length > 0 && <div class="online-users"><span>متصلون مؤخرًا</span><div>{onlineUsers.slice(0, 5).map((online: any) => <a href={`/dashboard/users?view=${online.id}`} title={online.name || 'مستخدم'}>{String(online.name || 'م').trim().slice(0, 1)}</a>)}{onlineUsers.length > 5 && <b>+{number.format(onlineUsers.length - 5)}</b>}</div></div>}
				<a class="panel-link" href="/dashboard/users"><span>عرض المستخدمين</span><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></a>
			</aside>
		</div>

		<div class="insights-grid">
			<section class="panel content-health">
				<header class="panel-heading"><div><span>جاهزية النشر</span><h2>حالة المحتوى</h2><p>نسبة المقالات المنشورة إلى المسودات.</p></div><a href="/dashboard/content-audit">فتح التدقيق</a></header>
				<div class="content-health-body"><div class="content-donut" style={`--publish:${publishRatio * 3.6}deg`}><span><strong>{formatNumber(publishRatio)}%</strong><small>منشور</small></span></div><div class="content-counts"><div><i class="published"></i><span>المقالات المنشورة</span><strong>{formatNumber(publishedArticles)}</strong></div><div><i class="draft"></i><span>المسودات</span><strong>{formatNumber(draftArticles)}</strong></div><div><i class="total"></i><span>إجمالي المحتوى</span><strong>{formatNumber(contentTotal)}</strong></div></div></div>
				<footer><span>{publishRatio >= 80 ? 'نسبة النشر جيدة، حافظ على مراجعة الجودة.' : 'توجد مسودات تحتاج إلى مراجعة واستكمال.'}</span><b class:list={{ good: publishRatio >= 80 }}>{publishRatio >= 80 ? 'مستقر' : 'يحتاج متابعة'}</b></footer>
			</section>

			<section class="panel top-content">
				<header class="panel-heading"><div><span>الأكثر مشاهدة</span><h2>أفضل المحتوى أداءً</h2><p>ترتيب موحد للمقالات والمنشورات.</p></div><a href="/dashboard/articles">عرض الكل</a></header>
				{topItems.length ? <div class="rank-list">{topItems.map((item, index) => <a href={item.href}><b class:list={{ top: index < 3 }}>{number.format(index + 1)}</b><div><strong>{item.title}</strong><span>{item.type}</span></div><aside><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>{formatNumber(item.views)}</aside></a>)}</div> : <div class="empty-block"><i><DashboardNavIcon name="article" class="size-5" /></i><strong>لا توجد بيانات مشاهدة كافية</strong><span>ستظهر العناصر الأعلى أداءً بعد تسجيل الزيارات.</span></div>}
			</section>

			<section class="panel recent-activity">
				<header class="panel-heading"><div><span>سجل العمليات</span><h2>أحدث النشاطات</h2><p>آخر تغييرات نفذها فريق الإدارة.</p></div><a href="/dashboard/security">المراقبة</a></header>
				{recentActivities.length ? <div class="activity-list">{recentActivities.slice(0, 6).map((activity: any) => <article><i><DashboardNavIcon name={activityIcon(activity.type)} class="size-4" /></i><div><strong>{activity.title || activity.description || 'نشاط جديد'}</strong><span>{activity.user?.name || 'النظام'} · {formatDateTime(activity.created_at)}</span></div></article>)}</div> : <div class="empty-block"><i><DashboardNavIcon name="dashboard" class="size-5" /></i><strong>لا توجد نشاطات حديثة</strong><span>ستظهر عمليات الإدارة الجديدة في هذا السجل.</span></div>}
			</section>
		</div>

		<div class="operations-grid">
			<section class="panel security-summary">
				<header class="panel-heading"><div><span>آخر 24 ساعة</span><h2>ملخص الأمان</h2><p>الأحداث الحرجة والعناوين المحظورة.</p></div><i class:list={['security-state', numberValue(securityStats.critical_logs) === 0 && 'safe']}><svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d={numberValue(securityStats.critical_logs) === 0 ? 'm9 12 2 2 4-5' : 'M12 8v5m0 3h.01'}/></svg></i></header>
				{canSecurity ? <><div class="security-metrics"><div><span>أحداث اليوم</span><strong>{formatNumber(securityOverview.last_24h_events)}</strong></div><div><span>حرجة</span><strong class="danger">{formatNumber(securityStats.critical_logs)}</strong></div><div><span>محظورة</span><strong>{formatNumber(securityStats.blocked_ips)}</strong></div></div><div class="security-note"><i></i><span>{numberValue(securityStats.critical_logs) > 0 ? 'توجد سجلات حرجة تحتاج إلى المراجعة الآن.' : 'لا توجد تنبيهات حرجة مفتوحة في القراءة الحالية.'}</span></div></> : <div class="locked-block"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span>بيانات الأمان تحتاج صلاحية إدارة الأمن.</span></div>}
				<a class="panel-link" href="/dashboard/security"><span>فتح مركز الأمان</span><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></a>
			</section>

			<section class="panel teacher-summary">
