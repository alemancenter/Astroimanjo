		.redis-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem;margin:.8rem 0}.redis-tabs>a{display:grid;min-height:4.1rem;grid-template-columns:auto 1fr auto;align-items:center;gap:.65rem;border:1px solid var(--rd-line);border-radius:.78rem;background:#fff;padding:.7rem .8rem;color:#6b798b;box-shadow:0 2px 7px rgb(23 43 77/.03);position:relative}.redis-tabs>a::after{position:absolute;right:.7rem;bottom:-1px;left:.7rem;height:.18rem;border-radius:.2rem .2rem 0 0;background:transparent;content:""}.redis-tabs>a>svg{width:1.15rem;height:1.15rem}.redis-tabs>a>span{display:grid;color:#394d65;font-size:.82rem;font-weight:900}.redis-tabs>a small{margin-top:.05rem;color:#8a96a6;font-size:.64rem;font-weight:600}.redis-tabs>a>b{border-radius:99rem;background:#eef2f6;padding:.2rem .38rem;font-size:.61rem}.redis-tabs>a.active{border-color:#b7cbe2;background:#f7faff;color:var(--rd-blue)}.redis-tabs>a.active::after{background:var(--rd-blue)}.redis-tabs>a.active>span{color:var(--rd-blue)}
