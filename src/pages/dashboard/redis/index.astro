---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { getCurrentUser, isAdmin } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';

const user = await getCurrentUser(Astro);
if (!user) return Astro.redirect(`/login?redirect_to=${encodeURIComponent('/dashboard/redis')}`);
if (!isAdmin(user)) return Astro.redirect('/dashboard?error=forbidden');

const token = Astro.cookies.get('token')?.value;
const search = Astro.url.searchParams;
const allowedTabs = ['overview', 'keys', 'maintenance', 'diagnostics'];
const tab = allowedTabs.includes(search.get('tab') || '') ? String(search.get('tab')) : 'overview';
const q = (search.get('q') || '').trim();
const ttlFilter = ['all', 'persistent', 'volatile'].includes(search.get('ttl_filter') || '') ? String(search.get('ttl_filter')) : 'all';
const page = Math.max(1, Number.parseInt(search.get('page') || '1', 10) || 1);
const pattern = q ? (q.includes('*') ? q : `*${q}*`) : '*';
const cookieHeader = `token=${token}`;

const [infoResult, testResult, keysResult] = await Promise.all([
	apiFetch<any>('/dashboard/redis/info', { countryId: Astro.locals.countryId, cookieHeader }),
	apiFetch<Record<string, boolean>>('/dashboard/redis/test', { countryId: Astro.locals.countryId, cookieHeader }),
	apiFetch<any>('/dashboard/redis/keys', { countryId: Astro.locals.countryId, cookieHeader, params: { pattern, ttl_filter: ttlFilter, page, per_page: 25 } }),
]);

const rawInfo = String(infoResult.data?.info || '');
const info: Record<string, string> = {};
const infoSections: Record<string, Array<[string, string]>> = {};
let currentSection = 'General';
for (const rawLine of rawInfo.split(/\r?\n/)) {
	const line = rawLine.trim();
	if (!line) continue;
	if (line.startsWith('#')) {
		currentSection = line.replace(/^#\s*/, '') || 'General';
		infoSections[currentSection] ||= [];
		continue;
	}
	const separator = line.indexOf(':');
	if (separator < 1) continue;
	const key = line.slice(0, separator);
	const value = line.slice(separator + 1);
	info[key] = value;
	(infoSections[currentSection] ||= []).push([key, value]);
}

const keyPayload: any = keysResult.data || {};
const keys: any[] = Array.isArray(keyPayload.data) ? keyPayload.data : (Array.isArray(keysResult.data) ? keysResult.data : []);
const currentPage = Number(keyPayload.current_page || page);
const hasMore = Boolean(keyPayload.has_more);
const shownFrom = Number(keyPayload.from || (keys.length ? ((currentPage - 1) * 25) + 1 : 0));
const shownTo = Number(keyPayload.to || ((currentPage - 1) * 25) + keys.length);
const persistentCount = keys.filter((key) => key.is_persistent).length;
const volatileCount = keys.length - persistentCount;
const sampledMemory = keys.reduce((total, key) => total + Number(key.memory_usage_bytes || 0), 0);
const health = testResult.data || {};
const healthEntries = Object.entries(health);
const healthyNodes = healthEntries.filter(([, ok]) => ok).length;
const serverHealthy = infoResult.ok && testResult.ok && (healthEntries.length === 0 || healthyNodes === healthEntries.length);

const number = new Intl.NumberFormat('ar-EG');
const decimal = new Intl.NumberFormat('ar-EG', { maximumFractionDigits: 1 });
const toNumber = (value?: string) => Number.parseFloat(value || '0') || 0;
const usedMemory = toNumber(info.used_memory);
const maxMemory = toNumber(info.maxmemory);
const memoryPercent = maxMemory > 0 ? Math.min(100, Math.round((usedMemory / maxMemory) * 100)) : 0;
const hits = toNumber(info.keyspace_hits);
const misses = toNumber(info.keyspace_misses);
const hitRate = hits + misses > 0 ? Math.round((hits / (hits + misses)) * 100) : 0;
const formatBytes = (bytes: number) => {
	if (!bytes) return '0 بايت';
	if (bytes < 1024) return `${number.format(bytes)} بايت`;
	if (bytes < 1024 ** 2) return `${decimal.format(bytes / 1024)} كيلوبايت`;
	if (bytes < 1024 ** 3) return `${decimal.format(bytes / 1024 ** 2)} ميجابايت`;
	return `${decimal.format(bytes / 1024 ** 3)} جيجابايت`;
};
const tabHref = (nextTab: string) => {
	const params = new URLSearchParams();
	params.set('tab', nextTab);
	if (nextTab === 'keys') {
		if (q) params.set('q', q);
		if (ttlFilter !== 'all') params.set('ttl_filter', ttlFilter);
	}
	return `/dashboard/redis?${params}`;
};
const pageHref = (nextPage: number) => {
	const params = new URLSearchParams(Astro.url.searchParams);
	params.set('tab', 'keys');
	params.set('page', String(nextPage));
	params.delete('success'); params.delete('error');
	return `/dashboard/redis?${params}`;
};
const redirectTo = `${Astro.url.pathname}${Astro.url.search}`;
const success = search.get('success');
const error = search.get('error');
const sectionLabels: Record<string, string> = { Server: 'الخادم', Clients: 'العملاء', Memory: 'الذاكرة', Persistence: 'الاستمرارية', Stats: 'الإحصائيات', Replication: 'النسخ', CPU: 'المعالج', Keyspace: 'مساحات المفاتيح', General: 'عام' };
const healthLabels: Record<string, string> = { default: 'قاعدة البيانات الرئيسية', cache: 'ذاكرة التخزين المؤقت', queue: 'طابور المهام' };
const typeLabels: Record<string, string> = { string: 'نصي', hash: 'Hash', list: 'قائمة', set: 'مجموعة', zset: 'مجموعة مرتبة', stream: 'تدفق' };
---

<DashboardLayout title="إدارة Redis" user={user}>
	<div class="redis-page">
		{error && <div class="redis-alert is-error" role="alert"><i>!</i><div><strong>تعذّر تنفيذ العملية</strong><span>{error}</span></div><a href={tabHref(tab)} aria-label="إغلاق">×</a></div>}
		{success && <div class="redis-alert is-success" role="status"><i><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></i><div><strong>تمت العملية بنجاح</strong><span>{success}</span></div><a href={tabHref(tab)} aria-label="إغلاق">×</a></div>}

		<header class="redis-hero">
			<div class="hero-copy">
				<span class="eyebrow"><svg viewBox="0 0 24 24"><path d="M4 6c0-2 3.6-3 8-3s8 1 8 3-3.6 3-8 3-8-1-8-3Z"/><path d="M4 6v6c0 2 3.6 3 8 3s8-1 8-3V6M4 12v6c0 2 3.6 3 8 3s8-1 8-3v-6"/></svg>البنية التحتية وذاكرة التخزين</span>
				<h1>مركز إدارة Redis</h1>
				<p>راقب أداء الخادم، افحص المفاتيح ومدد صلاحيتها، ونفّذ أعمال الصيانة الحساسة من مساحة واحدة آمنة.</p>
			</div>
			<div class:list={['connection-state', serverHealthy && 'is-online']}>
				<span class="pulse"><i></i></span>
				<div><small>حالة الاتصال</small><strong>{serverHealthy ? 'متصل ويعمل بكفاءة' : 'يحتاج إلى فحص'}</strong><span>{healthyNodes || 0} من {healthEntries.length || 3} قنوات متاحة</span></div>
				<a href="/dashboard/redis?tab=diagnostics" aria-label="فتح التشخيص"><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></a>
			</div>
		</header>

		<nav class="redis-tabs" role="tablist" aria-label="أقسام إدارة Redis">
			<a href={tabHref('overview')} role="tab" aria-selected={tab === 'overview'} class:list={{ active: tab === 'overview' }}><svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg><span>نظرة عامة<small>الحالة والأداء</small></span></a>
			<a href={tabHref('keys')} role="tab" aria-selected={tab === 'keys'} class:list={{ active: tab === 'keys' }}><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-3 3 3 3m-6 0 2 2"/></svg><span>المفاتيح<small>البحث والإدارة</small></span><b>{number.format(keys.length)}</b></a>
			<a href={tabHref('maintenance')} role="tab" aria-selected={tab === 'maintenance'} class:list={{ active: tab === 'maintenance' }}><svg viewBox="0 0 24 24"><path d="m14 6 4-4 4 4-4 4M3 14a7 7 0 0 0 12 5M10 18l-4 4-4-4 4-4M21 10A7 7 0 0 0 9 5"/></svg><span>الصيانة<small>التنظيف وTTL</small></span></a>
			<a href={tabHref('diagnostics')} role="tab" aria-selected={tab === 'diagnostics'} class:list={{ active: tab === 'diagnostics' }}><svg viewBox="0 0 24 24"><path d="M4 19V9m5 10V5m6 14v-7m5 7V3"/></svg><span>التشخيص<small>تفاصيل الخادم</small></span></a>
		</nav>

		{tab === 'overview' && <div class="tab-panel overview-panel" role="tabpanel">
			<section class="metric-grid">
				<article><i class="blue"><svg viewBox="0 0 24 24"><path d="M4 6c0-2 3.6-3 8-3s8 1 8 3-3.6 3-8 3-8-1-8-3Z"/><path d="M4 6v6c0 2 3.6 3 8 3s8-1 8-3V6"/></svg></i><div><span>الذاكرة المستخدمة</span><strong>{info.used_memory_human || formatBytes(usedMemory)}</strong><small>{maxMemory ? `${memoryPercent}% من الحد المتاح` : 'لا يوجد حد أقصى مقيّد'}</small></div></article>
				<article><i class="green"><svg viewBox="0 0 24 24"><path d="m4 14 5-5 4 4 7-8"/><path d="M15 5h5v5"/></svg></i><div><span>نسبة إصابة الكاش</span><strong>{number.format(hitRate)}%</strong><small>{number.format(hits)} إصابة مقابل {number.format(misses)} فقد</small></div></article>
				<article><i class="orange"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8M21 21v-2a4 4 0 0 0-3-3.87M17 3.13a4 4 0 0 1 0 7.75"/></svg></i><div><span>العملاء المتصلون</span><strong>{number.format(toNumber(info.connected_clients))}</strong><small>{number.format(toNumber(info.blocked_clients))} اتصالات محجوبة</small></div></article>
				<article><i class="dark"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i><div><span>مدة التشغيل</span><strong>{number.format(toNumber(info.uptime_in_days))} يوم</strong><small>الإصدار {info.redis_version || 'غير معروف'}</small></div></article>
			</section>

			<div class="overview-grid">
				<section class="panel performance-card">
					<header class="panel-heading"><div><span>مؤشرات لحظية</span><h2>صحة الأداء</h2><p>قراءة مختصرة لأهم مؤشرات Redis الحالية.</p></div><i class:list={['status-badge', serverHealthy && 'ok']}>{serverHealthy ? 'مستقر' : 'تنبيه'}</i></header>
					<div class="performance-body">
						<div class="memory-ring" style={`--value:${memoryPercent || Math.min(92, Math.max(8, Math.round(usedMemory / 1024 / 1024)))}`}><div><strong>{maxMemory ? `${number.format(memoryPercent)}%` : (info.used_memory_human || '—')}</strong><span>{maxMemory ? 'استهلاك الذاكرة' : 'استخدام حالي'}</span></div></div>
						<div class="performance-list">
							<div><span><i class="green-dot"></i>العمليات في الثانية</span><strong>{number.format(toNumber(info.instantaneous_ops_per_sec))}</strong></div>
							<div><span><i class="blue-dot"></i>إجمالي الأوامر</span><strong>{number.format(toNumber(info.total_commands_processed))}</strong></div>
							<div><span><i class="orange-dot"></i>المفاتيح المُرحّلة</span><strong>{number.format(toNumber(info.evicted_keys))}</strong></div>
							<div><span><i class="dark-dot"></i>تجزئة الذاكرة</span><strong>{decimal.format(toNumber(info.mem_fragmentation_ratio))}×</strong></div>
						</div>
					</div>
				</section>

				<section class="panel channel-card">
					<header class="panel-heading"><div><span>قنوات الاتصال</span><h2>حالة قواعد Redis</h2><p>فحص مستقل لكل قناة يستخدمها التطبيق.</p></div><a href="/dashboard/redis?tab=diagnostics">التفاصيل</a></header>
					<div class="channel-list">
						{healthEntries.length ? healthEntries.map(([name, ok]) => <article><i class:list={{ online: ok }}><svg viewBox="0 0 24 24"><path d="M5 12.5 9.5 17 19 7"/></svg></i><div><strong>{healthLabels[name] || name}</strong><span>{ok ? 'الاتصال مستقر ويستجيب' : 'لا توجد استجابة من القناة'}</span></div><b class:list={{ online: ok }}>{ok ? 'متصل' : 'متوقف'}</b></article>) : <div class="inline-empty"><strong>لا تتوفر نتيجة فحص الآن</strong><span>افتح تبويب التشخيص لإعادة المحاولة.</span></div>}
					</div>
				</section>

				<section class="panel sample-card">
					<header class="panel-heading"><div><span>عينة المفاتيح الحالية</span><h2>توزيع التخزين</h2><p>الأرقام التالية مبنية على الصفحة الحالية من المفاتيح.</p></div><a href="/dashboard/redis?tab=keys">إدارة المفاتيح</a></header>
					<div class="sample-bars">
						<div><header><span>مفاتيح مؤقتة</span><strong>{number.format(volatileCount)}</strong></header><i><b style={`width:${keys.length ? Math.round((volatileCount / keys.length) * 100) : 0}%`}></b></i></div>
						<div class="persistent"><header><span>مفاتيح دائمة</span><strong>{number.format(persistentCount)}</strong></header><i><b style={`width:${keys.length ? Math.round((persistentCount / keys.length) * 100) : 0}%`}></b></i></div>
					</div>
					<footer><div><span>حجم العينة</span><strong>{number.format(keys.length)} مفتاح</strong></div><div><span>ذاكرة العينة</span><strong>{formatBytes(sampledMemory)}</strong></div></footer>
				</section>

				<section class="panel guidance-card">
					<header><i><svg viewBox="0 0 24 24"><path d="M12 3a7 7 0 0 0-4 12.7V19h8v-3.3A7 7 0 0 0 12 3ZM9 22h6M9 12h6"/></svg></i><div><span>توصيات التشغيل</span><h2>قراءة ذكية للحالة</h2></div></header>
					<ul>
						<li class:list={{ warning: persistentCount > volatileCount && keys.length > 0 }}><i></i><div><strong>{persistentCount > volatileCount && keys.length > 0 ? 'راجع المفاتيح الدائمة' : 'سياسة TTL متوازنة'}</strong><span>{persistentCount > volatileCount && keys.length > 0 ? 'نسبة المفاتيح بلا انتهاء مرتفعة في العينة الحالية.' : 'غالبية مفاتيح العينة لها مدة صلاحية واضحة.'}</span></div></li>
						<li class:list={{ warning: hitRate > 0 && hitRate < 70 }}><i></i><div><strong>{hitRate > 0 && hitRate < 70 ? 'نسبة إصابة منخفضة' : 'أداء الكاش ضمن النطاق الجيد'}</strong><span>{hitRate > 0 && hitRate < 70 ? 'راجع أسماء المفاتيح ومدد التخزين المؤقت.' : 'لا توجد إشارة فورية إلى هدر في طلبات الكاش.'}</span></div></li>
						<li class:list={{ danger: toNumber(info.evicted_keys) > 0 }}><i></i><div><strong>{toNumber(info.evicted_keys) > 0 ? 'رُحّلت مفاتيح بسبب الذاكرة' : 'لا توجد عمليات ترحيل'}</strong><span>{toNumber(info.evicted_keys) > 0 ? 'تحقق من حد الذاكرة وسياسة الإخلاء.' : 'لم يُسجل Redis مفاتيح مُرحّلة في القراءة الحالية.'}</span></div></li>
					</ul>
				</section>
			</div>
		</div>}

		{tab === 'keys' && <div class="tab-panel" role="tabpanel">
			<section class="panel keys-panel">
				<header class="keys-header"><div><span>مستكشف البيانات</span><h2>مفاتيح Redis</h2><p>ابحث بالاسم أو النمط، راقب النوع والحجم، وتحكم في مدة الصلاحية.</p></div><button type="button" class="primary-button" data-open-create><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>إضافة مفتاح</button></header>
				<form method="get" class="keys-filter">
					<input type="hidden" name="tab" value="keys" />
					<label class="search-field"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input name="q" value={q} placeholder="ابحث باسم المفتاح أو استخدم نمطًا مثل cache:*" /></label>
					<label><span>مدة الصلاحية</span><select name="ttl_filter"><option value="all" selected={ttlFilter === 'all'}>جميع المفاتيح</option><option value="volatile" selected={ttlFilter === 'volatile'}>مؤقتة فقط</option><option value="persistent" selected={ttlFilter === 'persistent'}>دائمة فقط</option></select></label>
					<button type="submit">تطبيق الفلترة</button>
					{(q || ttlFilter !== 'all') && <a href="/dashboard/redis?tab=keys">مسح</a>}
				</form>

				<div class="keys-summary"><span><b>{number.format(keys.length)}</b> مفتاحًا في الصفحة</span><span><b>{number.format(persistentCount)}</b> دائم</span><span><b>{number.format(volatileCount)}</b> مؤقت</span><span><b>{formatBytes(sampledMemory)}</b> حجم ظاهر</span></div>
				{keysResult.ok ? <>
					<div class="keys-table-wrap"><table class="keys-table"><thead><tr><th>المفتاح</th><th>النوع</th><th>مدة الصلاحية</th><th>الحجم</th><th>الحالة</th><th><span class="sr-only">الإجراءات</span></th></tr></thead><tbody>
						{keys.map((key) => <tr><td><div class="key-name"><i><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-3 3 3 3"/></svg></i><code dir="ltr" title={key.key}>{key.key}</code></div></td><td><span class={`type-pill is-${key.type}`}>{typeLabels[key.type] || key.type || 'غير معروف'}</span></td><td><strong class:list={['ttl-value', key.is_persistent && 'persistent']}>{key.is_persistent ? 'بلا انتهاء' : (key.ttl_label || `${number.format(Number(key.ttl || 0))} ثانية`)}</strong></td><td>{formatBytes(Number(key.memory_usage_bytes || 0))}</td><td><span class:list={['lifecycle', key.is_persistent ? 'persistent' : 'temporary']}><i></i>{key.is_persistent ? 'دائم' : 'مؤقت'}</span></td><td><div class="row-actions"><button type="button" data-expire-key={key.key} title="تعيين مدة صلاحية"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></button><button type="button" class="delete" data-delete-key={key.key} title="حذف المفتاح"><svg viewBox="0 0 24 24"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg></button></div></td></tr>)}
					</tbody></table></div>
					{keys.length === 0 && <div class="empty-state"><i><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-3 3 3 3"/></svg></i><h3>لا توجد مفاتيح مطابقة</h3><p>غيّر عبارة البحث أو مرشح مدة الصلاحية ثم أعد المحاولة.</p><a href="/dashboard/redis?tab=keys">عرض جميع المفاتيح</a></div>}
					{keys.length > 0 && <footer class="pagination"><span>عرض {number.format(shownFrom)}–{number.format(shownTo)}</span><div><a class:list={{ disabled: currentPage <= 1 }} href={currentPage > 1 ? pageHref(currentPage - 1) : '#'} aria-disabled={currentPage <= 1}>السابق</a><b>صفحة {number.format(currentPage)}</b><a class:list={{ disabled: !hasMore }} href={hasMore ? pageHref(currentPage + 1) : '#'} aria-disabled={!hasMore}>التالي</a></div></footer>}
				</> : <div class="empty-state is-error"><i>!</i><h3>تعذّر تحميل مفاتيح Redis</h3><p>{keysResult.message}</p><a href="/dashboard/redis?tab=keys">إعادة المحاولة</a></div>}
			</section>
		</div>}

		{tab === 'maintenance' && <div class="tab-panel maintenance-panel" role="tabpanel">
			<section class="maintenance-intro"><div><span>عمليات محكومة</span><h2>صيانة دورة حياة المفاتيح</h2><p>أدوات مخصصة لعلاج المفاتيح القديمة وتقليل تراكم البيانات دون تشغيل أوامر عامة خطرة.</p></div><aside><svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d="m9 12 2 2 4-5"/></svg><strong>نطاق آمن</strong><span>كل عملية أدناه تستهدف نمطًا محددًا في الباك إند.</span></aside></section>
			<div class="maintenance-grid">
				<article class="maintenance-card recommended"><header><i><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i><span>موصى به</span></header><h3>تعيين TTL للمفاتيح القديمة</h3><p>يضيف مدة صلاحية لمفاتيح Laravel القديمة الخاصة بموقع IP بدل بقائها في الذاكرة دائمًا.</p><dl><div><dt>النمط المستهدف</dt><dd dir="ltr">*_cache_ip_location_*</dd></div><div><dt>المدة الافتراضية</dt><dd>7 أيام</dd></div></dl><form method="post" action="/api/dashboard/redis/maintenance/expire-legacy"><input type="hidden" name="redirect_to" value="/dashboard/redis?tab=maintenance"/><label><span>مدة الصلاحية الجديدة</span><select name="ttl"><option value="86400">يوم واحد</option><option value="604800" selected>7 أيام</option><option value="2592000">30 يومًا</option></select></label><button type="submit"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>تطبيق مدة الصلاحية</button></form></article>
