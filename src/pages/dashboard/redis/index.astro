		</div>}

		{tab === 'diagnostics' && <div class="tab-panel diagnostics-panel" role="tabpanel">
			<section class="diagnostic-status panel"><header><div><span>اختبار الاتصال</span><h2>حالة البنية الفعلية</h2><p>نتيجة Ping منفصلة لكل قاعدة مستخدمة داخل التطبيق.</p></div><a href="/dashboard/redis?tab=diagnostics"><svg viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 9a7 7 0 0 1 12-2l2 2M4 15l2 2a7 7 0 0 0 12-2"/></svg>إعادة الفحص</a></header><div>{healthEntries.length ? healthEntries.map(([name, ok]) => <article class:list={{ ok }}><i><svg viewBox="0 0 24 24"><path d={ok ? 'm5 12 4 4L19 6' : 'M12 8v5m0 3h.01'}/></svg></i><div><strong>{healthLabels[name] || name}</strong><span>{ok ? 'تستجيب بصورة طبيعية' : 'تعذّر الوصول إليها'}</span></div><b>{ok ? 'Online' : 'Offline'}</b></article>) : <div class="inline-empty"><strong>لم تصل بيانات الفحص</strong><span>{testResult.message || 'تحقق من تشغيل Redis واتصال الباك إند.'}</span></div>}</div></section>
			<section class="server-facts">
				<article><span>إصدار Redis</span><strong>{info.redis_version || '—'}</strong><small>{info.redis_mode || 'standalone'}</small></article><article><span>نظام التشغيل</span><strong>{info.os?.split(' ')?.[0] || '—'}</strong><small dir="ltr">{info.arch_bits ? `${info.arch_bits}-bit` : '—'}</small></article><article><span>المنفذ</span><strong>{info.tcp_port || '—'}</strong><small>اتصال TCP</small></article><article><span>معرّف العملية</span><strong>{info.process_id || '—'}</strong><small>PID الحالي</small></article>
			</section>
			<section class="info-sections panel"><header><div><span>بيانات الخادم</span><h2>التشخيص التفصيلي</h2><p>قيم تقنية مباشرة من أمر INFO، منظمة حسب القسم.</p></div><span class="read-only"><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM8 8h8m-8 4h8m-8 4h5"/></svg>للقراءة فقط</span></header>{infoResult.ok ? <div class="info-grid">{Object.entries(infoSections).filter(([, rows]) => rows.length).map(([section, rows]) => <details><summary><span>{sectionLabels[section] || section}</span><b>{number.format(rows.length)} قيمة</b><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></summary><dl>{rows.map(([key, value]) => <div><dt dir="ltr">{key}</dt><dd dir="ltr" title={value}>{value}</dd></div>)}</dl></details>)}</div> : <div class="empty-state is-error"><i>!</i><h3>تعذّر قراءة معلومات الخادم</h3><p>{infoResult.message}</p></div>}</section>
		</div>}
	</div>

	<dialog id="create-key-dialog" class="redis-dialog"><form method="post" action="/api/dashboard/redis/keys/set"><button type="button" class="dialog-close" data-close-dialog aria-label="إغلاق">×</button><header><i class="blue"><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-3 3 3 3"/></svg></i><div><span>مفتاح جديد</span><h2>إضافة قيمة إلى Redis</h2><p>يُطبق TTL لمدة ساعة افتراضيًا لحماية الذاكرة.</p></div></header><input type="hidden" name="redirect_to" value={redirectTo}/><label><span>اسم المفتاح</span><input name="key" required dir="ltr" placeholder="app:cache:example" autocomplete="off"/></label><label><span>القيمة</span><textarea name="value" required dir="ltr" rows="4" placeholder='{"status":"active"}'></textarea></label><div class="dialog-fields"><label><span>مدة الصلاحية</span><select name="ttl" data-create-ttl><option value="300">5 دقائق</option><option value="3600" selected>ساعة</option><option value="86400">يوم</option><option value="604800">7 أيام</option><option value="2592000">30 يومًا</option></select></label><label class="persist-option"><input type="checkbox" name="persist" value="1" data-persist-toggle/><span><strong>مفتاح دائم</strong><small>بدون تاريخ انتهاء</small></span></label></div><aside><svg viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10 3h4l8 18H2Z"/></svg><span>لا تستخدم المفتاح الدائم إلا للبيانات التي يجب أن تبقى فعلًا؛ فهو يحتاج حذفًا يدويًا.</span></aside><footer><button type="button" data-close-dialog>إلغاء</button><button type="submit" class="primary">إنشاء المفتاح</button></footer></form></dialog>

	<dialog id="expire-key-dialog" class="redis-dialog small"><form method="post" data-expire-form><button type="button" class="dialog-close" data-close-dialog aria-label="إغلاق">×</button><header><i class="orange"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i><div><span>دورة الحياة</span><h2>تعيين مدة الصلاحية</h2><p data-expire-name dir="ltr"></p></div></header><input type="hidden" name="redirect_to" value={redirectTo}/><label><span>المدة الجديدة</span><select name="ttl"><option value="300">5 دقائق</option><option value="3600">ساعة</option><option value="86400">يوم</option><option value="604800" selected>7 أيام</option><option value="2592000">30 يومًا</option></select></label><footer><button type="button" data-close-dialog>إلغاء</button><button type="submit" class="primary">حفظ المدة</button></footer></form></dialog>

	<dialog id="redis-confirm-dialog" class="confirm-dialog"><div><button type="button" data-close-confirm aria-label="إغلاق">×</button><i data-confirm-icon><svg viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10 3h4l8 18H2Z"/></svg></i><span>تأكيد العملية</span><h2 data-confirm-heading>هل تريد المتابعة؟</h2><p data-confirm-copy></p><aside><strong>قبل المتابعة</strong><small>سيتم تنفيذ العملية مباشرة في Redis، راجع النطاق الموضح أعلاه.</small></aside><footer><button type="button" data-close-confirm>إلغاء</button><button type="button" data-confirm-submit>تأكيد التنفيذ</button></footer></div></dialog>

	<form method="post" data-delete-form hidden><input type="hidden" name="redirect_to" value={redirectTo}/></form>

	<script>
		const createDialog = document.getElementById('create-key-dialog') as HTMLDialogElement | null;
		const expireDialog = document.getElementById('expire-key-dialog') as HTMLDialogElement | null;
		const confirmDialog = document.getElementById('redis-confirm-dialog') as HTMLDialogElement | null;
		let pendingForm: HTMLFormElement | null = null;
		const openConfirm = (form: HTMLFormElement, title: string, message: string, danger = false) => {
			pendingForm = form;
			const heading = confirmDialog?.querySelector<HTMLElement>('[data-confirm-heading]');
			const copy = confirmDialog?.querySelector<HTMLElement>('[data-confirm-copy]');
			if (heading) heading.textContent = title;
			if (copy) copy.textContent = message;
			confirmDialog?.classList.toggle('is-danger', danger);
			confirmDialog?.showModal();
		};
		document.querySelector<HTMLButtonElement>('[data-open-create]')?.addEventListener('click', () => createDialog?.showModal());
		document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => button.addEventListener('click', () => (button.closest('dialog') as HTMLDialogElement | null)?.close()));
		document.querySelector<HTMLInputElement>('[data-persist-toggle]')?.addEventListener('change', (event) => { const ttl = document.querySelector<HTMLSelectElement>('[data-create-ttl]'); if (ttl) ttl.disabled = (event.currentTarget as HTMLInputElement).checked; });
		document.querySelectorAll<HTMLButtonElement>('[data-expire-key]').forEach((button) => button.addEventListener('click', () => {
			const key = button.dataset.expireKey || '';
			const form = expireDialog?.querySelector<HTMLFormElement>('[data-expire-form]');
			const name = expireDialog?.querySelector<HTMLElement>('[data-expire-name]');
			if (form) form.action = `/api/dashboard/redis/${encodeURIComponent(key)}/expire`;
			if (name) name.textContent = key;
			expireDialog?.showModal();
		}));
		document.querySelectorAll<HTMLButtonElement>('[data-delete-key]').forEach((button) => button.addEventListener('click', () => {
			const key = button.dataset.deleteKey || '';
			const form = document.querySelector<HTMLFormElement>('[data-delete-form]');
			if (!form) return;
			form.action = `/api/dashboard/redis/${encodeURIComponent(key)}/delete`;
			openConfirm(form, 'حذف مفتاح Redis؟', `سيتم حذف المفتاح “${key}” نهائيًا من Redis.`, true);
		}));
		document.querySelectorAll<HTMLFormElement>('[data-confirm-action]').forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); openConfirm(form, form.dataset.confirmTitle || 'تأكيد العملية', form.dataset.confirmMessage || 'هل تريد تنفيذ هذه العملية؟', form.dataset.confirmDanger === '1'); }));
		document.querySelectorAll<HTMLButtonElement>('[data-close-confirm]').forEach((button) => button.addEventListener('click', () => { pendingForm = null; confirmDialog?.close(); }));
		confirmDialog?.querySelector<HTMLButtonElement>('[data-confirm-submit]')?.addEventListener('click', () => { const form = pendingForm; pendingForm = null; confirmDialog?.close(); form?.submit(); });
		[createDialog, expireDialog, confirmDialog].forEach((dialog) => dialog?.addEventListener('click', (event) => { if (event.target === dialog) { pendingForm = null; dialog.close(); } }));
	</script>

