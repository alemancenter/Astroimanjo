---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DashboardAlert from '../../../components/ui/DashboardAlert.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetchList } from '../../../lib/api';

const guard = await requireDashboard(Astro, 'manage roles');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;

const token = Astro.cookies.get('token')?.value;
const authOptions = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };
const [rolesResult, permissionsResult] = await Promise.all([
	apiFetchList<any>('/dashboard/roles', authOptions),
	apiFetchList<any>('/dashboard/permissions', authOptions),
]);

const roles = rolesResult.items;
const permissions = permissionsResult.items;
const search = (Astro.url.searchParams.get('search') || '').trim();
const filteredRoles = search
	? roles.filter((role: any) => String(role.name || '').toLocaleLowerCase().includes(search.toLocaleLowerCase()))
	: roles;
const isSuperAdmin = user.roles?.some((role: any) => role.name === 'Super Admin') ?? false;
const protectedRoles = new Set(['Super Admin', 'Admin']);
const usedPermissionIds = new Set(roles.flatMap((role: any) => (role.permissions ?? []).map((permission: any) => Number(permission.id))));
const totalAssignments = roles.reduce((sum: number, role: any) => sum + (role.permissions?.length ?? 0), 0);
const averagePermissions = roles.length ? Math.round(totalAssignments / roles.length) : 0;
const coverage = permissions.length ? Math.round((usedPermissionIds.size / permissions.length) * 100) : 0;

const categoryLabels: Record<string, string> = {
	users: 'المستخدمون', roles: 'الأدوار', permissions: 'الصلاحيات', articles: 'المقالات', posts: 'المنشورات',
	categories: 'التصنيفات', comments: 'التعليقات', files: 'الملفات', settings: 'الإعدادات', dashboard: 'لوحة التحكم',
	security: 'الأمان', subscriptions: 'الاشتراكات', teachers: 'المعلمون', classes: 'الصفوف', subjects: 'المواد',
	lessons: 'الدروس', messages: 'الرسائل', notifications: 'الإشعارات', calendar: 'التقويم', other: 'أخرى',
};

function permissionCategory(name: string): string {
	const clean = String(name || '').trim().toLowerCase();
	if (!clean) return 'other';
	if (clean.includes('.')) return clean.split('.')[0];
	const words = clean.split(/\s+/);
	return words[words.length - 1] || 'other';
}

const permissionGroups = [...permissions.reduce((map: Map<string, any[]>, permission: any) => {
	const key = permissionCategory(permission.name);
	const group = map.get(key) ?? [];
	group.push(permission);
	map.set(key, group);
	return map;
}, new Map<string, any[]>()).entries()]
	.map(([key, items]) => ({ key, label: categoryLabels[key] || key, permissions: items.sort((a, b) => a.name.localeCompare(b.name)) }))
	.sort((a, b) => a.label.localeCompare(b.label, 'ar'));

function formatDate(value: unknown): string {
	if (!value) return 'غير متوفر';
	const date = new Date(String(value));
	return Number.isNaN(date.getTime()) ? 'غير متوفر' : date.toLocaleDateString('ar-JO', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<DashboardLayout title="الأدوار والصلاحيات" user={user}>
	<div class="roles-page">
		<DashboardAlert />

		<header class="roles-header">
			<div>
				<span>إدارة الوصول والصلاحيات</span>
				<h1>الأدوار</h1>
				<p>تحكم بمستويات وصول فريق الإدارة واربط كل دور بالصلاحيات اللازمة فقط.</p>
			</div>
			<div class="roles-header-actions">
				<a class="roles-secondary-action" href="/dashboard/permissions"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="15" r="4" /><path d="m11 12 8-8m-3 3 2 2m-5 1 2 2" /></svg>إدارة الصلاحيات</a>
			{isSuperAdmin ? (
				<button class="roles-primary-action" type="button" data-open-role>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
					إضافة دور جديد
				</button>
			) : <span class="roles-readonly"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>عرض فقط</span>}
			</div>
		</header>

		<section class="roles-stats" aria-label="ملخص الأدوار">
			<article><span class="is-blue"><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.7 2.7 8 7 10 4.3-2 7-5.3 7-10V6l-7-3Z" /></svg></span><div><strong>{roles.length.toLocaleString('ar-EG')}</strong><p>أدوار النظام</p><small>{protectedRoles.size} أدوار أساسية</small></div></article>
			<article><span class="is-green"><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4" /><path d="m11 12 8-8m-3 3 2 2m-5 1 2 2" /></svg></span><div><strong>{permissions.length.toLocaleString('ar-EG')}</strong><p>الصلاحيات المتاحة</p><small>{usedPermissionIds.size.toLocaleString('ar-EG')} مستخدمة حاليًا</small></div></article>
			<article><span class="is-orange"><svg viewBox="0 0 24 24"><path d="M4 19V9m6 10V5m6 14v-7m4 7H2" /></svg></span><div><strong>{averagePermissions.toLocaleString('ar-EG')}</strong><p>متوسط الصلاحيات</p><small>لكل دور</small></div></article>
			<article><span class="is-graphite"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span><div><strong>{coverage.toLocaleString('ar-EG')}%</strong><p>تغطية الصلاحيات</p><small>{permissions.length - usedPermissionIds.size} غير مرتبطة</small></div></article>
		</section>

		{!isSuperAdmin && <div class="roles-security-note"><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.7 2.7 8 7 10 4.3-2 7-5.3 7-10V6l-7-3Z" /><path d="m9.5 12 1.7 1.7 3.5-4" /></svg><div><strong>صلاحيات العرض متاحة</strong><p>إنشاء الأدوار أو تعديلها أو حذفها يتطلب حساب Super Admin ويُتحقق منه داخل الباك إند.</p></div></div>}

		<section class="roles-toolbar">
			<form method="get" action="/dashboard/roles" class="roles-search">
				<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
				<input type="search" name="search" value={search} placeholder="ابحث باسم الدور..." aria-label="البحث في الأدوار" />
				<button type="submit">بحث</button>
				{search && <a href="/dashboard/roles">مسح</a>}
			</form>
			<div class="roles-result"><strong>{filteredRoles.length.toLocaleString('ar-EG')}</strong><span>نتيجة من {roles.length.toLocaleString('ar-EG')}</span></div>
		</section>

		{!rolesResult.ok ? (
			<section class="roles-empty is-error"><h2>تعذّر تحميل الأدوار</h2><p>{rolesResult.message}</p><a href="/dashboard/roles">إعادة المحاولة</a></section>
		) : (
			<section class="roles-list-card">
				<div class="roles-list-head"><div><h2>أدوار النظام</h2><p>اضغط على اسم الدور أو زر التفاصيل لمراجعة صلاحياته.</p></div><span>RBAC</span></div>
				<div class="roles-table-wrap">
					<table>
						<thead><tr><th>الدور</th><th>الصلاحيات الممنوحة</th><th>التغطية</th><th>آخر تحديث</th><th><span class="sr-only">الإجراءات</span></th></tr></thead>
						<tbody>
							{filteredRoles.map((role: any) => {
								const rolePermissions = role.permissions ?? [];
								const roleCoverage = permissions.length ? Math.round((rolePermissions.length / permissions.length) * 100) : 0;
								const isProtected = protectedRoles.has(role.name);
								return <tr>
									<td><div class="role-identity"><span class:list={{ 'is-protected': isProtected }}><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.7 2.7 8 7 10 4.3-2 7-5.3 7-10V6l-7-3Z" /></svg></span><div><a href={`/dashboard/roles/${role.id}/edit`}>{role.name}</a><p>المعرف #{role.id} · {role.guard_name || 'api'}</p></div>{isProtected && <em>أساسي</em>}</div></td>
									<td>{rolePermissions.length ? <div class="role-permissions"><strong>{rolePermissions.length} صلاحية</strong>{rolePermissions.slice(0, 4).map((permission: any) => <span dir="ltr">{permission.name}</span>)}{rolePermissions.length > 4 && <i>+{rolePermissions.length - 4}</i>}</div> : <span class="role-no-permissions">دون صلاحيات</span>}</td>
									<td><div class="role-coverage"><div><i style={`width:${roleCoverage}%`}></i></div><span>{roleCoverage}%</span></div></td>
									<td><time datetime={role.updated_at}>{formatDate(role.updated_at || role.created_at)}</time></td>
									<td><div class="role-actions"><a href={`/dashboard/roles/${role.id}/edit`} aria-label={`عرض دور ${role.name}`}><svg viewBox="0 0 24 24"><path d="M4 12s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z" /><circle cx="12" cy="12" r="2" /></svg></a>{isSuperAdmin && !isProtected && <form method="post" action={`/api/dashboard/roles/${role.id}/delete`} data-delete-role={role.name}><button type="submit" aria-label={`حذف دور ${role.name}`}><svg viewBox="0 0 24 24"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 13H7L6 7" /></svg></button></form>}</div></td>
								</tr>;
							})}
						</tbody>
					</table>
				</div>

				<div class="roles-mobile-list">
					{filteredRoles.map((role: any) => { const rolePermissions = role.permissions ?? []; const isProtected = protectedRoles.has(role.name); return <article><div class="role-mobile-head"><span class:list={{ 'is-protected': isProtected }}><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.7 2.7 8 7 10 4.3-2 7-5.3 7-10V6l-7-3Z" /></svg></span><div><a href={`/dashboard/roles/${role.id}/edit`}>{role.name}</a><p>#{role.id} · {role.guard_name || 'api'} · {formatDate(role.updated_at || role.created_at)}</p></div>{isProtected && <em>أساسي</em>}</div><div class="role-mobile-count"><strong>{rolePermissions.length}</strong><span>صلاحية ممنوحة</span></div><div class="role-mobile-permissions">{rolePermissions.slice(0, 5).map((permission: any) => <span dir="ltr">{permission.name}</span>)}{rolePermissions.length === 0 && <i>لا توجد صلاحيات مرتبطة</i>}{rolePermissions.length > 5 && <i>+{rolePermissions.length - 5} أخرى</i>}</div><div class="role-mobile-actions"><a href={`/dashboard/roles/${role.id}/edit`}>عرض وتعديل الدور</a>{isSuperAdmin && !isProtected && <form method="post" action={`/api/dashboard/roles/${role.id}/delete`} data-delete-role={role.name}><button type="submit">حذف</button></form>}</div></article>; })}
				</div>

				{filteredRoles.length === 0 && <div class="roles-empty"><span><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg></span><h2>لا توجد أدوار مطابقة</h2><p>جرّب استخدام اسم مختلف في البحث.</p><a href="/dashboard/roles">عرض جميع الأدوار</a></div>}
			</section>
		)}

		{isSuperAdmin && <dialog id="new-role-dialog" class="role-dialog">
			<div class="role-dialog-card">
				<header><div><span>دور جديد</span><h2>إنشاء مستوى وصول</h2><p>امنح أقل مجموعة صلاحيات يحتاجها هذا الدور لإنجاز عمله.</p></div><button type="button" data-close-role aria-label="إغلاق"><svg viewBox="0 0 24 24"><path d="m7 7 10 10M17 7 7 17" /></svg></button></header>
				<form method="post" action="/api/dashboard/roles/save" class="role-create-form">
					<div class="role-name-field"><label for="role-name">اسم الدور</label><input id="role-name" name="name" type="text" required minlength="2" maxlength="125" placeholder="مثال: مدير المحتوى" autocomplete="off" /></div>
					<div class="permission-picker-head"><div><strong>الصلاحيات</strong><span><b data-selected-count>0</b> من {permissions.length} محددة</span></div><label><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg><input type="search" placeholder="بحث في الصلاحيات..." data-permission-search /></label></div>
					<div class="permission-groups">
						{permissionGroups.map((group) => <section data-permission-group><div class="permission-group-title"><div><strong>{group.label}</strong><span>{group.permissions.length} صلاحية</span></div><button type="button" data-select-group>تحديد المجموعة</button></div><div>{group.permissions.map((permission: any) => <label data-permission-item data-permission-name={String(permission.name).toLocaleLowerCase()}><input type="checkbox" name="permissions" value={permission.id} /><span><i></i><b dir="ltr">{permission.name}</b></span></label>)}</div></section>)}
						{permissions.length === 0 && <div class="permission-empty">لا توجد صلاحيات متاحة.</div>}
					</div>
					<footer><button type="button" data-close-role>إلغاء</button><button type="submit"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>إنشاء الدور</button></footer>
				</form>
			</div>
		</dialog>}
	</div>

	<script>
		const dialog = document.querySelector<HTMLDialogElement>('#new-role-dialog');
		document.querySelector('[data-open-role]')?.addEventListener('click', () => dialog?.showModal());
		document.querySelectorAll('[data-close-role]').forEach((button) => button.addEventListener('click', () => dialog?.close()));
		dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
		document.querySelectorAll<HTMLFormElement>('[data-delete-role]').forEach((form) => form.addEventListener('submit', (event) => {
			const name = form.dataset.deleteRole || 'هذا الدور';
			if (!window.confirm(`سيتم حذف دور «${name}» نهائيًا وفصل صلاحياته عن المستخدمين. هل تريد المتابعة؟`)) event.preventDefault();
		}));

		const permissionInputs = [...document.querySelectorAll<HTMLInputElement>('.permission-groups input[type="checkbox"]')];
		const selectedCount = document.querySelector<HTMLElement>('[data-selected-count]');
		const refreshCount = () => { if (selectedCount) selectedCount.textContent = String(permissionInputs.filter((input) => input.checked).length); };
		permissionInputs.forEach((input) => input.addEventListener('change', refreshCount));
		document.querySelectorAll<HTMLElement>('[data-permission-group]').forEach((group) => {
			group.querySelector('[data-select-group]')?.addEventListener('click', () => {
				const visibleInputs = [...group.querySelectorAll<HTMLInputElement>('label:not([hidden]) input[type="checkbox"]')];
				const shouldCheck = visibleInputs.some((input) => !input.checked);
				visibleInputs.forEach((input) => { input.checked = shouldCheck; });
				refreshCount();
			});
		});
		document.querySelector<HTMLInputElement>('[data-permission-search]')?.addEventListener('input', (event) => {
			const term = (event.currentTarget as HTMLInputElement).value.trim().toLocaleLowerCase();
			document.querySelectorAll<HTMLElement>('[data-permission-group]').forEach((group) => {
				let visible = 0;
				group.querySelectorAll<HTMLElement>('[data-permission-item]').forEach((item) => {
					item.hidden = !!term && !(item.dataset.permissionName || '').includes(term);
					if (!item.hidden) visible += 1;
				});
				group.hidden = visible === 0;
			});
		});
	</script>

	<style>
		.roles-page{--rb-blue:#1a4d8f;--rb-green:#0f8464;--rb-orange:#e8a244;--rb-ink:#172a43;--rb-muted:#758397;--rb-line:#dde5ed;max-width:1420px;margin:0 auto;color:var(--rb-ink)}
		.roles-header{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1rem}.roles-header>div>span{color:var(--rb-blue);font-size:.55rem;font-weight:850}.roles-header h1{margin:.1rem 0;color:#0b2342;font-size:1.35rem;font-weight:950}.roles-header p{margin:0;color:var(--rb-muted);font-size:.62rem}.roles-header-actions{display:flex;align-items:center;gap:.45rem}.roles-primary-action,.roles-secondary-action,.roles-readonly{display:inline-flex;min-height:2.35rem;align-items:center;gap:.35rem;border-radius:.52rem;padding:.45rem .72rem;font-family:inherit;font-size:.58rem;font-weight:850}.roles-primary-action{border:1px solid #16437d;background:var(--rb-blue);color:#fff}.roles-secondary-action{border:1px solid var(--rb-line);background:#fff;color:var(--rb-blue)}.roles-readonly{border:1px solid var(--rb-line);background:#fff;color:#718096}.roles-primary-action svg,.roles-secondary-action svg,.roles-readonly svg{width:.82rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}
		.roles-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem;margin-bottom:1rem}.roles-stats article{display:flex;align-items:center;gap:.65rem;border:1px solid var(--rb-line);border-radius:.75rem;background:#fff;padding:.72rem .8rem;box-shadow:0 1px 2px rgb(15 35 60/.04)}.roles-stats article>span{display:grid;width:2.25rem;height:2.25rem;flex:none;place-items:center;border-radius:.55rem}.roles-stats svg{width:.9rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.7}.roles-stats .is-blue{background:#edf4fb;color:var(--rb-blue)}.roles-stats .is-green{background:#eaf8f3;color:var(--rb-green)}.roles-stats .is-orange{background:#fff5e7;color:#b66b0d}.roles-stats .is-graphite{background:#f0f3f6;color:#526376}.roles-stats strong{display:block;color:#132b48;font-size:.9rem;font-weight:950;line-height:1}.roles-stats p{margin:.18rem 0 0;color:#455b72;font-size:.53rem;font-weight:800}.roles-stats small{display:block;margin-top:.08rem;color:#929daa;font-size:.43rem}
		.roles-security-note{display:flex;align-items:center;gap:.55rem;margin-bottom:1rem;border:1px solid #e7dac4;border-radius:.65rem;background:#fffaf2;padding:.6rem .75rem}.roles-security-note>svg{width:1rem;flex:none;fill:none;stroke:#b16a11;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.7}.roles-security-note strong{display:block;color:#82541c;font-size:.55rem}.roles-security-note p{margin:.08rem 0 0;color:#9d7b4f;font-size:.47rem}
