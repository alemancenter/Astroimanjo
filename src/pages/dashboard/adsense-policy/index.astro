---
// Deterministic (no AI) AdSense content-policy scanner across articles and posts:
// duplicate/near-duplicate content (matched on content text AND title, not just word count),
// thin/weak content, and corrupted content (unresolved template artifacts). Reuses
// internal/contentquality's existing engines end to end. Nothing here edits, unpublishes, or
// redirects content automatically; it only surfaces issues for human review.
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';

const guard = await requireDashboard(Astro, ['manage articles', 'manage posts']);
if ('redirect' in guard) return guard.redirect;
const { user } = guard;

// The backend caches the last completed scan in Redis (GET returns it, POST runs a fresh one
// and overwrites it) specifically so a plain page reload shows the same results instead of
// coming back empty until "فحص" is clicked again.
const token = Astro.cookies.get('token')?.value;
const lastScan = (await apiFetch<any>('/dashboard/adsense-policy/scan', {
	countryId: Astro.locals.countryId,
	cookieHeader: `token=${token}`,
})).data ?? null;
---

<DashboardLayout title="سياسة AdSense" description="فحص المقالات والمنشورات بحثًا عن مخالفات سياسة AdSense" user={user}>
	<div class="policy-page" data-initial-scan={lastScan ? JSON.stringify(lastScan) : ''}>
		<header class="policy-header">
			<div>
				<span>مراجعة الامتثال</span>
				<h1>سياسة AdSense — المحتوى</h1>
				<p>فحص كامل لجميع المقالات والمنشورات الحالية بحثًا عن: تطابق كامل في النص أو العنوان، تشابه عالٍ، محتوى ضعيف (قصير جدًا أو ناقص البيانات)، ومحتوى تالف (بقايا نصوص غير مكتملة). المراجعة والقرار تبقى يدوية بالكامل.</p>
			</div>
			<div class="scan-action">
				<button type="button" data-scan-button class="scan-button">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" data-scan-icon><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 3h6l1 3h4v15H4V6h4l1-3Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m8 14 2 2 5-5M8 10h4"/></svg>
					<span data-scan-label>فحص المقالات والمنشورات بشكل كامل</span>
				</button>
				<small data-scan-timestamp hidden></small>
			</div>
		</header>

		<p class="policy-hint" data-scan-hint hidden>لم يُنفَّذ أي فحص بعد. قد يستغرق الفحص الكامل حتى دقيقة حسب عدد المقالات والمنشورات.</p>

		<div class="policy-summary" data-scan-summary hidden>
			<div><strong data-sum-scanned>٠</strong><span>عنصر تم فحصه</span></div>
			<div class="tone-exact"><strong data-sum-exact>٠</strong><span>تطابق كامل</span></div>
			<div class="tone-near"><strong data-sum-near>٠</strong><span>تكرار محتوى</span></div>
			<div class="tone-template"><strong data-sum-template>٠</strong><span>تشابه قالبي</span></div>
			<div class="tone-weak"><strong data-sum-weak>٠</strong><span>محتوى ضعيف</span></div>
			<div class="tone-issue"><strong data-sum-issues>٠</strong><span>محتوى تالف</span></div>
		</div>

		<div class="policy-filters" data-scan-filters hidden>
			<label class="filter-search">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
				<input type="text" data-filter-search placeholder="ابحث بالعنوان أو رقم المعرّف..." />
			</label>
			<select data-filter-type>
				<option value="all">كل النوع</option>
				<option value="article">مقالات فقط</option>
				<option value="post">منشورات فقط</option>
			</select>
			<select data-filter-status>
				<option value="all">كل الحالة</option>
				<option value="published">منشور فقط</option>
				<option value="draft">مسودة فقط</option>
			</select>
			<select data-filter-kind>
				<option value="all">كل أنواع التطابق</option>
				<option value="exact">تطابق كامل</option>
				<option value="near">تكرار محتوى</option>
				<option value="template">تشابه قالبي</option>
			</select>
			<button type="button" data-filter-reset class="filter-reset">إعادة تعيين</button>
		</div>

		<div class="policy-error" data-scan-error role="alert" hidden></div>

		<section class="policy-section" data-section="clusters" hidden>
			<h2>التطابق الكامل والتكرار <small data-count-clusters></small></h2>
			<div class="policy-clusters" data-scan-clusters></div>
			<p class="filter-empty" data-filter-empty="clusters" hidden>لا توجد نتائج مطابقة لعوامل التصفية الحالية.</p>
		</section>

		<section class="policy-section" data-section="weak" hidden>
			<h2>محتوى ضعيف <small data-count-weak></small></h2>
			<div class="policy-list" data-scan-weak></div>
			<p class="filter-empty" data-filter-empty="weak" hidden>لا توجد نتائج مطابقة لعوامل التصفية الحالية.</p>
		</section>

		<section class="policy-section" data-section="issues" hidden>
			<h2>محتوى تالف / مخالفات محتملة <small data-count-issues></small></h2>
			<div class="policy-list" data-scan-issues></div>
			<p class="filter-empty" data-filter-empty="issues" hidden>لا توجد نتائج مطابقة لعوامل التصفية الحالية.</p>
		</section>

		<div class="policy-empty" data-scan-empty hidden>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="m5 13 4 4L19 7"/></svg>
			<h3>لا توجد مشاكل ملحوظة</h3>
			<p>لم يجد الفحص أي تكرار أو محتوى ضعيف أو محتوى تالف.</p>
		</div>
	</div>

	<template data-cluster-template>
		<article class="cluster-card">
			<header>
				<span class="cluster-kind" data-cluster-kind></span>
				<span class="cluster-badges" data-cluster-badges></span>
				<span class="cluster-sim" data-cluster-sim></span>
			</header>
			<p class="cluster-rec" data-cluster-rec></p>
			<div class="cluster-members" data-cluster-members></div>
		</article>
	</template>

	<template data-member-template>
		<div class="member-row">
			<div class="member-info">
				<span class="member-type" data-member-type></span>
				<a class="member-title" data-member-title target="_blank" rel="noopener"></a>
				<span class="member-status" data-member-status></span>
			</div>
			<div class="member-actions">
				<span class="member-words" data-member-words></span>
				<a data-member-edit class="member-edit">تعديل</a>
			</div>
		</div>
	</template>

	<template data-weak-template>
		<article class="issue-card">
			<div class="member-row">
				<div class="member-info">
					<span class="member-type" data-member-type></span>
					<a class="member-title" data-member-title target="_blank" rel="noopener"></a>
					<span class="member-status" data-member-status></span>
				</div>
				<div class="member-actions">
					<span class="member-words" data-member-words></span>
					<a data-member-edit class="member-edit">تعديل</a>
				</div>
			</div>
			<ul class="issue-signals" data-issue-signals></ul>
		</article>
	</template>

	<template data-policy-issue-template>
		<article class="issue-card tone-issue">
			<div class="member-row">
				<div class="member-info">
					<span class="member-type" data-member-type></span>
					<a class="member-title" data-member-title target="_blank" rel="noopener"></a>
					<span class="member-status" data-member-status></span>
				</div>
				<div class="member-actions">
					<a data-member-edit class="member-edit">تعديل</a>
				</div>
			</div>
			<ul class="issue-signals" data-issue-list></ul>
		</article>
	</template>

	<script>
		const page = document.querySelector<HTMLElement>('.policy-page');
		const scanButton = document.querySelector<HTMLButtonElement>('[data-scan-button]');
		const scanLabel = document.querySelector<HTMLElement>('[data-scan-label]');
		const scanIcon = document.querySelector<HTMLElement>('[data-scan-icon]');
		const timestampEl = document.querySelector<HTMLElement>('[data-scan-timestamp]');
		const hint = document.querySelector<HTMLElement>('[data-scan-hint]');
		const summaryBox = document.querySelector<HTMLElement>('[data-scan-summary]');
		const filtersBox = document.querySelector<HTMLElement>('[data-scan-filters]');
		const emptyBox = document.querySelector<HTMLElement>('[data-scan-empty]');
		const errorBox = document.querySelector<HTMLElement>('[data-scan-error]');
		const clustersBox = document.querySelector<HTMLElement>('[data-scan-clusters]');
		const weakBox = document.querySelector<HTMLElement>('[data-scan-weak]');
		const issuesBox = document.querySelector<HTMLElement>('[data-scan-issues]');
		const clusterTemplate = document.querySelector<HTMLTemplateElement>('[data-cluster-template]');
		const memberTemplate = document.querySelector<HTMLTemplateElement>('[data-member-template]');
		const weakTemplate = document.querySelector<HTMLTemplateElement>('[data-weak-template]');
		const policyIssueTemplate = document.querySelector<HTMLTemplateElement>('[data-policy-issue-template]');
		const searchInput = document.querySelector<HTMLInputElement>('[data-filter-search]');
		const typeSelect = document.querySelector<HTMLSelectElement>('[data-filter-type]');
		const statusSelect = document.querySelector<HTMLSelectElement>('[data-filter-status]');
		const kindSelect = document.querySelector<HTMLSelectElement>('[data-filter-kind]');
		const resetButton = document.querySelector<HTMLButtonElement>('[data-filter-reset]');

		const number = new Intl.NumberFormat('ar-EG');
		const percent = (value: number) => `${new Intl.NumberFormat('ar-EG', { maximumFractionDigits: 1 }).format(value * 100)}%`;
		const kindClass = (kind: string) => kind === 'exact' ? 'tone-exact' : kind === 'near' ? 'tone-near' : 'tone-template';
		const matchedOnLabel = (on: string) => on === 'content' ? 'المحتوى' : on === 'title' ? 'العنوان' : on;

		let currentResult: any = null;

		function fillMemberRow(root: DocumentFragment | HTMLElement, member: any) {
			const typeEl = root.querySelector<HTMLElement>('[data-member-type]')!;
			typeEl.textContent = member.type === 'article' ? 'مقال' : 'منشور';
			const titleEl = root.querySelector<HTMLAnchorElement>('[data-member-title]')!;
			titleEl.textContent = member.title || `#${member.id}`;
			titleEl.href = member.public_url;
			const statusEl = root.querySelector<HTMLElement>('[data-member-status]')!;
			statusEl.textContent = member.published ? 'منشور' : 'مسودة';
			statusEl.classList.toggle('is-published', Boolean(member.published));
			const wordsEl = root.querySelector<HTMLElement>('[data-member-words]');
			if (wordsEl) wordsEl.textContent = `${number.format(member.word_count)} كلمة`;
			const editEl = root.querySelector<HTMLAnchorElement>('[data-member-edit]')!;
			editEl.href = member.edit_url;
		}

		function renderMember(member: any): Node {
			if (!memberTemplate) return document.createDocumentFragment();
			const node = memberTemplate.content.cloneNode(true) as DocumentFragment;
			fillMemberRow(node, member);
			return node;
		}

		function renderCluster(cluster: any): Node {
			if (!clusterTemplate) return document.createDocumentFragment();
			const node = clusterTemplate.content.cloneNode(true) as DocumentFragment;
			const card = node.querySelector<HTMLElement>('.cluster-card')!;
			card.classList.add(kindClass(cluster.kind));
			node.querySelector<HTMLElement>('[data-cluster-kind]')!.textContent = cluster.kind_label;
			const badgesEl = node.querySelector<HTMLElement>('[data-cluster-badges]')!;
			badgesEl.textContent = (cluster.matched_on || []).map(matchedOnLabel).join(' + ');
			node.querySelector<HTMLElement>('[data-cluster-sim]')!.textContent = `أعلى تشابه ${percent(cluster.max_similarity)}`;
			node.querySelector<HTMLElement>('[data-cluster-rec]')!.textContent = cluster.recommendation;
			const membersBox = node.querySelector<HTMLElement>('[data-cluster-members]')!;
			for (const member of cluster.members || []) membersBox.appendChild(renderMember(member));
			return node;
		}

		function renderWeak(item: any): Node {
			if (!weakTemplate) return document.createDocumentFragment();
			const node = weakTemplate.content.cloneNode(true) as DocumentFragment;
			fillMemberRow(node, item);
			const list = node.querySelector<HTMLElement>('[data-issue-signals]')!;
			for (const signal of item.signals || []) {
				const li = document.createElement('li');
				li.textContent = signal;
				list.appendChild(li);
			}
			return node;
		}

		function renderPolicyIssue(item: any): Node {
			if (!policyIssueTemplate) return document.createDocumentFragment();
			const node = policyIssueTemplate.content.cloneNode(true) as DocumentFragment;
			fillMemberRow(node, item);
			const list = node.querySelector<HTMLElement>('[data-issue-list]')!;
			for (const issue of item.issues || []) {
				const li = document.createElement('li');
				const fieldLabel = issue.field === 'title' ? 'العنوان' : 'المحتوى';
				li.textContent = `${fieldLabel}: بقايا نص غير مكتمل "${issue.token}" — ...${issue.snippet}...`;
				list.appendChild(li);
			}
			return node;
		}

		function setBusy(busy: boolean) {
			if (scanButton) scanButton.disabled = busy;
			if (scanIcon) scanIcon.classList.toggle('is-spinning', busy);
			if (scanLabel) scanLabel.textContent = busy ? 'جارِ الفحص... قد يستغرق حتى دقيقة' : 'إعادة الفحص بشكل كامل';
		}

		function toggleSection(name: string, hasItems: boolean) {
			const section = document.querySelector<HTMLElement>(`[data-section="${name}"]`);
			if (section) section.hidden = !hasItems;
		}

		function toggleFilterEmpty(name: string, isEmpty: boolean) {
			const el = document.querySelector<HTMLElement>(`[data-filter-empty="${name}"]`);
			if (el) el.hidden = !isEmpty;
		}

		// A cluster/item "matches" the type/status/search filters if the cluster as a whole is
		// relevant — for clusters that means at least one member matches, since splitting a
		// duplicate pair across a type filter would hide the very thing being compared.
		function matchesTypeStatusSearch(member: any, type: string, status: string, search: string): boolean {
			if (type !== 'all' && member.type !== type) return false;
			if (status === 'published' && !member.published) return false;
			if (status === 'draft' && member.published) return false;
			if (search) {
				const haystack = `${member.title || ''} ${member.id}`.toLowerCase();
				if (!haystack.includes(search)) return false;
			}
			return true;
		}

		function applyFilters() {
			if (!currentResult) return;
			const search = (searchInput?.value || '').trim().toLowerCase();
			const type = typeSelect?.value || 'all';
			const status = statusSelect?.value || 'all';
			const kind = kindSelect?.value || 'all';

			const clusters = (currentResult.clusters || []).filter((cluster: any) => {
				if (kind !== 'all' && cluster.kind !== kind) return false;
				return (cluster.members || []).some((m: any) => matchesTypeStatusSearch(m, type, status, search));
			});
			const weakItems = (currentResult.weak_content || []).filter((item: any) => matchesTypeStatusSearch(item, type, status, search));
			const issues = (currentResult.policy_issues || []).filter((item: any) => matchesTypeStatusSearch(item, type, status, search));

			if (clustersBox) {
				clustersBox.innerHTML = '';
				for (const cluster of clusters) clustersBox.appendChild(renderCluster(cluster));
			}
			if (weakBox) {
				weakBox.innerHTML = '';
				for (const item of weakItems) weakBox.appendChild(renderWeak(item));
			}
			if (issuesBox) {
				issuesBox.innerHTML = '';
				for (const item of issues) issuesBox.appendChild(renderPolicyIssue(item));
			}

			const totalClusters = (currentResult.clusters || []).length;
			const totalWeak = (currentResult.weak_content || []).length;
			const totalIssues = (currentResult.policy_issues || []).length;
			document.querySelector('[data-count-clusters]')!.textContent = `(${number.format(clusters.length)} من ${number.format(totalClusters)})`;
			document.querySelector('[data-count-weak]')!.textContent = `(${number.format(weakItems.length)} من ${number.format(totalWeak)})`;
			document.querySelector('[data-count-issues]')!.textContent = `(${number.format(issues.length)} من ${number.format(totalIssues)})`;

			toggleSection('clusters', totalClusters > 0);
			toggleSection('weak', totalWeak > 0);
			toggleSection('issues', totalIssues > 0);
			toggleFilterEmpty('clusters', totalClusters > 0 && clusters.length === 0);
			toggleFilterEmpty('weak', totalWeak > 0 && weakItems.length === 0);
			toggleFilterEmpty('issues', totalIssues > 0 && issues.length === 0);

			if (emptyBox) emptyBox.hidden = totalClusters > 0 || totalWeak > 0 || totalIssues > 0;
		}

		function renderResult(result: any) {
			currentResult = result;
			if (!result) {
				if (hint) hint.hidden = false;
				if (summaryBox) summaryBox.hidden = true;
				if (filtersBox) filtersBox.hidden = true;
				if (timestampEl) timestampEl.hidden = true;
				return;
			}
			if (hint) hint.hidden = true;
			const summary = result.summary || {};
			if (summaryBox) {
				summaryBox.hidden = false;
				summaryBox.querySelector('[data-sum-scanned]')!.textContent = number.format(summary.scanned_items || 0);
				summaryBox.querySelector('[data-sum-exact]')!.textContent = number.format(summary.exact_clusters || 0);
				summaryBox.querySelector('[data-sum-near]')!.textContent = number.format(summary.near_clusters || 0);
				summaryBox.querySelector('[data-sum-template]')!.textContent = number.format(summary.template_clusters || 0);
				summaryBox.querySelector('[data-sum-weak]')!.textContent = number.format(summary.weak_content_items || 0);
				summaryBox.querySelector('[data-sum-issues]')!.textContent = number.format(summary.policy_issue_items || 0);
			}
			if (filtersBox) filtersBox.hidden = false;
			if (timestampEl && result.scanned_at) {
				timestampEl.hidden = false;
				const date = new Date(result.scanned_at);
				timestampEl.textContent = `آخر فحص: ${date.toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' })}`;
			}
			applyFilters();
		}

		[searchInput, typeSelect, statusSelect, kindSelect].forEach((el) => {
			el?.addEventListener('input', applyFilters);
			el?.addEventListener('change', applyFilters);
		});
		resetButton?.addEventListener('click', () => {
			if (searchInput) searchInput.value = '';
			if (typeSelect) typeSelect.value = 'all';
			if (statusSelect) statusSelect.value = 'all';
			if (kindSelect) kindSelect.value = 'all';
			applyFilters();
		});

		scanButton?.addEventListener('click', async () => {
			setBusy(true);
			if (errorBox) { errorBox.hidden = true; errorBox.textContent = ''; }
			try {
				const res = await fetch('/api/dashboard/adsense-policy/scan', { method: 'POST' });
				const json: any = await res.json().catch(() => null);
				if (!res.ok || !json?.success) throw new Error(json?.message || 'تعذّر تنفيذ الفحص، حاول مرة أخرى.');
				renderResult(json.data || null);
			} catch (error) {
				if (errorBox) {
					errorBox.hidden = false;
					errorBox.textContent = error instanceof Error ? error.message : 'تعذّر تنفيذ الفحص، حاول مرة أخرى.';
				}
			} finally {
				setBusy(false);
			}
		});

		// Seed from the last scan the server already loaded (see the Astro frontmatter) so a
		// plain page reload shows the same results instead of coming back empty.
		try {
			const initial = page?.dataset.initialScan;
			renderResult(initial ? JSON.parse(initial) : null);
		} catch {
			renderResult(null);
		}
	</script>

	<style>
		.policy-page{max-width:1100px;margin-inline:auto;padding-bottom:3rem}
		.policy-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;border:1px solid #dfe6ee;border-radius:.85rem;background:#fff;padding:1rem 1.1rem;margin-bottom:.9rem}
		.policy-header>div:first-child{max-width:42rem}
		.policy-header span:first-child{display:block;margin-bottom:.2rem;color:#1a4d8f;font-size:.68rem;font-weight:850}
		.policy-header h1{margin:0;color:#061a3a;font-size:clamp(1.25rem,1.05rem + .6vw,1.6rem);font-weight:950}
		.policy-header p{margin:.4rem 0 0;color:#718096;font-size:.72rem;line-height:1.8}
		.scan-action{display:grid;justify-items:end;gap:.35rem}
		.scan-action>small{color:#8a97a6;font-size:.58rem}
		.scan-button{display:inline-flex;align-items:center;gap:.5rem;min-height:2.7rem;border:1px solid #16427d;border-radius:.55rem;background:#1a4d8f;padding:.55rem .9rem;color:#fff;font-family:inherit;font-size:.68rem;font-weight:850;white-space:nowrap}
		.scan-button:disabled{cursor:wait;opacity:.75}
		.scan-button svg{width:1rem;height:1rem;stroke-width:1.8}
		.scan-button svg.is-spinning{animation:policy-spin 1s linear infinite}
		@keyframes policy-spin{to{transform:rotate(360deg)}}
		.policy-hint{margin:0 0 .9rem;color:#8a97a6;font-size:.66rem}
		.policy-summary{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.6rem;margin-bottom:.9rem}
		.policy-summary>div{border:1px solid #dfe6ee;border-radius:.65rem;background:#fff;padding:.65rem .7rem;text-align:center}
		.policy-summary strong{display:block;color:#102a43;font-size:1.05rem;font-weight:950}
		.policy-summary span{display:block;margin-top:.15rem;color:#8a97a6;font-size:.56rem}
		.policy-summary .tone-exact strong{color:#b3261e}
		.policy-summary .tone-near strong{color:#b3691e}
		.policy-summary .tone-template strong{color:#6b5bd6}
		.policy-summary .tone-weak strong{color:#b36c16}
		.policy-summary .tone-issue strong{color:#9333ea}
		.policy-filters{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;border:1px solid #dfe6ee;border-radius:.65rem;background:#fff;padding:.6rem .7rem;margin-bottom:1rem}
		.filter-search{display:flex;flex:1 1 14rem;min-width:12rem;align-items:center;gap:.4rem;border:1px solid #d9e2ec;border-radius:.5rem;padding:0 .55rem}
		.filter-search svg{width:.85rem;height:.85rem;flex:none;color:#94a3b8}
