---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import DashboardAlert from '../../../../components/ui/DashboardAlert.astro';
import PostForm from '../../../../components/dashboard/PostForm.astro';
import { requireDashboard } from '../../../../lib/auth';
import { apiFetch, apiFetchList } from '../../../../lib/api';

const guard = await requireDashboard(Astro, 'manage posts');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;

const { id } = Astro.params;
const auth = { countryId: Astro.locals.countryId, cookieHeader: `token=${Astro.cookies.get('token')?.value}` };
const [postResult, { items: categories }, seoResult] = await Promise.all([
	apiFetch<any>(`/dashboard/posts/${id}`, {
		...auth,
	}),
	apiFetchList<any>('/categories', { countryId: Astro.locals.countryId }),
	apiFetch<any>(`/dashboard/seo/metadata/post/${id}`, auth),
]);
const post = postResult.data;
---

<DashboardLayout title="تعديل منشور" user={user}>
	<DashboardAlert />
	{
		!postResult.ok || !post ? (
			<p class="text-red-600 dark:text-red-400">{postResult.ok ? 'المنشور غير موجود.' : postResult.message}</p>
		) : (
			<PostForm post={post} seo={seoResult.data} categories={categories} countryId={Astro.locals.countryId} />
		)
	}
</DashboardLayout>
