---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import CountrySwitcher from '../../../components/CountrySwitcher.astro';
import DashboardNavIcon from '../../../components/dashboard/DashboardNavIcon.astro';
import { requireDashboard, hasPermission, isAdmin } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';
import { getCountryById } from '../../../lib/countries';

const guard = await requireDashboard(Astro);
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const allowed = isAdmin(user) || hasPermission(user, 'manage monitoring') || hasPermission(user, 'manage performance');
if (!allowed) return Astro.redirect('/dashboard?error=forbidden');

const params = Astro.url.searchParams;
const allowedTabs = ['overview', 'audience', 'realtime', 'performance'];
const tab = allowedTabs.includes(params.get('tab') || '') ? String(params.get('tab')) : 'overview';
const days = [7, 14, 30, 90, 365].includes(Number(params.get('days'))) ? Number(params.get('days')) : 30;
const visitorType = ['all', 'members', 'guests', 'bots'].includes(params.get('type') || '') ? String(params.get('type')) : 'all';
const q = (params.get('q') || '').trim().toLowerCase();
const countryId = Astro.locals.countryId;
const currentCountry = getCountryById(countryId);
const cookieHeader = `token=${Astro.cookies.get('token')?.value}`;

const [visitorResult, contentResult, summaryResult, liveResult, cacheResult, responseResult, rawResult] = await Promise.all([
	apiFetch<any>('/dashboard/visitor-analytics', { countryId, cookieHeader, params: { days }, timeoutMs: 30_000 }),
	apiFetch<any>('/dashboard/content-analytics', { countryId, cookieHeader }),
	apiFetch<any>('/dashboard', { countryId, cookieHeader }),
	apiFetch<any>('/dashboard/performance/live', { countryId, cookieHeader }),
	apiFetch<any>('/dashboard/performance/cache', { countryId, cookieHeader }),
	apiFetch<any>('/dashboard/performance/response-time', { countryId, cookieHeader }),
	apiFetch<any>('/dashboard/performance/raw', { countryId, cookieHeader }),
]);

const visitor = visitorResult.data || {};
const visitorStats = visitor.visitor_stats || {};
const userStats = visitor.user_stats || {};
const chartData: any[] = Array.isArray(visitor.chart_data) ? visitor.chart_data : [];
const devices: any[] = Array.isArray(visitor.device_stats) ? visitor.device_stats : [];
const sources: any[] = Array.isArray(visitor.traffic_sources) ? visitor.traffic_sources : [];
const countries: any[] = Array.isArray(visitor.country_stats) ? visitor.country_stats : [];
const activeVisitors: any[] = Array.isArray(visitorStats.active_visitors) ? visitorStats.active_visitors : [];
const content = contentResult.data || {};
const summary = summaryResult.data || {};
const live = liveResult.data || {};
const cache = cacheResult.data || {};
const response = responseResult.data || {};
const raw = rawResult.data || {};
const goStats = raw.go || {};
const redisInfo = raw.redis_info || {};

const numberValue = (...values: unknown[]) => {
	for (const value of values) { const parsed = Number(value); if (Number.isFinite(parsed)) return parsed; }
	return 0;
};
const number = new Intl.NumberFormat('ar-EG');
const decimal = new Intl.NumberFormat('ar-EG', { maximumFractionDigits: 1 });
const percent = (value: unknown) => `${decimal.format(numberValue(value))}%`;
const formatBytes = (value: unknown) => {
	const bytes = numberValue(value);
	if (!bytes) return '0 بايت';
	if (bytes < 1024) return `${number.format(bytes)} بايت`;
	if (bytes < 1024 ** 2) return `${decimal.format(bytes / 1024)} كيلوبايت`;
	if (bytes < 1024 ** 3) return `${decimal.format(bytes / 1024 ** 2)} ميجابايت`;
	return `${decimal.format(bytes / 1024 ** 3)} جيجابايت`;
};
const formatTime = (value: unknown) => {
	const date = new Date(String(value || ''));
	return Number.isNaN(date.getTime()) ? 'الآن' : date.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
};
const periodViews = chartData.reduce((total, item) => total + numberValue(item.pageViews, item.views), 0);
const periodVisitors = chartData.reduce((total, item) => total + numberValue(item.visitors), 0);
const pagesPerVisitor = periodVisitors > 0 ? periodViews / periodVisitors : 0;
const maxChart = Math.max(1, ...chartData.flatMap((item) => [numberValue(item.pageViews), numberValue(item.visitors)]));
const chartWidth = 760;
const chartHeight = 230;
const linePoints = (key: 'pageViews' | 'visitors') => chartData.map((item, index) => {
	const x = chartData.length <= 1 ? chartWidth / 2 : (index / (chartData.length - 1)) * chartWidth;
	const y = chartHeight - (numberValue(item[key]) / maxChart) * (chartHeight - 30) - 12;
	return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
const viewPoints = linePoints('pageViews');
const visitorPoints = linePoints('visitors');
const viewArea = chartData.length ? `M0 ${chartHeight} L${viewPoints.replaceAll(' ', ' L')} L${chartWidth} ${chartHeight} Z` : '';
const maxSource = Math.max(1, ...sources.map((item) => numberValue(item.visits)));
const maxCountry = Math.max(1, ...countries.map((item) => numberValue(item.count)));
const deviceTotal = Math.max(1, devices.reduce((total, item) => total + numberValue(item.count), 0));
const deviceRows = devices.map((item, index) => ({
	...item,
	share: numberValue(item.value) || (numberValue(item.count) / deviceTotal) * 100,
	tone: `tone-${index % 4}`,
	iconPath: String(item.name).toLowerCase().includes('mobile') ? 'M8 2h8v20H8zM11 18h2' : 'M3 4h18v13H3zM8 21h8M12 17v4',
}));
const filteredVisitors = activeVisitors.filter((item) => {
	const typeMatch = visitorType === 'all' || (visitorType === 'members' && item.is_member) || (visitorType === 'guests' && !item.is_member && !item.is_bot) || (visitorType === 'bots' && item.is_bot);
	const haystack = [item.ip, item.country, item.city, item.user_name, item.user_email, item.browser, item.os, item.current_page].join(' ').toLowerCase();
	return typeMatch && (!q || haystack.includes(q));
});
const published = numberValue(content.published_articles);
const drafts = numberValue(content.draft_articles);
const contentTotal = published + drafts;
const publishRate = contentTotal ? Math.round((published / contentTotal) * 100) : 0;
const topContent = [
	...(Array.isArray(content.top_articles) ? content.top_articles.map((item: any) => ({ ...item, kind: 'مقال', href: `/dashboard/articles/${item.id}/edit`, views: numberValue(item.visit_count, item.views) })) : []),
	...(Array.isArray(content.top_posts) ? content.top_posts.map((item: any) => ({ ...item, kind: 'منشور', href: `/dashboard/posts/${item.id}/edit`, views: numberValue(item.views, item.visit_count) })) : []),
].sort((a, b) => b.views - a.views).slice(0, 8);
const memoryPct = Math.round(numberValue(live.memory?.usage_percentage));
const responseMs = numberValue(response.average_ms);
const cachePct = Math.round(numberValue(cache.hit_ratio));
const platformSeries = summary.analytics || {};
const platformTotals = {
	articles: (Array.isArray(platformSeries.articles) ? platformSeries.articles : []).reduce((sum: number, value: unknown) => sum + numberValue(value), 0),
	posts: (Array.isArray(platformSeries.news) ? platformSeries.news : []).reduce((sum: number, value: unknown) => sum + numberValue(value), 0),
	comments: (Array.isArray(platformSeries.comments) ? platformSeries.comments : []).reduce((sum: number, value: unknown) => sum + numberValue(value), 0),
};
const allOk = [visitorResult, contentResult, summaryResult, liveResult, cacheResult, responseResult, rawResult].every((result) => result.ok);
const tabHref = (next: string) => `/dashboard/analytics?tab=${next}&days=${days}`;
const success = params.get('success');
const error = params.get('error');
const periodLabel = days === 7 ? '7 أيام' : days === 14 ? '14 يومًا' : days === 30 ? '30 يومًا' : days === 90 ? '3 أشهر' : 'سنة';
const sourceLabel = (source: string) => !source || source === 'Direct' ? 'دخول مباشر' : source;
const deviceLabel = (name: string) => ({ Desktop: 'حاسوب', Mobile: 'هاتف', Tablet: 'جهاز لوحي' }[name] || name || 'غير معروف');
const deviceTypeLabel = (type: string) => ({ mobile: 'هاتف', tablet: 'جهاز لوحي', desktop: 'حاسوب' }[type] || 'غير معروف');
---

<DashboardLayout title="التحليلات" description="تحليل حركة الزوار وأداء المحتوى والمنصة" user={user}>
	<div class="analytics-page">
		{error && <div class="analytics-alert is-error" role="alert"><i>!</i><div><strong>تعذّر تنفيذ العملية</strong><span>{error}</span></div><a href={tabHref(tab)}>×</a></div>}
		{success && <div class="analytics-alert is-success" role="status"><i><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></i><div><strong>تمت العملية بنجاح</strong><span>{success}</span></div><a href={tabHref(tab)}>×</a></div>}

		<header class="analytics-hero">
			<div><span class="eyebrow"><svg viewBox="0 0 24 24"><path d="M4 19V9m5 10V5m6 14v-7m5 7V3"/></svg>ذكاء الأعمال واتخاذ القرار</span><h1>مركز التحليلات</h1><p>افهم سلوك زوار منصة {currentCountry.name}، مصادر الوصول، أداء المحتوى وصحة البنية التقنية من بيانات فعلية ومباشرة.</p></div>
			<div class="hero-controls"><div class="country-select"><span>قاعدة البيانات</span><CountrySwitcher /></div><form method="get"><input type="hidden" name="tab" value={tab}/><label><span>الفترة الزمنية</span><select name="days" onchange="this.form.submit()"><option value="7" selected={days === 7}>آخر 7 أيام</option><option value="14" selected={days === 14}>آخر 14 يومًا</option><option value="30" selected={days === 30}>آخر 30 يومًا</option><option value="90" selected={days === 90}>آخر 3 أشهر</option><option value="365" selected={days === 365}>آخر سنة</option></select></label></form><a href={tabHref(tab)} title="تحديث"><svg viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 9a7 7 0 0 1 12-2l2 2M4 15l2 2a7 7 0 0 0 12-2"/></svg></a></div>
		</header>

		<nav class="analytics-tabs" role="tablist" aria-label="أقسام التحليلات">
			<a href={tabHref('overview')} role="tab" aria-selected={tab === 'overview'} class:list={{ active: tab === 'overview' }}><DashboardNavIcon name="analytics" class="size-5"/><span><strong>نظرة تنفيذية</strong><small>الاتجاهات والمؤشرات</small></span></a>
			<a href={tabHref('audience')} role="tab" aria-selected={tab === 'audience'} class:list={{ active: tab === 'audience' }}><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg><span><strong>الجمهور والاكتساب</strong><small>الدول والأجهزة والمصادر</small></span></a>
			<a href={tabHref('realtime')} role="tab" aria-selected={tab === 'realtime'} class:list={{ active: tab === 'realtime' }}><svg viewBox="0 0 24 24"><path d="M3 12h4l2-6 4 12 2-6h6"/></svg><span><strong>الزوار الآن</strong><small>نشاط لحظي مباشر</small></span><b>{number.format(activeVisitors.length)}</b></a>
			<a href={tabHref('performance')} role="tab" aria-selected={tab === 'performance'} class:list={{ active: tab === 'performance' }}><svg viewBox="0 0 24 24"><path d="M4 19a8 8 0 1 1 16 0M12 13l4-4"/></svg><span><strong>أداء المنصة</strong><small>Go وRedis والذاكرة</small></span></a>
		</nav>

		{!allOk && <div class="data-notice"><svg viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10 3h4l8 18H2Z"/></svg><div><strong>بعض مصادر البيانات لم تستجب</strong><span>ستظل الأقسام المتاحة ظاهرة، ويمكنك إعادة التحديث لاستكمال المؤشرات.</span></div></div>}

		{tab === 'overview' && <main class="tab-panel" role="tabpanel">
			<section class="metric-grid">
				<article class="blue"><header><span>مشاهدات الفترة</span><i><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg></i></header><strong>{number.format(periodViews)}</strong><footer><span>خلال {periodLabel}</span><b>{decimal.format(pagesPerVisitor)} صفحة/زائر</b></footer></article>
				<article class="green"><header><span>الزوار</span><i><DashboardNavIcon name="users" class="size-5"/></i></header><strong>{number.format(periodVisitors)}</strong><footer><span>زوار الفترة المحددة</span><b class:list={{ down: numberValue(visitorStats.change) < 0 }}>{numberValue(visitorStats.change) < 0 ? '↓' : '↑'} {percent(Math.abs(numberValue(visitorStats.change)))}</b></footer></article>
				<article class="orange"><header><span>النشطون الآن</span><i><svg viewBox="0 0 24 24"><path d="M3 12h4l2-6 4 12 2-6h6"/></svg></i></header><strong>{number.format(visitorStats.current)}</strong><footer><span>{number.format(visitorStats.current_members)} عضو · {number.format(visitorStats.current_guests)} زائر</span><b class="live"><i></i>مباشر</b></footer></article>
				<article class="violet"><header><span>إجمالي المستخدمين</span><i><DashboardNavIcon name="users" class="size-5"/></i></header><strong>{number.format(userStats.total)}</strong><footer><span>{number.format(userStats.active)} حساب نشط</span><b>+{number.format(userStats.new_today)} اليوم</b></footer></article>
			</section>

			<section class="panel traffic-chart">
				<header class="panel-heading"><div><span>الاتجاه الزمني</span><h2>الزيارات والمشاهدات</h2><p>مقارنة الزوار الفريدين مع عدد الصفحات التي تمت مشاهدتها.</p></div><div class="legend"><span><i class="blue"></i>مشاهدات الصفحات</span><span><i class="green"></i>الزوار</span></div></header>
				{chartData.length ? <div class="chart-wrap"><svg viewBox={`0 0 ${chartWidth} 250`} preserveAspectRatio="none" role="img" aria-label="تطور الزيارات"><defs><linearGradient id="viewsArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1A4D8F" stop-opacity=".22"/><stop offset="100%" stop-color="#1A4D8F" stop-opacity="0"/></linearGradient></defs><g class="chart-grid"><line x1="0" x2={chartWidth} y1="35" y2="35"/><line x1="0" x2={chartWidth} y1="95" y2="95"/><line x1="0" x2={chartWidth} y1="155" y2="155"/><line x1="0" x2={chartWidth} y1="230" y2="230"/></g><path d={viewArea} fill="url(#viewsArea)"/><polyline points={viewPoints} class="views-line"/><polyline points={visitorPoints} class="visitors-line"/></svg><div class="chart-labels">{chartData.map((item) => <span>{item.name || new Date(item.full_date).toLocaleDateString('ar-EG', { day: 'numeric', month: 'short' })}</span>)}</div></div> : <div class="empty"><i><DashboardNavIcon name="analytics" class="size-6"/></i><h3>لا توجد بيانات للفترة المحددة</h3><p>ستظهر الزيارات هنا بعد تسجيل نشاط جديد.</p></div>}
				<footer class="chart-footer"><div><span>متوسط المشاهدات يوميًا</span><strong>{number.format(chartData.length ? Math.round(periodViews / chartData.length) : 0)}</strong></div><div><span>متوسط الزوار يوميًا</span><strong>{number.format(chartData.length ? Math.round(periodVisitors / chartData.length) : 0)}</strong></div><div><span>أفضل يوم</span><strong>{chartData.length ? [...chartData].sort((a,b) => numberValue(b.pageViews)-numberValue(a.pageViews))[0]?.name || '—' : '—'}</strong></div></footer>
			</section>

			<div class="overview-lower">
				<section class="panel content-performance"><header class="panel-heading"><div><span>تحليلات المحتوى</span><h2>أداء النشر</h2><p>حالة المقالات ونشاط آخر سبعة أيام.</p></div><a href="/dashboard/content-audit">تدقيق الجودة</a></header><div class="content-body"><div class="publish-donut" style={`--rate:${publishRate * 3.6}deg`}><span><strong>{number.format(publishRate)}%</strong><small>منشور</small></span></div><div class="content-stats"><div><span>منشور</span><strong>{number.format(published)}</strong></div><div><span>مسودة</span><strong>{number.format(drafts)}</strong></div><div><span>مقالات الأسبوع</span><strong>{number.format(platformTotals.articles)}</strong></div><div><span>منشورات الأسبوع</span><strong>{number.format(platformTotals.posts)}</strong></div></div></div></section>
				<section class="panel top-content"><header class="panel-heading"><div><span>ترتيب الأداء</span><h2>المحتوى الأعلى مشاهدة</h2><p>أفضل المقالات والمنشورات وفق الزيارات.</p></div><a href="/dashboard/articles">المحتوى</a></header>{topContent.length ? <div class="rank-list">{topContent.slice(0,5).map((item,index) => <a href={item.href}><b class:list={{ top:index<3 }}>{number.format(index+1)}</b><div><strong>{item.title || 'بدون عنوان'}</strong><span>{item.kind}</span></div><aside><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>{number.format(item.views)}</aside></a>)}</div> : <div class="empty compact"><h3>لا توجد بيانات مشاهدة بعد</h3></div>}</section>
				<section class="panel acquisition-snapshot"><header class="panel-heading"><div><span>اكتساب الزوار</span><h2>أهم المصادر</h2><p>القنوات التي أرسلت الزيارات خلال الفترة.</p></div><a href={tabHref('audience')}>التفاصيل</a></header><div class="source-mini">{sources.slice(0,5).map((item,index) => <div><i>{number.format(index+1)}</i><span title={item.source}>{sourceLabel(item.source)}</span><b>{number.format(item.visits)}</b></div>)}{!sources.length && <div class="empty compact"><h3>لا توجد مصادر مسجلة</h3></div>}</div></section>
			</div>
		</main>}

		{tab === 'audience' && <main class="tab-panel audience-panel" role="tabpanel">
			<section class="audience-intro"><div><span>تحليل الجمهور</span><h2>من يصل إلى المنصة وكيف؟</h2><p>توزيع جغرافي وتقني يساعدك على تحسين المحتوى وتجربة الاستخدام.</p></div><aside><div><span>إجمالي الزوار</span><strong>{number.format(periodVisitors)}</strong></div><div><span>إجمالي المشاهدات</span><strong>{number.format(periodViews)}</strong></div><div><span>صفحات لكل زائر</span><strong>{decimal.format(pagesPerVisitor)}</strong></div></aside></section>
			<div class="audience-grid">
				<section class="panel countries-panel"><header class="panel-heading"><div><span>التوزيع الجغرافي</span><h2>أعلى الدول</h2><p>ترتيب الزيارات المسجلة حسب الدولة.</p></div><span class="count-badge">{number.format(countries.length)} دولة</span></header><div class="bar-list">{countries.slice(0,10).map((item,index) => <article><i>{number.format(index+1)}</i><div><header><span>{item.country || 'غير معروف'}</span><strong>{number.format(item.count)}</strong></header><b><i style={`width:${(numberValue(item.count)/maxCountry)*100}%`}></i></b></div></article>)}{!countries.length && <div class="empty"><h3>لا توجد بيانات جغرافية</h3></div>}</div></section>
				<section class="panel device-panel"><header class="panel-heading"><div><span>التجربة التقنية</span><h2>الأجهزة المستخدمة</h2><p>حصة كل نوع من إجمالي الزيارات.</p></div></header><div class="device-layout"><div class="device-donut" style={`--desktop:${(numberValue(devices[0]?.count)/deviceTotal)*360}deg`}><span><strong>{number.format(deviceTotal)}</strong><small>زيارة مصنفة</small></span></div><div class="device-list">{deviceRows.map((item) => <article><i class={item.tone}><svg viewBox="0 0 24 24"><path d={item.iconPath}/></svg></i><div><span>{deviceLabel(item.name)}</span><b><i style={`width:${item.share}%`}></i></b></div><strong>{decimal.format(item.share)}%</strong></article>)}</div></div></section>
				<section class="panel sources-panel"><header class="panel-heading"><div><span>قنوات الاستحواذ</span><h2>مصادر الزيارات</h2><p>المواقع والإحالات التي جلبت الجمهور.</p></div></header><div class="source-list">{sources.slice(0,12).map((item,index) => <article><i>{number.format(index+1)}</i><div><header><span title={item.source}>{sourceLabel(item.source)}</span><strong>{number.format(item.visits)}</strong></header><b><i style={`width:${(numberValue(item.visits)/maxSource)*100}%`}></i></b></div><em class:list={{ down:numberValue(item.change)<0 }}>{numberValue(item.change)<0?'↓':'↑'} {percent(Math.abs(numberValue(item.change)))}</em></article>)}{!sources.length && <div class="empty"><h3>لا توجد مصادر زيارات مسجلة</h3></div>}</div></section>
			</div>
		</main>}

		{tab === 'realtime' && <main class="tab-panel realtime-panel" role="tabpanel">
			<section class="realtime-hero"><div class="pulse-orbit"><i></i><span><strong>{number.format(visitorStats.current)}</strong><small>نشط الآن</small></span></div><div><span>تحديث لحظي</span><h2>زوار المنصة خلال آخر 15 دقيقة</h2><p>تابع نوع الزائر وموقعه والجهاز والصفحة الحالية دون مغادرة لوحة الإدارة.</p><div><b><i></i>{number.format(visitorStats.current_members)} أعضاء</b><b><i></i>{number.format(visitorStats.current_guests)} زوار</b></div></div><a href={tabHref('realtime')}><svg viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 9a7 7 0 0 1 12-2l2 2M4 15l2 2a7 7 0 0 0 12-2"/></svg>تحديث الآن</a></section>
			<section class="panel visitors-panel"><header class="visitors-header"><div><span>قائمة المتصلين</span><h2>الجلسات النشطة</h2><p>تظهر البيانات المتاحة فقط، وتحترم الحقول غير المسجلة.</p></div><form method="get"><input type="hidden" name="tab" value="realtime"/><input type="hidden" name="days" value={days}/><label class="visitor-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input name="q" value={params.get('q') || ''} placeholder="بحث بالاسم أو IP أو الموقع..."/></label><select name="type"><option value="all" selected={visitorType==='all'}>جميع الزوار</option><option value="members" selected={visitorType==='members'}>الأعضاء فقط</option><option value="guests" selected={visitorType==='guests'}>الزوار فقط</option><option value="bots" selected={visitorType==='bots'}>البوتات فقط</option></select><button>بحث</button>{(q||visitorType!=='all')&&<a href={tabHref('realtime')}>مسح</a>}</form></header><div class="visitor-summary"><span><b>{number.format(filteredVisitors.length)}</b> جلسة مطابقة</span><span><b>{number.format(filteredVisitors.filter(item=>item.is_member).length)}</b> أعضاء</span><span><b>{number.format(filteredVisitors.filter(item=>!item.is_member&&!item.is_bot).length)}</b> زوار</span><span><b>{number.format(filteredVisitors.filter(item=>item.is_bot).length)}</b> بوتات</span></div>
				<div class="visitors-table-wrap"><table><thead><tr><th>الزائر</th><th>الموقع</th><th>الجهاز والمتصفح</th><th>الصفحة الحالية</th><th>آخر نشاط</th><th>عنوان IP</th></tr></thead><tbody>{filteredVisitors.map((item)=><tr><td><div class="visitor-id"><i class:list={{ member:item.is_member, bot:item.is_bot }}>{item.is_bot?'ب':item.is_member?String(item.user_name||'ع').slice(0,1):'ز'}</i><span><strong>{item.is_bot?'بوت':item.is_member?(item.user_name||'عضو مسجل'):'زائر'}</strong><small>{item.is_bot?'زيارة آلية':item.is_member?(item.user_email||'عضو'):'جلسة عامة'}</small></span></div></td><td><div class="location"><svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2"/></svg><span>{[item.city,item.country].filter(Boolean).join('، ')||'غير معروف'}</span></div></td><td><div class="device-info"><strong>{item.browser||'غير معروف'}</strong><small>{item.os||'نظام غير معروف'} · {deviceTypeLabel(item.device_type)}</small></div></td><td><a class="current-page" href={item.current_page_full||item.current_page||'#'} target="_blank" rel="noopener" dir="ltr">{item.current_page||'—'}</a></td><td>{formatTime(item.last_active)}</td><td><code dir="ltr">{item.ip||'—'}</code></td></tr>)}</tbody></table></div>{!filteredVisitors.length&&<div class="empty"><i><DashboardNavIcon name="users" class="size-6"/></i><h3>لا توجد جلسات مطابقة حاليًا</h3><p>جرّب إزالة البحث أو تغيير نوع الزائر.</p></div>}</section>
		</main>}

		{tab === 'performance' && <main class="tab-panel performance-panel" role="tabpanel">
			<section class="performance-metrics">
				<article class:list={['response',responseMs>500&&'danger',responseMs>150&&responseMs<=500&&'warning']}><i><svg viewBox="0 0 24 24"><path d="M4 19a8 8 0 1 1 16 0M12 13l4-4"/></svg></i><div><span>زمن الاستجابة</span><strong>{number.format(responseMs)} <small>ms</small></strong><b>{responseMs<=150?'ممتاز':responseMs<=500?'مقبول':'مرتفع'}</b></div></article>
				<article class:list={['memory',memoryPct>85&&'danger',memoryPct>65&&memoryPct<=85&&'warning']}><i><svg viewBox="0 0 24 24"><path d="M7 4h10v16H7zM10 8h4M4 8h3m10 0h3M4 12h3m10 0h3M4 16h3m10 0h3"/></svg></i><div><span>ذاكرة التطبيق</span><strong>{number.format(memoryPct)}<small>%</small></strong><b>{formatBytes(live.memory?.used)} مستخدم</b></div></article>
				<article class:list={['cache',cachePct<50&&'warning']}><i><DashboardNavIcon name="database" class="size-5"/></i><div><span>نسبة إصابة Redis</span><strong>{number.format(cachePct)}<small>%</small></strong><b>{cache.cache_size||'0 B'} حجم الكاش</b></div></article>
				<article class="runtime"><i><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM9 9h6m-6 4h6m-6 4h3"/></svg></i><div><span>Go Routines</span><strong>{number.format(goStats.goroutines)}</strong><b>{number.format(goStats.num_gc)} دورة GC</b></div></article>
			</section>
			<div class="performance-grid">
				<section class="panel resource-panel"><header class="panel-heading"><div><span>موارد التطبيق</span><h2>الذاكرة وRuntime</h2><p>مؤشرات مباشرة من عملية Go الحالية.</p></div><span class="live-chip"><i></i>Live</span></header><div class="resource-body"><div class="resource-ring" style={`--usage:${memoryPct*3.6}deg`}><span><strong>{number.format(memoryPct)}%</strong><small>ذاكرة مستخدمة</small></span></div><dl><div><dt>الذاكرة المستخدمة</dt><dd>{formatBytes(live.memory?.used)}</dd></div><div><dt>ذاكرة النظام</dt><dd>{formatBytes(live.memory?.total)}</dd></div><div><dt>ذاكرة Go المخصصة</dt><dd>{formatBytes(goStats.alloc)}</dd></div><div><dt>ذاكرة Go النظامية</dt><dd>{formatBytes(goStats.sys)}</dd></div><div><dt>أنوية المعالج</dt><dd>{number.format(live.cpu?.cores)}</dd></div><div><dt>دورات تنظيف الذاكرة</dt><dd>{number.format(goStats.num_gc)}</dd></div></dl></div></section>
				<section class="panel redis-panel"><header class="panel-heading"><div><span>طبقة التخزين المؤقت</span><h2>تشخيص Redis</h2><p>أهم المؤشرات المستخرجة من Redis INFO.</p></div><a href="/dashboard/redis">إدارة Redis</a></header><div class="redis-facts"><article><span>الإصدار</span><strong>{redisInfo.redis_version||'—'}</strong></article><article><span>العملاء</span><strong>{number.format(redisInfo.connected_clients)}</strong></article><article><span>العمليات/ث</span><strong>{number.format(redisInfo.instantaneous_ops_per_sec)}</strong></article><article><span>مدة التشغيل</span><strong>{number.format(redisInfo.uptime_in_days)} يوم</strong></article><article><span>مفاتيح مُرحّلة</span><strong>{number.format(redisInfo.evicted_keys)}</strong></article><article><span>تجزئة الذاكرة</span><strong>{decimal.format(redisInfo.mem_fragmentation_ratio)}×</strong></article></div><footer><div><span>إصابات الكاش</span><strong>{number.format(redisInfo.keyspace_hits)}</strong></div><div><span>فقد الكاش</span><strong>{number.format(redisInfo.keyspace_misses)}</strong></div><div><span>الذاكرة المستخدمة</span><strong>{redisInfo.used_memory_human||cache.cache_size||'—'}</strong></div></footer></section>
				<section class="panel retention-panel"><header class="panel-heading"><div><span>حوكمة البيانات</span><h2>سياسة الاحتفاظ</h2><p>احذف سجلات الزوار الأقدم من المدة المحددة لتقليل حجم قاعدة البيانات.</p></div><i><svg viewBox="0 0 24 24"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg></i></header><div class="retention-copy"><svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d="m9 12 2 2 4-5"/></svg><p><strong>عملية محددة النطاق</strong><span>لن تمسح بيانات المحتوى أو المستخدمين؛ تستهدف سجلات تتبع الزيارات القديمة فقط.</span></p></div><form method="post" action="/api/dashboard/analytics/prune" data-prune-form><input type="hidden" name="redirect_to" value={`/dashboard/analytics?tab=performance&days=${days}`}/><label><span>الاحتفاظ ببيانات آخر</span><select name="days"><option value="90">90 يومًا</option><option value="180">180 يومًا</option><option value="365" selected>سنة واحدة</option><option value="730">سنتين</option></select></label><button type="submit"><svg viewBox="0 0 24 24"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg>تنظيف البيانات القديمة</button></form></section>
			</div>
		</main>}
	</div>

	<dialog id="analytics-confirm" class="analytics-confirm"><div><button type="button" data-close-confirm>×</button><i><svg viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10 3h4l8 18H2Z"/></svg></i><span>إجراء صيانة</span><h2>تنظيف بيانات الزوار القديمة؟</h2><p data-confirm-copy></p><aside><strong>لن يمكن التراجع عن هذه العملية</strong><small>سيتم حذف سجلات التتبع الأقدم من المدة المختارة نهائيًا.</small></aside><footer><button type="button" data-close-confirm>إلغاء</button><button type="button" data-confirm-submit>تأكيد التنظيف</button></footer></div></dialog>

	<script>
		const pruneForm = document.querySelector<HTMLFormElement>('[data-prune-form]');
		const confirmDialog = document.getElementById('analytics-confirm') as HTMLDialogElement | null;
		pruneForm?.addEventListener('submit', (event) => {
			event.preventDefault();
			const select = pruneForm.querySelector<HTMLSelectElement>('[name="days"]');
			const option = select?.selectedOptions[0]?.textContent || 'المدة المختارة';
			const copy = confirmDialog?.querySelector<HTMLElement>('[data-confirm-copy]');
			if (copy) copy.textContent = `سيحتفظ النظام ببيانات آخر ${option} ويحذف ما هو أقدم منها.`;
			confirmDialog?.showModal();
		});
		document.querySelectorAll<HTMLButtonElement>('[data-close-confirm]').forEach((button) => button.addEventListener('click', () => confirmDialog?.close()));
		confirmDialog?.querySelector<HTMLButtonElement>('[data-confirm-submit]')?.addEventListener('click', () => { confirmDialog.close(); pruneForm?.submit(); });
		confirmDialog?.addEventListener('click', (event) => { if (event.target === confirmDialog) confirmDialog.close(); });
	</script>

