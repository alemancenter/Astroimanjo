---
// Overview tab — split out of the old single tab=overview|audience|realtime|performance page
// into its own route so each tab loads independently and only fetches what it needs (see
// AnalyticsHeader.astro for the shared hero/tab-nav, analytics-shared.css for shared tokens).
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import AnalyticsHeader from '../../../components/dashboard/AnalyticsHeader.astro';
import DashboardNavIcon from '../../../components/dashboard/DashboardNavIcon.astro';
import '../../../styles/analytics-shared.css';
import { requireDashboard, hasPermission, isAdmin } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';
import { getCountryById } from '../../../lib/countries';

const guard = await requireDashboard(Astro);
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const allowed = isAdmin(user) || hasPermission(user, 'manage monitoring') || hasPermission(user, 'manage performance');
if (!allowed) return Astro.redirect('/dashboard?error=forbidden');

const params = Astro.url.searchParams;
const days = [7, 14, 30, 90, 365].includes(Number(params.get('days'))) ? Number(params.get('days')) : 30;
const countryId = Astro.locals.countryId;
const currentCountry = getCountryById(countryId);
const cookieHeader = `token=${Astro.cookies.get('token')?.value}`;

const [visitorResult, contentResult, summaryResult] = await Promise.all([
	apiFetch<any>('/dashboard/visitor-analytics', { countryId, cookieHeader, params: { days } }),
	apiFetch<any>('/dashboard/content-analytics', { countryId, cookieHeader }),
	apiFetch<any>('/dashboard', { countryId, cookieHeader }),
]);

const visitor = visitorResult.data || {};
const visitorStats = visitor.visitor_stats || {};
const userStats = visitor.user_stats || {};
const chartData: any[] = Array.isArray(visitor.chart_data) ? visitor.chart_data : [];
const sources: any[] = Array.isArray(visitor.traffic_sources) ? visitor.traffic_sources : [];
const activeVisitors: any[] = Array.isArray(visitorStats.active_visitors) ? visitorStats.active_visitors : [];
const content = contentResult.data || {};
const summary = summaryResult.data || {};

const numberValue = (...values: unknown[]) => {
	for (const value of values) { const parsed = Number(value); if (Number.isFinite(parsed)) return parsed; }
	return 0;
};
const number = new Intl.NumberFormat('ar-EG');
const decimal = new Intl.NumberFormat('ar-EG', { maximumFractionDigits: 1 });
const periodViews = chartData.reduce((total, item) => total + numberValue(item.pageViews, item.views), 0);
const periodVisitors = chartData.reduce((total, item) => total + numberValue(item.visitors), 0);
const pagesPerVisitor = periodVisitors > 0 ? periodViews / periodVisitors : 0;
const maxChart = Math.max(1, ...chartData.flatMap((item) => [numberValue(item.pageViews), numberValue(item.visitors)]));
const chartWidth = 760;
const chartHeight = 230;
const linePoints = (key: 'pageViews' | 'visitors') => chartData.map((item, index) => {
	const x = chartData.length <= 1 ? chartWidth / 2 : (index / (chartData.length - 1)) * chartWidth;
	const y = chartHeight - (numberValue(item[key]) / maxChart) * (chartHeight - 30) - 12;
	return `${x.toFixed(1)},${y.toFixed(1)}`;
}).join(' ');
const viewPoints = linePoints('pageViews');
const visitorPoints = linePoints('visitors');
const viewArea = chartData.length ? `M0 ${chartHeight} L${viewPoints.replaceAll(' ', ' L')} L${chartWidth} ${chartHeight} Z` : '';
const published = numberValue(content.published_articles);
const drafts = numberValue(content.draft_articles);
const contentTotal = published + drafts;
const publishRate = contentTotal ? Math.round((published / contentTotal) * 100) : 0;
const topContent = [
	...(Array.isArray(content.top_articles) ? content.top_articles.map((item: any) => ({ ...item, kind: 'مقال', href: `/dashboard/articles/${item.id}/edit`, views: numberValue(item.visit_count, item.views) })) : []),
	...(Array.isArray(content.top_posts) ? content.top_posts.map((item: any) => ({ ...item, kind: 'منشور', href: `/dashboard/posts/${item.id}/edit`, views: numberValue(item.views, item.visit_count) })) : []),
].sort((a, b) => b.views - a.views).slice(0, 8);
const platformSeries = summary.analytics || {};
const platformTotals = {
	articles: (Array.isArray(platformSeries.articles) ? platformSeries.articles : []).reduce((sum: number, value: unknown) => sum + numberValue(value), 0),
	posts: (Array.isArray(platformSeries.news) ? platformSeries.news : []).reduce((sum: number, value: unknown) => sum + numberValue(value), 0),
};
const allOk = visitorResult.ok && contentResult.ok && summaryResult.ok;
const sourceLabel = (source: string) => !source || source === 'Direct' ? 'دخول مباشر' : source;
const periodLabel = days === 7 ? '7 أيام' : days === 14 ? '14 يومًا' : days === 30 ? '30 يومًا' : days === 90 ? '3 أشهر' : 'سنة';
const success = params.get('success');
const error = params.get('error');
---

<DashboardLayout title="التحليلات" description="نظرة تنفيذية على أداء المنصة" user={user}>
	<div class="analytics-page">
		<AnalyticsHeader activeTab="overview" days={days} countryName={currentCountry.name} realtimeCount={visitorResult.ok ? activeVisitors.length : undefined} allOk={allOk} error={error} success={success} />

		<main class="tab-panel" role="tabpanel">
			<section class="metric-grid">
				<article class="blue"><header><span>مشاهدات الفترة</span><i><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg></i></header><strong>{number.format(periodViews)}</strong><footer><span>خلال {periodLabel}</span><b>{decimal.format(pagesPerVisitor)} صفحة/زائر</b></footer></article>
				<article class="green"><header><span>الزوار</span><i><DashboardNavIcon name="users" class="size-5"/></i></header><strong>{number.format(periodVisitors)}</strong><footer><span>زوار الفترة المحددة</span><b class:list={{ down: numberValue(visitorStats.change) < 0 }}>{numberValue(visitorStats.change) < 0 ? '↓' : '↑'} {decimal.format(Math.abs(numberValue(visitorStats.change)))}%</b></footer></article>
				<article class="orange"><header><span>النشطون الآن</span><i><svg viewBox="0 0 24 24"><path d="M3 12h4l2-6 4 12 2-6h6"/></svg></i></header><strong>{number.format(visitorStats.current)}</strong><footer><span>{number.format(visitorStats.current_members)} عضو · {number.format(visitorStats.current_guests)} زائر</span><b class="live"><i></i>مباشر</b></footer></article>
				<article class="violet"><header><span>إجمالي المستخدمين</span><i><DashboardNavIcon name="users" class="size-5"/></i></header><strong>{number.format(userStats.total)}</strong><footer><span>{number.format(userStats.active)} حساب نشط</span><b>+{number.format(userStats.new_today)} اليوم</b></footer></article>
			</section>

			<section class="panel traffic-chart">
				<header class="panel-heading"><div><span>الاتجاه الزمني</span><h2>الزيارات والمشاهدات</h2><p>مقارنة الزوار الفريدين مع عدد الصفحات التي تمت مشاهدتها.</p></div><div class="legend"><span><i class="blue"></i>مشاهدات الصفحات</span><span><i class="green"></i>الزوار</span></div></header>
				{chartData.length ? <div class="chart-wrap"><svg viewBox={`0 0 ${chartWidth} 250`} preserveAspectRatio="none" role="img" aria-label="تطور الزيارات"><defs><linearGradient id="viewsArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1A4D8F" stop-opacity=".22"/><stop offset="100%" stop-color="#1A4D8F" stop-opacity="0"/></linearGradient></defs><g class="chart-grid"><line x1="0" x2={chartWidth} y1="35" y2="35"/><line x1="0" x2={chartWidth} y1="95" y2="95"/><line x1="0" x2={chartWidth} y1="155" y2="155"/><line x1="0" x2={chartWidth} y1="230" y2="230"/></g><path d={viewArea} fill="url(#viewsArea)"/><polyline points={viewPoints} class="views-line"/><polyline points={visitorPoints} class="visitors-line"/></svg><div class="chart-labels">{chartData.map((item) => <span>{item.name || new Date(item.full_date).toLocaleDateString('ar-EG', { day: 'numeric', month: 'short' })}</span>)}</div></div> : <div class="empty"><i><DashboardNavIcon name="analytics" class="size-6"/></i><h3>لا توجد بيانات للفترة المحددة</h3><p>ستظهر الزيارات هنا بعد تسجيل نشاط جديد.</p></div>}
				<footer class="chart-footer"><div><span>متوسط المشاهدات يوميًا</span><strong>{number.format(chartData.length ? Math.round(periodViews / chartData.length) : 0)}</strong></div><div><span>متوسط الزوار يوميًا</span><strong>{number.format(chartData.length ? Math.round(periodVisitors / chartData.length) : 0)}</strong></div><div><span>أفضل يوم</span><strong>{chartData.length ? [...chartData].sort((a,b) => numberValue(b.pageViews)-numberValue(a.pageViews))[0]?.name || '—' : '—'}</strong></div></footer>
			</section>

			<div class="overview-lower">
				<section class="panel content-performance"><header class="panel-heading"><div><span>تحليلات المحتوى</span><h2>أداء النشر</h2><p>حالة المقالات ونشاط آخر سبعة أيام.</p></div></header><div class="content-body"><div class="publish-donut" style={`--rate:${publishRate * 3.6}deg`}><span><strong>{number.format(publishRate)}%</strong><small>منشور</small></span></div><div class="content-stats"><div><span>منشور</span><strong>{number.format(published)}</strong></div><div><span>مسودة</span><strong>{number.format(drafts)}</strong></div><div><span>مقالات الأسبوع</span><strong>{number.format(platformTotals.articles)}</strong></div><div><span>منشورات الأسبوع</span><strong>{number.format(platformTotals.posts)}</strong></div></div></div></section>
				<section class="panel top-content"><header class="panel-heading"><div><span>ترتيب الأداء</span><h2>المحتوى الأعلى مشاهدة</h2><p>أفضل المقالات والمنشورات وفق الزيارات.</p></div><a href="/dashboard/articles">المحتوى</a></header>{topContent.length ? <div class="rank-list">{topContent.slice(0,5).map((item,index) => <a href={item.href}><b class:list={{ top:index<3 }}>{number.format(index+1)}</b><div><strong>{item.title || 'بدون عنوان'}</strong><span>{item.kind}</span></div><aside><svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>{number.format(item.views)}</aside></a>)}</div> : <div class="empty compact"><h3>لا توجد بيانات مشاهدة بعد</h3></div>}</section>
				<section class="panel acquisition-snapshot"><header class="panel-heading"><div><span>اكتساب الزوار</span><h2>أهم المصادر</h2><p>القنوات التي أرسلت الزيارات خلال الفترة.</p></div><a href={`/dashboard/analytics/audience?days=${days}`}>التفاصيل</a></header><div class="source-mini">{sources.slice(0,5).map((item,index) => <div><i>{number.format(index+1)}</i><span title={item.source}>{sourceLabel(item.source)}</span><b>{number.format(item.visits)}</b></div>)}{!sources.length && <div class="empty compact"><h3>لا توجد مصادر مسجلة</h3></div>}</div></section>
			</div>
		</main>
	</div>
</DashboardLayout>

<style>
	.metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-bottom:.7rem}.metric-grid article{--tone:var(--an-blue);--soft:#eaf1fa;display:flex;min-height:8.5rem;flex-direction:column;border:1px solid var(--an-line);border-radius:.8rem;background:#fff;padding:.8rem;box-shadow:0 3px 10px rgb(23 43 77/.035)}.metric-grid article.green{--tone:var(--an-green);--soft:#e4f6ef}.metric-grid article.orange{--tone:#c77a1c;--soft:#fff2df}.metric-grid article.violet{--tone:#7254a3;--soft:#f1edfa}.metric-grid header{display:flex;align-items:center;justify-content:space-between}.metric-grid header span{color:#68788d;font-size:.7rem;font-weight:800}.metric-grid header i{display:grid;width:2.3rem;height:2.3rem;place-items:center;border-radius:.58rem;background:var(--soft);color:var(--tone)}.metric-grid article>strong{margin:.3rem 0;color:var(--an-ink);font-size:1.5rem;font-weight:950}.metric-grid footer{display:flex;align-items:center;justify-content:space-between;gap:.4rem;margin-top:auto}.metric-grid footer>span{color:#8591a1;font-size:.6rem}.metric-grid footer>b{border-radius:99rem;background:#e4f6ef;padding:.22rem .4rem;color:#087559;font-size:.56rem}.metric-grid footer>b.down{background:#fff0f2;color:#b13642}.metric-grid footer>b.live{display:flex;align-items:center;gap:.25rem}.metric-grid footer>b.live i{width:.38rem;height:.38rem;border-radius:50%;background:currentColor}
	.traffic-chart{padding:1rem}.legend{display:flex;gap:.55rem}.legend span{display:flex;align-items:center;gap:.25rem;color:#758397;font-size:.59rem}.legend i{width:.42rem;height:.42rem;border-radius:50%;background:var(--an-blue)}.legend i.green{background:var(--an-green)}.chart-wrap{padding-top:.7rem}.chart-wrap svg{width:100%;height:16rem}.chart-grid line{stroke:#dfe6ed;stroke-dasharray:3 5}.chart-wrap polyline{fill:none;stroke-linecap:round;stroke-linejoin:round}.views-line{stroke:var(--an-blue);stroke-width:3}.visitors-line{stroke:var(--an-green);stroke-width:2.5}.chart-labels{display:flex;justify-content:space-between;gap:.2rem;color:#8290a1;font-size:.55rem}.chart-labels span{overflow:hidden;flex:1;text-align:center;text-overflow:ellipsis;white-space:nowrap}.chart-footer{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;border-top:1px solid #edf1f5;margin-top:.55rem;padding-top:.65rem}.chart-footer>div{display:grid;border-radius:.48rem;background:#f6f8fb;padding:.48rem}.chart-footer span{color:#788698;font-size:.59rem}.chart-footer strong{color:#304760;font-size:.72rem}
	.overview-lower{display:grid;grid-template-columns:.8fr 1fr .8fr;gap:.7rem;margin-top:.7rem}.overview-lower>.panel{padding:.9rem}.content-body{display:grid;grid-template-columns:7rem 1fr;align-items:center;gap:.6rem;padding:.7rem 0}.publish-donut{display:grid;width:6.3rem;aspect-ratio:1;place-items:center;border-radius:50%;background:conic-gradient(var(--an-green) var(--rate),#efd39f var(--rate));position:relative}.publish-donut::after{position:absolute;width:4.5rem;aspect-ratio:1;border-radius:50%;background:#fff;content:""}.publish-donut>span{display:grid;z-index:1;text-align:center}.publish-donut strong{color:var(--an-ink);font-size:.9rem}.publish-donut small{color:#7b8999;font-size:.54rem}.content-stats{display:grid;grid-template-columns:1fr 1fr;gap:.35rem}.content-stats>div{display:grid;border:1px solid #e8edf2;border-radius:.45rem;padding:.42rem}.content-stats span{color:#7b899a;font-size:.55rem}.content-stats strong{color:#344a62;font-size:.68rem}.rank-list{display:grid;padding-top:.42rem}.rank-list>a{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:.48rem;border-bottom:1px solid #edf1f5;padding:.43rem 0}.rank-list>a:last-child{border:0}.rank-list>a>b{display:grid;width:1.65rem;height:1.65rem;place-items:center;border-radius:.4rem;background:#edf1f5;color:#68778a;font-size:.58rem}.rank-list>a>b.top{background:#eaf1fa;color:var(--an-blue)}.rank-list>a>div{display:grid;min-width:0}.rank-list strong{overflow:hidden;color:#30465f;font-size:.64rem;text-overflow:ellipsis;white-space:nowrap}.rank-list span{color:#8995a4;font-size:.54rem}.rank-list aside{display:flex;align-items:center;gap:.2rem;color:#66778b;font-size:.55rem;font-weight:850}.rank-list aside svg{width:.7rem;height:.7rem}.source-mini{display:grid;padding-top:.42rem}.source-mini>div:not(.empty){display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:.4rem;border-bottom:1px solid #edf1f5;padding:.47rem 0}.source-mini>div>i{display:grid;width:1.45rem;height:1.45rem;place-items:center;border-radius:.35rem;background:#e4f6ef;color:var(--an-green);font-size:.53rem;font-style:normal}.source-mini>div>span{overflow:hidden;color:#41566e;font-size:.62rem;text-overflow:ellipsis;white-space:nowrap}.source-mini>div>b{color:#6a7a8e;font-size:.59rem}
	:global(.dark) .metric-grid article,:global(.dark) .traffic-chart{border-color:#30445d;background:#0f2547}:global(.dark) .chart-footer>div{background:#122a49}:global(.dark) .publish-donut::after{background:#0f2547}
	@media(max-width:1120px){.metric-grid{grid-template-columns:repeat(2,1fr)}.overview-lower{grid-template-columns:1fr 1fr}.acquisition-snapshot{grid-column:1/-1}}
	@media(max-width:600px){.metric-grid,.overview-lower{grid-template-columns:1fr}.chart-wrap svg{height:12rem}.chart-labels span:nth-child(even){display:none}.chart-footer{grid-template-columns:1fr}}
</style>
