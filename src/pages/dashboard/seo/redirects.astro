---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';

const guard = await requireDashboard(Astro, 'manage seo');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const token = Astro.cookies.get('token')?.value;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const logPage = Math.max(1, Number(Astro.url.searchParams.get('log_page') || 1));
const q = Astro.url.searchParams.get('q') || '';
const auth = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };
const [redirectResult, logsResult] = await Promise.all([
	apiFetch<any[]>('/dashboard/seo/redirects', { ...auth, params: { page, per_page: 30, q } }),
	apiFetch<any[]>('/dashboard/seo/404', { ...auth, params: { page: logPage, per_page: 30, resolved: false } }),
]);
const redirects = redirectResult.data || [];
const logs = logsResult.data || [];
const nf = new Intl.NumberFormat('ar-EG');
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
---
<DashboardLayout title="التحويلات وسجل 404" user={user}>
	<div class="redirect-page">
		{success&&<div class="notice is-ok">تم حفظ التغييرات.</div>}{error&&<div class="notice is-error">{error}</div>}
		<header><div><a href="/dashboard/seo">ImanSEO</a><h1>التحويلات ومراقبة الروابط المفقودة</h1><p>تحويلات آمنة مع منع الحلقات، وأنماط exact/prefix/regex، وتجميع أخطاء 404 دون تخزين عنوان IP.</p></div><form method="get"><input name="q" value={q} placeholder="بحث في التحويلات"/><button>بحث</button></form></header>
		<section class="redirect-grid">
			<main><div class="section-title"><div><span>Redirect Manager</span><h2>التحويلات</h2></div><strong>{nf.format(redirectResult.meta?.total||redirects.length)}</strong></div>
				<details class="create-box" open><summary>إضافة تحويل</summary><form method="post" action="/api/dashboard/seo/redirects/save"><label>المصدر<input name="source_path" dir="ltr" required placeholder="/jo/old-page"/></label><label>الهدف<input name="target_url" dir="ltr" placeholder="/jo/new-page"/></label><label>الحالة<select name="status_code"><option value="301">301 دائم</option><option value="302">302 مؤقت</option><option value="307">307 مؤقت</option><option value="308">308 دائم</option><option value="410">410 محذوف</option></select></label><label>المطابقة<select name="match_type"><option value="exact">مطابقة تامة</option><option value="prefix">بادئة</option><option value="regex">Regex</option></select></label><label class="check"><input type="checkbox" name="preserve_query" value="true" checked/>حفظ Query String</label><label class="check"><input type="checkbox" name="active" value="true" checked/>نشط</label><button>حفظ التحويل</button></form></details>
				<div class="redirect-list">{redirects.map((item:any)=><article><div class="redirect-line"><span class:list={['code',item.status_code===410&&'is-gone']}>{item.status_code}</span><div><strong dir="ltr">{item.source_path}</strong><small dir="ltr">{item.target_url||'Gone'}</small></div><span class:list={['state',item.active&&'is-active']}>{item.active?'نشط':'متوقف'}</span><b>{nf.format(item.hit_count||0)} زيارة</b></div><details><summary>تعديل</summary><form method="post" action="/api/dashboard/seo/redirects/save"><input type="hidden" name="id" value={item.id}/><label>المصدر<input name="source_path" dir="ltr" value={item.source_path}/></label><label>الهدف<input name="target_url" dir="ltr" value={item.target_url}/></label><select name="status_code"><option value="301" selected={item.status_code===301}>301</option><option value="302" selected={item.status_code===302}>302</option><option value="307" selected={item.status_code===307}>307</option><option value="308" selected={item.status_code===308}>308</option><option value="410" selected={item.status_code===410}>410</option></select><select name="match_type"><option value="exact" selected={item.match_type==='exact'}>exact</option><option value="prefix" selected={item.match_type==='prefix'}>prefix</option><option value="regex" selected={item.match_type==='regex'}>regex</option></select><label class="check"><input type="checkbox" name="preserve_query" value="true" checked={item.preserve_query}/>Query</label><label class="check"><input type="checkbox" name="active" value="true" checked={item.active}/>نشط</label><button>تحديث</button></form><form method="post" action={`/api/dashboard/seo/redirects/${item.id}/delete`}><button class="delete">حذف</button></form></details></article>)}{!redirects.length&&<p class="empty">لا توجد تحويلات.</p>}</div>
			</main>
			<aside><div class="section-title"><div><span>404 Monitor</span><h2>الروابط المفقودة</h2></div><strong>{nf.format(logsResult.meta?.total||logs.length)}</strong></div><div class="log-list">{logs.map((log:any)=><article><header><strong dir="ltr">{log.path}</strong><span>{nf.format(log.hit_count)} مرة</span></header><small>{new Date(log.last_seen_at).toLocaleString('ar-EG')}</small>{log.last_referrer&&<p dir="ltr">من: {log.last_referrer}</p>}<form method="post" action="/api/dashboard/seo/redirects/save"><input type="hidden" name="source_path" value={log.path}/><input type="hidden" name="status_code" value="301"/><input type="hidden" name="match_type" value="exact"/><input type="hidden" name="preserve_query" value="true"/><input type="hidden" name="active" value="true"/><input type="hidden" name="log_id" value={log.id}/><input name="target_url" dir="ltr" required placeholder="الرابط البديل"/><button>إنشاء 301 ومعالجة</button></form><form method="post" action={`/api/dashboard/seo/404/${log.id}/resolve`}><button class="ignore">تعليم كمعالج</button></form></article>)}{!logs.length&&<p class="empty">لا توجد أخطاء 404 غير معالجة.</p>}</div></aside>
		</section>
	</div>
	<style>.redirect-page{--r-line:#dce5ee;--r-ink:#17314b;--r-blue:#1a4d8f;display:grid;gap:.75rem;direction:rtl}.notice{border:1px solid;border-radius:.55rem;padding:.55rem;font-size:.65rem}.notice.is-ok{border-color:#b9e3d4;background:#f1faf7;color:#08765a}.notice.is-error{border-color:#edc8cc;background:#fff5f6;color:#a93440}.redirect-page>header{display:flex;align-items:center;justify-content:space-between;gap:1rem;border:1px solid var(--r-line);border-radius:.8rem;background:#fff;padding:.9rem}.redirect-page>header a,.section-title span{color:var(--r-blue);font-size:.58rem;font-weight:850}.redirect-page h1{margin:.1rem 0;color:var(--r-ink);font-size:1.15rem}.redirect-page>header p{margin:0;color:#718096;font-size:.62rem}.redirect-page>header form{display:flex}.redirect-page input,.redirect-page select{min-height:2.25rem;border:1px solid #d8e2ec;border-radius:.38rem;background:#fff;padding:.35rem .5rem;font-family:inherit;font-size:.59rem}.redirect-page button{border:0;border-radius:.38rem;background:var(--r-blue);padding:.4rem .65rem;color:#fff;font-family:inherit;font-size:.58rem;font-weight:850}.redirect-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(18rem,.65fr);align-items:start;gap:.65rem}.redirect-grid>main,.redirect-grid>aside{border:1px solid var(--r-line);border-radius:.7rem;background:#fff;padding:.7rem}.section-title{display:flex;align-items:center;justify-content:space-between}.section-title h2{margin:.1rem 0;color:var(--r-ink);font-size:.82rem}.section-title>strong{border-radius:.35rem;background:#edf4fc;padding:.25rem .4rem;color:var(--r-blue);font-size:.58rem}.create-box{margin:.6rem 0;border:1px solid #dce6f0;border-radius:.5rem;background:#f8fbff}.create-box summary,.redirect-list article>details>summary{cursor:pointer;padding:.5rem;color:var(--r-blue);font-size:.59rem;font-weight:850}.create-box form,.redirect-list details form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem;padding:.55rem}.create-box label,.redirect-list label{display:grid;gap:.15rem;color:#536a80;font-size:.52rem}.create-box .check,.redirect-list .check{display:flex;align-items:center}.check input{min-height:0}.redirect-list{display:grid}.redirect-list>article{border-top:1px solid #edf1f5;padding:.45rem 0}.redirect-line{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;align-items:center;gap:.45rem}.redirect-line .code{border-radius:.3rem;background:#e9f4ef;padding:.25rem;color:#08765a;font-size:.55rem;font-weight:900}.redirect-line .code.is-gone{background:#fee9eb;color:#ac3541}.redirect-line>div{display:grid;min-width:0}.redirect-line>div strong,.redirect-line>div small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.redirect-line>div strong{color:var(--r-ink);font-size:.57rem}.redirect-line>div small{color:#7d8b9b;font-size:.5rem}.redirect-line .state{border-radius:99rem;background:#eef1f4;padding:.2rem .35rem;color:#7c8896;font-size:.48rem}.redirect-line .state.is-active{background:#e5f5ef;color:#08765a}.redirect-line>b{color:#75869a;font-size:.5rem}.redirect-list details{margin-right:2.1rem}.redirect-list details form+form{display:block;padding-top:0}.redirect-list button.delete{background:#fff0f1;color:#ae3541}.log-list{display:grid}.log-list>article{border-top:1px solid #edf1f5;padding:.55rem 0}.log-list article>header{display:flex;justify-content:space-between}.log-list header strong{max-width:75%;overflow:hidden;color:var(--r-ink);font-size:.57rem;text-overflow:ellipsis}.log-list header span{color:#b35a19;font-size:.5rem;font-weight:850}.log-list article>small,.log-list article>p{color:#8492a2;font-size:.48rem}.log-list article>p{overflow:hidden;margin:.15rem 0;text-overflow:ellipsis}.log-list article form{display:flex;margin-top:.35rem}.log-list article form input{min-width:0;flex:1}.log-list button.ignore{background:transparent;color:#718096;padding-right:0}.empty{text-align:center;color:#718096;font-size:.6rem}:global(.dark) .redirect-page{--r-line:#30465e;--r-ink:#edf4fa}:global(.dark) .redirect-page>header,:global(.dark) .redirect-grid>main,:global(.dark) .redirect-grid>aside{background:#102744}:global(.dark) .redirect-page input,:global(.dark) .redirect-page select{border-color:#3a5069;background:#0e223b;color:#e7eef6}:global(.dark) .create-box{border-color:#354b64;background:#122b49}@media(max-width:950px){.redirect-grid{grid-template-columns:1fr}}@media(max-width:600px){.redirect-page>header{align-items:stretch;flex-direction:column}.create-box form,.redirect-list details form{grid-template-columns:1fr}.redirect-line{grid-template-columns:auto minmax(0,1fr)}.redirect-line .state,.redirect-line>b{display:none}}</style>
</DashboardLayout>
