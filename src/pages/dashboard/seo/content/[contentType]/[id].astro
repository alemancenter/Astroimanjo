---
import DashboardLayout from '../../../../../layouts/DashboardLayout.astro';
import { requireDashboard } from '../../../../../lib/auth';
import { apiFetch } from '../../../../../lib/api';
const {contentType,id}=Astro.params;if(!['article','post'].includes(contentType||'')||!/^\d+$/.test(id||''))return Astro.redirect('/dashboard/seo');
const guard=await requireDashboard(Astro,['manage seo',contentType==='article'?'manage articles':'manage posts']);if('redirect'in guard)return guard.redirect;const{user}=guard;
const auth={countryId:Astro.locals.countryId,cookieHeader:`token=${Astro.cookies.get('token')?.value}`};const[metadataResult,revisionsResult,linksResult]=await Promise.all([apiFetch<any>(`/dashboard/seo/metadata/${contentType}/${id}`,auth),apiFetch<any[]>(`/dashboard/seo/metadata/${contentType}/${id}/revisions`,auth),apiFetch<any[]>(`/dashboard/seo/links/${contentType}/${id}`,auth)]);const metadata=metadataResult.data;const revisions=revisionsResult.data||[];const links=linksResult.data||[];let analysis:any=null;try{analysis=metadata?.analysis_json?JSON.parse(metadata.analysis_json):null}catch{}const nf=new Intl.NumberFormat('ar-EG');const editURL=contentType==='article'?`/dashboard/articles/${id}/edit`:`/dashboard/posts/${id}/edit`;const success=Astro.url.searchParams.get('success');
---
<DashboardLayout title={`تفاصيل SEO #${id}`} user={user}><div class="seo-content-detail">{success&&<div class="detail-note">تمت استعادة النسخة وحفظ نسخة جديدة من الحالة الحالية.</div>}<header><div><a href="/dashboard/seo">ImanSEO</a><h1>{contentType==='article'?'المقال':'المنشور'} #{id}</h1><p>السجل، التحليل، وإشارات البحث لهذا المحتوى.</p></div><a class="edit" href={editURL}>فتح المحرر</a></header><section class="detail-metrics"><article><span>درجة SEO</span><strong>{nf.format(metadata?.score||0)}/100</strong></article><article><span>العبارة الرئيسية</span><strong>{metadata?.focus_keyword||'غير محددة'}</strong></article><article><span>الفهرسة</span><strong>{metadata?.robots_index===false?'noindex':'index'}</strong></article><article><span>Schema</span><strong>{metadata?.schema_type||'Article'}</strong></article></section><section class="detail-grid"><main><header><span>التحليل الحالي</span><h2>نتائج الفحص</h2></header><div class="checks">{analysis?.checks?.map((check:any)=><article><i class={`is-${check.status}`}>{check.status==='good'?'✓':check.status==='error'?'!':'•'}</i><div><strong>{check.message}</strong><small>{check.recommendation||check.code}</small></div><b>{check.points}/{check.max_points}</b></article>)}{!analysis&&<p>أعد حفظ المحتوى من المحرر لإنشاء تحليل حديث.</p>}</div><header><span>Link Assistant</span><h2>روابط داخلية مقترحة</h2></header><div class="links">{links.map((item:any)=><article><div><strong>{item.title}</strong><small dir="ltr">{item.url}</small></div><b>{item.score}%</b></article>)}{!links.length&&<p>لا توجد اقتراحات قوية.</p>}</div></main><aside><header><span>SEO Revisions</span><h2>النسخ السابقة</h2></header><div>{revisions.map((revision:any)=><article><div><strong>النسخة {revision.version}</strong><small>{new Date(revision.created_at).toLocaleString('ar-EG')}</small><p>{revision.change_note||'حفظ تلقائي'}</p></div><form method="post" action={`/api/dashboard/seo/content/${contentType}/${id}/restore`}><input type="hidden" name="revision_id" value={revision.id}/><button>استعادة</button></form></article>)}{!revisions.length&&<p>لا توجد نسخ بعد.</p>}</div></aside></section></div><style>.seo-content-detail{--d-line:#dce5ee;--d-ink:#17314b;--d-blue:#1a4d8f;display:grid;gap:.7rem;direction:rtl}.detail-note{border:1px solid #b9e3d4;border-radius:.55rem;background:#f1faf7;padding:.55rem;color:#08765a;font-size:.62rem}.seo-content-detail>header{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--d-line);border-radius:.8rem;background:#fff;padding:.9rem}.seo-content-detail>header a:not(.edit),.detail-grid header span{color:var(--d-blue);font-size:.56rem;font-weight:850}.seo-content-detail h1{margin:.1rem 0;color:var(--d-ink);font-size:1.1rem}.seo-content-detail>header p{margin:0;color:#718096;font-size:.6rem}.seo-content-detail>header .edit{border-radius:.4rem;background:var(--d-blue);padding:.45rem .7rem;color:#fff;font-size:.58rem;font-weight:850}.detail-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:.55rem}.detail-metrics article{border:1px solid var(--d-line);border-radius:.6rem;background:#fff;padding:.6rem}.detail-metrics span{display:block;color:#718096;font-size:.52rem}.detail-metrics strong{display:block;overflow:hidden;color:var(--d-ink);font-size:.72rem;text-overflow:ellipsis;white-space:nowrap}.detail-grid{display:grid;grid-template-columns:minmax(0,1fr) 18rem;align-items:start;gap:.6rem}.detail-grid>main,.detail-grid>aside{border:1px solid var(--d-line);border-radius:.7rem;background:#fff;padding:.65rem}.detail-grid header{border-bottom:1px solid #edf1f5;padding:.4rem}.detail-grid h2{margin:.1rem 0;color:var(--d-ink);font-size:.75rem}.checks{display:grid;grid-template-columns:repeat(2,1fr);gap:.35rem;padding:.5rem 0}.checks article{display:grid;grid-template-columns:auto 1fr auto;gap:.4rem;border:1px solid #e6ebf1;border-radius:.4rem;padding:.4rem}.checks i{display:grid;width:1.25rem;height:1.25rem;place-items:center;border-radius:50%;background:#edf1f5;color:#708095;font-size:.5rem;font-style:normal}.checks i.is-good{background:#e3f5ee;color:#08765a}.checks i.is-error{background:#fee8ea;color:#ac3541}.checks article>div{display:grid}.checks strong,.links strong{color:var(--d-ink);font-size:.54rem}.checks small,.links small{color:#8290a0;font-size:.47rem}.checks b,.links b{color:var(--d-blue);font-size:.52rem}.links article{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #edf1f5;padding:.45rem}.links article>div{display:grid}.detail-grid>aside>div>article{display:flex;justify-content:space-between;border-top:1px solid #edf1f5;padding:.5rem}.detail-grid aside article>div{display:grid}.detail-grid aside strong{font-size:.55rem}.detail-grid aside small,.detail-grid aside p,.detail-grid aside>div>p{margin:.1rem 0;color:#8290a0;font-size:.47rem}.detail-grid aside button{border:1px solid #b9cde4;border-radius:.35rem;background:#fff;padding:.3rem;color:var(--d-blue);font-family:inherit;font-size:.5rem;font-weight:850}:global(.dark) .seo-content-detail{--d-line:#30465e;--d-ink:#edf4fa}:global(.dark) .seo-content-detail>header,:global(.dark) .detail-metrics article,:global(.dark) .detail-grid>main,:global(.dark) .detail-grid>aside{background:#102744}@media(max-width:850px){.detail-grid{grid-template-columns:1fr}}@media(max-width:600px){.detail-metrics,.checks{grid-template-columns:repeat(2,1fr)}}</style></DashboardLayout>
