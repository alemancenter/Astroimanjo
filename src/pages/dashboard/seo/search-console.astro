---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';
import { getCountryById } from '../../../lib/countries';

const guard=await requireDashboard(Astro,'manage seo'); if('redirect'in guard)return guard.redirect; const{user}=guard;
const country=getCountryById(Astro.locals.countryId); const token=Astro.cookies.get('token')?.value; const days=[7,30,90,180].includes(Number(Astro.url.searchParams.get('days')))?Number(Astro.url.searchParams.get('days')):30; const page=Math.max(1,Number(Astro.url.searchParams.get('page')||1)); const q=Astro.url.searchParams.get('q')||'';
const auth={countryId:Astro.locals.countryId,cookieHeader:`token=${token}`};
const [propertiesResult,keywordsResult,analyticsResult]=await Promise.all([apiFetch<any[]>('/dashboard/gsc/properties',auth),apiFetch<any[]>('/dashboard/gsc/keywords',{...auth,params:{country_code:country.code,days,page,per_page:50,q}}),apiFetch<any[]>('/dashboard/gsc/analytics',{...auth,params:{country_code:country.code,days}})]);
const properties=propertiesResult.data||[]; const property=properties.find((item:any)=>item.country_code===country.code); const keywords=keywordsResult.data||[]; const keywordMeta=keywordsResult.meta; const analytics=analyticsResult.data||[];
const totals=analytics.reduce((a:any,r:any)=>({clicks:a.clicks+Number(r.clicks||0),impressions:a.impressions+Number(r.impressions||0),weighted:a.weighted+Number(r.position||0)*Number(r.impressions||0)}),{clicks:0,impressions:0,weighted:0}); const ctr=totals.impressions?totals.clicks/totals.impressions*100:0; const position=totals.impressions?totals.weighted/totals.impressions:0; const nf=new Intl.NumberFormat('ar-EG'); const dec=new Intl.NumberFormat('ar-EG',{maximumFractionDigits:1}); const success=Astro.url.searchParams.get('success'); const error=Astro.url.searchParams.get('error');
---
<DashboardLayout title="Google Search Console" user={user}>
<div class="gsc-page">{success&&<div class="gsc-note is-ok">بدأت العملية. قد تتأخر بيانات Google من يومين إلى ثلاثة أيام.</div>}{error&&<div class="gsc-note is-error">{error}</div>}
<header><div><a href="/dashboard/seo">ImanSEO</a><h1>إحصاءات البحث وتتبع العبارات</h1><p>بيانات حقيقية من Google: النقرات والظهور وCTR ومتوسط الترتيب، مع مزامنة حالة الفهرسة.</p></div><aside><span>{country.flag}</span><strong>{property?.site_url||'لم تُضبط الخاصية'}</strong><i class:list={{active:property?.active}}>{property?.active?'متصل':'غير مهيأ'}</i></aside></header>
<section class="gsc-stats"><article><span>النقرات</span><strong>{nf.format(totals.clicks)}</strong></article><article><span>مرات الظهور</span><strong>{nf.format(totals.impressions)}</strong></article><article><span>CTR</span><strong>{dec.format(ctr)}%</strong></article><article><span>متوسط الترتيب</span><strong>{position?dec.format(position):'—'}</strong></article></section>
<section class="gsc-layout"><main><header><div><span>Rank Tracker</span><h2>عبارات البحث</h2></div><form method="get"><select name="days">{[7,30,90,180].map(d=><option value={d} selected={days===d}>{d} يومًا</option>)}</select><input name="q" value={q} placeholder="بحث في العبارات"/><button>تطبيق</button></form></header><div class="gsc-table"><table><thead><tr><th>عبارة البحث</th><th>النقرات</th><th>الظهور</th><th>CTR</th><th>الترتيب</th><th>الصفحات</th></tr></thead><tbody>{keywords.map((row:any)=><tr><td><strong>{row.query}</strong><small>{new Date(row.last_date).toLocaleDateString('ar-EG')}</small></td><td>{nf.format(row.clicks)}</td><td>{nf.format(row.impressions)}</td><td>{dec.format(Number(row.ctr||0)*100)}%</td><td><b class:list={{top:Number(row.position)<=10}}>{dec.format(row.position)}</b></td><td>{nf.format(row.pages)}</td></tr>)}</tbody></table>{!keywords.length&&<p>لا توجد بيانات عبارات بعد. اضبط الخاصية وشغّل مزامنة الأداء.</p>}</div>{keywordMeta && <Pagination currentPage={keywordMeta.current_page} lastPage={keywordMeta.last_page} url={Astro.url} />}</main>
<aside><section><span>إعداد الخاصية</span><h2>ربط الدولة الحالية</h2><form method="post" action="/api/dashboard/seo/gsc/property"><input type="hidden" name="country_code" value={country.code}/><label>Search Console Property<input name="site_url" dir="ltr" required value={property?.site_url||''} placeholder="sc-domain:imanjo.com"/></label><label class="check"><input type="checkbox" name="active" value="true" checked={property?.active??true}/>فعّالة</label><button>حفظ الخاصية</button></form><small>يجب إضافة البريد الخاص بالحساب الخدمي مستخدمًا في Search Console أولًا.</small></section><section><span>المزامنة</span><h2>تحديث البيانات</h2><form method="post" action="/api/dashboard/seo/gsc/sync-analytics"><input type="hidden" name="country_code" value={country.code}/><button>مزامنة الأداء والعبارات</button></form><form method="post" action="/api/dashboard/seo/gsc/sync-index"><input type="hidden" name="country_code" value={country.code}/><button class="secondary">فحص فهرسة أحدث 100 صفحة</button></form></section><section><span>اختبار مباشر</span><h2>URL Inspection</h2><form method="post" action="/api/dashboard/seo/gsc/test"><input type="hidden" name="country_code" value={country.code}/><input name="url" type="url" dir="ltr" required placeholder="https://imanjo.com/..."/><button class="secondary">اختبار الاتصال والرابط</button></form></section></aside></section></div>
<style>.gsc-page{--g-line:#dce5ee;--g-ink:#17314b;--g-blue:#1a4d8f;display:grid;gap:.7rem;direction:rtl}.gsc-note{border:1px solid;border-radius:.55rem;padding:.55rem;font-size:.62rem}.gsc-note.is-ok{border-color:#b9e3d4;background:#f1faf7;color:#08765a}.gsc-note.is-error{border-color:#ecc8cc;background:#fff5f6;color:#a93440}.gsc-page>header{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--g-line);border-radius:.8rem;background:#fff;padding:.9rem}.gsc-page>header a,.gsc-layout main>header span,.gsc-layout>aside section>span{color:var(--g-blue);font-size:.57rem;font-weight:850}.gsc-page h1{margin:.12rem 0;color:var(--g-ink);font-size:1.15rem}.gsc-page>header p{margin:0;color:#718096;font-size:.62rem}.gsc-page>header aside{display:grid;justify-items:center}.gsc-page>header aside>span{font-size:1.4rem}.gsc-page>header aside>strong{max-width:16rem;overflow:hidden;font-size:.55rem;text-overflow:ellipsis}.gsc-page>header aside>i{margin-top:.15rem;border-radius:99rem;background:#eef1f4;padding:.2rem .4rem;color:#7b8796;font-size:.48rem;font-style:normal}.gsc-page>header aside>i.active{background:#e4f5ef;color:#08765a}.gsc-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.55rem}.gsc-stats article{border:1px solid var(--g-line);border-radius:.65rem;background:#fff;padding:.65rem}.gsc-stats span{display:block;color:#718096;font-size:.56rem}.gsc-stats strong{color:var(--g-ink);font-size:1rem}.gsc-layout{display:grid;grid-template-columns:minmax(0,1fr) 18rem;align-items:start;gap:.65rem}.gsc-layout>main,.gsc-layout>aside>section{border:1px solid var(--g-line);border-radius:.7rem;background:#fff}.gsc-layout main>header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edf1f5;padding:.65rem}.gsc-layout h2{margin:.1rem 0;color:var(--g-ink);font-size:.78rem}.gsc-layout main form{display:flex}.gsc-page input,.gsc-page select{min-height:2.2rem;border:1px solid #d8e2ec;border-radius:.38rem;background:#fff;padding:.35rem .5rem;font-family:inherit;font-size:.56rem}.gsc-page button{border:0;border-radius:.38rem;background:var(--g-blue);padding:.4rem .65rem;color:#fff;font-family:inherit;font-size:.56rem;font-weight:850}.gsc-page button.secondary{border:1px solid #b9cde4;background:#fff;color:var(--g-blue)}.gsc-table{overflow:auto}.gsc-table table{width:100%;border-collapse:collapse}.gsc-table th{background:#f8fafc;padding:.48rem;text-align:right;color:#708095;font-size:.52rem}.gsc-table td{border-top:1px solid #edf1f5;padding:.5rem;color:#53697f;font-size:.56rem}.gsc-table td:first-child strong,.gsc-table td:first-child small{display:block}.gsc-table td:first-child strong{color:var(--g-ink);font-size:.58rem}.gsc-table td:first-child small{color:#8996a5;font-size:.47rem}.gsc-table td b{border-radius:.3rem;background:#fff1df;padding:.2rem;color:#a66616}.gsc-table td b.top{background:#e3f5ee;color:#08765a}.gsc-table>p{text-align:center;color:#718096;font-size:.6rem}.gsc-layout>aside{display:grid;gap:.55rem}.gsc-layout>aside section{padding:.65rem}.gsc-layout>aside form{display:grid;gap:.4rem;margin-top:.5rem}.gsc-layout>aside label{display:grid;gap:.2rem;color:#52677d;font-size:.53rem}.gsc-layout>aside label.check{display:flex;align-items:center}.gsc-layout>aside .check input{min-height:0}.gsc-layout>aside section>small{display:block;margin-top:.4rem;color:#8492a2;font-size:.48rem;line-height:1.6}:global(.dark) .gsc-page{--g-line:#30465e;--g-ink:#edf4fa}:global(.dark) .gsc-page>header,:global(.dark) .gsc-stats article,:global(.dark) .gsc-layout>main,:global(.dark) .gsc-layout>aside>section{background:#102744}:global(.dark) .gsc-page input,:global(.dark) .gsc-page select{border-color:#3a5069;background:#0e223b;color:#e7eef6}:global(.dark) .gsc-table th{background:#132c49}@media(max-width:900px){.gsc-layout{grid-template-columns:1fr}}@media(max-width:600px){.gsc-stats{grid-template-columns:repeat(2,1fr)}.gsc-page>header{align-items:flex-start;flex-direction:column}.gsc-layout main>header{align-items:stretch;flex-direction:column}.gsc-layout main form{flex-wrap:wrap}}</style>
</DashboardLayout>
