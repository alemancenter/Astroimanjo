---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DashboardAlert from '../../../components/ui/DashboardAlert.astro';
import ArticleForm from '../../../components/dashboard/ArticleForm.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';

const guard = await requireDashboard(Astro, 'manage articles');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;

const result = await apiFetch<any>('/dashboard/articles/create', {
	countryId: Astro.locals.countryId,
	cookieHeader: `token=${Astro.cookies.get('token')?.value}`,
});
const data = result.data;
---

<DashboardLayout title="مقال جديد" user={user}>
	<DashboardAlert />
	<ArticleForm classes={data?.classes ?? []} countryId={Astro.locals.countryId} />
</DashboardLayout>
