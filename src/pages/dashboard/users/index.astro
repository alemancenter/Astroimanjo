---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DashboardAlert from '../../../components/ui/DashboardAlert.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { requireDashboard, hasPermission } from '../../../lib/auth';
import { apiFetchList } from '../../../lib/api';
import { assetUrl } from '../../../lib/assets';

const guard = await requireDashboard(Astro, 'manage users');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;

const validStatuses = new Set(['active', 'inactive', 'banned']);
const search = (Astro.url.searchParams.get('search') || '').trim();
const requestedStatus = Astro.url.searchParams.get('status') || '';
const status = validStatuses.has(requestedStatus) ? requestedStatus : '';
const role = (Astro.url.searchParams.get('role') || '').trim();
const requestedVerification = Astro.url.searchParams.get('email_verified') || '';
const emailVerified = requestedVerification === 'verified' || requestedVerification === 'unverified' ? requestedVerification : '';
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const page = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const token = Astro.cookies.get('token')?.value;
const authOptions = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };

const [listResult, rolesResult, allCount, activeCount, inactiveCount, bannedCount] = await Promise.all([
	apiFetchList<any>('/dashboard/users', { ...authOptions, params: { search, status, role, email_verified: emailVerified, page, per_page: 20 } }),
	apiFetchList<any>('/dashboard/roles', { ...authOptions, params: { per_page: 200 } }),
	apiFetchList<any>('/dashboard/users', { ...authOptions, params: { page: 1, per_page: 1 } }),
	apiFetchList<any>('/dashboard/users', { ...authOptions, params: { status: 'active', page: 1, per_page: 1 } }),
	apiFetchList<any>('/dashboard/users', { ...authOptions, params: { status: 'inactive', page: 1, per_page: 1 } }),
	apiFetchList<any>('/dashboard/users', { ...authOptions, params: { status: 'banned', page: 1, per_page: 1 } }),
]);

const users = listResult.items;
const meta = listResult.meta;
const total = meta?.total ?? users.length;
const counts = {
	all: allCount.meta?.total ?? allCount.items.length,
	active: activeCount.meta?.total ?? activeCount.items.length,
	inactive: inactiveCount.meta?.total ?? inactiveCount.items.length,
	banned: bannedCount.meta?.total ?? bannedCount.items.length,
};
const statusLabels: Record<string, string> = { active: 'نشط', inactive: 'غير نشط', banned: 'محظور' };
const canManageRoles = hasPermission(user, 'manage roles');
const currentUrl = `${Astro.url.pathname}${Astro.url.search}`;
const nowTime = Date.now();

function initials(name: string): string {
	const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
	if (!parts.length) return '؟';
	return parts.length === 1 ? parts[0].slice(0, 2) : `${parts[0][0] || ''}${parts[1][0] || ''}`;
}

function filterUrl(nextStatus: string): string {
	const params = new URLSearchParams(Astro.url.searchParams);
	if (nextStatus) params.set('status', nextStatus); else params.delete('status');
	params.delete('page');
	return `/dashboard/users${params.size ? `?${params.toString()}` : ''}`;
}

function activityInfo(target: any) {
	const value = target.last_activity || target.last_seen;
	if (!value) return { online: false, label: 'لا يوجد نشاط مسجل' };
	const time = new Date(value).getTime();
	const online = Number.isFinite(time) && nowTime - time < 5 * 60 * 1000;
	return { online, label: online ? 'متصل الآن' : new Date(value).toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' }) };
}
---

<DashboardLayout title="إدارة المستخدمين" user={user}>
	<DashboardAlert />

	<div class="users-page">
		<header class="users-page-header">
			<div><span class="users-eyebrow">إدارة الحسابات</span><h1>المستخدمون</h1><p>راجع الحسابات وحالاتها، وأدِر الأدوار والوصول إلى المنصة من مكان واحد.</p></div>
			{canManageRoles && <button type="button" class="users-create-button" data-open-create><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-width="1.8" d="M12 5v14M5 12h14" /></svg>مستخدم جديد</button>}
		</header>

		<section class="users-summary" aria-label="ملخص حالات المستخدمين">
			<a href={filterUrl('')} class:list={['users-summary-item', !status && 'is-selected']}><span class="is-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="3.5" /><path stroke-linecap="round" stroke-width="1.7" d="M4.5 20c.5-4.2 3-6.5 7.5-6.5s7 2.3 7.5 6.5" /></svg></span><p>إجمالي المستخدمين<strong>{counts.all.toLocaleString('ar-EG')}</strong></p></a>
			<a href={filterUrl('active')} class:list={['users-summary-item', status === 'active' && 'is-selected']}><span class="is-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m5 12 4 4L19 6" /></svg></span><p>حسابات نشطة<strong>{counts.active.toLocaleString('ar-EG')}</strong></p></a>
			<a href={filterUrl('inactive')} class:list={['users-summary-item', status === 'inactive' && 'is-selected']}><span class="is-gray"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="8" /><path stroke-linecap="round" stroke-width="1.8" d="M8 12h8" /></svg></span><p>غير نشطة<strong>{counts.inactive.toLocaleString('ar-EG')}</strong></p></a>
			<a href={filterUrl('banned')} class:list={['users-summary-item', status === 'banned' && 'is-selected']}><span class="is-red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="8" /><path stroke-linecap="round" stroke-width="1.8" d="m7 7 10 10" /></svg></span><p>حسابات محظورة<strong>{counts.banned.toLocaleString('ar-EG')}</strong></p></a>
		</section>

		<section class="users-filter-card" aria-label="البحث والتصفية">
			<form method="get" class="users-filter-form">
				<label class="users-search-field"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7" /><path stroke-linecap="round" stroke-width="1.8" d="m16.5 16.5 4 4" /></svg><input type="search" name="search" value={search} placeholder="ابحث بالاسم أو البريد الإلكتروني..." aria-label="البحث في المستخدمين" /></label>
				<label class="users-select-field"><span>الحالة</span><select name="status"><option value="" selected={!status}>جميع الحالات</option><option value="active" selected={status === 'active'}>نشط</option><option value="inactive" selected={status === 'inactive'}>غير نشط</option><option value="banned" selected={status === 'banned'}>محظور</option></select></label>
				<label class="users-select-field"><span>توثيق البريد</span><select name="email_verified"><option value="" selected={!emailVerified}>الكل</option><option value="verified" selected={emailVerified === 'verified'}>بريد موثّق</option><option value="unverified" selected={emailVerified === 'unverified'}>بريد غير موثّق</option></select></label>
				<label class="users-select-field"><span>الدور</span><select name="role"><option value="" selected={!role}>جميع الأدوار</option>{rolesResult.items.map((item: any) => <option value={item.name} selected={role === item.name}>{item.name}</option>)}</select></label>
				<button type="submit" class="users-filter-button">تطبيق</button>
				{(search || status || role || emailVerified) && <a href="/dashboard/users" class="users-clear-button">مسح التصفية</a>}
			</form>
			<div class="users-result-count"><strong>{total.toLocaleString('ar-EG')}</strong><span>مستخدم</span></div>
		</section>

		<form id="users-bulk-form" method="post" action="/api/dashboard/users/bulk-action" class="users-bulk-bar" data-bulk-form hidden>
			<input type="hidden" name="redirect_to" value={currentUrl} />
			<div><strong id="users-selected-count">٠</strong><span>حسابات محددة</span></div>
			<div class="users-bulk-actions"><button type="submit" name="operation" value="active">تفعيل</button><button type="submit" name="operation" value="inactive">تعطيل</button><button type="submit" name="operation" value="banned" class="is-ban">حظر</button><button type="submit" name="operation" value="delete" class="is-delete"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16m-10 4v6m4-6v6m-7-10 .8 13h8.4L17 7m-7-3h4l1 3H9l1-3Z" /></svg>حذف المحدد</button></div>
		</form>

		{!listResult.ok ? (
			<section class="users-error"><strong>تعذّر تحميل المستخدمين</strong><p>{listResult.message}</p><a href={Astro.url.pathname}>إعادة المحاولة</a></section>
		) : (
			<>
				<section class="users-table-card users-desktop">
					<div class="users-table-heading"><div><h2>قائمة المستخدمين</h2><p>الحسابات مرتبة من الأحدث تسجيلًا.</p></div><span>{users.length.toLocaleString('ar-EG')} نتيجة في الصفحة</span></div>
					<div class="users-table-scroll"><table><thead><tr><th class="users-check-cell"><input id="users-select-all" type="checkbox" aria-label="تحديد جميع المستخدمين في الصفحة" /></th><th>المستخدم</th><th>الأدوار</th><th>الحالة</th><th>توثيق البريد</th><th>آخر نشاط</th><th>تاريخ التسجيل</th><th><span class="sr-only">الإجراءات</span></th></tr></thead><tbody>
						{users.map((target: any) => {
							const self = String(target.id) === String(user.id);
							const photo = assetUrl(target.profile_photo_path, 80);
							const activity = activityInfo(target);
							return <tr class:list={[self && 'is-self']}><td class="users-check-cell"><input class="users-row-check" type="checkbox" name="ids" value={target.id} form="users-bulk-form" disabled={self} aria-label={`تحديد ${target.name}`} /></td><td><div class="users-identity">{photo ? <img src={photo} alt="" loading="lazy" /> : <span class={`avatar-tone-${Number(target.id) % 5}`}>{initials(target.name)}</span>}<div><a href={`/dashboard/users/${target.id}/edit`}>{target.name}{self && <small class="users-self-label">أنت</small>}</a><p dir="ltr">{target.email}</p><small>#{target.id}</small></div></div></td><td><div class="users-roles">{target.roles?.length ? target.roles.map((item: any) => <span>{item.name}</span>) : <em>دون دور</em>}</div></td><td><span class={`users-status is-${target.status || 'inactive'}`}><i></i>{statusLabels[target.status] || target.status || 'غير نشط'}</span></td><td>{target.email_verified_at ? <span class="users-verification is-verified"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m5 12 4 4L19 6" /></svg>موثّق</span> : <span class="users-verification">غير موثّق</span>}</td><td><span class:list={['users-activity', activity.online && 'is-online']}><i></i><strong>{activity.label}</strong></span></td><td><time datetime={target.created_at}>{target.created_at ? new Date(target.created_at).toLocaleDateString('ar-EG', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}</time></td><td><div class="users-actions"><a href={`/dashboard/users/${target.id}/edit`} class="users-role-button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 12s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z" /><circle cx="12" cy="12" r="2" /></svg>عرض الملف</a>{!self && <details class="users-more"><summary aria-label={`إجراءات ${target.name}`}><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="19" cy="12" r="1.5" /></svg></summary><div>{(['active', 'inactive', 'banned'] as const).filter((next) => next !== target.status).map((next) => <form method="post" action="/api/dashboard/users/status" data-status-form={next}><input type="hidden" name="id" value={target.id} /><input type="hidden" name="status" value={next} /><input type="hidden" name="redirect_to" value={currentUrl} /><button type="submit" class={next === 'banned' ? 'is-danger' : ''}>{next === 'active' ? 'تفعيل الحساب' : next === 'inactive' ? 'تعطيل الحساب' : 'حظر الحساب'}</button></form>)}<form method="post" action={`/api/dashboard/users/${target.id}/delete`} data-confirm-delete><input type="hidden" name="redirect_to" value={currentUrl} /><button type="submit" class="is-delete">حذف نهائي</button></form></div></details>}</div></td></tr>;
						})}
					</tbody></table></div>
					{users.length === 0 && <div class="users-empty"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="3.5" /><path stroke-linecap="round" stroke-width="1.7" d="M4.5 20c.5-4.2 3-6.5 7.5-6.5s7 2.3 7.5 6.5" /></svg></span><h3>لا يوجد مستخدمون مطابقون</h3><p>جرّب تعديل عبارة البحث أو خيارات التصفية.</p></div>}
				</section>

				<div class="users-mobile">{users.map((target: any) => { const self = String(target.id) === String(user.id); const photo = assetUrl(target.profile_photo_path, 80); const activity = activityInfo(target); return <article class="users-mobile-card"><div class="users-mobile-head">{photo ? <img src={photo} alt="" loading="lazy" /> : <span class={`avatar-tone-${Number(target.id) % 5}`}>{initials(target.name)}</span>}<div><h2><a href={`/dashboard/users/${target.id}/edit`}>{target.name}</a>{self && <small>أنت</small>}</h2><p dir="ltr">{target.email}</p></div><span class={`users-status is-${target.status || 'inactive'}`}><i></i>{statusLabels[target.status] || 'غير نشط'}</span></div><div class="users-mobile-meta"><span>الأدوار<strong>{target.roles?.map((item: any) => item.name).join('، ') || 'دون دور'}</strong></span><span>البريد<strong>{target.email_verified_at ? 'موثّق' : 'غير موثّق'}</strong></span><span>آخر نشاط<strong class={activity.online ? 'is-online' : ''}>{activity.label}</strong></span></div><div class="users-mobile-actions"><a href={`/dashboard/users/${target.id}/edit`}>عرض الملف الكامل</a>{!self && <form method="post" action="/api/dashboard/users/status"><input type="hidden" name="id" value={target.id} /><input type="hidden" name="status" value={target.status === 'active' ? 'inactive' : 'active'} /><input type="hidden" name="redirect_to" value={currentUrl} /><button type="submit">{target.status === 'active' ? 'تعطيل' : 'تفعيل'}</button></form>}{!self && <form method="post" action={`/api/dashboard/users/${target.id}/delete`} data-confirm-delete><input type="hidden" name="redirect_to" value={currentUrl} /><button type="submit" class="is-delete">حذف</button></form>}</div></article>; })}{users.length === 0 && <div class="users-empty"><h3>لا يوجد مستخدمون مطابقون</h3><p>جرّب تعديل البحث أو التصفية.</p></div>}</div>
				{meta && <Pagination currentPage={meta.current_page} lastPage={meta.last_page} url={Astro.url} />}
			</>
		)}
	</div>

	{canManageRoles && <dialog id="create-user-dialog" class="users-dialog"><div class="users-dialog-card"><div class="users-dialog-head"><div><span>حساب جديد</span><h2>إضافة مستخدم إلى المنصة</h2><p>أنشئ الحساب وحدد أدواره الأولية.</p></div><button type="button" data-close-create aria-label="إغلاق"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-width="1.8" d="m7 7 10 10M17 7 7 17" /></svg></button></div><form method="post" action="/api/dashboard/users/save" class="users-create-form"><input type="hidden" name="redirect_to" value={currentUrl} /><label><span>الاسم الكامل</span><input type="text" name="name" required minlength="2" maxlength="255" autocomplete="name" placeholder="اسم المستخدم" /></label><label><span>البريد الإلكتروني</span><input type="email" name="email" required autocomplete="email" dir="ltr" placeholder="user@example.com" /></label><label><span>كلمة المرور</span><input type="password" name="password" required minlength="8" autocomplete="new-password" dir="ltr" placeholder="8 أحرف على الأقل" /></label><fieldset><legend>الأدوار الأولية</legend><div>{rolesResult.items.map((item: any) => <label><input type="checkbox" name="roles" value={item.id} /><span>{item.name}</span></label>)}</div>{!rolesResult.ok && <small>تعذّر تحميل قائمة الأدوار.</small>}</fieldset><div class="users-dialog-actions"><button type="button" data-close-create>إلغاء</button><button type="submit">إنشاء المستخدم</button></div></form></div></dialog>}

	<script>
		const checks = Array.from(document.querySelectorAll<HTMLInputElement>('.users-row-check:not(:disabled)'));
		const selectAll = document.getElementById('users-select-all') as HTMLInputElement | null;
		const bulkBar = document.querySelector<HTMLElement>('[data-bulk-form]');
		const selectedCount = document.getElementById('users-selected-count');
		const updateSelection = () => {
			const count = checks.filter((check) => check.checked).length;
			if (bulkBar) bulkBar.hidden = count === 0;
			if (selectedCount) selectedCount.textContent = count.toLocaleString('ar-EG');
			if (selectAll) { selectAll.checked = checks.length > 0 && count === checks.length; selectAll.indeterminate = count > 0 && count < checks.length; }
		};
		selectAll?.addEventListener('change', () => { checks.forEach((check) => { check.checked = selectAll.checked; }); updateSelection(); });
		checks.forEach((check) => check.addEventListener('change', updateSelection));
		document.getElementById('users-bulk-form')?.addEventListener('submit', (event: SubmitEvent) => {
			const operation = (event.submitter as HTMLButtonElement | null)?.value;
			const count = checks.filter((check) => check.checked).length;
			if (!count || (operation === 'delete' && !window.confirm(`سيتم حذف ${count} حساب نهائيًا. هل تريد المتابعة؟`)) || (operation === 'banned' && !window.confirm(`سيتم حظر ${count} حساب ومنع الوصول إلى المنصة. هل تريد المتابعة؟`))) event.preventDefault();
		});
		document.querySelectorAll<HTMLFormElement>('[data-confirm-delete]').forEach((form) => form.addEventListener('submit', (event) => { if (!window.confirm('سيتم حذف حساب المستخدم نهائيًا. هل تريد المتابعة؟')) event.preventDefault(); }));
		document.querySelectorAll<HTMLFormElement>('[data-status-form="banned"]').forEach((form) => form.addEventListener('submit', (event) => { if (!window.confirm('سيتم حظر الحساب ومنع المستخدم من الوصول إلى المنصة. هل تريد المتابعة؟')) event.preventDefault(); }));
		document.addEventListener('click', (event) => { document.querySelectorAll<HTMLDetailsElement>('.users-more[open]').forEach((details) => { if (!details.contains(event.target as Node)) details.removeAttribute('open'); }); });
		const dialog = document.getElementById('create-user-dialog') as HTMLDialogElement | null;
		document.querySelector('[data-open-create]')?.addEventListener('click', () => dialog?.showModal());
		document.querySelectorAll('[data-close-create]').forEach((button) => button.addEventListener('click', () => dialog?.close()));
		dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
	</script>

	<style>
		.users-page{--us-ink:#102a43;--us-muted:#718096;--us-line:#dfe6ee;max-width:1360px;margin-inline:auto;padding-bottom:2rem}.users-page-header{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1rem}.users-eyebrow{display:block;margin-bottom:.25rem;color:#1a4d8f;font-size:.65rem;font-weight:850}.users-page-header h1{margin:0;color:#061a3a;font-size:clamp(1.35rem,1.1rem + .65vw,1.85rem);font-weight:900;line-height:1.3}.users-page-header p{margin:.28rem 0 0;color:var(--us-muted);font-size:.75rem}.users-create-button{display:inline-flex;min-height:2.6rem;align-items:center;justify-content:center;gap:.4rem;border:1px solid #16427d;border-radius:.6rem;background:#1a4d8f;padding:.5rem .9rem;color:#fff;font-family:inherit;font-size:.73rem;font-weight:850;box-shadow:0 2px 4px rgb(26 77 143/.16)}.users-create-button svg{width:1rem;height:1rem}
		.users-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-bottom:1rem}.users-summary-item{display:flex;min-height:4.35rem;align-items:center;gap:.65rem;border:1px solid var(--us-line);border-radius:.75rem;background:#fff;padding:.65rem .75rem;box-shadow:0 1px 2px rgb(15 23 42/.04)}.users-summary-item:hover,.users-summary-item.is-selected{border-color:#9bb7d8}.users-summary-item.is-selected{box-shadow:inset 0 -2px #1a4d8f}.users-summary-item>span{display:grid;width:2.35rem;height:2.35rem;flex:none;place-items:center;border-radius:.55rem}.users-summary-item svg{width:1.05rem;height:1.05rem}.users-summary-item .is-blue{background:#edf4fc;color:#1a4d8f}.users-summary-item .is-green{background:#edf9f5;color:#0f8464}.users-summary-item .is-gray{background:#f1f5f9;color:#718096}.users-summary-item .is-red{background:#fff1f2;color:#c5303e}.users-summary-item p{margin:0;color:var(--us-muted);font-size:.59rem}.users-summary-item strong{display:block;margin-top:.08rem;color:var(--us-ink);font-size:.9rem;font-weight:900}
