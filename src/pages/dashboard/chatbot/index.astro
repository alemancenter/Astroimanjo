---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch, apiFetchList } from '../../../lib/api';
import { getCountryById } from '../../../lib/countries';

const guard = await requireDashboard(Astro, 'manage settings');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;

const allowedTabs = ['overview', 'knowledge', 'sessions'];
const tab = allowedTabs.includes(Astro.url.searchParams.get('tab') || '') ? String(Astro.url.searchParams.get('tab')) : 'overview';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') || 1));
const knowledgeSearch = String(Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const knowledgeCategory = String(Astro.url.searchParams.get('category') || '');
const knowledgeStatus = String(Astro.url.searchParams.get('status') || '');
const token = Astro.cookies.get('token')?.value;
const currentCountry = getCountryById(Astro.locals.countryId);

const [knowledgeResult, sessionsResult] = await Promise.all([
	apiFetchList<any>('/dashboard/chatbot/knowledge', {
		countryId: Astro.locals.countryId,
		cookieHeader: `token=${token}`,
		params: { limit: 200, country: currentCountry.code },
	}),
	apiFetch<any[]>('/dashboard/chatbot/sessions', {
		countryId: Astro.locals.countryId,
		cookieHeader: `token=${token}`,
		params: { per_page: 12, page },
	}),
]);

const knowledge = knowledgeResult.items;
const sessions = Array.isArray(sessionsResult.data) ? sessionsResult.data : [];
const categories = [...new Set(knowledge.map((item: any) => String(item.category || '')).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'ar'));
const filteredKnowledge = knowledge.filter((item: any) => {
	const haystack = `${item.title || ''} ${item.question || ''} ${item.answer || ''} ${item.keywords || ''}`.toLowerCase();
	return (!knowledgeSearch || haystack.includes(knowledgeSearch))
		&& (!knowledgeCategory || item.category === knowledgeCategory)
		&& (!knowledgeStatus || (knowledgeStatus === 'active' ? item.is_active : !item.is_active));
});
const activeKnowledge = knowledge.filter((item: any) => item.is_active).length;
const recentMessages = sessions.reduce((sum: number, session: any) => sum + (Array.isArray(session.messages) ? session.messages.length : 0), 0);
const openSessions = sessions.filter((session: any) => session.status === 'open').length;
const totalSessions = Number(sessionsResult.meta?.total ?? sessions.length);
const maxCategoryCount = Math.max(1, ...categories.map((category) => knowledge.filter((item: any) => item.category === category).length));
const sectionOk = tab === 'knowledge' ? knowledgeResult.ok : tab === 'sessions' ? sessionsResult.ok : knowledgeResult.ok && sessionsResult.ok;
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
const cleanUrl = new URL(Astro.url);
cleanUrl.searchParams.delete('success'); cleanUrl.searchParams.delete('error');
const redirectTo = `${cleanUrl.pathname}${cleanUrl.search ? cleanUrl.search : ''}`;

const numberFormat = new Intl.NumberFormat('ar-EG');
const dateFormat = new Intl.DateTimeFormat('ar-EG', { dateStyle: 'medium', timeStyle: 'short' });
const formatDate = (value?: string | null) => value ? dateFormat.format(new Date(value)) : '—';
const tabUrl = (name: string) => `/dashboard/chatbot?tab=${name}`;
const categoryLabel = (value: string) => value ? value.replaceAll('_', ' ') : 'غير مصنف';
const intentLabels: Record<string, string> = {
	auth_login_problem: 'تسجيل الدخول', auth_register_problem: 'إنشاء الحساب', password_reset_problem: 'كلمة المرور',
	email_verification_problem: 'تفعيل البريد', download_problem: 'التحميل', download_location: 'مكان الملف',
	search_content: 'البحث عن المحتوى', request_content: 'طلب محتوى', contact_support: 'التواصل مع الدعم',
	site_error: 'مشكلة تقنية', general_question: 'سؤال عام', country_or_curriculum: 'الدولة والمنهاج',
};
const successMessages: Record<string, string> = {
	created: 'تمت إضافة المعرفة الجديدة بنجاح.', updated: 'تم تحديث المعرفة بنجاح.', deleted: 'تم حذف المعرفة.',
	sessions_deleted: 'تم حذف المحادثات المحددة بنجاح.',
};
const paginationHref = (target: number) => {
	const url = new URL(Astro.url);
	url.searchParams.set('tab', 'sessions'); url.searchParams.set('page', String(target));
	url.searchParams.delete('success'); url.searchParams.delete('error');
	return `${url.pathname}?${url.searchParams.toString()}`;
};
---

<DashboardLayout title="المساعد الذكي" user={user}>
	<div class="chatbot-admin">
		{error && <div class="chatbot-alert is-error" role="alert"><i>!</i><div><strong>تعذّر تنفيذ العملية</strong><span>{error}</span></div><a href={redirectTo}>×</a></div>}
		{success && <div class="chatbot-alert is-success" role="status"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m5 12 4 4L19 6"/></svg></i><div><strong>تمت العملية بنجاح</strong><span>{successMessages[success] || 'تم حفظ التغييرات.'}</span></div><a href={redirectTo}>×</a></div>}

		<header class="chatbot-hero">
			<div><span class="chatbot-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1"/></svg>مركز المساعد الذكي</span><h1>إدارة الشات بوت</h1><p>راقب تفاعل الزوار وطوّر إجابات المساعد من قاعدة معرفة منظمة خاصة بمنصة {currentCountry.name}.</p></div>
			<div class:list={['chatbot-health', sectionOk && 'is-online']}><i><span></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M7 9h10a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-3a4 4 0 0 1 4-4Zm5 0V5m-3 9h.01M15 14h.01M9 17h6"/><circle cx="12" cy="3" r="1"/></svg></i><div><strong>{sectionOk ? 'المساعد يعمل بصورة طبيعية' : 'تعذّر الاتصال ببيانات المساعد'}</strong><span>{numberFormat.format(activeKnowledge)} إجابة نشطة في قاعدة المعرفة</span></div></div>
		</header>

		<section class="chatbot-stats" aria-label="ملخص أداء الشات بوت">
			<article><i class="is-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8m-8 4h5"/></svg></i><div><span>قاعدة المعرفة</span><strong>{numberFormat.format(knowledge.length)}</strong><small>{numberFormat.format(activeKnowledge)} نشطة</small></div></article>
			<article><i class="is-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5h16v12H8l-4 4z"/></svg></i><div><span>إجمالي المحادثات</span><strong>{numberFormat.format(totalSessions)}</strong><small>{numberFormat.format(openSessions)} مفتوحة في الصفحة</small></div></article>
			<article><i class="is-orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 6h16M4 12h16M4 18h10"/></svg></i><div><span>التصنيفات المعرفية</span><strong>{numberFormat.format(categories.length)}</strong><small>تغطية موضوعية</small></div></article>
			<article><i class="is-dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M7 8h10M7 12h7M7 16h4M4 4h16v16H4z"/></svg></i><div><span>رسائل الصفحة الحالية</span><strong>{numberFormat.format(recentMessages)}</strong><small>آخر {numberFormat.format(sessions.length)} محادثة</small></div></article>
		</section>

		<nav class="chatbot-tabs" aria-label="أقسام إدارة الشات بوت">
			<a href={tabUrl('overview')} class:list={{ 'is-active': tab === 'overview' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 13h6V4H4zm10 7h6V11h-6zM4 20h6v-3H4zm10-13h6V4h-6z"/></svg><span>نظرة عامة</span></a>
			<a href={tabUrl('knowledge')} class:list={{ 'is-active': tab === 'knowledge' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5a3 3 0 0 1 3-2h5v17H7a3 3 0 0 0-3 2zm16 0a3 3 0 0 0-3-2h-5v17h5a3 3 0 0 1 3 2z"/></svg><span>قاعدة المعرفة</span><strong>{numberFormat.format(knowledge.length)}</strong></a>
			<a href={tabUrl('sessions')} class:list={{ 'is-active': tab === 'sessions' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5h16v12H8l-4 4z"/></svg><span>سجل المحادثات</span><strong>{numberFormat.format(totalSessions)}</strong></a>
		</nav>

		{!sectionOk ? <section class="chatbot-empty is-error"><i>!</i><h2>تعذّر تحميل بيانات الشات بوت</h2><p>{tab === 'knowledge' ? knowledgeResult.message : sessionsResult.message}</p><a href={redirectTo}>إعادة المحاولة</a></section> : tab === 'overview' ? <div class="chatbot-overview">
			<section class="chatbot-panel category-panel"><header><div><span>تغطية المعرفة</span><h2>أكبر التصنيفات</h2></div><a href={tabUrl('knowledge')}>إدارة المعرفة</a></header><div class="category-bars">{categories.slice(0, 7).map((category) => { const count = knowledge.filter((item: any) => item.category === category).length; return <div><span>{categoryLabel(category)}</span><i><b style={`width:${Math.max(7, count / maxCategoryCount * 100)}%`}></b></i><strong>{numberFormat.format(count)}</strong></div>; })}{!categories.length && <p>لا توجد تصنيفات بعد.</p>}</div></section>
			<section class="chatbot-panel recent-panel"><header><div><span>النشاط الأخير</span><h2>أحدث المحادثات</h2></div><a href={tabUrl('sessions')}>عرض السجل</a></header><div>{sessions.slice(0, 6).map((session: any) => <a href={`/dashboard/chatbot/sessions/${session.id}`}><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5h16v12H8l-4 4z"/></svg></i><div><strong>{session.user_id ? `عضو #${session.user_id}` : 'زائر'}</strong><span>{intentLabels[session.last_intent] || categoryLabel(session.last_intent) || 'بدون نية محددة'}</span></div><time>{formatDate(session.updated_at)}</time><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m9 18 6-6-6-6"/></svg></a>)}{!sessions.length && <p class="panel-empty">لا توجد محادثات حتى الآن.</p>}</div></section>
			<section class="chatbot-panel readiness-panel"><header><div><span>جاهزية المساعد</span><h2>فحص قاعدة المعرفة</h2></div><b>{knowledge.length ? `${Math.round(activeKnowledge / knowledge.length * 100)}%` : '0%'}</b></header><div class="readiness-ring" style={`--score:${knowledge.length ? Math.round(activeKnowledge / knowledge.length * 100) : 0}`}><strong>{knowledge.length ? `${Math.round(activeKnowledge / knowledge.length * 100)}%` : '0%'}</strong><span>معرفة نشطة</span></div><ul><li class:list={{ 'is-ready': activeKnowledge > 0 }}><i></i><span>إجابات نشطة</span><b>{numberFormat.format(activeKnowledge)}</b></li><li class:list={{ 'is-ready': categories.length >= 5 }}><i></i><span>تنوع التصنيفات</span><b>{numberFormat.format(categories.length)}</b></li><li class:list={{ 'is-ready': knowledge.some((item: any) => item.country_code === 'all') }}><i></i><span>معرفة عامة</span><b>{knowledge.filter((item: any) => item.country_code === 'all').length ? 'متوفرة' : 'ناقصة'}</b></li></ul></section>
			<section class="chatbot-panel quick-panel"><header><div><span>إجراءات سريعة</span><h2>طوّر جودة الردود</h2></div></header><button type="button" data-open-knowledge><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg></i><span><strong>إضافة معرفة جديدة</strong><small>أضف سؤالًا وإجابة دقيقة للمساعد</small></span><b>‹</b></button><a href={tabUrl('sessions')}><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5h16v12H8l-4 4z"/></svg></i><span><strong>مراجعة المحادثات</strong><small>اكتشف الأسئلة التي تحتاج إجابات أفضل</small></span><b>‹</b></a></section>
		</div> : tab === 'knowledge' ? <section class="knowledge-section">
			<header class="section-title"><div><span>المحتوى التدريبي</span><h2>إدارة قاعدة المعرفة</h2><p>نظّم الأسئلة المباشرة التي يعتمد عليها المساعد قبل استخدام الردود البديلة.</p></div><button type="button" data-open-knowledge><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg>إضافة معرفة</button></header>
			<form class="knowledge-filters" method="get" action="/dashboard/chatbot"><input type="hidden" name="tab" value="knowledge"/><label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" name="q" value={Astro.url.searchParams.get('q') || ''} placeholder="ابحث في السؤال أو الإجابة أو الكلمات المفتاحية..."/></label><select name="category"><option value="">كل التصنيفات</option>{categories.map((category) => <option value={category} selected={knowledgeCategory === category}>{categoryLabel(category)}</option>)}</select><select name="status"><option value="">كل الحالات</option><option value="active" selected={knowledgeStatus === 'active'}>نشطة</option><option value="inactive" selected={knowledgeStatus === 'inactive'}>معطلة</option></select><button type="submit">تصفية</button>{(knowledgeSearch || knowledgeCategory || knowledgeStatus) && <a href={tabUrl('knowledge')}>مسح</a>}</form>
			<div class="knowledge-summary"><span>عرض <strong>{numberFormat.format(filteredKnowledge.length)}</strong> من أصل {numberFormat.format(knowledge.length)} معرفة</span><div><i class="is-active"></i>نشطة <i></i>معطلة</div></div>
			{filteredKnowledge.length ? <div class="knowledge-grid">{filteredKnowledge.map((item: any) => <article class:list={{ 'is-inactive': !item.is_active }}><header><span class="knowledge-priority">#{numberFormat.format(Number(item.priority || 10))}</span><span class:list={['knowledge-status', item.is_active && 'is-active']}><i></i>{item.is_active ? 'نشطة' : 'معطلة'}</span></header><div><span class="knowledge-category">{categoryLabel(item.category)}</span><h3>{item.title}</h3><p class="knowledge-question"><b>س:</b> {item.question}</p><p class="knowledge-answer">{item.answer}</p></div><footer><span>{item.country_code === 'all' ? 'جميع الدول' : currentCountry.name} · تحديث {formatDate(item.updated_at)}</span><div><button type="button" data-edit-knowledge data-id={String(item.id)} data-title={item.title || ''} data-question={item.question || ''} data-answer={item.answer || ''} data-category={item.category || ''} data-keywords={item.keywords || ''} data-country={item.country_code || currentCountry.code} data-priority={String(item.priority || 10)} data-active={String(!!item.is_active)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m4 16-1 5 5-1L19 9l-4-4zM13 7l4 4"/></svg>تعديل</button><button type="button" class="is-delete" data-delete-knowledge data-id={String(item.id)} data-title={item.title}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg></button><form method="post" action={`/api/dashboard/chatbot/knowledge/${item.id}/delete`} data-knowledge-delete-form={String(item.id)}><input type="hidden" name="redirect_to" value={redirectTo}/></form></div></footer></article>)}</div> : <section class="chatbot-empty"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5a3 3 0 0 1 3-2h5v17H7a3 3 0 0 0-3 2zm16 0a3 3 0 0 0-3-2h-5v17h5a3 3 0 0 1 3 2z"/></svg></i><h2>لا توجد معرفة مطابقة</h2><p>جرّب تغيير معايير البحث أو أضف إجابة جديدة.</p></section>}
		</section> : <section class="sessions-section">
			<header class="section-title"><div><span>سجل التفاعل</span><h2>محادثات الزوار</h2><p>راجع مسارات الأسئلة، وصدّر المحادثات المفيدة أو احذف السجلات غير المطلوبة.</p></div><span class="session-page-count">صفحة {numberFormat.format(sessionsResult.meta?.current_page ?? page)} من {numberFormat.format(sessionsResult.meta?.last_page ?? 1)}</span></header>
			{sessions.length ? <form method="post" action="/api/dashboard/chatbot/sessions/export" class="sessions-form" data-sessions-form><div class="bulk-toolbar"><label><input type="checkbox" data-select-all/><span>تحديد الصفحة</span></label><span data-selected-count>لم يتم تحديد محادثات</span><div><button type="submit" data-export-selected disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v12m-4-4 4 4 4-4M5 19h14"/></svg>تصدير للتدريب</button><button type="button" class="is-delete" data-delete-sessions disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg>حذف المحدد</button><button type="submit" hidden formaction="/api/dashboard/chatbot/sessions/bulk-delete" data-submit-delete></button></div><input type="hidden" name="redirect_to" value={redirectTo}/></div><div class="sessions-table-wrap"><table><thead><tr><th class="check-cell"></th><th>الزائر</th><th>آخر نية</th><th>المسار الحالي</th><th>الرسائل</th><th>الحالة</th><th>آخر نشاط</th><th></th></tr></thead><tbody>{sessions.map((session: any) => <tr><td class="check-cell"><input type="checkbox" name="ids" value={String(session.id)} data-session-check/></td><td><div class="session-person"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0"/></svg></i><div><strong>{session.user_id ? `عضو #${session.user_id}` : 'زائر'}</strong><span dir="ltr">{String(session.guest_id || `session-${session.id}`).slice(0, 28)}</span></div></div></td><td><span class="intent-badge">{intentLabels[session.last_intent] || categoryLabel(session.last_intent) || 'غير محددة'}</span></td><td><div class="session-step"><strong>{categoryLabel(session.current_intent) || '—'}</strong><span>{categoryLabel(session.current_step) || 'بداية المحادثة'}</span></div></td><td><strong class="message-count">{numberFormat.format(Array.isArray(session.messages) ? session.messages.length : 0)}</strong></td><td><span class:list={['session-status', session.status === 'open' && 'is-open']}><i></i>{session.status === 'open' ? 'مفتوحة' : 'مغلقة'}</span></td><td><time>{formatDate(session.updated_at)}</time></td><td><a class="open-session" href={`/dashboard/chatbot/sessions/${session.id}`}>فتح<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m9 18 6-6-6-6"/></svg></a></td></tr>)}</tbody></table></div></form> : <section class="chatbot-empty"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 5h16v12H8l-4 4z"/></svg></i><h2>لا توجد محادثات بعد</h2><p>ستظهر محادثات الزوار هنا فور استخدام المساعد.</p></section>}
			{sessionsResult.meta && sessionsResult.meta.last_page > 1 && <nav class="sessions-pagination" aria-label="صفحات المحادثات"><a href={paginationHref(Math.max(1, sessionsResult.meta.current_page - 1))} class:list={{ 'is-disabled': sessionsResult.meta.current_page <= 1 }}>السابق</a><span>صفحة <strong>{numberFormat.format(sessionsResult.meta.current_page)}</strong> من {numberFormat.format(sessionsResult.meta.last_page)}</span><a href={paginationHref(Math.min(sessionsResult.meta.last_page, sessionsResult.meta.current_page + 1))} class:list={{ 'is-disabled': sessionsResult.meta.current_page >= sessionsResult.meta.last_page }}>التالي</a></nav>}
		</section>}
	</div>

	<dialog id="knowledge-dialog" class="knowledge-dialog" aria-labelledby="knowledge-dialog-title"><form method="post" action="/api/dashboard/chatbot/knowledge/save"><header><div><span data-dialog-eyebrow>معرفة جديدة</span><h2 id="knowledge-dialog-title" data-dialog-title>إضافة إجابة للمساعد</h2><p>اكتب السؤال بالطريقة التي يستخدمها الزائر، وقدّم جوابًا مباشرًا وواضحًا.</p></div><button type="button" data-close-knowledge aria-label="إغلاق">×</button></header><input type="hidden" name="id" data-field-id/><input type="hidden" name="redirect_to" value={redirectTo}/><div class="knowledge-form-body"><label class="is-wide"><span>العنوان الإداري <b>*</b></span><input type="text" name="title" required data-field-title placeholder="مثال: مشكلة تحميل الملفات"/></label><label class="is-wide"><span>سؤال الزائر <b>*</b></span><input type="text" name="question" required data-field-question placeholder="مثال: لماذا لا أستطيع تحميل الملف؟"/></label><label class="is-wide"><span>الإجابة <b>*</b></span><textarea name="answer" rows="5" required data-field-answer placeholder="اكتب خطوات واضحة وقصيرة لحل المشكلة..."></textarea><small>الإجابة المباشرة والمنظمة تعطي نتائج أفضل.</small></label><label><span>التصنيف</span><input type="text" name="category" list="knowledge-categories" data-field-category placeholder="download_problem"/><datalist id="knowledge-categories">{categories.map((category) => <option value={category}/>)}</datalist></label><label><span>نطاق المعرفة</span><select name="country_code" data-field-country><option value={currentCountry.code}>{currentCountry.name}</option><option value="all">جميع الدول</option></select></label><label class="is-wide"><span>الكلمات المفتاحية</span><input type="text" name="keywords" data-field-keywords placeholder="تحميل، ملف، لا يعمل، download"/><small>افصل بين الكلمات والعبارات بفاصلة.</small></label><label><span>الأولوية</span><input type="number" name="priority" min="1" max="999" value="10" data-field-priority/></label><label class="toggle-field"><span>حالة المعرفة</span><span class="toggle-control"><input type="checkbox" name="is_active" checked data-field-active/><i></i><b>نشطة وقابلة للاستخدام</b></span></label></div><footer><button type="button" data-close-knowledge>إلغاء</button><button type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h12l2 2v14H5zM8 4v6h8V4M8 16h8"/></svg><span data-save-label>حفظ المعرفة</span></button></footer></form></dialog>

	<dialog id="chatbot-confirm" class="chatbot-confirm" aria-labelledby="chatbot-confirm-title"><div><button type="button" data-close-confirm aria-label="إغلاق">×</button><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 9v4m0 4h.01M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/></svg></i><span>تأكيد الإجراء</span><h2 id="chatbot-confirm-title" data-confirm-title>هل تريد المتابعة؟</h2><p data-confirm-message></p><aside><strong>تنبيه</strong><small data-confirm-note>لا يمكن التراجع عن هذا الإجراء بعد تنفيذه.</small></aside><footer><button type="button" data-close-confirm>إلغاء</button><button type="button" data-confirm-action>تأكيد الحذف</button></footer></div></dialog>

	<script>
		const knowledgeDialog = document.getElementById('knowledge-dialog') as HTMLDialogElement | null;
		const knowledgeForm = knowledgeDialog?.querySelector('form') as HTMLFormElement | null;
		const field = (name: string) => knowledgeDialog?.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-field-${name}]`);
		const openKnowledge = (button?: HTMLButtonElement) => {
			knowledgeForm?.reset();
			const editing = !!button?.dataset.id;
			(field('id') as HTMLInputElement | null)!.value = button?.dataset.id || '';
			(field('title') as HTMLInputElement | null)!.value = button?.dataset.title || '';
			(field('question') as HTMLInputElement | null)!.value = button?.dataset.question || '';
			(field('answer') as HTMLTextAreaElement | null)!.value = button?.dataset.answer || '';
			(field('category') as HTMLInputElement | null)!.value = button?.dataset.category || '';
			(field('keywords') as HTMLInputElement | null)!.value = button?.dataset.keywords || '';
			(field('country') as HTMLSelectElement | null)!.value = button?.dataset.country || (field('country') as HTMLSelectElement | null)?.options[0]?.value || 'all';
			(field('priority') as HTMLInputElement | null)!.value = button?.dataset.priority || '10';
			(field('active') as HTMLInputElement | null)!.checked = !editing || button?.dataset.active === 'true';
			const title = knowledgeDialog?.querySelector<HTMLElement>('[data-dialog-title]'); const eyebrow = knowledgeDialog?.querySelector<HTMLElement>('[data-dialog-eyebrow]'); const save = knowledgeDialog?.querySelector<HTMLElement>('[data-save-label]');
			if (title) title.textContent = editing ? 'تعديل معرفة المساعد' : 'إضافة إجابة للمساعد'; if (eyebrow) eyebrow.textContent = editing ? 'تحديث المعرفة' : 'معرفة جديدة'; if (save) save.textContent = editing ? 'حفظ التعديلات' : 'حفظ المعرفة';
			knowledgeDialog?.showModal();
		};
		document.querySelectorAll<HTMLButtonElement>('[data-open-knowledge]').forEach((button) => button.addEventListener('click', () => openKnowledge()));
		document.querySelectorAll<HTMLButtonElement>('[data-edit-knowledge]').forEach((button) => button.addEventListener('click', () => openKnowledge(button)));
		document.querySelectorAll<HTMLButtonElement>('[data-close-knowledge]').forEach((button) => button.addEventListener('click', () => knowledgeDialog?.close()));
		knowledgeDialog?.addEventListener('click', (event) => { if (event.target === knowledgeDialog) knowledgeDialog.close(); });

		const confirmDialog = document.getElementById('chatbot-confirm') as HTMLDialogElement | null; let pendingAction: (() => void) | null = null;
		const showConfirm = (title: string, message: string, action: () => void, buttonLabel = 'تأكيد الحذف') => { const titleNode = confirmDialog?.querySelector<HTMLElement>('[data-confirm-title]'); const messageNode = confirmDialog?.querySelector<HTMLElement>('[data-confirm-message]'); const actionNode = confirmDialog?.querySelector<HTMLElement>('[data-confirm-action]'); if (titleNode) titleNode.textContent = title; if (messageNode) messageNode.textContent = message; if (actionNode) actionNode.textContent = buttonLabel; pendingAction = action; confirmDialog?.showModal(); };
		document.querySelectorAll<HTMLButtonElement>('[data-delete-knowledge]').forEach((button) => button.addEventListener('click', () => showConfirm('حذف المعرفة؟', `سيتم حذف «${button.dataset.title || 'هذه المعرفة'}» ولن يستخدمها المساعد مجددًا.`, () => document.querySelector<HTMLFormElement>(`[data-knowledge-delete-form="${button.dataset.id}"]`)?.requestSubmit(), 'حذف المعرفة')));
		document.querySelectorAll<HTMLButtonElement>('[data-close-confirm]').forEach((button) => button.addEventListener('click', () => { pendingAction = null; confirmDialog?.close(); }));
		confirmDialog?.querySelector<HTMLButtonElement>('[data-confirm-action]')?.addEventListener('click', () => { const action = pendingAction; pendingAction = null; confirmDialog?.close(); action?.(); });
		confirmDialog?.addEventListener('click', (event) => { if (event.target === confirmDialog) { pendingAction = null; confirmDialog.close(); } });

		const sessionsForm = document.querySelector<HTMLFormElement>('[data-sessions-form]'); const sessionChecks = [...document.querySelectorAll<HTMLInputElement>('[data-session-check]')]; const selectAll = document.querySelector<HTMLInputElement>('[data-select-all]'); const selectedLabel = document.querySelector<HTMLElement>('[data-selected-count]'); const exportButton = document.querySelector<HTMLButtonElement>('[data-export-selected]'); const deleteButton = document.querySelector<HTMLButtonElement>('[data-delete-sessions]');
		const updateSelection = () => { const selected = sessionChecks.filter((checkbox) => checkbox.checked).length; if (selectedLabel) selectedLabel.textContent = selected ? `تم تحديد ${selected} محادثة` : 'لم يتم تحديد محادثات'; if (exportButton) exportButton.disabled = !selected; if (deleteButton) deleteButton.disabled = !selected; if (selectAll) { selectAll.checked = selected === sessionChecks.length && selected > 0; selectAll.indeterminate = selected > 0 && selected < sessionChecks.length; } };
		selectAll?.addEventListener('change', () => { sessionChecks.forEach((checkbox) => checkbox.checked = !!selectAll.checked); updateSelection(); }); sessionChecks.forEach((checkbox) => checkbox.addEventListener('change', updateSelection));
		deleteButton?.addEventListener('click', () => { const count = sessionChecks.filter((checkbox) => checkbox.checked).length; if (!count) return; showConfirm('حذف المحادثات المحددة؟', `سيتم حذف ${count} محادثة مع جميع رسائلها نهائيًا.`, () => sessionsForm?.querySelector<HTMLButtonElement>('[data-submit-delete]')?.click(), 'حذف المحادثات'); });
	</script>

