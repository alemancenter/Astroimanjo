		.chatbot-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem;margin-bottom:.75rem}.chatbot-tabs a{display:flex;min-height:2.8rem;align-items:center;justify-content:center;gap:.38rem;border:1px solid var(--cb-line);border-radius:.6rem;background:#fff;padding:.4rem .65rem;color:#64748b;font-size:.75rem;font-weight:850}.chatbot-tabs svg{width:.95rem;height:.95rem;stroke-width:1.8}.chatbot-tabs strong{display:grid;min-width:1.5rem;height:1.4rem;place-items:center;border-radius:.35rem;background:#f0f3f6;font-size:.6rem}.chatbot-tabs a.is-active{border-color:#98b4d6;background:#f6f9fd;color:var(--cb-blue);box-shadow:inset 0 -2px var(--cb-blue)}.chatbot-tabs a.is-active strong{background:#e4edf8}
		.chatbot-overview{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) 18rem;gap:.7rem}.chatbot-panel{border:1px solid var(--cb-line);border-radius:.85rem;background:#fff;padding:.9rem;box-shadow:0 3px 10px rgb(23 43 77/.04)}.chatbot-panel>header{display:flex;align-items:center;justify-content:space-between;gap:.7rem;border-bottom:1px solid #edf1f5;padding-bottom:.65rem}.chatbot-panel>header span{color:var(--cb-blue);font-size:.64rem;font-weight:850}.chatbot-panel h2{margin:.08rem 0 0;color:var(--cb-ink);font-size:.92rem;font-weight:950}.chatbot-panel>header>a{color:var(--cb-blue);font-size:.65rem;font-weight:850}.category-bars{display:grid;gap:.62rem;padding-top:.7rem}.category-bars>div{display:grid;grid-template-columns:8rem minmax(4rem,1fr) 2rem;align-items:center;gap:.5rem}.category-bars>div>span{overflow:hidden;color:#52667d;font-size:.68rem;text-overflow:ellipsis;white-space:nowrap}.category-bars>div>i{height:.42rem;overflow:hidden;border-radius:99rem;background:#edf1f5}.category-bars>div>i>b{display:block;height:100%;border-radius:inherit;background:var(--cb-blue)}.category-bars>div>strong{color:var(--cb-ink);font-size:.66rem;text-align:left}.recent-panel{grid-column:2/4}.recent-panel>div{display:grid}.recent-panel>div>a{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;align-items:center;gap:.55rem;border-bottom:1px solid #eff2f5;padding:.55rem 0}.recent-panel>div>a:last-child{border:0}.recent-panel>div>a>i{display:grid;width:2rem;height:2rem;place-items:center;border-radius:.5rem;background:#edf3fa;color:var(--cb-blue)}.recent-panel>div>a>i svg{width:.9rem;height:.9rem}.recent-panel a>div{display:grid;min-width:0;gap:.07rem}.recent-panel a strong{color:var(--cb-ink);font-size:.71rem}.recent-panel a span{overflow:hidden;color:var(--cb-muted);font-size:.62rem;text-overflow:ellipsis;white-space:nowrap}.recent-panel time{color:#8b97a5;font-size:.58rem}.recent-panel a>svg{width:.8rem;height:.8rem;color:#8b97a5;stroke-width:2}.panel-em