	<script>
		const logDialog = document.getElementById('security-log-dialog') as HTMLDialogElement | null;
		const setLogDetail = (selector: string, value: string) => { const element = logDialog?.querySelector<HTMLElement>(selector); if (element) element.textContent = value || '—'; };
		document.querySelectorAll<HTMLElement>('[data-open-log]').forEach((button) => button.addEventListener('click', () => { setLogDetail('[data-detail-type]', button.dataset.logType || 'حدث أمني'); setLogDetail('[data-detail-description]', button.dataset.logDescription || 'لا يوجد وصف.'); setLogDetail('[data-detail-ip]', button.dataset.logIp || '—'); setLogDetail('[data-detail-location]', button.dataset.logLocation || 'غير معروف'); setLogDetail('[data-detail-method]', button.dataset.logMethod || '—'); setLogDetail('[data-detail-route]', button.dataset.logRoute || '—'); setLogDetail('[data-detail-risk]', `${button.dataset.logRisk || '0'} / 100`); setLogDetail('[data-detail-time]', button.dataset.logTime || '—'); setLogDetail('[data-detail-agent]', button.dataset.logAgent || 'غير متوفر'); logDialog?.showModal(); }));
		document.querySelectorAll('[data-close-log]').forEach((button) => button.addEventListener('click', () => logDialog?.close())); logDialog?.addEventListener('click', (event) => { if (event.target === logDialog) logDialog.close(); });
		const confirmDialog = document.getElementById('security-confirm-dialog') as HTMLDialogElement | null; let pendingForm: HTMLFormElement | null = null;
		document.querySelectorAll<HTMLFormElement>('[data-confirm]').forEach((form) => form.addEventListener('submit', (event) => { if (form.dataset.confirmed === 'true') return; event.preventDefault(); pendingForm = form; const title = confirmDialog?.querySelector<HTMLElement>('[data-confirm-dialog-title]'); const message = confirmDialog?.querySelector<HTMLElement>('[data-confirm-dialog-message]'); const action = confirmDialog?.querySelector<HTMLButtonElement>('[data-confirm-action]'); if (title) title.textContent = form.dataset.confirmTitle || 'هل تريد المتابعة؟'; if (message) message.textContent = form.dataset.confirmMessage || 'سيتم تنفيذ هذا الإجراء الآن.'; if (action) action.textContent = form.dataset.confirmButton || 'تأكيد'; confirmDialog?.showModal(); }));
		document.querySelectorAll('[data-close-confirm]').forEach((button) => button.addEventListener('click', () => confirmDialog?.close())); confirmDialog?.addEventListener('click', (event) => { if (event.target === confirmDialog) confirmDialog.close(); }); confirmDialog?.addEventListener('close', () => { pendingForm = null; }); confirmDialog?.querySelector('[data-confirm-action]')?.addEventListener('click', () => { if (!pendingForm) return; const form = pendingForm; form.dataset.confirmed = 'true'; form.requestSubmit(); });
