---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DashboardAlert from '../../../components/ui/DashboardAlert.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { requireDashboard } from '../../../lib/auth';
import { apiFetch } from '../../../lib/api';

const guard = await requireDashboard(Astro, 'manage security');
if ('redirect' in guard) return guard.redirect;
const { user } = guard;
const token = Astro.cookies.get('token')?.value;
const params = Astro.url.searchParams;
const allowedTabs = new Set(['overview', 'events', 'blocked', 'trusted']);
const requestedTab = params.get('tab') || 'overview';
const tab = allowedTabs.has(requestedTab) ? requestedTab : 'overview';
const page = Math.max(1, Number(params.get('page')) || 1);
const search = (params.get('q') || '').trim();
const severity = ['info', 'warning', 'danger', 'critical'].includes(params.get('severity') || '') ? params.get('severity')! : '';
const eventType = (params.get('event_type') || '').trim();
const resolution = ['open', 'resolved'].includes(params.get('resolution') || '') ? params.get('resolution')! : '';
const blockStatus = ['active', 'expired'].includes(params.get('status') || '') ? params.get('status')! : '';
const requestOptions = { countryId: Astro.locals.countryId, cookieHeader: `token=${token}` };

const [statsResult, overviewResult, analyticsResult, routesResult, geoResult, logsResult, blockedResult, trustedResult] = await Promise.all([
	apiFetch<any>('/dashboard/security/stats', requestOptions),
	apiFetch<any>('/dashboard/security/overview', requestOptions),
	apiFetch<any>('/dashboard/security/analytics', requestOptions),
	apiFetch<any[]>('/dashboard/security/analytics/routes', requestOptions),
	apiFetch<any[]>('/dashboard/security/analytics/geo', requestOptions),
	apiFetch<any[]>('/dashboard/security/logs', { ...requestOptions, params: { severity: severity || undefined, event_type: eventType || undefined, q: search || undefined, resolved: resolution === 'open' ? 'false' : resolution === 'resolved' ? 'true' : undefined, page: tab === 'events' ? page : 1, per_page: tab === 'events' ? 20 : 8 } }),
	apiFetch<any[]>('/dashboard/security/blocked-ips', { ...requestOptions, params: { q: tab === 'blocked' ? search || undefined : undefined, status: tab === 'blocked' ? blockStatus || undefined : undefined, page: tab === 'blocked' ? page : 1, per_page: tab === 'blocked' ? 20 : 6 } }),
	apiFetch<any[]>('/dashboard/security/trusted-ips', { ...requestOptions, params: { page: tab === 'trusted' ? page : 1, per_page: tab === 'trusted' ? 20 : 6 } }),
]);

const stats = statsResult.data ?? {};
const overview = overviewResult.data ?? {};
const analytics = analyticsResult.data ?? { by_severity: [], by_event_type: [] };
const topRoutes = Array.isArray(routesResult.data) ? routesResult.data : [];
const geo = Array.isArray(geoResult.data) ? geoResult.data : [];
const logs = Array.isArray(logsResult.data) ? logsResult.data : [];
const blockedIps = Array.isArray(blockedResult.data) ? blockedResult.data : [];
const trustedIps = Array.isArray(trustedResult.data) ? trustedResult.data : [];
const unresolved = Math.max(0, Number(stats.total_logs || 0) - Number(stats.resolved_logs || 0));
const redirectTo = `${Astro.url.pathname}${Astro.url.search}`;
const numberFormat = new Intl.NumberFormat('ar-EG');
const dateTimeFormat = new Intl.DateTimeFormat('ar-EG', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' });
const formatDate = (value: string) => { const date = new Date(value); return Number.isNaN(date.getTime()) ? '—' : dateTimeFormat.format(date); };
const severityLabel: Record<string, string> = { info: 'معلومات', warning: 'تحذير', danger: 'خطر', critical: 'حرج' };
const eventLabels: Record<string, string> = { login_failed: 'فشل تسجيل الدخول', suspicious_activity: 'نشاط مشبوه', blocked_access: 'وصول محظور', rate_limit_exceeded: 'تجاوز حد الطلبات', sql_injection_attempt: 'محاولة SQL Injection', xss_attempt: 'محاولة XSS', invalid_token: 'رمز دخول غير صالح', unauthorized_access: 'وصول غير مصرح' };
const eventOptions = Object.entries(eventLabels);
const tabUrl = (next: string) => `/dashboard/security?tab=${next}`;
const maxSeverity = Math.max(1, ...(analytics.by_severity || []).map((row: any) => Number(row.count || 0)));
const maxEvent = Math.max(1, ...(analytics.by_event_type || []).map((row: any) => Number(row.count || 0)));
const maxRoute = Math.max(1, ...topRoutes.map((row: any) => Number(row.count || 0)));
const maxIP = Math.max(1, ...((overview.top_ips || []).map((row: any) => Number(row.count || 0))));
const sectionOk = tab === 'events' ? logsResult.ok : tab === 'blocked' ? blockedResult.ok : tab === 'trusted' ? trustedResult.ok : overviewResult.ok;
---

<DashboardLayout title="الأمان والمراقبة" user={user}>
	<div class="security-page">
		<DashboardAlert />
		<header class="security-header"><div><span>الحماية والمراقبة</span><h1>مركز الأمان</h1><p>راقب الأحداث الأمنية، حلّل مصادر المخاطر، وأدر عناوين الشبكة من مكان واحد.</p></div><div class:list={['security-health', Number(stats.critical_logs || 0) > 0 && 'has-risk']}><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d="m9 12 2 2 4-5"/></svg></i><div><strong>{Number(stats.critical_logs || 0) > 0 ? 'توجد أحداث حرجة تحتاج للمراجعة' : 'حالة الحماية مستقرة'}</strong><span>{numberFormat.format(unresolved)} حدثًا مفتوحًا حاليًا</span></div></div></header>

		<section class="security-summary" aria-label="ملخص الأمان">
			<div class="security-stat is-blue"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 4h16v16H4zM8 9h8m-8 4h8m-8 4h5"/></svg></i><div><small>إجمالي الأحداث</small><strong>{numberFormat.format(Number(stats.total_logs || 0))}</strong><span>{numberFormat.format(Number(overview.last_7d_events || 0))} خلال 7 أيام</span></div></div>
			<div class="security-stat is-red"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 9v4m0 4h.01M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/></svg></i><div><small>الأحداث الحرجة</small><strong>{numberFormat.format(Number(stats.critical_logs || 0))}</strong><span>{numberFormat.format(Number(overview.last_24h_events || 0))} حدثًا خلال 24 ساعة</span></div></div>
			<div class="security-stat is-green"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m4 12 4 4L18 6"/></svg></i><div><small>تمت معالجتها</small><strong>{numberFormat.format(Number(stats.resolved_logs || 0))}</strong><span>{stats.total_logs ? `${numberFormat.format(Math.round((Number(stats.resolved_logs || 0) / Number(stats.total_logs)) * 100))}٪ من السجلات` : 'لا توجد سجلات بعد'}</span></div></div>
			<div class="security-stat is-orange"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 3h14v18H5zM9 8h6m-6 4h6m-6 4h3"/></svg></i><div><small>عناوين محظورة</small><strong>{numberFormat.format(Number(stats.blocked_ips || 0))}</strong><span>يُمنع وصولها للمنصة</span></div></div>
			<div class="security-stat is-graphite"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d="m9 12 2 2 4-5"/></svg></i><div><small>عناوين موثوقة</small><strong>{numberFormat.format(Number(stats.trusted_ips || 0))}</strong><span>مستثناة من بعض القيود</span></div></div>
		</section>

		<nav class="security-tabs" aria-label="أقسام مركز الأمان"><a href={tabUrl('overview')} class:list={{ 'is-active': tab === 'overview' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 13h6V4H4zm10 7h6V11h-6zM4 20h6v-3H4zm10-13h6V4h-6z"/></svg><span>نظرة عامة</span></a><a href={tabUrl('events')} class:list={{ 'is-active': tab === 'events' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8m-8 4h5"/></svg><span>سجل الأحداث</span><strong>{numberFormat.format(Number(stats.total_logs || 0))}</strong></a><a href={tabUrl('blocked')} class:list={{ 'is-active': tab === 'blocked' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="m6 6 12 12"/></svg><span>العناوين المحظورة</span><strong>{numberFormat.format(Number(stats.blocked_ips || 0))}</strong></a><a href={tabUrl('trusted')} class:list={{ 'is-active': tab === 'trusted' }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6Z"/><path d="m9 12 2 2 4-5"/></svg><span>العناوين الموثوقة</span><strong>{numberFormat.format(Number(stats.trusted_ips || 0))}</strong></a></nav>

		{!sectionOk ? <section class="security-state is-error"><i>!</i><h2>تعذّر تحميل بيانات الأمان</h2><p>تحقق من اتصال الخادم ثم أعد المحاولة.</p><a href={redirectTo}>إعادة المحاولة</a></section> : tab === 'overview' ? <div class="security-overview">
			<section class="security-chart-card"><header><div><span>توزيع الخطورة</span><h2>الأحداث حسب مستوى الخطر</h2></div><strong>{numberFormat.format(Number(stats.total_logs || 0))} حدث</strong></header><div class="security-bars">{(analytics.by_severity || []).map((row: any) => <div><label><span class={`severity-dot is-${row.severity}`}></span><strong>{severityLabel[row.severity] || row.severity}</strong><b>{numberFormat.format(Number(row.count || 0))}</b></label><i><span class={`is-${row.severity}`} style={`width:${Math.max(4, (Number(row.count || 0) / maxSeverity) * 100)}%`}></span></i></div>)}{!(analytics.by_severity || []).length && <p>لا توجد بيانات تحليلية بعد.</p>}</div></section>
			<section class="security-chart-card"><header><div><span>أنواع الأحداث</span><h2>أكثر الأنشطة الأمنية تكرارًا</h2></div></header><div class="security-bars is-events">{(analytics.by_event_type || []).slice(0, 7).map((row: any) => <div><label><strong>{eventLabels[row.event_type] || row.event_type}</strong><b>{numberFormat.format(Number(row.count || 0))}</b></label><i><span style={`width:${Math.max(4, (Number(row.count || 0) / maxEvent) * 100)}%`}></span></i></div>)}{!(analytics.by_event_type || []).length && <p>لا توجد بيانات تحليلية بعد.</p>}</div></section>
			<section class="security-list-card"><header><div><span>مصادر النشاط</span><h2>أكثر عناوين IP ظهورًا</h2></div><a href={tabUrl('events')}>عرض السجل</a></header><div class="security-ranked-list">{(overview.top_ips || []).slice(0, 7).map((item: any, index: number) => <div><b>{numberFormat.format(index + 1)}</b><code dir="ltr">{item.ip_address}</code><i><span style={`width:${Math.max(5, (Number(item.count || 0) / maxIP) * 100)}%`}></span></i><strong>{numberFormat.format(Number(item.count || 0))}</strong></div>)}{!(overview.top_ips || []).length && <p>لا توجد مصادر مسجلة.</p>}</div></section>
			<section class="security-list-card"><header><div><span>الوجهات المستهدفة</span><h2>أكثر المسارات تعرضًا للأحداث</h2></div></header><div class="security-ranked-list is-routes">{topRoutes.slice(0, 7).map((item: any, index: number) => <div><b>{numberFormat.format(index + 1)}</b><code dir="ltr">{item.route || '/'}</code><i><span style={`width:${Math.max(5, (Number(item.count || 0) / maxRoute) * 100)}%`}></span></i><strong>{numberFormat.format(Number(item.count || 0))}</strong></div>)}{!topRoutes.length && <p>لا توجد مسارات مسجلة.</p>}</div></section>
			<section class="security-list-card is-wide"><header><div><span>التوزيع الجغرافي</span><h2>الدول المرتبطة بالأحداث الأمنية</h2></div><strong>{numberFormat.format(Number(overview.total_attacks || 0))} محاولة مصنفة كهجوم</strong></header><div class="security-country-list">{geo.slice(0, 10).map((item: any) => <div><span>{item.country_code || 'غير معروف'}</span><strong>{numberFormat.format(Number(item.count || 0))}</strong></div>)}{!geo.length && <p>لا توجد بيانات جغرافية.</p>}</div></section>
		</div> : tab === 'events' ? <div class="security-events-view">
			<section class="security-filter-card"><form method="get" action="/dashboard/security"><input type="hidden" name="tab" value="events"/><label class="security-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" name="q" value={search} placeholder="ابحث بعنوان IP كامل..."/></label><select name="severity" aria-label="مستوى الخطورة"><option value="">كل مستويات الخطورة</option>{Object.entries(severityLabel).map(([value, label]) => <option value={value} selected={severity === value}>{label}</option>)}</select><select name="event_type" aria-label="نوع الحدث"><option value="">كل أنواع الأحداث</option>{eventOptions.map(([value, label]) => <option value={value} selected={eventType === value}>{label}</option>)}</select><select name="resolution" aria-label="حالة المعالجة"><option value="">كل الحالات</option><option value="open" selected={resolution === 'open'}>مفتوحة</option><option value="resolved" selected={resolution === 'resolved'}>تمت معالجتها</option></select><button type="submit">تطبيق الفلاتر</button>{(search || severity || eventType || resolution) && <a href={tabUrl('events')}>مسح</a>}</form><form method="post" action="/api/dashboard/security/logs/clear" data-confirm data-confirm-title="مسح جميع سجلات الأمان؟" data-confirm-message="سيتم حذف السجل الأمني بالكامل، ولا يمكن استعادة هذه البيانات بعد ذلك." data-confirm-button="مسح السجلات"><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" class="security-clear-logs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg>مسح السجل</button></form></section>
			{logs.length ? <section class="security-table-card"><header><div><h2>سجل الأحداث الأمنية</h2><p>{numberFormat.format(logsResult.meta?.total ?? logs.length)} نتيجة مطابقة</p></div><span>صفحة {numberFormat.format(logsResult.meta?.current_page ?? page)} من {numberFormat.format(logsResult.meta?.last_page ?? 1)}</span></header><div class="security-table-scroll"><table><thead><tr><th>الخطورة</th><th>الحدث</th><th>عنوان IP</th><th>المسار</th><th>درجة الخطر</th><th>الحالة</th><th>الوقت</th><th>الإجراءات</th></tr></thead><tbody>{logs.map((log: any) => <tr class:list={{ 'is-open': !log.is_resolved }}><td><span class={`security-severity is-${log.severity}`}><i></i>{severityLabel[log.severity] || log.severity}</span></td><td><button type="button" class="security-event-name" data-open-log data-log-type={eventLabels[log.event_type] || log.event_type} data-log-description={log.description || ''} data-log-ip={log.ip_address || ''} data-log-route={log.route || ''} data-log-method={log.method || ''} data-log-risk={String(log.risk_score || 0)} data-log-agent={log.user_agent || ''} data-log-location={[log.city, log.country_code].filter(Boolean).join('، ')} data-log-time={formatDate(log.created_at)}>{eventLabels[log.event_type] || log.event_type}<small>{String(log.description || '').slice(0, 70)}</small></button></td><td><code dir="ltr">{log.ip_address}</code></td><td><span class="security-route" dir="ltr"><b>{log.method || '—'}</b>{log.route || '—'}</span></td><td><span class:list={['risk-score', Number(log.risk_score || 0) >= 70 && 'is-high']}><b>{numberFormat.format(Number(log.risk_score || 0))}</b><i><span style={`width:${Math.min(100, Number(log.risk_score || 0))}%`}></span></i></span></td><td><span class:list={['security-resolution', log.is_resolved && 'is-resolved']}><i></i>{log.is_resolved ? 'مُعالج' : 'مفتوح'}</span></td><td><time datetime={log.created_at}>{formatDate(log.created_at)}</time></td><td><div class="security-actions"><button type="button" data-open-log data-log-type={eventLabels[log.event_type] || log.event_type} data-log-description={log.description || ''} data-log-ip={log.ip_address || ''} data-log-route={log.route || ''} data-log-method={log.method || ''} data-log-risk={String(log.risk_score || 0)} data-log-agent={log.user_agent || ''} data-log-location={[log.city, log.country_code].filter(Boolean).join('، ')} data-log-time={formatDate(log.created_at)} title="عرض التفاصيل"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></button>{!log.is_resolved && <form method="post" action={`/api/dashboard/security/logs/${log.id}/resolve`}><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" class="is-resolve" title="تحديد كمُعالج"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m4 12 4 4L18 6"/></svg></button></form>}<form method="post" action={`/api/dashboard/security/logs/${log.id}/delete`} data-confirm data-confirm-title="حذف سجل الأمان؟" data-confirm-message="سيتم حذف هذا السجل نهائيًا من سجل المراقبة." data-confirm-button="حذف السجل"><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit" class="is-delete" title="حذف السجل"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 7h16m-10 4v6m4-6v6M9 7l1-3h4l1 3m3 0-1 14H7L6 7"/></svg></button></form></div></td></tr>)}</tbody></table></div></section> : <section class="security-state"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 4h14v16H5zM8 8h8m-8 4h8"/></svg></i><h2>لا توجد أحداث مطابقة</h2><p>جرّب تعديل الفلاتر أو مسحها.</p></section>}{logsResult.meta && logsResult.meta.last_page > 1 && <Pagination currentPage={logsResult.meta.current_page} lastPage={logsResult.meta.last_page} url={Astro.url}/>} 
		</div> : tab === 'blocked' ? <div class="security-ip-view">
			<section class="security-ip-form-card is-block"><header><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="m6 6 12 12"/></svg></i><div><h2>حظر عنوان IP</h2><p>امنع عنوانًا مشبوهًا من الوصول إلى المنصة.</p></div></header><form method="post" action="/api/dashboard/security/block-ip"><input type="hidden" name="redirect_to" value={redirectTo}/><label><span>عنوان IP</span><input type="text" name="ip_address" required placeholder="192.0.2.1" dir="ltr"/></label><label><span>سبب الحظر</span><input type="text" name="reason" placeholder="نشاط مشبوه أو محاولات متكررة"/></label><label><span>مدة الحظر</span><select name="days"><option value="0">دائم</option><option value="1">يوم واحد</option><option value="7">7 أيام</option><option value="30">30 يومًا</option><option value="90">90 يومًا</option></select></label><button type="submit">حظر العنوان</button></form></section>
			<main class="security-ip-list"><section class="security-ip-filter"><form method="get" action="/dashboard/security"><input type="hidden" name="tab" value="blocked"/><label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input type="search" name="q" value={search} placeholder="ابحث بالعنوان أو سبب الحظر..."/></label><select name="status"><option value="">كل الحالات</option><option value="active" selected={blockStatus === 'active'}>نشط</option><option value="expired" selected={blockStatus === 'expired'}>منتهي</option></select><button type="submit">بحث</button>{(search || blockStatus) && <a href={tabUrl('blocked')}>مسح</a>}</form></section>{blockedIps.length ? <section class="security-ip-table"><header><h2>قائمة العناوين المحظورة</h2><span>{numberFormat.format(blockedResult.meta?.total ?? blockedIps.length)} عنوان</span></header><div>{blockedIps.map((item: any) => <article><span class="ip-status is-blocked"><i></i>{item.status === 'expired' ? 'منتهي' : 'محظور'}</span><div class="ip-main"><code dir="ltr">{item.ip_address}</code><p>{item.reason || 'لم يتم تحديد سبب للحظر'}</p></div><div class="ip-meta"><span>{item.is_auto_block ? 'حظر تلقائي' : 'حظر يدوي'}</span><time>{item.expires_at ? `ينتهي ${formatDate(item.expires_at)}` : 'حظر دائم'}</time></div><form method="post" action="/api/dashboard/security/unblock-ip" data-confirm data-confirm-title="إلغاء حظر العنوان؟" data-confirm-message={`سيتم السماح للعنوان ${item.ip_address} بالوصول إلى المنصة مجددًا.`} data-confirm-button="إلغاء الحظر"><input type="hidden" name="ip" value={item.ip_address}/><input type="hidden" name="redirect_to" value={redirectTo}/><button type="submit">إلغاء الحظر</button></form></article>)}</div></section> : <section class="security-state"><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="9"/><path d="m6 6 12 12"/></svg></i><h2>لا توجد عناوين محظورة مطابقة</h2><p>يمكنك إضافة عنوان جديد من النموذج المجاور.</p></section>}{blockedResult.meta && blockedResult.meta.last_page > 1 && <Pagination currentPage={blockedResult.meta.current_page} lastPage={blockedResult.meta.last_page} url={Astro.url}/>}</main>
		</div> : <div class="security-ip-view">
