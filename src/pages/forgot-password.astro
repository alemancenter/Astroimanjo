---
import Layout from '../layouts/Layout.astro';
import '../styles/auth-pages.css';
import AuthShell from '../components/ui/AuthShell.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
---

<Layout title="استعادة كلمة المرور" description="اطلب رابطًا آمنًا لإعادة تعيين كلمة المرور." noindex>
	<AuthShell title="استعادة كلمة المرور" eyebrow="العودة إلى حسابك" description="أدخل بريدك الإلكتروني وسنرسل إليك رابطًا آمنًا لإعداد كلمة مرور جديدة.">
		{sent ? (
			<div class="space-y-6">
				<div class="alert-success" role="status">
					<svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
					<div><strong class="block">تحقق من بريدك الإلكتروني</strong><span>إذا كان البريد مسجلًا لدينا، فستصلك رسالة الاستعادة خلال دقائق. تحقق أيضًا من مجلد البريد غير المرغوب فيه.</span></div>
				</div>
				<a href="/login" class="btn-primary w-full">العودة إلى تسجيل الدخول</a>
				<a href="/forgot-password" class="btn-ghost w-full">إرسال رابط مرة أخرى</a>
			</div>
		) : (
			<>
				{error && <div class="alert-error mb-6" role="alert">{error}</div>}
				<form method="post" action="/api/auth/forgot-password" class="space-y-5">
					<div>
						<label for="email" class="form-label">البريد الإلكتروني</label>
						<input id="email" type="email" name="email" required autocomplete="email" inputmode="email" dir="ltr" class="form-control text-left" placeholder="name@example.com" />
						<p class="form-hint">لن نكشف ما إذا كان البريد مرتبطًا بحساب حفاظًا على الخصوصية.</p>
					</div>
					<button type="submit" class="btn-primary w-full py-3.5">إرسال رابط الاستعادة</button>
					<a href="/login" class="btn-ghost w-full">العودة إلى تسجيل الدخول</a>
				</form>
			</>
		)}
	</AuthShell>
</Layout>
