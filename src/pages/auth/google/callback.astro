---
// Landing page for the backend's redirect-based Google OAuth flow
// (back/internal/handlers/auth/handler.go GoogleCallback). By the time the browser reaches
// this page, the session cookies are already set — GoogleCallback sets them directly on its own
// redirect response with Domain=.imanjo.com (see cookieDomain()), which the browser carries
// straight through this cross-subdomain navigation. This page has nothing left to do but send
// the visitor to their actual destination (or show why it didn't work).
import { safeRedirectPath } from '../../../lib/safe-redirect';
import { oauthErrorMessage } from '../../../lib/oauth-errors';

const params = Astro.url.searchParams;
const errorMessage = oauthErrorMessage(params.get('error'));
const destination = errorMessage
	? `/login?error=${encodeURIComponent(errorMessage)}`
	: safeRedirectPath(params.get('redirect_to'), '/');
return Astro.redirect(destination);
---
<p>جارِ تحويلك... إذا لم يتم التحويل تلقائيًا، <a href={destination}>اضغط هنا</a>.</p>
