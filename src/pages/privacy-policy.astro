---
import Layout from '../layouts/Layout.astro';
import '../styles/static-pages.css';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ProseContainer from '../components/ui/ProseContainer.astro';
import { getSiteContactInfo } from '../lib/site-contact';

export const prerender = true;

const { siteOrigin, siteHost, contactEmail } = await getSiteContactInfo(Astro);
---

<Layout title="سياسة الخصوصية" description="طريقة تعامل موقع الإيمان التعليمي مع البيانات الشخصية والخصوصية وملفات الارتباط.">
	<Breadcrumbs items={[{ label: 'سياسة الخصوصية' }]} />
	<ProseContainer title="سياسة الخصوصية" description="نوضح هنا طريقة التعامل مع البيانات والخصوصية وملفات الارتباط بطريقة مباشرة وقابلة للقراءة." lastUpdated="16 مايو 2026" eyebrow="الخصوصية وحماية البيانات">
		<p>توضح سياسة الخصوصية هذه سياساتنا وإجراءاتنا بشأن جمع معلوماتك واستخدامها والإفصاح عنها عند استخدامك للخدمة، وتخبرك بحقوق الخصوصية الخاصة بك وكيف يحميك القانون.</p>
		<p>نستخدم بياناتك الشخصية لتوفير الخدمة وتحسينها. باستخدام الخدمة، فإنك توافق على جمع المعلومات واستخدامها وفقًا لسياسة الخصوصية هذه.</p>

		<h2>التفسير والتعريفات</h2>
		<h3>التفسير</h3>
		<p>الكلمات التي يبدأ الحرف الأول منها بأحرف كبيرة لها معانٍ محددة وفقًا للشروط التالية. تحمل التعريفات المعنى نفسه سواء وردت بصيغة المفرد أو الجمع.</p>
		<h3>التعريفات</h3>
		<ul>
			<li><strong>الحساب:</strong> حساب فريد يتم إنشاؤه لك للوصول إلى خدمتنا أو أجزاء منها.</li>
			<li><strong>الشركة:</strong> تشير إلى موقع الإيمان التعليمي، ويشار إليها في هذه السياسة بعبارات «الشركة» أو «نحن» أو «لنا».</li>
			<li><strong>ملفات تعريف الارتباط:</strong> ملفات صغيرة يضعها موقع إلكتروني على جهازك وتحتوي على تفاصيل سجل التصفح واستخدامات أخرى.</li>
			<li><strong>البلد:</strong> المملكة الأردنية الهاشمية.</li>
			<li><strong>الجهاز:</strong> أي جهاز يمكنه الوصول إلى الخدمة مثل الحاسوب أو الهاتف أو الجهاز اللوحي.</li>
			<li><strong>البيانات الشخصية:</strong> أي معلومات تتعلق بشخص محدد أو يمكن تحديد هويته.</li>
			<li><strong>الخدمة:</strong> الموقع الإلكتروني والخدمات التعليمية التي يتيحها.</li>
			<li><strong>الموقع الإلكتروني:</strong> موقع الإيمان التعليمي، المتاح عبر <a href={siteOrigin} rel="noopener noreferrer">{siteHost}</a>.</li>
		</ul>

		<h2>جمع بياناتك الشخصية واستخدامها</h2>
		<h3>أنواع البيانات التي يتم جمعها</h3>
		<p>أثناء استخدام خدمتنا، قد نطلب منك تزويدنا ببعض المعلومات الشخصية التي يمكن استخدامها للاتصال بك أو تحديد هويتك، وقد تشمل:</p>
		<ul>
			<li>الاسم الأول والأخير.</li>
			<li>البريد الإلكتروني.</li>
			<li>رقم الهاتف.</li>
			<li>بيانات الاستخدام.</li>
		</ul>
		<h3>بيانات الاستخدام</h3>
		<p>تُجمع بيانات الاستخدام تلقائيًا عند استخدام الخدمة. وقد تتضمن عنوان IP لجهازك، ونوع المتصفح وإصداره، وصفحات الخدمة التي تزورها، ووقت الزيارة وتاريخها، والوقت الذي تقضيه في الصفحات، ومعرفات الأجهزة الفريدة وبيانات تشخيصية أخرى.</p>
		<h3>تقنيات التتبع وملفات تعريف الارتباط</h3>
		<p>نستخدم ملفات تعريف الارتباط وتقنيات تتبع مشابهة لتتبع النشاط وتخزين معلومات معينة بهدف تشغيل الموقع وتحسينه وقياس أدائه. يمكنك معرفة التفاصيل من <a href="/cookie-policy">سياسة ملفات تعريف الارتباط</a>.</p>

		<h2>استخدام بياناتك الشخصية</h2>
		<p>يجوز لنا استخدام البيانات الشخصية للأغراض التالية:</p>
		<ul>
			<li><strong>لتوفير خدمتنا وصيانتها:</strong> بما في ذلك مراقبة استخدام الخدمة وتحسين أدائها.</li>
			<li><strong>لإدارة حسابك:</strong> وإتاحة الوظائف المختلفة المتوفرة للمستخدمين المسجلين.</li>
			<li><strong>للتواصل معك:</strong> عبر البريد الإلكتروني أو الهاتف بشأن التحديثات أو طلبات الدعم أو معلومات الخدمة.</li>
			<li><strong>لتزويدك بالأخبار:</strong> والمعلومات ذات الصلة بالخدمات والمحتوى، ما لم تختر عدم تلقيها.</li>
			<li>لإدارة طلباتك، وتحليل الاستخدام، وتطوير المحتوى والخدمات وتجربة المستخدم.</li>
		</ul>

		<h2>الإعلانات وGoogle AdSense</h2>
		<p>نستخدم Google AdSense لعرض إعلانات على موقعنا. تستخدم Google وشركاؤها ملفات تعريف الارتباط أو تقنيات مشابهة لعرض الإعلانات وقياسها وتحسينها، وقد تعتمد الإعلانات على زياراتك لهذا الموقع أو مواقع أخرى.</p>
		<p>يمكنك تعطيل تخصيص الإعلانات أو معرفة طريقة استخدام Google لبياناتك من الروابط التالية:</p>
		<ul>
			<li><a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">إعدادات إعلانات Google</a>.</li>
			<li><a href="https://policies.google.com/technologies/partner-sites?hl=ar" target="_blank" rel="noopener noreferrer">كيف تستخدم Google البيانات عند استخدام مواقع شركائها</a>.</li>
			<li><a href="https://policies.google.com/technologies/cookies?hl=ar" target="_blank" rel="noopener noreferrer">كيف تستخدم Google ملفات تعريف الارتباط</a>.</li>
			<li><a href="/cookie-policy">سياسة ملفات تعريف الارتباط الخاصة بنا</a>.</li>
		</ul>
		<p>يمكنك مراجعة وتعديل موافقتك على ملفات تعريف الارتباط في أي وقت عبر إعدادات المتصفح.</p>

		<h2>حقوقك بشأن بياناتك الشخصية</h2>
		<p>وفقًا لأنظمة حماية البيانات المعمول بها، بما فيها GDPR وCCPA عند انطباقها، يحق لك ممارسة الحقوق التالية:</p>
		<ul>
			<li><strong>حق الوصول:</strong> طلب نسخة من البيانات الشخصية التي نحتفظ بها عنك.</li>
			<li><strong>حق التصحيح:</strong> طلب تصحيح البيانات غير الدقيقة أو استكمال البيانات الناقصة.</li>
			<li><strong>حق الحذف:</strong> طلب حذف بياناتك الشخصية عند عدم وجود سبب قانوني للاحتفاظ بها.</li>
			<li><strong>حق الاعتراض على المعالجة:</strong> الاعتراض على بعض أوجه استخدام بياناتك.</li>
			<li><strong>حق تقييد المعالجة:</strong> طلب تعليق معالجة البيانات في حالات معينة.</li>
			<li><strong>حق نقل البيانات:</strong> الحصول على بياناتك بصيغة منظمة وقابلة للقراءة آليًا متى كان ذلك منطبقًا.</li>
			<li><strong>حق سحب الموافقة:</strong> سحب موافقتك في أي وقت دون أن يؤثر ذلك على قانونية المعالجة السابقة.</li>
		</ul>
		<p>يمكنك تقديم طلبك عبر <a href="/contact-us">نموذج التواصل</a>. نعمل على الرد خلال 30 يومًا، وقد نطلب معلومات للتحقق من هويتك. كما يحق لك تقديم شكوى إلى جهة حماية البيانات المختصة حيث ينطبق ذلك.</p>

		<h2>خصوصية الأطفال</h2>
		<ul>
			<li>لا نجمع بيانات شخصية من الأطفال دون الثالثة عشرة من العمر بشكل مقصود دون موافقة ولي الأمر المسبقة.</li>
			<li>يُنصح أولياء الأمور بمرافقة أطفالهم عند استخدام الموقع وإنشاء أي حسابات بالنيابة عنهم.</li>
			<li>إذا اكتشفنا أننا جمعنا بيانات من طفل دون الثالثة عشرة دون موافقة ولي الأمر، فسنحذف هذه البيانات فورًا.</li>
			<li>يحق لولي الأمر طلب الاطلاع على بيانات طفله أو تعديلها أو حذفها عبر التواصل معنا.</li>
		</ul>

		<h2>أمان بياناتك الشخصية</h2>
		<p>أمان بياناتك الشخصية مهم بالنسبة لنا. لا توجد طريقة نقل عبر الإنترنت أو طريقة تخزين إلكتروني آمنة بنسبة 100%، لكننا نسعى جاهدين إلى استخدام وسائل مقبولة تجاريًا لحماية بياناتك.</p>

		<h2>التغييرات على سياسة الخصوصية</h2>
		<p>قد نحدّث سياسة الخصوصية من وقت إلى آخر. سننشر السياسة الجديدة على هذه الصفحة ونحدّث تاريخ «آخر تحديث»، ويُنصح بمراجعتها دوريًا.</p>

		<h2>التواصل معنا</h2>
		<p>لأي استفسار متعلق بالخصوصية، تواصل معنا عبر <a href={`mailto:${contactEmail}`}>{contactEmail}</a> أو <a href="/contact-us">نموذج التواصل</a>.</p>
	</ProseContainer>
</Layout>
