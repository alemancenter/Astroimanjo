---
import Layout from '../layouts/Layout.astro';
import '../styles/static-pages.css';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ProseContainer from '../components/ui/ProseContainer.astro';
import { getSiteContactInfo } from '../lib/site-contact';

export const prerender = true;

const { contactEmail } = await getSiteContactInfo(Astro);
---

<Layout title="السياسة التحريرية" description="معايير اختيار المحتوى التعليمي ومراجعته وتحديثه وتصحيح الأخطاء.">
	<Breadcrumbs items={[{ label: 'السياسة التحريرية' }]} />
	<ProseContainer title="السياسة التحريرية" description="المعايير التي نتبعها لاختيار المحتوى ومراجعته وتنظيمه والحفاظ على فائدته التعليمية." lastUpdated="20 مايو 2026" eyebrow="جودة المحتوى">
		<h2>معايير اختيار المحتوى</h2>
		<p>نعتمد في نشر المحتوى على مدى ارتباطه بالمنهاج، فائدته التعليمية، وضوح عنوانه، وإمكانية استفادة المستخدم منه في الدراسة أو التحضير أو المراجعة. لا يتم اعتماد الصفحات التي لا تقدم فائدة واضحة أو تحتوي على معلومات مضللة.</p>

		<h2>محتوى تعليمي واضح</h2>
		<p>نحرص على أن تكون الصفحات مرتبطة بصف أو مادة أو موضوع واضح.</p>

		<h2>تنظيم وفهرسة</h2>
		<p>يتم تنظيم المحتوى عبر الأقسام والكلمات والروابط الداخلية لتسهيل الوصول.</p>

		<h2>تحديث مستمر</h2>
		<p>نقوم بتحديث الملفات والمقالات عند توفر معلومات أو نسخ أحدث.</p>

		<h2>تصحيح الأخطاء</h2>
		<p>يمكن للمستخدمين إرسال ملاحظات حول أي خطأ أو ملف غير مناسب للمراجعة.</p>

		<h2>مراجعة المقالات والملفات</h2>
		<p>قبل نشر المحتوى أو تحديثه، تتم مراجعة العنوان، والتصنيف، والوصف، ووضوح الملف أو المرفق، وسلامة تجربة المستخدم. كما نعمل تدريجيًا على تحسين الصفحات القديمة وإضافة وصف تعليمي أوضح لكل ملف.</p>

		<h2>التعامل مع المحتوى القديم</h2>
		<p>نظرًا لكثرة الصفحات والملفات التعليمية، قد توجد صفحات قديمة تحتاج إلى تحسين أو تحديث. لذلك نعتمد خطة مراجعة مرحلية تبدأ بالصفحات الأعلى زيارة والأكثر أهمية، ثم تنتقل تدريجيًا إلى باقي المحتوى.</p>

		<h2>الإبلاغ عن خطأ</h2>
		<p>إذا لاحظت خطأ في صفحة، أو ملفًا غير مناسب، أو رابط تحميل لا يعمل، أو معلومة تحتاج إلى تحديث، يمكنك التواصل معنا عبر <a href="/contact-us">صفحة اتصل بنا</a> أو البريد <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</p>
	</ProseContainer>
</Layout>
