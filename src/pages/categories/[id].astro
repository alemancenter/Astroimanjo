---
// Legacy bare path — the canonical post-category page lives at /{countryCode}/posts/category/{id|slug}.
import { getCountryById } from '../../lib/countries';

const { id } = Astro.params;
const countryCode = getCountryById(Astro.locals.countryId).code;
return Astro.redirect(`/${countryCode}/posts/category/${id}`, 307);
---
