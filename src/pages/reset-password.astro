---
import Layout from '../layouts/Layout.astro';
import '../styles/auth-pages.css';
import AuthShell from '../components/ui/AuthShell.astro';

const params = Astro.url.searchParams;
const token = params.get('token')?.trim() || '';
const email = params.get('email')?.trim() || '';
const error = params.get('error');
const done = params.get('done') === '1';
---

<Layout title="تعيين كلمة مرور جديدة" description="أنشئ كلمة مرور جديدة لحسابك." noindex>
	<AuthShell title="كلمة مرور جديدة" eyebrow="تأمين الحساب" description="اختر كلمة مرور قوية لا تقل عن 8 أحرف ثم أكدها.">
		{done ? (
			<div class="space-y-6">
				<div class="alert-success" role="status">
					<svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
					<div><strong class="block">تم تحديث كلمة المرور</strong><span>يمكنك الآن تسجيل الدخول باستخدام كلمة المرور الجديدة.</span></div>
				</div>
				<a href="/login" class="btn-primary w-full">تسجيل الدخول</a>
			</div>
		) : !token ? (
			<div class="space-y-5">
				<div class="alert-error" role="alert">رابط إعادة تعيين كلمة المرور غير مكتمل أو غير صالح.</div>
				<a href="/forgot-password" class="btn-primary w-full">طلب رابط جديد</a>
			</div>
		) : (
			<>
				{error && <div class="alert-error mb-6" role="alert">{error}</div>}
				<form method="post" action="/api/auth/reset-password" class="space-y-5" data-reset-form>
					<input type="hidden" name="token" value={token} />
					<input type="hidden" name="email" value={email} />
					{!email && <div><label for="email" class="form-label">البريد الإلكتروني</label><input id="email" type="email" name="email" required autocomplete="email" dir="ltr" class="form-control text-left" /></div>}
					<div><label for="password" class="form-label">كلمة المرور الجديدة</label><input id="password" type="password" name="password" required minlength="8" autocomplete="new-password" dir="ltr" class="form-control text-left" placeholder="8 أحرف على الأقل" /></div>
					<div><label for="password_confirmation" class="form-label">تأكيد كلمة المرور</label><input id="password_confirmation" type="password" name="password_confirmation" required minlength="8" autocomplete="new-password" dir="ltr" class="form-control text-left" placeholder="أعد كتابة كلمة المرور" /></div>
					<p class="hidden text-sm font-bold text-red-600" data-password-error role="alert">كلمتا المرور غير متطابقتين.</p>
					<button type="submit" class="btn-primary w-full py-3.5">حفظ كلمة المرور الجديدة</button>
				</form>
			</>
		)}
	</AuthShell>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-reset-form]');
	form?.addEventListener('submit', (event) => {
		const password = form.querySelector<HTMLInputElement>('[name="password"]')?.value || '';
		const confirmation = form.querySelector<HTMLInputElement>('[name="password_confirmation"]')?.value || '';
		const error = form.querySelector<HTMLElement>('[data-password-error]');
		if (password !== confirmation) {
			event.preventDefault();
			error?.classList.remove('hidden');
			return;
		}
		error?.classList.add('hidden');
	});
</script>
