---
import Layout from '../../../../../layouts/Layout.astro';
import '../../../../../styles/lesson-pages.css';
import SubjectDetail from '../../../../../components/SubjectDetail.astro';
import { apiFetch, applyNotFoundStatus } from '../../../../../lib/api';

const { classId, subjectId } = Astro.params;
const countryCode = Astro.locals.countryCode!;
const countryId = Astro.locals.countryId;
const [semestersResult, classResult] = await Promise.all([
	apiFetch<any>(`/filter/semesters/${subjectId}`, { countryId }),
	apiFetch<any>(`/school-classes/${classId}`, { countryId }),
]);

const subject = semestersResult.data?.subject;
if (!semestersResult.ok || !subject) applyNotFoundStatus(Astro, semestersResult);
const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const canonicalUrl = new URL(`/${countryCode}/lesson/subjects/${subjectId}`, siteOrigin).toString();
---

<Layout
	title={subject?.subject_name || 'المادة الدراسية'}
	description={subject ? `ملفات ومقالات مادة ${subject.subject_name}.` : undefined}
	canonical={canonicalUrl}
>
	<SubjectDetail
		countryCode={countryCode}
		subject={subject}
		semesters={semestersResult.data?.semesters ?? []}
		schoolClass={classResult.data}
		semestersOk={semestersResult.ok}
		semestersMessage={semestersResult.message}
	/>
</Layout>
