---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/content-pages.css';
import KeywordsBrowse from '../../../../components/KeywordsBrowse.astro';

const countryCode = Astro.locals.countryCode!;
const hasFilters = !!Astro.url.searchParams.get('q')?.trim();
---

<Layout title="تصفح وسوم المنشورات" description="كل الوسوم المستخدمة في منشورات الموقع، مرتبة أبجدياً." noindex={hasFilters}>
	<KeywordsBrowse type="posts" detailBase={`/${countryCode}/posts/keyword`} title="وسوم المنشورات" />
</Layout>
