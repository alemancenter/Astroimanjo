---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/content-pages.css';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import PostCard from '../../../../components/ui/PostCard.astro';
import Pagination from '../../../../components/ui/Pagination.astro';
import EmptyState from '../../../../components/ui/EmptyState.astro';
import ErrorState from '../../../../components/ui/ErrorState.astro';
import { apiFetch, apiFetchList, applyNotFoundStatus } from '../../../../lib/api';

const { categoryId } = Astro.params;
const countryCode = Astro.locals.countryCode!;
const countryId = Astro.locals.countryId;
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

// The backend's /categories/:id is numeric-PK-only, but the site's indexed URLs use the
// category slug (see back/internal/services/sitemap_service.go). Resolve id-or-slug against
// the full list, same as the old frontend did.
const categoriesResult = await apiFetchList<any>('/categories', { countryId });
const { items: categories, ok: categoriesOk, message: categoriesMessage } = categoriesResult;
const category = categories.find((c: any) => c.slug === categoryId || String(c.id) === categoryId);
if (!category) applyNotFoundStatus(Astro, categoriesResult);

const postsResult = category
	? await apiFetch<any[]>('/posts', { countryId, params: { category_id: category.id, page, per_page: 12 } })
	: null;
const posts = postsResult && Array.isArray(postsResult.data) ? postsResult.data : [];
const meta = postsResult?.meta ?? null;

const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const canonicalUrl = category
	? new URL(`/${countryCode}/posts/category/${category.slug || category.id}`, siteOrigin).toString()
	: undefined;
---

<Layout
	title={category?.name || 'القسم'}
	description={category ? `تصفح منشورات قسم ${category.name}.` : undefined}
	canonical={canonicalUrl}
>
	<Breadcrumbs items={[{ label: 'الأقسام التعليمية', href: `/${countryCode}/categories` }, { label: category?.name || '...' }]} />

	<div class="page-shell">
		{
			!category ? (
				<ErrorState message={categoriesOk ? 'القسم غير موجود.' : categoriesMessage} />
			) : (
				<>
					<header class="page-heading"><span class="page-eyebrow">قسم تعليمي</span><h1 class="page-title">{category.name}</h1><p class="page-description">أحدث المقالات والموضوعات المتاحة ضمن هذا القسم.</p></header>

					{!postsResult?.ok ? (
						<ErrorState message={postsResult?.message} />
					) : posts.length > 0 ? (
						<>
							<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
								{posts.map((post: any, i: number) => (
									<PostCard post={post} href={`/${countryCode}/posts/${post.id}`} index={i} />
								))}
							</div>
							{meta && <Pagination currentPage={meta.current_page} lastPage={meta.last_page} url={Astro.url} />}
						</>
					) : (
						<EmptyState message="لا توجد منشورات في هذا القسم حالياً." />
					)}
				</>
			)
		}
	</div>
</Layout>
