---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/download-page.css';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import ErrorState from '../../../components/ui/ErrorState.astro';
import { apiFetch, applyNotFoundStatus } from '../../../lib/api';

const { fileId } = Astro.params;
const countryCode = Astro.locals.countryCode!;
const countryId = Astro.locals.countryId;
const errorMessage = Astro.url.searchParams.get('error');

const fileResult = await apiFetch<any>(`/files/${fileId}/info`, { countryId });
const payload = fileResult.data;
const file = payload?.file;
const item = payload?.item;
const itemType = payload?.type === 'post' || file?.post_id ? 'post' : 'article';

if (!fileResult.ok || !file) applyNotFoundStatus(Astro, fileResult);

let schoolClass: any = null;
if (file && itemType === 'article' && item?.grade_level) {
	const classResult = await apiFetch<any>(`/school-classes/${item.grade_level}`, { countryId });
	schoolClass = classResult.data;
}

if (file) {
	await apiFetch(`/files/${file.id}/increment-view`, { countryId, method: 'POST' });
}

const formatSize = (bytes?: number) => {
	if (!Number(bytes)) return 'حجم غير محدد';
	const units = ['بايت', 'ك.ب', 'م.ب', 'ج.ب'];
	const index = Math.min(Math.floor(Math.log(Number(bytes)) / Math.log(1024)), units.length - 1);
	const value = Number(bytes) / Math.pow(1024, index);
	return `${value.toLocaleString('ar-JO', { maximumFractionDigits: index ? 1 : 0 })} ${units[index]}`;
};

const extension = String(file?.file_type || file?.file_name?.split('.').pop() || 'FILE').replace(/^\./, '').toUpperCase();
const parentTitle = item?.title || item?.name || 'المحتوى المرتبط';
const parentHref = item?.id
	? (itemType === 'post' ? `/${countryCode}/posts/${item.id}` : `/${countryCode}/lesson/articles/${item.id}`)
	: `/${countryCode}/classes`;
const downloadHref = itemType === 'post'
	? `/api/download/post-file/${file?.id}`
	: `/api/download/article-file/${file?.id}`;
const categoryLabel = file?.file_category || (itemType === 'post' ? 'مرفق منشور' : 'مادة تعليمية');
const publishedAt = file?.updated_at || file?.created_at;
const formatDate = (value?: string) => value
	? new Date(value).toLocaleDateString('ar-JO', { year: 'numeric', month: 'long', day: 'numeric' })
	: 'غير محدد';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site?.origin || Astro.url.origin).toString();
---

<Layout
	title={file ? `تنزيل ${file.file_name}` : 'تنزيل الملف'}
	description={file ? `صفحة تنزيل الملف ${file.file_name} المرتبط بـ ${parentTitle}.` : undefined}
	canonical={canonicalUrl}
	noindex={true}
>
	{!fileResult.ok || !file ? (
		<div class="container-shell max-w-4xl py-14">
			<ErrorState message={fileResult.ok ? 'الملف المطلوب غير موجود أو تمت إزالته.' : fileResult.message} />
		</div>
	) : (
		<main class="download-page border-b border-graphite-200 bg-graphite-50 dark:border-graphite-800 dark:bg-graphite-950">

			<Breadcrumbs items={[
				{ label: itemType === 'post' ? 'المنشورات' : 'المقالات', href: itemType === 'post' ? `/${countryCode}/posts` : `/${countryCode}/classes` },
				{ label: parentTitle, href: parentHref },
				{ label: 'تنزيل الملف' },
			]} />

			<div class="container-shell max-w-6xl py-8 sm:py-10 lg:py-12">
				{errorMessage && (
					<div class="mb-6 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold leading-6 text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200" role="alert">
						<svg class="mt-0.5 size-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.3 3.7 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z" /></svg>
						<span>{errorMessage}</span>
					</div>
				)}

				<header class="mb-6 sm:mb-8">
					<span class="inline-flex items-center gap-2 rounded-full border border-royal-200 bg-white px-3 py-1.5 text-xs font-extrabold text-royal-700 shadow-sm dark:border-royal-900 dark:bg-graphite-900 dark:text-royal-200"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" /></svg>مركز تنزيل الملفات</span>
					<h1 class="mt-3 text-2xl font-black text-graphite-950 sm:text-3xl dark:text-white">تنزيل الملف</h1>
					<p class="mt-2 max-w-2xl text-sm font-medium leading-7 text-graphite-500 sm:text-base dark:text-graphite-400">بيانات واضحة للملف ومصدره قبل بدء التنزيل.</p>
				</header>

				<div class="grid items-start gap-6 lg:grid-cols-3 lg:gap-7">
					<section class="overflow-hidden rounded-2xl border border-graphite-200 bg-white shadow-soft dark:border-graphite-700 dark:bg-graphite-900 lg:col-span-2" aria-labelledby="download-title">
						<div class="border-b border-graphite-200 bg-white px-5 py-6 dark:border-graphite-700 dark:bg-graphite-900 sm:px-7 sm:py-7">
							<div class="flex flex-col gap-5 sm:flex-row sm:items-center">
								<div class="relative flex size-20 shrink-0 items-center justify-center rounded-2xl bg-royal-50 text-base font-black text-royal-700 ring-1 ring-royal-200 dark:bg-royal-950 dark:text-royal-200 dark:ring-royal-900 sm:size-24">
									{extension.slice(0, 5)}
									<span class="absolute -bottom-2 -left-2 flex size-8 items-center justify-center rounded-full border-4 border-white bg-emerald-brand-600 text-white dark:border-graphite-900" aria-hidden="true"><svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" /></svg></span>
								</div>
								<div class="min-w-0">
									<span class="mb-2 inline-flex rounded-full bg-royal-100 px-3 py-1 text-[11px] font-black text-royal-700 dark:bg-royal-900 dark:text-royal-200">{categoryLabel}</span>
									<h2 id="download-title" class="break-words text-xl font-black leading-9 text-graphite-950 sm:text-2xl sm:leading-10 dark:text-white">{file.file_name || `ملف رقم ${file.id}`}</h2>
									<p class="mt-2 text-sm font-medium leading-7 text-graphite-500 dark:text-graphite-400">راجع بيانات الملف ثم اضغط زر التنزيل الآمن بالأسفل.</p>
								</div>
							</div>
						</div>

						<div class="p-5 sm:p-7">
							<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
								<div class="rounded-xl border border-graphite-200 bg-graphite-50 p-4 dark:border-graphite-700 dark:bg-graphite-800"><span class="block text-xs font-bold text-graphite-500 dark:text-graphite-400">نوع الملف</span><strong class="mt-1.5 block text-base font-black text-graphite-900 dark:text-white">{extension}</strong></div>
								<div class="rounded-xl border border-graphite-200 bg-graphite-50 p-4 dark:border-graphite-700 dark:bg-graphite-800"><span class="block text-xs font-bold text-graphite-500 dark:text-graphite-400">الحجم</span><strong class="mt-1.5 block text-base font-black text-graphite-900 dark:text-white">{formatSize(file.file_size)}</strong></div>
								<div class="rounded-xl border border-graphite-200 bg-graphite-50 p-4 dark:border-graphite-700 dark:bg-graphite-800"><span class="block text-xs font-bold text-graphite-500 dark:text-graphite-400">المشاهدات</span><strong class="mt-1.5 block text-base font-black text-graphite-900 dark:text-white">{Number(file.view_count || file.views_count || 0).toLocaleString('ar-JO')}</strong></div>
								<div class="rounded-xl border border-graphite-200 bg-graphite-50 p-4 dark:border-graphite-700 dark:bg-graphite-800"><span class="block text-xs font-bold text-graphite-500 dark:text-graphite-400">التنزيلات</span><strong class="mt-1.5 block text-base font-black text-graphite-900 dark:text-white">{Number(file.download_count || 0).toLocaleString('ar-JO')}</strong></div>
							</div>

							<div class="mt-6 rounded-2xl border border-emerald-brand-200 bg-emerald-brand-50/70 p-4 dark:border-emerald-brand-900 dark:bg-emerald-brand-950/35 sm:p-5">
								<div class="flex items-start gap-3">
									<span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-brand-600 text-white"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5-3.5V12c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6.5L12 3l8 3.5Z" /></svg></span>
									<div><h2 class="text-sm font-black text-emerald-brand-900 dark:text-emerald-brand-100">تنزيل محمي وموثوق</h2><p class="mt-1 text-xs font-medium leading-6 text-emerald-brand-800 dark:text-emerald-brand-200">يتم إنشاء رابط تنزيل مؤقت وآمن عند الضغط، ولن يتم تنزيل أي ملف دون موافقتك.</p></div>
								</div>
							</div>

							<a href={downloadHref} data-download-action class="mt-6 flex min-h-14 w-full items-center justify-center gap-3 rounded-2xl bg-royal-600 px-5 py-3.5 text-base font-black text-white shadow-lg shadow-royal-600/20 transition hover:-translate-y-0.5 hover:bg-royal-700 hover:shadow-xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-royal-300 active:translate-y-0">
								<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" /></svg>
								<span data-download-label>تنزيل الملف الآن</span>
							</a>
							<p class="mt-3 text-center text-[11px] font-semibold leading-5 text-graphite-400">إذا لم يبدأ التنزيل، اضغط الزر مرة أخرى وتأكد من السماح بالتنزيلات في المتصفح.</p>
						</div>
					</section>

					<aside class="space-y-5 lg:sticky lg:top-28">
						<section class="overflow-hidden rounded-2xl border border-graphite-200 bg-white shadow-soft dark:border-graphite-700 dark:bg-graphite-900">
							<header class="border-b border-graphite-200 px-5 py-4 dark:border-graphite-700"><span class="text-xs font-extrabold text-royal-600 dark:text-royal-300">مصدر الملف</span><h2 class="mt-1 text-base font-black text-graphite-950 dark:text-white">المحتوى المرتبط</h2></header>
							<div class="p-5">
								<a href={parentHref} class="group block rounded-xl bg-graphite-50 p-4 transition hover:bg-royal-50 dark:bg-graphite-800 dark:hover:bg-royal-950/50">
									<h3 class="line-clamp-3 text-base font-extrabold leading-7 text-graphite-900 transition group-hover:text-royal-700 dark:text-white dark:group-hover:text-royal-300">{parentTitle}</h3>
									<span class="mt-3 inline-flex items-center gap-1.5 text-xs font-black text-royal-600 dark:text-royal-300">عرض {itemType === 'post' ? 'المنشور' : 'المقال'}<svg class="size-3.5 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg></span>
								</a>
								<dl class="mt-4 divide-y divide-graphite-100 text-xs dark:divide-graphite-800">
									{schoolClass?.grade_name && <div class="flex justify-between gap-4 py-3"><dt class="text-graphite-500 dark:text-graphite-400">الصف</dt><dd class="text-left font-extrabold text-graphite-900 dark:text-white">{schoolClass.grade_name}</dd></div>}
									{item?.subject?.subject_name && <div class="flex justify-between gap-4 py-3"><dt class="text-graphite-500 dark:text-graphite-400">المادة</dt><dd class="text-left font-extrabold text-graphite-900 dark:text-white">{item.subject.subject_name}</dd></div>}
									{item?.semester?.semester_name && <div class="flex justify-between gap-4 py-3"><dt class="text-graphite-500 dark:text-graphite-400">الفصل</dt><dd class="text-left font-extrabold text-graphite-900 dark:text-white">{item.semester.semester_name}</dd></div>}
									<div class="flex justify-between gap-4 py-3"><dt class="text-graphite-500 dark:text-graphite-400">آخر تحديث</dt><dd class="text-left font-extrabold text-graphite-900 dark:text-white">{formatDate(publishedAt)}</dd></div>
								</dl>
							</div>
						</section>

						<a href={parentHref} class="flex min-h-12 items-center justify-center gap-2 rounded-2xl border border-graphite-200 bg-white px-4 py-3 text-sm font-extrabold text-graphite-700 shadow-soft transition hover:border-royal-300 hover:text-royal-700 dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-200 dark:hover:border-royal-700 dark:hover:text-royal-300">
							<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg>
							العودة إلى المحتوى
						</a>
					</aside>
				</div>
			</div>
		</main>
	)}

	<script>
		document.querySelectorAll<HTMLElement>('[data-download-action]').forEach((button) => {
			button.addEventListener('click', () => {
				const label = button.querySelector<HTMLElement>('[data-download-label]');
				if (label) label.textContent = 'جارٍ تحضير التنزيل الآمن…';
				button.setAttribute('aria-busy', 'true');
			});
		});
	</script>
</Layout>
