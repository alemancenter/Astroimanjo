---
import Layout from '../layouts/Layout.astro';
import '../styles/static-pages.css';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ProseContainer from '../components/ui/ProseContainer.astro';
import { getSiteContactInfo } from '../lib/site-contact';

export const prerender = true;

const { siteOrigin, siteHost, contactEmail } = await getSiteContactInfo(Astro);
---

<Layout title="من نحن" description="تعرّف إلى هوية موقع الإيمان التعليمي ورؤيته ورسالته وخدماته للطلاب والمعلمين.">
	<Breadcrumbs items={[{ label: 'من نحن' }]} />

	<ProseContainer
		title="من نحن"
		eyebrow="موقع الإيمان التعليمي"
		description="مرحبًا بكم في موقع الإيمان التعليمي، مساحة تعليمية مصممة لدعم الطلاب والمعلمين بمحتوى واضح وسهل الوصول."
	>
		<h2>هويتنا</h2>
		<p>
			<strong>موقع الإيمان التعليمي</strong> منصة تعليمية إلكترونية أردنية متخصصة في توفير المحتوى التعليمي للطلاب
			والمعلمين وفق المنهاج الدراسي الأردني. نعمل على تقديم موارد تعليمية عالية الجودة تشمل المناهج الدراسية وأوراق
			العمل والاختبارات والأخبار التربوية.
		</p>
		<ul>
			<li><strong>الموقع الإلكتروني:</strong> <a href={siteOrigin} rel="noopener noreferrer">{siteHost}</a></li>
			<li><strong>البريد الإلكتروني:</strong> <a href={`mailto:${contactEmail}`}>{contactEmail}</a></li>
			<li><strong>العنوان:</strong> إربد، الأردن</li>
		</ul>

		<h2>رؤيتنا</h2>
		<p>
			نسعى إلى أن نكون المصدر الأول للمحتوى التعليمي الموثوق والشامل، مع تسهيل الوصول إلى المواد التعليمية
			والاختبارات والمقالات الإرشادية للطلاب والمعلمين على حد سواء.
		</p>

		<h2>رسالتنا</h2>
		<p>
			تقديم تجربة تعليمية متكاملة تعتمد على توفير موارد تعليمية عالية الجودة تساهم في تحسين أداء الطلاب والمعلمين
			وتطوير البيئة التعليمية بشكل عام.
		</p>

		<h2>ماذا نقدم؟</h2>
		<h3>صفوف دراسية</h3>
		<p>محتوى يغطي جميع الصفوف من التمهيدي حتى الصف الثاني عشر.</p>
		<h3>مواد دراسية</h3>
		<ul>
			<li>الخطة الدراسية.</li>
			<li>أوراق العمل والكورسات.</li>
			<li>الاختبارات الشهرية والنهائية.</li>
			<li>الكتب الرسمية ودليل المعلم.</li>
		</ul>
		<h3>أخبار تربوية</h3>
		<p>آخر الأخبار التربوية والمقالات الإرشادية التي تهم الطلاب والمعلمين وأولياء الأمور.</p>
		<h3>تصفية المحتوى</h3>
		<p>أدوات بحث وتصنيف متقدمة تساعد المستخدمين على الوصول إلى المحتوى المناسب بسهولة.</p>

		<h2>قيمنا</h2>
		<ul>
			<li><strong>الجودة:</strong> تقديم محتوى تعليمي متميز ودقيق.</li>
			<li><strong>التعاون:</strong> تعزيز بيئة تعليمية تدعم الشراكة بين الطلاب والمعلمين.</li>
			<li><strong>الإبداع:</strong> استخدام أدوات وتقنيات حديثة لتحسين تجربة المستخدم.</li>
		</ul>

		<h2>التواصل معنا</h2>
		<p>
			إذا كانت لديك أسئلة أو اقتراحات، يسعدنا التواصل معك عبر
			<a href={`mailto:${contactEmail}`}>{contactEmail}</a> أو من خلال <a href="/contact-us">نموذج التواصل</a>.
		</p>
	</ProseContainer>
</Layout>
