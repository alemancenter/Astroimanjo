---
import Layout from '../layouts/Layout.astro';
import '../styles/static-pages.css';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ProseContainer from '../components/ui/ProseContainer.astro';
import { getSiteContactInfo } from '../lib/site-contact';

export const prerender = true;

const { contactEmail } = await getSiteContactInfo(Astro);
---

<Layout title="شروط الاستخدام" description="القواعد العامة لاستخدام موقع الإيمان التعليمي ومحتواه وخدماته.">
	<Breadcrumbs items={[{ label: 'شروط الاستخدام' }]} />
	<ProseContainer title="شروط الاستخدام" description="القواعد العامة لاستخدام الموقع والمحتوى التعليمي والخدمات المتاحة للمستخدمين." lastUpdated="30 مايو 2026" eyebrow="الشروط والأحكام">
		<h2>1. مقدمة</h2>
		<p>مرحبًا بكم في <strong>موقع الإيمان التعليمي</strong>. تحكم هذه الشروط استخدامكم للموقع والخدمات والمحتوى المتاح من خلاله. باستخدام الموقع فإنك تقر بأنك قرأت هذه الشروط وفهمتها ووافقت عليها، وإذا لم توافق عليها فيرجى عدم استخدام الخدمة.</p>

		<h2>2. التعريفات</h2>
		<ul>
			<li><strong>الموقع:</strong> موقع الإيمان التعليمي وخدماته المتاحة عبر الإنترنت.</li>
			<li><strong>المستخدم:</strong> كل شخص يزور الموقع أو ينشئ حسابًا أو يستخدم إحدى خدماته.</li>
			<li><strong>المحتوى:</strong> النصوص والصور والمقالات والملفات والمرفقات والمواد التعليمية المنشورة.</li>
		</ul>

		<h2>3. الأدوار والصلاحيات</h2>
		<p>يقسم الموقع صلاحيات المستخدمين إلى ثلاث فئات:</p>
		<ul>
			<li><strong>المدير:</strong> يدير الموقع والمستخدمين والمحتوى والإعدادات والصلاحيات العامة.</li>
			<li><strong>المشرف:</strong> يراجع المحتوى ويديره ضمن الصلاحيات التي تحددها الإدارة.</li>
			<li><strong>العضو:</strong> يستخدم المحتوى والخدمات المتاحة لحسابه ويلتزم بسياسات النشر والاستخدام.</li>
		</ul>

		<h2>4. استخدام الخدمة</h2>
		<p>باستخدامك للموقع، فإنك توافق على:</p>
		<ul>
			<li>عدم استخدام الموقع لأي غرض غير قانوني أو ينتهك القوانين الأردنية.</li>
			<li>عدم محاولة اختراق الموقع أو تعطيل عمله أو الوصول غير المصرح به إلى أنظمته.</li>
			<li>استخدام المحتوى المتاح للأغراض التعليمية الشخصية فقط وعدم إعادة توزيعه دون إذن مسبق.</li>
			<li>تقديم معلومات صحيحة عند إنشاء حساب والمحافظة على سرية بيانات الدخول.</li>
		</ul>

		<h2>5. الملكية الفكرية</h2>
		<p>جميع عناصر الموقع الأصلية، بما فيها التصميم والنصوص والشعارات والتنظيم البرمجي، محمية بموجب حقوق الملكية الفكرية. لا يجوز نسخها أو إعادة نشرها أو استخدامها تجاريًا دون إذن كتابي. وتبقى حقوق المواد المنسوبة إلى أصحابها محفوظة لهم وفق <a href="/copyright">سياسة حقوق النشر</a>.</p>

		<h2>6. سياسة المرفقات</h2>
		<p>يحتوي الموقع على مرفقات تعليمية تشمل:</p>
		<ul>
			<li>الخطة الدراسية.</li>
			<li>أوراق العمل وكورسات المواد.</li>
			<li>الاختبارات الشهرية والنهائية.</li>
			<li>الكتب الرسمية ودليل المعلم.</li>
		</ul>
		<p>يُسمح بتنزيل المرفقات للاستخدام الشخصي والتعليمي فقط، ويحظر توزيعها أو استخدامها لأغراض تجارية دون تصريح.</p>

		<h2>7. حدود المسؤولية</h2>
		<p>لا يتحمل الموقع المسؤولية عن:</p>
		<ul>
			<li>أي أضرار مباشرة أو غير مباشرة ناتجة عن استخدام المحتوى أو المرفقات.</li>
			<li>أي معلومات غير دقيقة أو غير محدثة على الموقع.</li>
			<li>أي انقطاع في الخدمة بسبب عوامل تقنية أو خارجية خارجة عن إرادتنا.</li>
		</ul>

		<h2>8. التعديلات</h2>
		<p>يجوز لنا تعديل هذه الشروط عند الحاجة. تصبح التعديلات نافذة عند نشرها على هذه الصفحة، ويُعد استمرار استخدام الموقع بعد النشر موافقة على الشروط المحدّثة.</p>

		<h2>9. القانون الحاكم</h2>
		<p>تُفسر هذه الشروط والأحكام وفقًا لقوانين المملكة الأردنية الهاشمية.</p>

		<h2>التواصل معنا</h2>
		<p>لأي استفسار حول هذه الشروط، تواصل معنا عبر <a href={`mailto:${contactEmail}`}>{contactEmail}</a> أو <a href="/contact-us">نموذج التواصل</a>.</p>
	</ProseContainer>
</Layout>
