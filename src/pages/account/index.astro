---
import Layout from '../../layouts/Layout.astro';
import '../../styles/auth-pages.css';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SocialIcon from '../../components/ui/SocialIcon.astro';
import { getCurrentUser, isAdmin, hasPermission } from '../../lib/auth';
import { DASHBOARD_NAV_ITEMS } from '../../lib/dashboard-nav';
import { assetUrl } from '../../lib/assets';
import { COUNTRIES } from '../../lib/countries';

const currentUser = await getCurrentUser(Astro);
if (!currentUser) {
	return Astro.redirect(`/login?redirect_to=${encodeURIComponent('/account')}`);
}

const grantedDashboardItems = DASHBOARD_NAV_ITEMS.filter((item) => {
	const granted = Array.isArray(item.permission)
		? item.permission.some((permission) => hasPermission(currentUser, permission))
		: Boolean(item.permission && hasPermission(currentUser, item.permission));
	return granted || Boolean(item.adminOnly && isAdmin(currentUser));
});
const canAccessDashboard = isAdmin(currentUser) || hasPermission(currentUser, 'access dashboard');
const canBroadcastNotifications = hasPermission(currentUser, 'manage notifications');

// The `country` field is free text on the backend — existing accounts may hold a full
// Arabic name ("الأردن"), a legacy numeric id ("1"), or already the short code ("jo").
// Normalize to the code so the <select> below can pre-select the right option; new saves
// always write the short code going forward.
function normalizeCountryCode(value?: string | null): string {
	const raw = (value || '').trim();
	if (!raw) return '';
	return COUNTRIES.find((c) => c.code === raw || c.id === raw || c.name === raw)?.code ?? raw;
}
const countryCode = normalizeCountryCode(currentUser.country);

const GENDER_OPTIONS = [
	{ value: 'male', label: 'ذكر' },
	{ value: 'female', label: 'أنثى' },
	{ value: 'other', label: 'غير ذلك' },
];
const genderLabel = GENDER_OPTIONS.find((g) => g.value === currentUser.gender)?.label || 'غير محدد';
const countryLabel = COUNTRIES.find((c) => c.code === countryCode)?.name || 'غير محدد';

const SOCIAL_FIELDS = [
	{ key: 'facebook', label: 'فيسبوك', placeholder: 'https://facebook.com/username' },
	{ key: 'twitter', label: 'X / تويتر', placeholder: 'https://x.com/username' },
	{ key: 'linkedin', label: 'لينكدإن', placeholder: 'https://linkedin.com/in/username' },
	{ key: 'instagram', label: 'إنستغرام', placeholder: 'https://instagram.com/username' },
	{ key: 'github', label: 'غيتهاب', placeholder: 'https://github.com/username' },
] as const;
const socialLinks = (currentUser.social_links || {}) as Record<string, string | undefined>;
const socialEntries = SOCIAL_FIELDS.map(({ key, label }) => ({ key, label, url: socialLinks[key]?.trim() || '' }));

// profile_photo_path alone is enough for assetUrl() to resolve correctly either way: for
// locally-uploaded photos it's a storage-relative path (assetUrl proxies it through the
// working /api/img endpoint); for OAuth avatars (Google/Facebook) it's already the full
// external URL, which assetUrl passes through unchanged. profile_photo_url, by contrast,
// is the *backend's own* prebuilt absolute URL for local uploads — built against the
// broken api.alemancenter.com/storage/ path — so it must not be preferred here.
const avatarSrc = assetUrl(currentUser.profile_photo_path, 180);
const isVerified = !!currentUser.email_verified_at;
const isOnline = (() => {
	if (!currentUser.last_activity) return false;
	const last = new Date(currentUser.last_activity).getTime();
	return !Number.isNaN(last) && Date.now() - last < 5 * 60 * 1000;
})();
const primaryRole = currentUser.roles?.[0]?.name || 'عضو';
const formatDate = (value?: string | null) => {
	if (!value) return '—';
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return '—';
	return new Intl.DateTimeFormat('ar-JO', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(date);
};

const completionChecks = [
	!!currentUser.name?.trim(),
	!!currentUser.phone?.trim(),
	!!currentUser.job_title?.trim(),
	!!countryCode,
	!!currentUser.gender,
	!!currentUser.bio?.trim(),
	!!avatarSrc,
	Object.values(socialLinks).some((v) => !!v?.trim()),
];
const completion = Math.round((completionChecks.filter(Boolean).length / completionChecks.length) * 100);

const params = Astro.url.searchParams;
const saved = params.get('saved') === '1';
const welcome = params.get('welcome') === '1';
const verificationSent = params.get('verification_sent') === '1';
const emailChanged = params.get('email_changed') === '1';
const resetSent = params.get('reset_sent') === '1';
const error = params.get('error');
---

<Layout title="حسابي" description="إدارة معلومات حسابك الشخصي." noindex>
	<Breadcrumbs items={[{ label: 'حسابي' }]} />

	<div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
		<section class="surface-card p-6 sm:p-8">
			<div class="grid gap-6 lg:grid-cols-[1fr_280px] lg:items-center">
				<div class="flex flex-col gap-5 sm:flex-row sm:items-center">
					<div class="relative w-fit flex-shrink-0">
						{avatarSrc ? (
							<img id="avatar-preview" src={avatarSrc} alt="" width="112" height="112" class="size-24 rounded-2xl border border-graphite-200 object-cover sm:size-28 dark:border-graphite-700" onerror="this.remove()" />
						) : (
							<span id="avatar-preview" class="flex size-24 items-center justify-center rounded-2xl bg-royal-600 text-3xl font-black text-white sm:size-28">{currentUser.name.trim().charAt(0) || 'ع'}</span>
						)}
						<button type="button" id="avatar-trigger" class="absolute -bottom-2 -left-2 flex size-10 items-center justify-center rounded-xl bg-royal-600 text-white shadow-md transition hover:bg-royal-500" aria-label="تغيير الصورة الشخصية">
							<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 0 1 2-2h.93a2 2 0 0 0 1.664-.89l.812-1.22A2 2 0 0 1 10.07 4h3.86a2 2 0 0 1 1.664.89l.812 1.22A2 2 0 0 0 18.07 7H19a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z" /><circle cx="12" cy="13" r="3.5" stroke-width="2" /></svg>
						</button>
						<span class:list={['absolute -right-1 -top-1 size-4 rounded-full border-2 border-white dark:border-graphite-900', isOnline ? 'bg-emerald-brand-500' : 'bg-graphite-400']} />
						<input type="file" id="profile_photo" name="profile_photo" form="profile-form" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
					</div>

					<div class="min-w-0">
						<div class="flex flex-wrap items-center gap-2">
							<h1 class="text-2xl font-black tracking-tight text-graphite-950 sm:text-3xl dark:text-white">{currentUser.name || 'الملف الشخصي'}</h1>
							<span class:list={['badge inline-flex items-center gap-1', isVerified ? 'badge-success' : 'bg-graphite-100 text-graphite-600 dark:bg-graphite-800 dark:text-graphite-300']}>
								<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">{isVerified ? <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 12 2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /> : <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />}</svg>
								{isVerified ? 'بريد موثق' : 'غير موثق'}
							</span>
						</div>
						<p class="mt-2 max-w-2xl text-sm leading-7 text-graphite-500 dark:text-graphite-400">
							إدارة بيانات العضو، الصورة الشخصية، معلومات التواصل، الروابط العامة، وخيارات الأمان المتاحة لحسابك.
						</p>
						<div class="mt-4 flex flex-wrap gap-2">
							<span class="inline-flex items-center gap-2 rounded-lg border border-graphite-200 bg-white px-3 py-1.5 text-xs font-bold text-graphite-600 dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-300"><svg class="size-3.5 text-royal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>{currentUser.status === 'active' ? 'الحساب فعال' : currentUser.status}</span>
							<span class="inline-flex items-center gap-2 rounded-lg border border-graphite-200 bg-white px-3 py-1.5 text-xs font-bold text-graphite-600 dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-300"><svg class="size-3.5 text-royal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>{primaryRole}</span>
							<span class="inline-flex items-center gap-2 rounded-lg border border-graphite-200 bg-white px-3 py-1.5 text-xs font-bold text-graphite-600 dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-300"><svg class="size-3.5 text-royal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M5 11h14M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /></svg>{isOnline ? 'متصل الآن' : `آخر نشاط: ${formatDate(currentUser.last_activity)}`}</span>
						</div>
					</div>
				</div>

				<div class="rounded-2xl border border-graphite-200 bg-graphite-50/60 p-4 dark:border-graphite-700 dark:bg-graphite-800/40">
					<div class="flex items-center justify-between gap-4">
						<span class="text-sm font-bold text-graphite-500 dark:text-graphite-400">اكتمال الملف</span>
						<span class="text-2xl font-black text-royal-600 dark:text-royal-300">{completion}%</span>
					</div>
					<div class="mt-3 h-2 overflow-hidden rounded-full bg-graphite-200 dark:bg-graphite-700">
						<div class="h-full rounded-full bg-gradient-to-l from-royal-600 via-emerald-brand-600 to-sunset-400" style={`width:${completion}%`} />
					</div>
					<p class="mt-3 text-xs leading-6 text-graphite-500 dark:text-graphite-400">تكتمل النسبة عند إضافة البيانات الأساسية والصورة والروابط الاختيارية.</p>
				</div>
			</div>
		</section>

		<div class="mt-6 space-y-3">
			{welcome && <div class="alert-success" role="status">أهلاً بك في موقع الإيمان التعليمي! تفقّد بريدك الإلكتروني لتفعيل حسابك.</div>}
			{saved && <div class="alert-success" role="status">تم حفظ التغييرات بنجاح.</div>}
			{verificationSent && <div class="alert-success" role="status">تم إرسال رسالة التفعيل، يرجى مراجعة بريدك الإلكتروني.</div>}
			{emailChanged && <div class="alert-success" role="status">تم تحديث البريد الإلكتروني وإرسال رسالة تفعيل جديدة إليه.</div>}
			{resetSent && <div class="alert-success" role="status">إن كان بريدك مسجّلاً لدينا، ستصلك رسالة لإعادة تعيين كلمة المرور خلال دقائق.</div>}
			{error && <div class="alert-error" role="alert">{error}</div>}
			{!isVerified && (
				<div class="alert-warning flex-col justify-between sm:flex-row sm:items-center">
					<span>بريدك الإلكتروني غير مفعّل بعد. بعض العمليات تتطلب تفعيل البريد أولاً.</span>
					<span class="text-sm font-bold underline">راجع تبويب "الأمان" أدناه</span>
				</div>
			)}
		</div>

		<div class="mt-6 grid gap-6 xl:grid-cols-[340px_minmax(0,1fr)]">
			<aside class="space-y-6">
				<div class="surface-card p-5">
					<h2 class="mb-4 text-base font-extrabold text-graphite-950 dark:text-white">ملخص الحساب</h2>
					<div class="space-y-3">
						<div class="flex items-start gap-3 rounded-xl border border-graphite-100 bg-graphite-50/60 p-3 dark:border-graphite-800 dark:bg-graphite-800/40">
							<span class="flex size-9 flex-none items-center justify-center rounded-lg bg-royal-50 text-royal-600 dark:bg-royal-950 dark:text-royal-300"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z" /></svg></span>
							<div class="min-w-0"><p class="text-xs font-bold text-graphite-400">البريد الإلكتروني</p><p class="mt-1 break-words text-sm font-bold text-graphite-800 dark:text-graphite-100" dir="ltr">{currentUser.email}</p></div>
						</div>
						<div class="flex items-start gap-3 rounded-xl border border-graphite-100 bg-graphite-50/60 p-3 dark:border-graphite-800 dark:bg-graphite-800/40">
							<span class="flex size-9 flex-none items-center justify-center rounded-lg bg-royal-50 text-royal-600 dark:bg-royal-950 dark:text-royal-300"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .95.68l1.5 4.49a1 1 0 0 1-.5 1.21l-2.26 1.13a11 11 0 0 0 5.52 5.52l1.13-2.26a1 1 0 0 1 1.21-.5l4.49 1.5a1 1 0 0 1 .68.95V19a2 2 0 0 1-2 2h-1C9.72 21 3 14.28 3 6V5Z" /></svg></span>
							<div class="min-w-0"><p class="text-xs font-bold text-graphite-400">الهاتف</p><p class="mt-1 text-sm font-bold text-graphite-800 dark:text-graphite-100" dir="ltr">{currentUser.phone || '—'}</p></div>
						</div>
						<div class="flex items-start gap-3 rounded-xl border border-graphite-100 bg-graphite-50/60 p-3 dark:border-graphite-800 dark:bg-graphite-800/40">
							<span class="flex size-9 flex-none items-center justify-center rounded-lg bg-royal-50 text-royal-600 dark:bg-royal-950 dark:text-royal-300"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87" /></svg></span>
							<div class="min-w-0"><p class="text-xs font-bold text-graphite-400">المسمى</p><p class="mt-1 text-sm font-bold text-graphite-800 dark:text-graphite-100">{currentUser.job_title || '—'}</p></div>
						</div>
						<div class="flex items-start gap-3 rounded-xl border border-graphite-100 bg-graphite-50/60 p-3 dark:border-graphite-800 dark:bg-graphite-800/40">
							<span class="flex size-9 flex-none items-center justify-center rounded-lg bg-royal-50 text-royal-600 dark:bg-royal-950 dark:text-royal-300"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2" /><path stroke-linecap="round" stroke-width="2" d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3C9.5 5.7 9.5 18.3 12 21" /></svg></span>
							<div class="min-w-0"><p class="text-xs font-bold text-graphite-400">الدولة</p><p class="mt-1 text-sm font-bold text-graphite-800 dark:text-graphite-100">{countryLabel}</p></div>
						</div>
						<div class="flex items-start gap-3 rounded-xl border border-graphite-100 bg-graphite-50/60 p-3 dark:border-graphite-800 dark:bg-graphite-800/40">
							<span class="flex size-9 flex-none items-center justify-center rounded-lg bg-royal-50 text-royal-600 dark:bg-royal-950 dark:text-royal-300"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2" /><path stroke-linecap="round" stroke-width="2" d="M3 10h18" /></svg></span>
							<div class="min-w-0"><p class="text-xs font-bold text-graphite-400">الجنس</p><p class="mt-1 text-sm font-bold text-graphite-800 dark:text-graphite-100">{genderLabel}</p></div>
						</div>
						<hr class="border-graphite-100 dark:border-graphite-800" />
						<div class="flex items-start gap-3 rounded-xl border border-graphite-100 bg-graphite-50/60 p-3 dark:border-graphite-800 dark:bg-graphite-800/40">
							<span class="flex size-9 flex-none items-center justify-center rounded-lg bg-royal-50 text-royal-600 dark:bg-royal-950 dark:text-royal-300"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M5 11h14M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /></svg></span>
							<div class="min-w-0"><p class="text-xs font-bold text-graphite-400">تاريخ الانضمام</p><p class="mt-1 text-sm font-bold text-graphite-800 dark:text-graphite-100">{formatDate(currentUser.created_at)}</p></div>
						</div>
					</div>
				</div>

				<div class="surface-card p-5">
					<h2 class="mb-4 text-base font-extrabold text-graphite-950 dark:text-white">الروابط العامة</h2>
					<div class="flex flex-wrap gap-2">
						{socialEntries.map(({ key, label, url }) => (
							url ? (
								<a href={url} target="_blank" rel="noreferrer noopener" aria-label={label} title={label} class="flex size-10 items-center justify-center rounded-xl border border-graphite-200 bg-white text-graphite-500 transition hover:border-royal-300 hover:text-royal-600 dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-400 dark:hover:text-royal-300">
									<SocialIcon name={key} />
								</a>
							) : (
								<span aria-label={`${label} غير مضاف`} title={`${label} غير مضاف`} class="flex size-10 items-center justify-center rounded-xl border border-dashed border-graphite-200 text-graphite-300 dark:border-graphite-700 dark:text-graphite-600">
									<SocialIcon name={key} />
								</span>
							)
						))}
					</div>
				</div>
			</aside>

			<div class="surface-card p-4 sm:p-6">
				<div class="flex flex-wrap gap-1 rounded-xl bg-graphite-50 p-1 dark:bg-graphite-800/60" role="tablist">
					<button type="button" data-tab-trigger="personal" data-active="true" class="tab-trigger"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>البيانات</button>
					<button type="button" data-tab-trigger="social" class="tab-trigger"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-width="2" /><path stroke-linecap="round" stroke-width="2" d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3C9.5 5.7 9.5 18.3 12 21" /></svg>الروابط</button>
					<button type="button" data-tab-trigger="security" class="tab-trigger"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3 4.5 6v6c0 4.5 3.2 7.7 7.5 9 4.3-1.3 7.5-4.5 7.5-9V6L12 3Z" /></svg>الأمان</button>
				</div>

				<form method="post" action="/api/account/profile" enctype="multipart/form-data" id="profile-form">
					<div data-tab-panel="personal" class="mt-6 space-y-6">
						<div class="grid gap-5 md:grid-cols-2">
							<div><label for="name" class="form-label">الاسم الكامل</label><input id="name" type="text" name="name" value={currentUser.name} required class="form-control" /></div>
							<div><label class="form-label">البريد الإلكتروني</label><input type="email" value={currentUser.email} disabled dir="ltr" class="form-control cursor-not-allowed bg-graphite-50 text-graphite-400 dark:bg-graphite-800 dark:text-graphite-500" /></div>
							<div><label for="phone" class="form-label">رقم الهاتف</label><input id="phone" type="tel" name="phone" value={currentUser.phone || ''} dir="ltr" placeholder="+962..." class="form-control" /></div>
							<div><label for="job_title" class="form-label">المسمى الوظيفي <span class="font-normal text-graphite-400">(اختياري)</span></label><input id="job_title" type="text" name="job_title" value={currentUser.job_title || ''} placeholder="مثال: معلم، طالب، ولي أمر" class="form-control" /></div>
							<div>
								<label for="country" class="form-label">الدولة</label>
								<select id="country" name="country" class="form-control">
									<option value="" selected={!countryCode}>غير محدد</option>
									{COUNTRIES.map((c) => <option value={c.code} selected={c.code === countryCode}>{c.flag} {c.name}</option>)}
								</select>
							</div>
							<div>
								<label for="gender" class="form-label">الجنس</label>
								<select id="gender" name="gender" class="form-control">
									<option value="" selected={!currentUser.gender}>غير محدد</option>
									{GENDER_OPTIONS.map((g) => <option value={g.value} selected={g.value === currentUser.gender}>{g.label}</option>)}
								</select>
							</div>
						</div>
						<div><label for="bio" class="form-label">نبذة تعريفية <span class="font-normal text-graphite-400">(اختياري)</span></label><textarea id="bio" name="bio" rows="4" class="form-control" placeholder="اكتب نبذة مختصرة تظهر مع حسابك عند الحاجة.">{currentUser.bio || ''}</textarea></div>
					</div>

					<div data-tab-panel="social" class="mt-6 hidden space-y-5">
						{SOCIAL_FIELDS.map(({ key, label, placeholder }) => (
							<div>
								<label for={`social_${key}`} class="form-label">{label}</label>
								<div class="relative">
									<span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-graphite-400"><SocialIcon name={key} /></span>
									<input id={`social_${key}`} type="url" name={`social_links[${key}]`} value={(socialLinks as Record<string, string | undefined>)[key] || ''} placeholder={placeholder} dir="ltr" autocomplete="off" class="form-control pr-10" />
								</div>
							</div>
						))}
					</div>

					<div class="mt-8 flex flex-col-reverse gap-3 border-t border-graphite-100 pt-5 sm:flex-row sm:items-center sm:justify-between dark:border-graphite-800">
						<a href="/account" class="btn-ghost">إعادة تحميل البيانات</a>
						<button type="submit" class="btn-primary" data-tab-submit="personal,social">حفظ التغييرات</button>
					</div>
				</form>

				<div data-tab-panel="security" class="mt-6 hidden space-y-6">
					<div class="grid gap-4 md:grid-cols-3">
						<div class:list={['rounded-xl border p-4', isVerified ? 'border-emerald-brand-500/25 bg-emerald-brand-500/10 text-emerald-brand-700 dark:text-emerald-brand-300' : 'border-amber-500/25 bg-amber-500/10 text-amber-700 dark:text-amber-300']}>
							<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z" /></svg>
							<p class="mt-3 text-xs font-bold opacity-80">البريد</p><p class="mt-1 text-lg font-black">{isVerified ? 'موثق' : 'غير موثق'}</p>
						</div>
						<div class:list={['rounded-xl border p-4', isOnline ? 'border-emerald-brand-500/25 bg-emerald-brand-500/10 text-emerald-brand-700 dark:text-emerald-brand-300' : 'border-graphite-200 bg-graphite-50 text-graphite-500 dark:border-graphite-700 dark:bg-graphite-800/40 dark:text-graphite-400']}>
							<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M5 11h14M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /></svg>
							<p class="mt-3 text-xs font-bold opacity-80">الاتصال</p><p class="mt-1 text-lg font-black">{isOnline ? 'متصل الآن' : 'غير متصل'}</p>
						</div>
						<div class:list={['rounded-xl border p-4', currentUser.status === 'active' ? 'border-emerald-brand-500/25 bg-emerald-brand-500/10 text-emerald-brand-700 dark:text-emerald-brand-300' : 'border-red-500/25 bg-red-500/10 text-red-700 dark:text-red-300']}>
							<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3 4.5 6v6c0 4.5 3.2 7.7 7.5 9 4.3-1.3 7.5-4.5 7.5-9V6L12 3Z" /></svg>
							<p class="mt-3 text-xs font-bold opacity-80">الحالة</p><p class="mt-1 text-lg font-black">{currentUser.status === 'active' ? 'فعال' : currentUser.status}</p>
						</div>
					</div>

					{!isVerified && (
						<div class="rounded-xl border border-graphite-200 bg-graphite-50/60 p-4 dark:border-graphite-700 dark:bg-graphite-800/40">
							{/* One form only — this used to be two parallel forms (a mobile one holding the
							   real input, a desktop-only one with its own hardcoded hidden field carrying the
							   *original* email) so on desktop the visible button belonged to the form that
							   never saw the user's edit, silently submitting the stale address. */}
							<div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
								<form method="post" action="/api/account/change-email">
									<label for="new_email" class="form-label">تعديل البريد قبل التفعيل</label>
									<div class="mt-2 flex flex-wrap gap-2">
										<input id="new_email" type="email" name="email" value={currentUser.email} dir="ltr" required class="form-control min-w-0 flex-1" />
										<button type="submit" class="btn-outline shrink-0">تحديث البريد</button>
									</div>
								</form>
								<form method="post" action="/api/auth/resend-verification"><button type="submit" class="btn-secondary w-full md:w-auto">إعادة الإرسال</button></form>
							</div>
						</div>
					)}

					<div class="rounded-xl border border-graphite-200 bg-graphite-50/60 p-4 dark:border-graphite-700 dark:bg-graphite-800/40">
						<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
							<div><h3 class="font-bold text-graphite-950 dark:text-white">كلمة المرور</h3><p class="mt-1 text-sm leading-6 text-graphite-500 dark:text-graphite-400">سيتم إرسال رابط آمن لإعادة التعيين إلى بريدك الإلكتروني المسجل.</p></div>
							<form method="post" action="/api/account/forgot-password"><button type="submit" class="btn-outline whitespace-nowrap">إرسال رابط إعادة التعيين</button></form>
						</div>
					</div>

					<div class="rounded-xl border border-red-300/60 bg-red-50 p-4 dark:border-red-900 dark:bg-red-950/30">
						<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
							<div class="min-w-0">
								<h3 class="flex items-center gap-2 font-bold text-red-700 dark:text-red-300"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M4.93 19h14.14c1.4 0 2.27-1.53 1.58-2.75L13.6 4.5a1.8 1.8 0 0 0-3.2 0L3.35 16.25C2.66 17.47 3.53 19 4.93 19Z" /></svg>حذف الحساب نهائيًا</h3>
								<p class="mt-1 text-sm leading-6 text-red-600/90 dark:text-red-300/80">هذا الإجراء يتطلب كلمة المرور الحالية ولا يمكن التراجع عنه بعد التنفيذ.</p>
							</div>
							<button type="button" id="open-delete-dialog" class="btn-danger flex-shrink-0 whitespace-nowrap"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 7-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16" /></svg>حذف الحساب</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="mt-6 grid gap-4 sm:grid-cols-2">
			<a href="/account/messages" class="interactive-card flex items-center justify-between gap-4 p-6">
				<div><h3 class="mb-1 font-extrabold text-graphite-950 dark:text-white">الرسائل</h3><p class="text-sm leading-6 text-graphite-500 dark:text-graphite-400">صندوق رسائلك الداخلية والرسائل المرسلة والمسودات.</p></div>
				<svg class="size-5 flex-shrink-0 text-royal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" /></svg>
			</a>
			<a href="/account/notifications" class="interactive-card flex items-center justify-between gap-4 p-6">
				<div><h3 class="mb-1 font-extrabold text-graphite-950 dark:text-white">الإشعارات</h3><p class="text-sm leading-6 text-graphite-500 dark:text-graphite-400">{canBroadcastNotifications ? 'إشعاراتك، وإرسال إشعارات جماعية.' : 'إشعاراتك الشخصية.'}</p></div>
				<svg class="size-5 flex-shrink-0 text-royal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" /></svg>
			</a>
		</div>

		{canAccessDashboard && (
			<div class="surface-card mt-6 p-6 sm:p-8">
				<div class="mb-5 flex items-center justify-between gap-4">
					<div><h2 class="text-lg font-extrabold text-graphite-950 dark:text-white">صلاحياتك الإدارية</h2><p class="mt-1 text-sm text-graphite-500 dark:text-graphite-400">حسابك يملك وصولاً إلى لوحة التحكم — هذه الأقسام المتاحة لك تحديدًا.</p></div>
					<a href="/dashboard" class="btn-primary flex-shrink-0 whitespace-nowrap px-5">فتح لوحة التحكم</a>
				</div>
				{grantedDashboardItems.length > 0 && (
					<ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
						{grantedDashboardItems.map((item) => (
							<li><a href={item.href} class="flex items-center gap-2 rounded-xl border border-graphite-200 px-4 py-2.5 text-sm font-bold text-graphite-700 transition hover:border-royal-300 hover:bg-royal-50 dark:border-graphite-700 dark:text-graphite-200 dark:hover:border-royal-500 dark:hover:bg-graphite-800"><span class="text-royal-500">•</span>{item.label}</a></li>
						))}
					</ul>
				)}
			</div>
		)}

		<a href="/account/teacher" class="interactive-card mt-6 flex items-center justify-between gap-4 p-6">
			<div><h3 class="mb-1 font-extrabold text-graphite-950 dark:text-white">منطقة المعلم</h3><p class="text-sm leading-6 text-graphite-500 dark:text-graphite-400">إدارة اشتراكك كمعلم والوصول لأدواتك الحصرية.</p></div>
			<svg class="size-5 flex-shrink-0 text-royal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" /></svg>
		</a>
	</div>

	<dialog id="delete-dialog" class="delete-dialog">
		<form method="post" action="/api/account/delete" class="p-6 sm:p-7">
			<h3 class="text-lg font-extrabold text-graphite-950 dark:text-white">تأكيد حذف الحساب</h3>
			<p class="mt-2 text-sm leading-6 text-graphite-500 dark:text-graphite-400">أدخل كلمة المرور الحالية لتأكيد حذف الحساب نهائيًا. لا يمكن التراجع عن هذا الإجراء.</p>
			<div class="mt-4"><label for="delete_password" class="form-label">كلمة المرور الحالية</label><input id="delete_password" type="password" name="password" required autocomplete="current-password" class="form-control" /></div>
			<div class="mt-6 flex justify-end gap-2">
				<button type="button" id="cancel-delete" class="btn-ghost">إلغاء</button>
				<button type="submit" class="btn-danger">حذف نهائي</button>
			</div>
		</form>
	</dialog>
</Layout>

<script>
	const triggers = document.querySelectorAll<HTMLButtonElement>('[data-tab-trigger]');
	const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
	triggers.forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const target = trigger.dataset.tabTrigger;
			triggers.forEach((t) => t.setAttribute('data-active', String(t === trigger)));
			panels.forEach((p) => p.classList.toggle('hidden', p.dataset.tabPanel !== target));
		});
	});

	const avatarTrigger = document.getElementById('avatar-trigger');
	const fileInput = document.getElementById('profile_photo') as HTMLInputElement | null;
	const avatarPreview = document.getElementById('avatar-preview');
	avatarTrigger?.addEventListener('click', () => fileInput?.click());
	fileInput?.addEventListener('change', () => {
		const file = fileInput.files?.[0];
		if (!file || !avatarPreview) return;
		const url = URL.createObjectURL(file);
		if (avatarPreview instanceof HTMLImageElement) {
			avatarPreview.src = url;
		} else {
			const img = document.createElement('img');
			img.id = 'avatar-preview';
			img.src = url;
			img.className = avatarPreview.className.replace(/flex|items-center|justify-center|bg-royal-600|text-3xl|font-black|text-white/g, '').trim() + ' object-cover';
			avatarPreview.replaceWith(img);
		}
	});

	const deleteDialog = document.getElementById('delete-dialog') as HTMLDialogElement | null;
	document.getElementById('open-delete-dialog')?.addEventListener('click', () => deleteDialog?.showModal());
	document.getElementById('cancel-delete')?.addEventListener('click', () => deleteDialog?.close());
	deleteDialog?.addEventListener('click', (event) => {
		if (event.target === deleteDialog) deleteDialog.close();
	});
</script>

<style>
	@reference "../../styles/global.css";

	.tab-trigger {
		@apply inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-bold text-graphite-500 transition hover:text-graphite-800 dark:text-graphite-400 dark:hover:text-white;
	}
	.tab-trigger[data-active='true'] {
		@apply bg-white text-royal-700 shadow-sm dark:bg-graphite-900 dark:text-royal-200;
	}
	.delete-dialog {
		@apply w-full max-w-md rounded-2xl border border-graphite-200 bg-white p-0 shadow-lifted dark:border-graphite-700 dark:bg-graphite-900;
	}
	.delete-dialog::backdrop {
		@apply bg-graphite-950/60 backdrop-blur-sm;
	}
</style>
