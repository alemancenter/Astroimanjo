---
import Layout from '../layouts/Layout.astro';
import '../styles/static-pages.css';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ProseContainer from '../components/ui/ProseContainer.astro';
import { getSiteContactInfo } from '../lib/site-contact';

export const prerender = true;

const { contactEmail } = await getSiteContactInfo(Astro);
---

<Layout title="إخلاء المسؤولية" description="نطاق المحتوى التعليمي وحدود المسؤولية وسياسة التعامل مع الملكية الفكرية.">
	<Breadcrumbs items={[{ label: 'إخلاء المسؤولية' }]} />
	<ProseContainer title="إخلاء المسؤولية" description="معلومات مهمة حول طبيعة المحتوى التعليمي، دقته، استخدامه، وطلبات إزالة المواد." lastUpdated="16 مايو 2026" eyebrow="تنبيه قانوني">
		<h2>1. الغرض من الموقع</h2>
		<p><strong>موقع الإيمان التعليمي</strong> منصة تهدف إلى تقديم محتوى تعليمي محدث ومصمم لدعم العملية التعليمية وفقًا للمنهاج الأردني. جميع المعلومات والمحتويات المقدمة على الموقع للأغراض التعليمية والإرشادية فقط.</p>

		<h2>2. دقة المعلومات</h2>
		<p>نسعى لضمان دقة وصحة جميع المعلومات المقدمة. ومع ذلك، لا نضمن أن تكون جميع المواد والمحتويات خالية تمامًا من الأخطاء أو محدثة بشكل كامل. يتحمل المستخدم مسؤولية التحقق من المعلومات قبل الاعتماد عليها.</p>

		<h2>3. حدود المسؤولية</h2>
		<p>الموقع غير مسؤول عن:</p>
		<ul>
			<li>أي أضرار مباشرة أو غير مباشرة قد تنجم عن استخدامك للموقع أو الاعتماد على محتوياته.</li>
			<li>أي خسائر أو أضرار تتعلق بتنزيل المرفقات أو المستندات التعليمية من الموقع.</li>
			<li>أي انقطاع في الخدمة بسبب مشكلات تقنية أو خارجية.</li>
		</ul>

		<h2>4. الروابط الخارجية</h2>
		<p>قد يحتوي الموقع على روابط لمواقع إلكترونية خارجية لتسهيل الوصول إلى مصادر إضافية. نحن غير مسؤولين عن محتوى أو سياسات الخصوصية الخاصة بهذه المواقع.</p>

		<h2>5. الاستخدام الشخصي وغير التجاري</h2>
		<p>جميع المحتويات والمواد التعليمية المقدمة على الموقع مصممة للاستخدام الشخصي وغير التجاري. يُحظر نسخ أو إعادة توزيع أي محتوى دون إذن كتابي مسبق.</p>

		<h2>6. حقوق الملكية الفكرية والمحتوى المنشور</h2>
		<p>يحترم الموقع حقوق الملكية الفكرية ويلتزم بالقوانين المعمول بها، وتنطبق السياسة التالية:</p>
		<ul>
			<li>المواد الصادرة رسميًا عن وزارة التربية والتعليم الأردنية تُعامل كمحتوى عام متاح للاستخدام التعليمي.</li>
			<li>المحتوى المقدم من معلمين أو مستخدمين يخضع لمراجعة وفق سياسة النشر الداخلية للموقع.</li>
			<li>أي محتوى محمي بحقوق ملكية يُبلغ عنه يُراجع ويُزال خلال المدة القانونية المحددة عند ثبوت الطلب.</li>
		</ul>

		<h2>7. إجراءات إشعار DMCA وإزالة المحتوى</h2>
		<p>إذا كنت تعتقد أن أحد المحتويات المنشورة ينتهك حقوق ملكيتك الفكرية، يرجى إرسال إشعار رسمي يتضمن:</p>
		<ul>
			<li>اسمك الكامل وبيانات التواصل، بما فيها البريد الإلكتروني ورقم الهاتف.</li>
			<li>وصفًا واضحًا للعمل المحمي بحقوق الملكية الذي تدّعي انتهاكه.</li>
			<li>الرابط المحدد (URL) للمحتوى الذي تطلب إزالته.</li>
			<li>بيانًا بأنك تؤمن بحسن نية بأن الاستخدام المعترض عليه غير مرخص من صاحب الحق أو وكيله أو القانون.</li>
			<li>بيانًا بأن المعلومات الواردة في إشعارك دقيقة وأنك صاحب الحق أو مفوض بالتصرف نيابة عنه.</li>
		</ul>
		<blockquote>
			<strong>خطوات تقديم الإشعار:</strong> أرسل التفاصيل إلى بريدنا الإلكتروني. سنرسل تأكيد الاستلام خلال 48 ساعة، ويُراجع الإشعار خلال 10 أيام عمل، وفي حال صحته يُزال المحتوى فور التحقق وتُبلغ الجهة المعنية.
		</blockquote>
		<p>أرسل إشعار DMCA إلى <a href={`mailto:${contactEmail}`}>{contactEmail}</a> أو عبر <a href="/contact-us">نموذج التواصل</a>.</p>

		<h2>8. سياسة التحقق من ملكية الملفات قبل النشر</h2>
		<p>يلتزم الموقع قبل نشر أي ملف أو مادة تعليمية بمراجعة المصدر والتحقق من أحد المعايير التالية:</p>
		<ul>
			<li>صدور المادة رسميًا عن جهة حكومية أو مؤسسة تعليمية معتمدة.</li>
			<li>حصول الناشر على إذن صريح من صاحب الحق بالنشر على المنصة.</li>
			<li>خضوع المادة لترخيص مفتوح، مثل Creative Commons، يجيز إعادة النشر للأغراض التعليمية.</li>
			<li>إنتاج المادة بالكامل من قبل فريق الموقع أو ناشريه المعتمدين.</li>
		</ul>
		<p>المحتوى المخالف لهذه المعايير يُزال فور اكتشافه أو الإبلاغ عنه، ويحتفظ الموقع بحق تعليق حساب أي ناشر يخالف هذه السياسة.</p>

		<h2>9. تحديث إخلاء المسؤولية</h2>
		<p>قد يتم تحديث هذه الصفحة من وقت إلى آخر لتعكس تغييرات في السياسات أو اللوائح. يُنصح المستخدمون بمراجعتها بانتظام للتأكد من فهمهم لأحدث نسخة.</p>

		<h2>التواصل معنا</h2>
		<p>لأي استفسار أو إبلاغ عن انتهاك لحقوق الملكية، استخدم <a href="/contact-us">نموذج التواصل</a>.</p>
	</ProseContainer>
</Layout>
