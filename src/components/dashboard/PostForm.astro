---
import 'quill/dist/quill.snow.css';
import { COUNTRIES, getCountryById } from '../../lib/countries';
import { assetUrl } from '../../lib/assets';
import ImanSeoPanel from './ImanSeoPanel.astro';

interface Props {
	post?: any;
	categories: any[];
	countryId: string;
	seo?: any;
}

const { post, categories, countryId, seo } = Astro.props;
const currentCountry = getCountryById(countryId);
const imageUrl = assetUrl(post?.image_url || post?.image, 480) || '';
const keywordsValue = typeof post?.keywords === 'string'
	? post.keywords
	: Array.isArray(post?.keywords_rel)
		? post.keywords_rel.map((keyword: any) => keyword.keyword).filter(Boolean).join('، ')
		: '';
---

<div class="post-form-page">
	<header class="post-form-header">
		<div class="post-form-heading">
			<a href="/dashboard/posts" class="post-back-button" aria-label="العودة إلى المنشورات">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m15 18-6-6 6-6" /></svg>
			</a>
			<div>
				<span class="post-eyebrow">إدارة المحتوى</span>
				<h1>{post?.id ? 'تعديل المنشور' : 'إضافة منشور جديد'}</h1>
				<p>أنشئ منشورًا منظمًا مع تصنيفه وصورته وبيانات ظهوره في محركات البحث.</p>
			</div>
		</div>
		<div class="post-country-control">
			<span class="post-country-flag" aria-hidden="true">{currentCountry.flag}</span>
			<div><small>قاعدة البيانات</small><strong>{currentCountry.name}</strong></div>
			<select id="post-country-select" data-current={countryId} aria-label="تبديل قاعدة البيانات">
				{COUNTRIES.map((country) => <option value={country.id} selected={country.id === countryId}>{country.name}</option>)}
			</select>
		</div>
	</header>

	<form id="post-editor-form" method="post" action="/api/dashboard/posts/save" enctype="multipart/form-data" class="post-editor-grid">
		{post?.id && <input type="hidden" name="id" value={post.id} />}

		<main class="post-main-column">
			<section class="post-card post-content-card">
				<div class="post-card-heading">
					<div><span class="post-step">01</span><h2>محتوى المنشور</h2><p>العنوان والنص الأساسي الذي سيظهر للزائر.</p></div>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm7 0v5h4M9 13h6m-6 4h4" /></svg>
				</div>

				<div class="post-field">
					<div class="post-label-row"><label for="title">العنوان</label><span id="post-title-count">0 / 500</span></div>
					<input id="title" type="text" name="title" maxlength="500" required value={post?.title ?? ''} placeholder="مثال: إعلان مهم بخصوص موعد الامتحان" />
				</div>

				<div class="post-field post-editor-field">
					<div class="post-label-row">
						<label for="post-editor-container">المحتوى</label>
						<button type="button" id="post-ai-generate-btn" class="post-ai-button"><svg id="post-ai-generate-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m12 3 1.1 4.1L17 8.3l-3.9 1.1L12 13.5l-1.1-4.1L7 8.3l3.9-1.2L12 3Zm6 11 .6 2.2 2.2.6-2.2.6L18 20l-.6-2.6-2.2-.6 2.2-.6L18 14Z" /></svg><span id="post-ai-generate-label">توليد مسودة بالذكاء الاصطناعي</span></button>
					</div>
					<p id="post-ai-generate-error" class="post-field-error" hidden></p>
					<p id="post-ai-generate-warning" class="post-field-hint is-warning" hidden></p>
					<div id="post-editor-toolbar">
						<span class="ql-formats"><button type="button" class="ql-bold"></button><button type="button" class="ql-italic"></button><button type="button" class="ql-underline"></button><button type="button" class="ql-strike"></button></span>
						<span class="ql-formats"><select class="ql-header"><option value="2"></option><option value="3"></option><option value=""></option></select></span>
						<span class="ql-formats"><button type="button" class="ql-list" value="ordered"></button><button type="button" class="ql-list" value="bullet"></button><button type="button" class="ql-blockquote"></button></span>
						<span class="ql-formats"><select class="ql-align"></select><button type="button" class="ql-direction" value="rtl"></button></span>
						<span class="ql-formats"><select class="ql-color"></select><button type="button" class="ql-link"></button><button type="button" class="ql-clean"></button></span>
						<span class="ql-formats"><button type="button" class="ql-undo" title="تراجع"><svg viewBox="0 0 18 18"><polyline class="ql-stroke" points="4 8 4 4 8 4" /><path class="ql-stroke" d="M4.5,7.5A6,6,0,1,1,3.6,10.5" /></svg></button><button type="button" class="ql-redo" title="إعادة"><svg viewBox="0 0 18 18"><polyline class="ql-stroke" points="14 8 14 4 10 4" /><path class="ql-stroke" d="M13.5,7.5A6,6,0,1,0,14.4,10.5" /></svg></button></span>
					</div>
					<div id="post-editor-container"></div>
					<textarea id="content" name="content" hidden>{post?.content ?? ''}</textarea>
					<div class="post-editor-footer"><span id="post-content-error" class="post-field-error" hidden>يرجى كتابة محتوى المنشور قبل الحفظ.</span><span id="post-word-count">0 كلمة</span></div>
				</div>
			</section>

			<section class="post-card post-seo-card">
				<div class="post-card-heading">
					<div><span class="post-step">02</span><h2>تحسين محركات البحث</h2><p>بيانات مختصرة تساعد المنشور على الظهور بصورة أفضل.</p></div>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 18V9m5 9V5m5 13v-6m5 6V3M3 21h18" /></svg>
				</div>
				<ImanSeoPanel seo={seo} contentType="post" contentId={post?.id} legacyDescription={post?.meta_description ?? ''} legacyKeywords={keywordsValue} imageAlt={post?.alt ?? ''} includeImageAlt />
			</section>
		</main>

		<aside class="post-sidebar">
			<section class="post-side-card">
				<div class="post-side-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 6h7l2 2h9v11H3V6Z" /></svg></span><div><h2>التصنيف</h2><p>القسم الذي سيظهر فيه المنشور</p></div></div>
				<div class="post-field">
					<label for="category_id">القسم</label>
					<select id="category_id" name="category_id" required>
						<option value="">— اختر القسم —</option>
						{categories.map((category: any) => <option value={category.id} selected={String(category.id) === String(post?.category_id ?? '')}>{category.name}</option>)}
					</select>
				</div>
			</section>

			<section class="post-side-card">
				<div class="post-side-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9" r="1.5" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="m4 17 5-5 4 4 2-2 5 4" /></svg></span><div><h2>الصورة الرئيسية</h2><p>واجهة المنشور عند عرضه</p></div></div>
				<label class="post-image-drop" for="post-image-input">
					<img id="post-image-preview" src={imageUrl || undefined} alt="" hidden={!imageUrl} />
					<span id="post-image-placeholder" hidden={Boolean(imageUrl)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" /></svg><strong>اختر صورة</strong><small>PNG أو JPG أو WEBP</small></span>
					<input id="post-image-input" type="file" name="image" accept="image/*" />
				</label>
			</section>

			<section class="post-side-card">
				<div class="post-side-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z" /></svg></span><div><h2>الإعدادات</h2><p>حالة الظهور والتمييز</p></div></div>
				<div class="post-field">
					<label for="is_active">الحالة</label>
					<select id="is_active" name="is_active"><option value="true" selected={!post || post?.is_active === true}>منشور</option><option value="false" selected={post?.is_active === false}>مسودة</option></select>
				</div>
				<label class="post-featured-option"><input type="checkbox" name="is_featured" checked={post?.is_featured === true} /><span><strong>منشور مميز</strong><small>إبرازه في الواجهة الرئيسية</small></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m12 3 2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.9-5.4 2.9 1-6-4.3-4.2 6-.9L12 3Z" /></svg></label>
			</section>

			<section class="post-side-card">
				<div class="post-side-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m8.5 12.5 5-5a3 3 0 1 1 4.2 4.2l-7.1 7.1a5 5 0 0 1-7.1-7.1l7.8-7.8" /></svg></span><div><h2>المرفقات</h2><p>ملفات إضافية للمنشور</p></div></div>
				<label class="post-files-drop" for="post-attachments"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" /></svg><strong>اختر الملفات</strong><small id="post-files-label">يمكن اختيار أكثر من ملف</small><input id="post-attachments" type="file" name="attachments" multiple /></label>
			</section>

			<button id="post-submit-button" type="submit" class="post-submit-button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4h12l2 2v14H5V4Zm3 0v6h8V4M8 20v-6h8v6" /></svg><span>{post?.id ? 'حفظ التعديلات' : 'حفظ المنشور'}</span></button>
	</aside>
	</form>
</div>

<script>
	// package.json pins quill to exactly 2.0.2 (no caret) — 2.0.3+ carries an unpatched XSS
	// advisory (CVE-2025-15056) in Quill's HTML-export path. Don't loosen the version range
	// until a patched release exists.
	import Quill from 'quill';

	const editorContainer = document.getElementById('post-editor-container');
	const editorToolbar = document.getElementById('post-editor-toolbar');
	const contentInput = document.getElementById('content') as HTMLTextAreaElement | null;
	const postForm = document.getElementById('post-editor-form') as HTMLFormElement | null;
	const contentError = document.getElementById('post-content-error');
	const wordCount = document.getElementById('post-word-count');

	if (editorContainer && contentInput) {
		const quill = new Quill(editorContainer, {
			theme: 'snow',
			modules: {
				toolbar: {
					container: editorToolbar,
					handlers: {
						undo(this: { quill: InstanceType<typeof Quill> }) { this.quill.history.undo(); },
						redo(this: { quill: InstanceType<typeof Quill> }) { this.quill.history.redo(); },
					},
				},
			},
			placeholder: 'اكتب محتوى المنشور هنا...'
		});
		if (contentInput.value) quill.clipboard.dangerouslyPasteHTML(contentInput.value);
		quill.root.setAttribute('dir', 'rtl');
		quill.root.style.textAlign = 'right';

		// AI writing assist — a single direct generation call scoped to the title + category
		// already selected, checked against the whole site for duplicate content on the
		// backend before being returned. Only fills the editor; saving stays fully manual.
		const postAiButton = document.getElementById('post-ai-generate-btn') as HTMLButtonElement | null;
		const postAiIcon = document.getElementById('post-ai-generate-icon');
		const postAiLabel = document.getElementById('post-ai-generate-label');
		const postAiError = document.getElementById('post-ai-generate-error');
		const postAiWarning = document.getElementById('post-ai-generate-warning');
		const postTitleInput = document.getElementById('title') as HTMLInputElement | null;
		const postCategorySelect = document.getElementById('category_id') as HTMLSelectElement | null;
		const postAttachmentsInput = document.getElementById('post-attachments') as HTMLInputElement | null;

		const setPostAiBusy = (busy: boolean) => {
			if (postAiButton) postAiButton.disabled = busy;
			postAiIcon?.classList.toggle('animate-spin', busy);
			if (postAiLabel) postAiLabel.textContent = busy ? 'جارِ التوليد...' : 'توليد مسودة بالذكاء الاصطناعي';
		};

		// Fills the ImanSeoPanel fields (src/components/dashboard/ImanSeoPanel.astro) with the
		// AI-suggested SEO metadata that the backend already scored/retried against the same
		// AnalyzeSEO the panel's own "تحليل الآن" button uses, then triggers that same button so
		// the score shown updates immediately instead of the admin having to click it manually.
		const applyAIGeneratedSEO = (seo: Record<string, string>) => {
			const seoRoot = document.querySelector<HTMLElement>('[data-iman-seo]');
			if (!seoRoot) return;
			const setValue = (selector: string, value: string | undefined, dispatchInput = false) => {
				const el = seoRoot.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(selector);
				if (el && value) {
					el.value = value;
					if (dispatchInput) el.dispatchEvent(new Event('input', { bubbles: true }));
				}
			};
			setValue('#meta_description', seo.meta_description, true);
			setValue('[name="seo_title"]', seo.seo_title, true);
			setValue('[name="seo_focus_keyword"]', seo.focus_keyword);
			setValue('[name="seo_additional_keywords"]', seo.additional_keywords);
			setValue('[name="seo_og_title"]', seo.og_title);
			setValue('[name="seo_og_description"]', seo.og_description);
			setValue('[name="seo_twitter_title"]', seo.twitter_title);
			setValue('[name="seo_twitter_description"]', seo.twitter_description);
			const schemaSelect = seoRoot.querySelector<HTMLSelectElement>('[name="seo_schema_type"]');
			if (schemaSelect && seo.schema_type) schemaSelect.value = seo.schema_type;
			seoRoot.querySelector<HTMLButtonElement>('[data-seo-analyze]')?.click();
		};

		postAiButton?.addEventListener('click', async () => {
			if (postAiError) postAiError.hidden = true;
			if (postAiWarning) postAiWarning.hidden = true;
			const title = postTitleInput?.value.trim() ?? '';
			const categoryName = postCategorySelect?.selectedOptions[0]?.textContent?.trim() ?? '';
			const attachmentName = postAttachmentsInput?.files?.[0]?.name ?? '';

			if (title.length < 5) {
				if (postAiError) { postAiError.textContent = 'يرجى إدخال عنوان مكوّن من 5 أحرف على الأقل قبل التوليد.'; postAiError.hidden = false; }
				return;
			}

			setPostAiBusy(true);
			try {
				const res = await fetch('/api/dashboard/content-gen/draft', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						content_type: 'post',
						title,
						category_name: categoryName,
						attachment_name: attachmentName,
					}),
				});
				const json = await res.json();
				if (!res.ok || !json?.success) throw new Error(json?.message || 'تعذّر توليد المحتوى');
				const html = json.data?.content_html || '';
				if (html) quill.clipboard.dangerouslyPasteHTML(html);
				if (json.data?.seo) applyAIGeneratedSEO(json.data.seo);
				const warnings = [json.data?.warning, json.data?.seo_warning].filter(Boolean);
				if (warnings.length && postAiWarning) {
					postAiWarning.textContent = warnings.join(' ');
					postAiWarning.hidden = false;
				}
			} catch (err) {
				if (postAiError) {
					postAiError.textContent = err instanceof Error ? err.message : 'تعذّر توليد المحتوى';
					postAiError.hidden = false;
				}
			} finally {
				setPostAiBusy(false);
			}
		});

		const updateWordCount = () => {
			const words = quill.getText().trim().split(/\s+/).filter(Boolean).length;
			if (wordCount) wordCount.textContent = `${words} كلمة`;
		};
		quill.on('text-change', updateWordCount);
		updateWordCount();

		postForm?.addEventListener('submit', (event) => {
			contentInput.value = quill.root.innerHTML;
			const empty = quill.getText().trim().length === 0;
			if (contentError) contentError.hidden = !empty;
			if (empty) {
				event.preventDefault();
				return;
			}
			const submitButton = document.getElementById('post-submit-button') as HTMLButtonElement | null;
			if (submitButton) {
				submitButton.disabled = true;
				const label = submitButton.querySelector('span');
				if (label) label.textContent = 'جارِ الحفظ...';
			}
		});
	}

	const titleInput = document.getElementById('title') as HTMLInputElement | null;
	const titleCount = document.getElementById('post-title-count');
	const metaInput = document.getElementById('meta_description') as HTMLTextAreaElement | null;
	const metaCount = document.getElementById('post-meta-count');
	const updateCounter = (input: HTMLInputElement | HTMLTextAreaElement | null, target: HTMLElement | null, preferredMax: number) => {
		if (input && target) target.textContent = `${input.value.length} / ${preferredMax}`;
	};
	titleInput?.addEventListener('input', () => updateCounter(titleInput, titleCount, 500));
	metaInput?.addEventListener('input', () => updateCounter(metaInput, metaCount, 160));
	updateCounter(titleInput, titleCount, 500);
	updateCounter(metaInput, metaCount, 160);

	const imageInput = document.getElementById('post-image-input') as HTMLInputElement | null;
	const imagePreview = document.getElementById('post-image-preview') as HTMLImageElement | null;
	const imagePlaceholder = document.getElementById('post-image-placeholder');
	let previewUrl = '';
	imageInput?.addEventListener('change', () => {
		const file = imageInput.files?.[0];
		if (!file || !imagePreview) return;
		if (previewUrl) URL.revokeObjectURL(previewUrl);
		previewUrl = URL.createObjectURL(file);
		imagePreview.src = previewUrl;
		imagePreview.hidden = false;
		if (imagePlaceholder) imagePlaceholder.hidden = true;
	});

	const attachmentsInput = document.getElementById('post-attachments') as HTMLInputElement | null;
	const attachmentsLabel = document.getElementById('post-files-label');
	attachmentsInput?.addEventListener('change', () => {
		const files = Array.from(attachmentsInput.files ?? []);
		if (attachmentsLabel) attachmentsLabel.textContent = files.length ? `${files.length} ملف محدد` : 'يمكن اختيار أكثر من ملف';
	});

	const countrySelect = document.getElementById('post-country-select') as HTMLSelectElement | null;
	countrySelect?.addEventListener('change', () => {
		if (countrySelect.value === countrySelect.dataset.current) return;
		const url = new URL(window.location.href);
		url.searchParams.set('country', countrySelect.value);
		window.location.href = url.toString();
	});
</script>

<style>
	.post-form-page{--post-ink:#102a43;--post-muted:#718096;--post-line:#dfe6ee;max-width:1280px;margin-inline:auto;padding-bottom:2rem;color:var(--post-ink)}
	.post-form-header{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;margin-bottom:1.1rem;border:1px solid var(--post-line);border-radius:.8rem;background:#fff;padding:1rem 1.15rem;box-shadow:0 1px 2px rgb(15 23 42 / .05)}
	.post-form-heading{display:flex;min-width:0;align-items:center;gap:.8rem}.post-back-button{display:grid;width:2.35rem;height:2.35rem;flex:none;place-items:center;border:1px solid #d9e2ec;border-radius:.55rem;color:#35516d}.post-back-button:hover{border-color:#9bb7dc;background:#f6f9fd;color:#1a4d8f}.post-back-button svg{width:1rem;height:1rem}.post-eyebrow{display:block;margin-bottom:.1rem;color:#1a4d8f;font-size:.65rem;font-weight:850}.post-form-heading h1{margin:0;color:#061a3a;font-size:clamp(1.2rem,1rem + .6vw,1.65rem);font-weight:900;line-height:1.35}.post-form-heading p{margin:.2rem 0 0;color:var(--post-muted);font-size:.7rem}
	.post-country-control{display:flex;align-items:center;gap:.55rem;flex:none}.post-country-flag{font-size:1.5rem}.post-country-control div{display:grid}.post-country-control small{color:var(--post-muted);font-size:.58rem}.post-country-control strong{font-size:.72rem}.post-country-control select{min-height:2.25rem;border:1px solid #d9e2ec;border-radius:.5rem;background:#fff;padding:.35rem .55rem;color:var(--post-ink);font-size:.7rem}
