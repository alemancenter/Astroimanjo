---
import 'quill/dist/quill.snow.css';
import { SUBJECT_FILE_CATEGORIES, getSubjectFileCategory } from '../../lib/subject-categories';
import { COUNTRIES, getCountryById } from '../../lib/countries';

interface Props {
	article?: any;
	classes: any[];
	countryId: string;
}
const { article, classes, countryId } = Astro.props;
const currentCountry = getCountryById(countryId);
// Subject/semester options are fetched on demand client-side (see the script below) via
// /filter/subjects/{classId} and /filter/semesters/{subjectId} — already-working, already
// publicly-deployed backend endpoints — instead of relying on the dashboard's own
// GetDashboardCreateData/GetDashboardEditData, which (as currently deployed to production)
// unconditionally returns empty subjects/semesters arrays. When editing, the article's own
// preloaded Subject/Semester relations seed the initial selection so nothing needs a fetch
// before the page is even interactive.

const inputClass =
	'form-control';
const labelClass = 'form-label';

const keywordsValue = Array.isArray(article?.keywords_rel)
	? article.keywords_rel.map((k: any) => k.keyword).filter(Boolean).join('، ')
	: '';

const files: any[] = Array.isArray(article?.files) ? article.files : [];

function formatSize(bytes: number): string {
	if (!bytes) return '—';
	const kb = bytes / 1024;
	if (kb < 1024) return `${kb.toFixed(0)} KB`;
	return `${(kb / 1024).toFixed(1)} MB`;
}
---

<div class="article-form-page">
<div class="article-form-countrybar surface-card mb-6 flex flex-wrap items-center justify-between gap-4 border-r-4 border-royal-500 p-5 sm:p-6">
	<div class="article-form-page-heading">
		<a href="/dashboard/articles" class="article-form-page-heading-icon" aria-label="العودة إلى المقالات"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m15 18-6-6 6-6" /></svg></a>
		<div><h2>{article?.id ? 'تعديل المقالة' : 'إضافة مقالة جديدة'}</h2><p>أنشئ محتوى تعليميًا منظمًا وحدد بياناته وتصنيفاته بسهولة.</p></div>
	</div>
	<div class="flex items-center gap-3">
		<span class="text-3xl" aria-hidden="true">{currentCountry.flag}</span>
		<div>
			<p class="text-xs font-bold text-graphite-500 dark:text-graphite-400">قاعدة البيانات الحالية</p>
			<p class="text-lg font-extrabold text-graphite-950 dark:text-white">{currentCountry.name}</p>
		</div>
	</div>
	<div class="flex items-center gap-2">
		<label for="country-database-select" class="form-label text-xs">تبديل قاعدة البيانات</label>
		<select
			id="country-database-select"
			class="form-control w-auto"
			data-current={currentCountry.id}
		>
			{COUNTRIES.map((c) => <option value={c.id} selected={c.id === countryId}>{c.flag} {c.name}</option>)}
		</select>
	</div>
	{article?.id && (
		<p class="w-full text-xs font-bold text-sunset-700 dark:text-sunset-300">
			⚠ تبديل قاعدة البيانات هنا سينقلك لإنشاء مقال جديد — هذا المقال محفوظ في قاعدة {currentCountry.name} ولا يمكن نقله بين الدول.
		</p>
	)}
</div>

<form id="article-form" method="post" action="/api/dashboard/articles/save" class="article-editor-form">
	{article?.id && <input type="hidden" name="id" value={article.id} />}
	<p id="save-error" class="hidden article-save-error"></p>

	<div class="article-main-column">
		<section class="article-content-card">
			<div class="article-card-title">
				<div><h2>محتوى المقالة</h2><p>أدخل العنوان واكتب المحتوى التعليمي بصورة واضحة ومنظمة.</p></div>
				<span>01</span>
			</div>

			<div class="article-title-section">
				<label for="title" class={labelClass}>العنوان</label>
				<input id="title" type="text" name="title" required value={article?.title ?? ''} class={inputClass} placeholder="مثال: حل أسئلة درس القواعد" />
			</div>

			<div class="article-content-section">
				<div class="article-content-label">
					<label for="quill-editor-container" class={labelClass}>المحتوى</label>
					<button type="button" id="ai-generate-btn" class="article-ai-button">
						<svg id="ai-generate-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m12 3 1.1 4.1L17 8.3l-3.9 1.1L12 13.5l-1.1-4.1L7 8.3l3.9-1.2L12 3Zm6 11 .6 2.2 2.2.6-2.2.6L18 20l-.6-2.6-2.2-.6 2.2-.6L18 14Z" /></svg>
						<span id="ai-generate-label">توليد بالذكاء الاصطناعي</span>
					</button>
				</div>
				<p id="ai-generate-error" class="form-hint hidden text-red-600 dark:text-red-400"></p>
				<div id="quill-toolbar">
					<span class="ql-formats"><button type="button" class="ql-bold"></button><button type="button" class="ql-italic"></button><button type="button" class="ql-underline"></button><button type="button" class="ql-strike"></button></span>
					<span class="ql-formats"><select class="ql-header"><option value="1"></option><option value="2"></option><option value="3"></option><option value=""></option></select><select class="ql-size"><option value="12px">صغير</option><option value="" selected>عادي</option><option value="20px">كبير</option><option value="28px">كبير جدًا</option></select></span>
					<span class="ql-formats"><button type="button" class="ql-list" value="ordered"></button><button type="button" class="ql-list" value="bullet"></button><button type="button" class="ql-blockquote"></button></span>
					<span class="ql-formats"><select class="ql-align"></select><button type="button" class="ql-direction" value="rtl"></button></span>
					<span class="ql-formats"><select class="ql-color"></select><select class="ql-background"></select></span>
					<span class="ql-formats"><button type="button" class="ql-link"></button><button type="button" class="ql-image"></button><button type="button" class="ql-video"></button><button type="button" class="ql-clean"></button></span>
					<span class="ql-formats"><button type="button" class="ql-undo" title="تراجع"><svg viewBox="0 0 18 18"><polyline class="ql-stroke" points="4 8 4 4 8 4" /><path class="ql-stroke" d="M4.5,7.5A6,6,0,1,1,3.6,10.5" /></svg></button><button type="button" class="ql-redo" title="إعادة"><svg viewBox="0 0 18 18"><polyline class="ql-stroke" points="14 8 14 4 10 4" /><path class="ql-stroke" d="M13.5,7.5A6,6,0,1,0,14.4,10.5" /></svg></button></span>
				</div>
				<div id="quill-editor-container"></div>
				<textarea id="content" name="content" class="hidden">{article?.content ?? ''}</textarea>
				<p id="content-error" class="hidden text-xs font-bold text-red-600 dark:text-red-400">يرجى كتابة محتوى المقال قبل الحفظ.</p>
			</div>
		</section>

		<section class="article-seo-card">
			<div class="article-card-title">
				<div><h2>تحسين محركات البحث</h2><p>بيانات مختصرة تساعد المقال في الظهور والوصول إلى جمهوره.</p></div>
				<span>02</span>
			</div>
			<div class="article-seo-section">
				<label for="meta_description" class={labelClass}>الوصف</label>
				<textarea id="meta_description" name="meta_description" rows="3" class={inputClass} placeholder="وصف قصير يظهر في نتائج البحث...">{article?.meta_description ?? ''}</textarea>
				<p class="form-hint">يفضل أن يكون الوصف بين 120 و160 حرفًا.</p>
			</div>
			<div class="article-keywords-section">
				<label for="keywords" class={labelClass}>الكلمات المفتاحية</label>
				<input id="keywords" type="text" name="keywords" value={keywordsValue} class={inputClass} placeholder="تعليم، قواعد، لغة عربية" />
				<p class="form-hint">افصل بين الكلمات باستخدام الفاصلة العربية.</p>
			</div>
		</section>
	</div>

	<aside class="article-sidebar">
		<section class="article-side-card article-taxonomy-section">
			<div class="article-side-section-heading"><span class="article-side-section-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M7 3v6m10-6v6M5 11h14v8H5z" /></svg></span><div><strong>التصنيف التعليمي</strong><small>قاعدة البيانات والمرحلة الدراسية</small></div></div>
			<div><label for="class_id" class={labelClass}>الصف الدراسي</label><select id="class_id" name="grade_level" required class={inputClass}><option value="">— اختر الصف —</option>{classes.map((cls: any) => <option value={cls.id} selected={cls.id === (article?.subject?.grade_level ?? article?.grade_level)}>{cls.grade_name}</option>)}</select></div>
			<div><label for="subject_id" class={labelClass}>المادة</label><select id="subject_id" name="subject_id" required class={inputClass}>{article?.subject ? <option value={article.subject_id} data-grade-level={article.subject.grade_level} selected>{article.subject.subject_name}</option> : <option value="">— اختر الصف أولًا —</option>}</select></div>
			<div><label for="semester_id" class={labelClass}>الفصل الدراسي</label><select id="semester_id" name="semester_id" required class={inputClass}>{article?.semester ? <option value={article.semester_id} selected>{article.semester.semester_name}</option> : <option value="">— اختر المادة أولًا —</option>}</select></div>
		</section>

		<section class="article-side-card article-ai-source-section">
			<div class="article-side-section-heading"><span class="article-side-section-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" /></svg></span><div><strong>ملف مصدر التوليد</strong><small>يُشترط توفر ملف قبل التوليد بالذكاء الاصطناعي</small></div></div>
			{files.length > 0 && (
				<div><label for="ai-source-existing-select" class={labelClass}>من الملفات المرفقة بالمقالة</label>
				<select id="ai-source-existing-select" class={inputClass}>
					{files.map((f: any, i: number) => <option value={f.id} selected={i === 0}>{f.file_name}</option>)}
					<option value="">— رفع ملف جديد بدلًا من ذلك —</option>
				</select></div>
			)}
			<label class="article-file-drop" for="ai-source-file-input" id="ai-source-upload-label" hidden={files.length > 0}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" /></svg><span>اختر ملف المصدر (DOCX أو PDF)</span><small>سيُقرأ محتواه لتوليد مقالة موثّقة منه</small><input id="ai-source-file-input" type="file" accept=".docx,.pdf" /></label>
			<p id="ai-source-status" class="form-hint">{files.length > 0 ? `سيُستخدم "${files[0].file_name}" مصدرًا للتوليد.` : 'لم يُرفع أي ملف بعد.'}</p>
			<input type="hidden" id="ai-source-file-id" name="ai_source_file_id" value={files.length > 0 ? files[0].id : ''} />
		</section>

		{!article?.id && (
			<section class="article-side-card article-create-attachments">
				<div class="article-side-section-heading"><span class="article-side-section-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m8.5 12.5 5-5a3 3 0 1 1 4.2 4.2l-7.1 7.1a5 5 0 0 1-7.1-7.1l7.8-7.8" /></svg></span><div><strong>المرفقات</strong><small>الملفات التابعة للمقال</small></div></div>
				<div><label for="staged-file-category" class={labelClass}>تصنيف الملفات</label><select id="staged-file-category" class={inputClass}><option value="">بدون تصنيف</option>{SUBJECT_FILE_CATEGORIES.map((c) => <option value={c.key}>{c.label}</option>)}</select></div>
				<label class="article-file-drop" for="staged-file-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" /></svg><span>اختر الملفات أو اسحبها هنا</span><small>PDF, DOCX, PPTX, ZIP</small><input id="staged-file-input" type="file" multiple /></label>
				<ul id="staged-file-list" class="space-y-2"></ul>
			</section>
		)}

		<section class="article-side-card article-status-section">
			<div class="article-side-section-heading"><span class="article-side-section-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M12 5v14" /></svg></span><div><strong>الإعدادات</strong><small>حالة ظهور المقالة</small></div></div>
			<span class={labelClass}>الحالة</span>
			<div class="article-status-options"><label><input type="radio" name="status" value="1" checked={article?.status === 1 || !article} /><span>منشور</span></label><label><input type="radio" name="status" value="0" checked={article?.status === 0} /><span>مسودة</span></label></div>
			<button type="submit" id="article-submit-btn" class="article-submit-section"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 12 20 4l-5 16-4-6-7-2Z" /></svg><span id="article-submit-label">حفظ المقالة</span></button>
		</section>
	</aside>
</form>

{article?.id && (
	<div class="article-attachments-card surface-card mt-6 space-y-5 p-5 sm:p-8">
		<div class="border-b border-graphite-200 pb-6 dark:border-graphite-700">
			<span class="page-eyebrow">الملفات الدراسية</span>
			<h3 class="text-lg font-extrabold text-graphite-950 dark:text-white">الملفات المرفقة بالمقال</h3>
			<p class="mt-2 text-sm text-graphite-500 dark:text-graphite-400">الملفات القابلة للتنزيل المرتبطة بهذا المقال.</p>
		</div>
		{files.length > 0 ? (
			<ul class="space-y-2">
				{files.map((f: any) => (
					<li class="flex items-center justify-between gap-3 rounded-xl border border-graphite-200 p-3 dark:border-graphite-700">
						<div class="min-w-0"><p class="truncate text-sm font-bold text-graphite-950 dark:text-white">{f.file_name}</p><p class="text-xs text-graphite-500 dark:text-graphite-400">{getSubjectFileCategory(f.file_category)?.label || f.file_category || 'بدون تصنيف'} · {formatSize(f.file_size)}</p></div>
						<form method="post" action={`/api/dashboard/files/${f.id}/delete`} onsubmit="return confirm('حذف هذا الملف نهائيًا؟')"><input type="hidden" name="redirect_to" value={`/dashboard/articles/${article.id}/edit`} /><button type="submit" class="shrink-0 text-sm font-bold text-red-600 hover:underline dark:text-red-400">حذف</button></form>
					</li>
				))}
			</ul>
		) : <p class="text-sm text-graphite-400">لا توجد ملفات مرفقة بعد.</p>}
		<form method="post" action={`/api/dashboard/articles/${article.id}/files`} enctype="multipart/form-data" class="flex flex-wrap items-end gap-3 rounded-xl border border-dashed border-graphite-300 p-4 dark:border-graphite-600">
			<input type="hidden" name="redirect_to" value={`/dashboard/articles/${article.id}/edit`} />
			<div class="min-w-[200px] flex-1"><label for="new-file" class="form-label text-xs">ملف جديد</label><input id="new-file" type="file" name="file" required class="form-control text-sm" /></div>
			<div><label for="file_category" class="form-label text-xs">التصنيف</label><select id="file_category" name="file_category" class="form-control text-sm"><option value="">بدون تصنيف</option>{SUBJECT_FILE_CATEGORIES.map((c) => <option value={c.key}>{c.label}</option>)}</select></div>
			<button type="submit" class="btn-outline">رفع الملف</button>
		</form>
	</div>
)}
</div>

<style>
	.article-form-page {
		--af-ink: #102a43;
		--af-muted: #6b7c93;
		--af-line: #dfe6ee;
		--af-soft: #f7f9fc;
		--af-blue: #2159d6;
		max-width: 1360px;
		margin-inline: auto;
		padding-bottom: 2rem;
	}

	.article-form-countrybar {
		min-height: 4.5rem;
		margin-bottom: 1rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		padding: 0;
		box-shadow: none;
	}

	.article-form-page-heading {
		display: flex;
		order: 1;
		align-items: center;
		gap: 0.75rem;
	}

	.article-form-page-heading-icon {
		display: inline-grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border: 1px solid #d7e0ea;
		border-radius: 0.55rem;
		background: #fff;
		color: #42526a;
		transition: border-color 150ms ease, color 150ms ease;
	}

	.article-form-page-heading-icon:hover {
		border-color: #9eb9df;
		color: var(--af-blue);
	}

	.article-form-page-heading-icon svg {
		width: 1rem;
		height: 1rem;
	}

	.article-form-page-heading h2 {
		margin: 0;
		color: #061a3a;
		font-size: clamp(1.35rem, 1.1rem + 0.65vw, 1.85rem);
		font-weight: 900;
		line-height: 1.25;
	}

	.article-form-page-heading p {
		margin: 0.25rem 0 0;
		color: var(--af-muted);
		font-size: 0.74rem;
		font-weight: 600;
	}

	.article-form-countrybar > .flex.items-center.gap-3 {
		display: none;
	}

	.article-form-countrybar > .flex.items-center.gap-2 {
		order: 2;
		margin-inline-start: auto;
	}

	.article-form-countrybar > .flex.items-center.gap-2 .form-label {
		display: none;
	}

	.article-form-countrybar > .flex.items-center.gap-2 select {
		width: 9rem;
		min-height: 2.3rem;
		border: 1px solid #d7e0ea;
		border-radius: 0.55rem;
		background-color: #fff;
		padding-block: 0.35rem;
		font-size: 0.75rem;
		font-weight: 700;
		box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
	}

	.article-form-warning,
	.article-save-error {
		margin-bottom: 1rem;
		border: 1px solid #fecaca;
		border-radius: 0.65rem;
		background: #fef2f2;
		padding: 0.75rem 0.9rem;
		color: #b91c1c;
		font-size: 0.75rem;
		font-weight: 700;
	}

	.article-editor-form {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 16rem;
		gap: 1.1rem;
		align-items: start;
	}

	.article-main-column,
	.article-sidebar {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 1.1rem;
	}

	.article-sidebar {
		position: sticky;
		top: 5.15rem;
	}

	.article-content-card,
	.article-seo-card,
	.article-side-card,
	.article-attachments-card {
		border: 1px solid var(--af-line);
		border-radius: 0.85rem;
		background: #fff;
		box-shadow: 0 1px 2px rgb(15 23 42 / 0.07);
	}

	.article-content-card,
	.article-seo-card {
		overflow: hidden;
	}

	.article-card-title {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid #edf1f5;
		padding: 1rem 1.15rem 0.9rem;
	}

	.article-card-title h2 {
		margin: 0;
		color: var(--af-ink);
		font-size: 0.9rem;
		font-weight: 850;
	}

	.article-card-title p {
		margin: 0.2rem 0 0;
		color: var(--af-muted);
		font-size: 0.68rem;
		line-height: 1.6;
	}

	.article-card-title > span {
		display: inline-grid;
		width: 1.75rem;
		height: 1.75rem;
		place-items: center;
		border-radius: 999px;
		background: #f1f5f9;
		color: #718096;
		font-size: 0.62rem;
		font-weight: 850;
	}

	.article-title-section {
		padding: 1rem 1.15rem 0;
	}

	.article-content-section {
		padding: 0.9rem 1.15rem 1.1rem;
	}

	.article-content-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.45rem;
	}

	.article-content-label .form-label {
		margin: 0;
	}

	.article-form-page .form-label {
		margin-bottom: 0.38rem;
		color: var(--af-ink);
		font-size: 0.7rem;
		font-weight: 750;
	}

	.article-form-page .form-control {
		min-height: 2.55rem;
		border: 1px solid #d9e2ec;
		border-radius: 0.55rem;
		background: #fff;
		padding: 0.55rem 0.7rem;
		color: var(--af-ink);
		font-size: 0.76rem;
		box-shadow: 0 1px 2px rgb(15 23 42 / 0.035);
	}

	.article-form-page .form-control:focus {
		border-color: #7ca7df;
		outline: none;
		box-shadow: 0 0 0 3px rgb(33 89 214 / 0.08);
	}

	.article-title-section .form-control {
		width: 100%;
		font-size: 0.8rem;
	}

	.article-ai-button {
		display: inline-flex;
		min-height: 1.9rem;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid #d3deed;
		border-radius: 0.5rem;
		background: #fff;
		padding: 0.3rem 0.55rem;
