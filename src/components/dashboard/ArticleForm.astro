</style>

<script>
	// package.json pins quill to exactly 2.0.2 (no caret) — 2.0.3+ carries an unpatched XSS
	// advisory (CVE-2025-15056) in Quill's HTML-export path. Don't loosen the version range
	// until a patched release exists.
	import Quill from 'quill';
	import QuillResizeImage from 'quill-resize-image';
	import { assetUrl } from '../../lib/assets';

	// Drag-to-resize handles on inserted images. Writes plain width/height HTML attributes
	// (not inline style) on the <img> — verified against the module's own source — which
	// bluemonday's stock UGCPolicy() already allows via AllowImages() (img width/height
	// matching a NumberOrPercent pattern), so unlike the align/direction/size attributors
	// below, this survives the backend sanitizer with no server-side change needed.
	Quill.register('modules/resize', QuillResizeImage);

	// Quill's DEFAULT align/direction/size/font attributors render as CSS classes
	// (ql-align-*, ql-direction-rtl, ql-size-*, ql-font-*) instead of inline styles — the
	// backend sanitizer (bluemonday) has no class allowlist, so those get silently stripped
	// on save, and even if they survived, the public article page never loads Quill's own
	// stylesheet to interpret them. Verified this the hard way (a live save round-tripped
	// and lost the formatting). Swap align/direction/size to their style-based variants,
	// which Quill ships natively for exactly this reason — inline `style="..."` survives
	// sanitization (see validator.go's AllowStyles) and needs no theme CSS to render
	// correctly on the public site. Font-family has no clean style-based equivalent that
	// would actually change anything (the public site loads exactly one webfont), so it's
	// left out rather than shipping a picker that does nothing.
	const AlignStyle = Quill.import('attributors/style/align') as any;
	const DirectionStyle = Quill.import('attributors/style/direction') as any;
	const SizeStyle = Quill.import('attributors/style/size') as any;
	SizeStyle.whitelist = ['12px', '20px', '28px'];
	Quill.register(AlignStyle, true);
	Quill.register(DirectionStyle, true);
	Quill.register(SizeStyle, true);

	const container = document.getElementById('quill-editor-container');
	const toolbar = document.getElementById('quill-toolbar');
	const hiddenTextarea = document.getElementById('content') as HTMLTextAreaElement | null;
	const errorHint = document.getElementById('content-error');

	async function uploadEditorImage(quill: InstanceType<typeof Quill>) {
		const input = document.createElement('input');
		input.type = 'file';
		input.accept = 'image/*';
		input.onchange = async () => {
			const file = input.files?.[0];
			if (!file) return;
			const range = quill.getSelection(true);
			const placeholderIndex = range ? range.index : quill.getLength();
			quill.insertText(placeholderIndex, 'جارِ رفع الصورة...', 'italic', 'api');

			const formData = new FormData();
			formData.set('image', file);
			try {
				const res = await fetch('/api/dashboard/upload-image', { method: 'POST', body: formData });
				const json = await res.json();
				quill.deleteText(placeholderIndex, 'جارِ رفع الصورة...'.length);
				if (!res.ok || !json?.success) {
					throw new Error(json?.message || 'فشل رفع الصورة');
				}
				// Not the backend's raw `url` field — that points at storage paths that 404
				// unreliably (see lib/assets.ts). Route through the same image proxy every
				// other image reference in this project uses.
				const src = assetUrl(json.data?.path, 1200);
				if (src) quill.insertEmbed(placeholderIndex, 'image', src, 'user');
				quill.setSelection(placeholderIndex + 1, 0);
			} catch (err) {
				quill.deleteText(placeholderIndex, 'جارِ رفع الصورة...'.length);
				alert(err instanceof Error ? err.message : 'فشل رفع الصورة');
			}
		};
		input.click();
	}

	// Mirrors lib/countries.ts (COUNTRIES) — kept as a tiny literal here rather than importing
	// the full list, since this script only ever needs id → code for one outgoing request.
	const COUNTRY_ID_TO_CODE: Record<string, string> = { '1': 'jo', '2': 'sa', '3': 'eg', '4': 'ps' };

	// New-article file staging: only present on the create page (absent when editing, where
	// files upload immediately via their own form). Held here rather than re-read from the
	// <input> at submit time so files stay staged across multiple picks (each change replaces
	// the input's own FileList, so accumulating requires tracking it separately).
	const stagedFiles: File[] = [];
	const stagedFileInput = document.getElementById('staged-file-input') as HTMLInputElement | null;
	const stagedFileList = document.getElementById('staged-file-list');
	function renderStagedFiles() {
		if (!stagedFileList) return;
		stagedFileList.innerHTML = '';
		stagedFiles.forEach((file, index) => {
			const li = document.createElement('li');
			li.className = 'flex items-center justify-between gap-3 rounded-xl border border-graphite-200 p-3 text-sm dark:border-graphite-700';
			const name = document.createElement('span');
			name.className = 'truncate font-bold text-graphite-950 dark:text-white';
			name.textContent = file.name;
			const removeBtn = document.createElement('button');
			removeBtn.type = 'button';
			removeBtn.className = 'shrink-0 text-xs font-bold text-red-600 hover:underline dark:text-red-400';
			removeBtn.textContent = 'إزالة';
			removeBtn.addEventListener('click', () => {
				stagedFiles.splice(index, 1);
				renderStagedFiles();
			});
			li.append(name, removeBtn);
			stagedFileList.appendChild(li);
		});
	}
	stagedFileInput?.addEventListener('change', () => {
		for (const file of Array.from(stagedFileInput.files ?? [])) stagedFiles.push(file);
		stagedFileInput.value = '';
		renderStagedFiles();
	});

	// AI-source file. When the article already has attached files, picking one here just
	// reuses its existing id directly — no upload, no re-reading the same file the admin
	// already uploaded. Only picking "رفع ملف جديد" (or having no attachments yet) falls back
	// to the upload flow below, which uploads immediately (via the generic, article-less
	// /api/dashboard/files/upload endpoint) so the backend can read it before generation runs.
	// The resulting file id is associated with the article once it exists either way — see the
	// ai_source_file_id hidden input and articles/save.ts.
	const aiSourceInput = document.getElementById('ai-source-file-input') as HTMLInputElement | null;
	const aiSourceUploadLabel = document.getElementById('ai-source-upload-label');
	const aiSourceFileIdInput = document.getElementById('ai-source-file-id') as HTMLInputElement | null;
	const aiSourceStatus = document.getElementById('ai-source-status');
	const aiSourceExistingSelect = document.getElementById('ai-source-existing-select') as HTMLSelectElement | null;
	aiSourceExistingSelect?.addEventListener('change', () => {
		const option = aiSourceExistingSelect.selectedOptions[0];
		if (aiSourceExistingSelect.value) {
			if (aiSourceFileIdInput) aiSourceFileIdInput.value = aiSourceExistingSelect.value;
			if (aiSourceStatus) {
				aiSourceStatus.textContent = `سيُستخدم "${option?.textContent ?? ''}" مصدرًا للتوليد.`;
				aiSourceStatus.className = 'form-hint text-emerald-600 dark:text-emerald-400';
			}
			aiSourceUploadLabel?.setAttribute('hidden', '');
		} else {
			if (aiSourceFileIdInput) aiSourceFileIdInput.value = '';
			if (aiSourceStatus) {
				aiSourceStatus.textContent = 'لم يُرفع أي ملف بعد.';
				aiSourceStatus.className = 'form-hint';
			}
			aiSourceUploadLabel?.removeAttribute('hidden');
		}
	});
	aiSourceInput?.addEventListener('change', async () => {
		const file = aiSourceInput.files?.[0];
		if (!file) return;
		if (aiSourceStatus) {
			aiSourceStatus.textContent = `جارِ رفع ${file.name}...`;
			aiSourceStatus.className = 'form-hint';
		}
		if (aiSourceFileIdInput) aiSourceFileIdInput.value = '';
		try {
			const uploadData = new FormData();
			uploadData.set('file', file);
			const res = await fetch('/api/dashboard/files/upload', { method: 'POST', headers: { 'X-Requested-With': 'fetch' }, body: uploadData });
			const json = await res.json();
			if (!res.ok || !json?.success || !json?.id) throw new Error(json?.message || 'تعذّر رفع الملف');
			if (aiSourceFileIdInput) aiSourceFileIdInput.value = String(json.id);
			if (aiSourceStatus) {
				aiSourceStatus.textContent = `تم رفع ${json.file_name || file.name} بنجاح — يمكنك الآن التوليد.`;
				aiSourceStatus.className = 'form-hint text-emerald-600 dark:text-emerald-400';
			}
		} catch (err) {
			if (aiSourceStatus) {
				aiSourceStatus.textContent = err instanceof Error ? err.message : 'تعذّر رفع الملف';
				aiSourceStatus.className = 'form-hint text-red-600 dark:text-red-400';
			}
			aiSourceInput.value = '';
		}
	});

	if (container && hiddenTextarea) {
		const quill = new Quill(container, {
			theme: 'snow',
			modules: {
				toolbar: {
					container: toolbar,
					handlers: {
						image: function (this: { quill: InstanceType<typeof Quill> }) {
							uploadEditorImage(this.quill);
						},
						undo: function (this: { quill: InstanceType<typeof Quill> }) {
							this.quill.history.undo();
						},
						redo: function (this: { quill: InstanceType<typeof Quill> }) {
							this.quill.history.redo();
						},
					},
				},
				resize: { locale: {} },
			},
			placeholder: 'ابدأ بكتابة محتوى المقال هنا...',
		});
		// Documented API for seeding initial HTML (not a raw innerHTML assignment) — keeps
		// Quill's internal document model in sync with the DOM from the start, rather than
		// only after the first edit.
		if (hiddenTextarea.value) quill.clipboard.dangerouslyPasteHTML(hiddenTextarea.value);
		quill.root.setAttribute('dir', 'rtl');
		quill.root.style.textAlign = 'right';

		const form = hiddenTextarea.closest('form') as HTMLFormElement | null;
		const isCreateMode = !form?.querySelector('input[name="id"]');
		const submitBtn = document.getElementById('article-submit-btn') as HTMLButtonElement | null;
		const submitLabel = document.getElementById('article-submit-label');
		const saveError = document.getElementById('save-error');

		form?.addEventListener('submit', (event) => {
			hiddenTextarea.value = quill.root.innerHTML;
			const isEmpty = quill.getText().trim().length === 0;
			errorHint?.classList.toggle('hidden', !isEmpty);
			if (isEmpty) {
				event.preventDefault();
				return;
			}
			// Editing an existing article: files already upload immediately via their own
			// form below — a normal POST is enough here, nothing else to coordinate.
			if (!isCreateMode) return;

			// Creating a new article: the article doesn't have an id yet, so any files staged
			// above (#staged-file-input) can't be uploaded until this save returns one. Submit
			// via fetch instead of a native POST so the response (the new id) is readable,
			// then upload each staged file, then land on the edit page — one guided flow
			// instead of "save, then come back and add files".
			event.preventDefault();
			saveError?.classList.add('hidden');
			if (submitBtn) submitBtn.disabled = true;
			if (submitLabel) submitLabel.textContent = 'جارِ الحفظ...';

			(async () => {
				try {
					const formData = new FormData(form);
					const res = await fetch(form.action, {
						method: 'POST',
						headers: { 'X-Requested-With': 'fetch' },
						body: formData,
					});
					const json = await res.json();
					if (!res.ok || !json?.success || !json?.id) {
						throw new Error(json?.message || 'تعذّر حفظ المقال');
					}

					const stagedCategory = (document.getElementById('staged-file-category') as HTMLSelectElement | null)?.value ?? '';
					if (submitLabel && stagedFiles.length > 0) submitLabel.textContent = `جارِ رفع الملفات (0/${stagedFiles.length})...`;
					for (let i = 0; i < stagedFiles.length; i++) {
						const uploadData = new FormData();
						uploadData.set('file', stagedFiles[i]);
						if (stagedCategory) uploadData.set('file_category', stagedCategory);
						const uploadRes = await fetch(`/api/dashboard/articles/${json.id}/files`, { method: 'POST', body: uploadData });
						// A failed file upload shouldn't block navigating to the now-created
						// article — the admin can retry the upload from the edit page either way.
						if (!uploadRes.ok) console.error('failed to upload staged file', stagedFiles[i].name);
						if (submitLabel) submitLabel.textContent = `جارِ رفع الملفات (${i + 1}/${stagedFiles.length})...`;
					}

					window.location.href = `/dashboard/articles/${json.id}/edit?success=1`;
				} catch (err) {
					if (submitBtn) submitBtn.disabled = false;
					if (submitLabel) submitLabel.textContent = 'حفظ';
					if (saveError) {
						saveError.textContent = err instanceof Error ? err.message : 'حدث خطأ غير متوقع أثناء الحفظ';
						saveError.classList.remove('hidden');
					}
				}
			})();
		});

		// AI content generation — starts an async backend job (Together AI via
		// services.AIService), polls until done, then fills content + (only if still empty)
		// meta_description/keywords from the same generated article so nothing is overwritten
		// that the admin already typed themselves.
		const aiButton = document.getElementById('ai-generate-btn') as HTMLButtonElement | null;
		const aiIcon = document.getElementById('ai-generate-icon');
		const aiLabel = document.getElementById('ai-generate-label');
		const aiError = document.getElementById('ai-generate-error');
		const titleInput = document.getElementById('title') as HTMLInputElement | null;
		const metaDescriptionInput = document.getElementById('meta_description') as HTMLTextAreaElement | null;
		const keywordsInput = document.getElementById('keywords') as HTMLInputElement | null;
		const subjectSelectForAI = document.getElementById('subject_id') as HTMLSelectElement | null;
		const semesterSelectForAI = document.getElementById('semester_id') as HTMLSelectElement | null;
		const countrySelectForAI = document.getElementById('country-database-select') as HTMLSelectElement | null;

		const setAIBusy = (busy: boolean) => {
			if (aiButton) aiButton.disabled = busy;
			aiIcon?.classList.toggle('animate-spin', busy);
			if (aiLabel) aiLabel.textContent = busy ? 'جارِ التوليد... (قد يستغرق دقائق)' : 'توليد بالذكاء الاصطناعي';
		};

		aiButton?.addEventListener('click', async () => {
			aiError?.classList.add('hidden');
			const title = titleInput?.value.trim() ?? '';
			if (title.length < 5) {
				if (aiError) {
					aiError.textContent = 'يرجى إدخال عنوان مكون من 5 أحرف على الأقل قبل التوليد.';
					aiError.classList.remove('hidden');
				}
				return;
			}
			const sourceFileId = aiSourceFileIdInput?.value.trim() ?? '';
			if (!sourceFileId) {
				if (aiError) {
					aiError.textContent = 'يرجى رفع ملف مصدر التوليد أولًا (أعلى قسم المرفقات).';
					aiError.classList.remove('hidden');
				}
				return;
			}

			const subjectOption = subjectSelectForAI?.selectedOptions[0];
			const semesterOption = semesterSelectForAI?.selectedOptions[0];
			if (!subjectOption?.value || !semesterOption?.value) {
				if (aiError) {
					aiError.textContent = 'يرجى اختيار الصف والمادة والفصل الدراسي كاملة قبل التوليد.';
					aiError.classList.remove('hidden');
				}
				return;
			}
			const countryCode = COUNTRY_ID_TO_CODE[countrySelectForAI?.value ?? ''] ?? '';

			setAIBusy(true);
			try {
				const genRes = await fetch('/api/dashboard/ai/generate', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						title,
						content_type: 'article',
						country_code: countryCode,
						file_ids: [Number(sourceFileId)],
						grade_level: subjectOption?.dataset.gradeLevel || undefined,
						subject_id: subjectOption?.value || undefined,
						subject_name: subjectOption?.textContent?.trim() || undefined,
						semester_id: semesterOption?.value || undefined,
						semester_name: semesterOption?.textContent?.trim() || undefined,
					}),
				});
				const genJson = await genRes.json();
				if (!genRes.ok || !genJson?.job_id) {
					throw new Error(genJson?.message || 'تعذّر بدء عملية التوليد');
				}

				const jobId = genJson.job_id;
				// File-grounded generation runs several sequential AI calls (fact extraction,
				// then up to 3 writer/validator rounds chasing the 99% SEO bar), so this can
				// legitimately take a couple of minutes. Hard cap at ~5m20s (just past the
				// backend's own groundedGenerationTimeout of 5m) instead of polling forever.
				const maxPollAttempts = 107;
				const poll = async (attempt = 0): Promise<void> => {
					if (attempt >= maxPollAttempts) {
						throw new Error('استغرق التوليد وقتًا أطول من المتوقع. يرجى المحاولة مرة أخرى.');
					}
					const statusRes = await fetch(`/api/dashboard/ai/status/${jobId}`);
					const statusJson = await statusRes.json();
					if (statusJson?.status === 'done') {
						const html = statusJson.content_html || statusJson.content || '';
						if (html) quill.clipboard.dangerouslyPasteHTML(html);
						const article = statusJson.article;
						if (article?.meta_description && metaDescriptionInput && !metaDescriptionInput.value.trim()) {
							metaDescriptionInput.value = article.meta_description;
						}
						if (Array.isArray(article?.keywords) && article.keywords.length && keywordsInput && !keywordsInput.value.trim()) {
							keywordsInput.value = article.keywords.join('، ');
						}
						if (typeof article?.seo_score === 'number' && article.seo_score < 99 && aiError) {
							const topIssue = Array.isArray(article.seo_issues) && article.seo_issues.length ? ` — ${article.seo_issues[0]}` : '';
							aiError.textContent = `تم التوليد بجودة SEO ${article.seo_score}% (أقل من 99%)${topIssue}. راجع المحتوى قبل النشر.`;
							aiError.classList.remove('hidden');
						}
						setAIBusy(false);
						return;
					}
					if (statusJson?.status === 'failed') {
						throw new Error(statusJson?.error || 'فشل توليد المحتوى');
					}
					await new Promise((resolve) => setTimeout(resolve, 3000));
					return poll(attempt + 1);
				};
				await poll();
			} catch (err) {
				setAIBusy(false);
				if (aiError) {
					aiError.textContent = err instanceof Error ? err.message : 'حدث خطأ غير متوقع أثناء التوليد';
					aiError.classList.remove('hidden');
				}
			}
		});
	}

	// Country/database selector — reloads the page under the chosen country so the
	// class/subject/semester lists (fetched server-side) reflect that country's own data.
	// Matches CountrySwitcher.astro's bare-page mechanism (?country= query, persisted to a
	// cookie by middleware.ts) rather than inventing a second one.
	const countrySelect = document.getElementById('country-database-select') as HTMLSelectElement | null;
	countrySelect?.addEventListener('change', () => {
		if (countrySelect.value === countrySelect.dataset.current) return;
		const url = new URL(window.location.href);
		url.searchParams.set('country', countrySelect.value);
		window.location.href = url.toString();
	});

	// Cascading class → subject → semester, fetched on demand from the backend's own
	// /filter/subjects/{classId} and /filter/semesters/{subjectId} — already-working, already
	// publicly-deployed endpoints (used by the public article search page already) — rather
	// than from the dashboard's own bulk create/edit-data endpoint, which as currently
	// deployed to production unconditionally returns empty subjects/semesters arrays. This
	// sidesteps that bug entirely without needing any backend change.
	function setSelectLoading(select: HTMLSelectElement, label: string) {
		select.innerHTML = '';
		const opt = document.createElement('option');
		opt.value = '';
		opt.textContent = label;
		select.appendChild(opt);
		select.disabled = true;
	}

	function populateSelect(select: HTMLSelectElement, items: any[], valueKey: string, labelKey: string, placeholder: string, extraAttrs?: (item: any) => Record<string, string>, preserveValue?: string) {
		// Callers that first show a loading state via setSelectLoading() have already wiped
		// select.value to '' by the time this runs — preserveValue lets them pass the value
		// captured *before* that wipe, instead of losing it. Falls back to reading select.value
		// live for the plain (no loading-state) call sites.
		const currentValue = preserveValue ?? select.value;
		select.innerHTML = '';
		select.disabled = false;
		const placeholderOption = document.createElement('option');
		placeholderOption.value = '';
		placeholderOption.textContent = placeholder;
		select.appendChild(placeholderOption);
		for (const item of items) {
			const opt = document.createElement('option');
			opt.value = String(item[valueKey]);
			opt.textContent = item[labelKey];
			if (extraAttrs) {
				for (const [key, value] of Object.entries(extraAttrs(item))) opt.dataset[key] = value;
			}
			select.appendChild(opt);
		}
		if ([...select.options].some((o) => o.value === currentValue)) select.value = currentValue;
	}

	const classSelectEl = document.getElementById('class_id') as HTMLSelectElement | null;
	const subjectSelectEl = document.getElementById('subject_id') as HTMLSelectElement | null;
	const semesterSelectEl = document.getElementById('semester_id') as HTMLSelectElement | null;

	async function loadSubjectsForClass(classId: string) {
		if (!subjectSelectEl) return;
		if (!classId) {
			populateSelect(subjectSelectEl, [], 'id', 'subject_name', '— اختر الصف أولاً —');
			return;
		}
		// Capture before setSelectLoading() wipes select.value to '' — otherwise the article's
		// originally-selected subject is lost the moment loading starts, regardless of whether
		// it's still present in the freshly-fetched list.
		const previousValue = subjectSelectEl.value;
		setSelectLoading(subjectSelectEl, 'جارِ التحميل...');
		try {
			const res = await fetch(`/api/dashboard/filter/subjects/${classId}`);
			const json = await res.json();
			const items = Array.isArray(json?.data) ? json.data : [];
			populateSelect(subjectSelectEl, items, 'id', 'subject_name', '— اختر مادة —', (item) => ({ gradeLevel: String(item.grade_level) }), previousValue);
		} catch {
			populateSelect(subjectSelectEl, [], 'id', 'subject_name', '— تعذّر تحميل المواد —');
		}
	}

	async function loadSemestersForSubject(subjectId: string) {
		if (!semesterSelectEl) return;
		if (!subjectId) {
			populateSelect(semesterSelectEl, [], 'id', 'semester_name', '— اختر المادة أولاً —');
			return;
		}
		const previousValue = semesterSelectEl.value;
		setSelectLoading(semesterSelectEl, 'جارِ التحميل...');
		try {
			const res = await fetch(`/api/dashboard/filter/semesters/${subjectId}`);
			const json = await res.json();
			const items = Array.isArray(json?.data?.semesters) ? json.data.semesters : [];
			populateSelect(semesterSelectEl, items, 'id', 'semester_name', '— اختر فصلاً —', undefined, previousValue);
		} catch {
			populateSelect(semesterSelectEl, [], 'id', 'semester_name', '— تعذّر تحميل الفصول —');
		}
	}

	classSelectEl?.addEventListener('change', async () => {
		await loadSubjectsForClass(classSelectEl.value);
		if (semesterSelectEl) populateSelect(semesterSelectEl, [], 'id', 'semester_name', '— اختر المادة أولاً —');
	});
	subjectSelectEl?.addEventListener('change', () => loadSemestersForSubject(subjectSelectEl.value));

	// Editing an existing article: the subject/semester selects start out with only the
	// article's current values pre-filled (from its preloaded Subject/Semester relations, no
	// fetch needed) — but the admin should still be able to pick a DIFFERENT subject within
	// the same class, or a different semester within the same subject, without having to
	// touch the class dropdown first. Load the full sibling options now, preserving selection.
	// Sequenced (not fire-and-forget): loadSubjectsForClass reads subjectSelectEl's original
	// value synchronously before its own loading state clears it, but that same clearing also
	// makes subjectSelectEl.value read '' for the check below for as long as its fetch is in
	// flight — awaiting first means the semester preload correctly sees the restored subject.
	(async () => {
		if (classSelectEl?.value) await loadSubjectsForClass(classSelectEl.value);
		if (subjectSelectEl?.value) await loadSemestersForSubject(subjectSelectEl.value);
	})();
</script>
