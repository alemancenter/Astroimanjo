---
interface Props { author?: any }
const { author } = Astro.props;
---
<form class="author-form" method="post" action="/api/dashboard/seo/authors/save">
	<label>رقم المستخدم<input name="user_id" type="number" min="1" required value={author?.user_id || ''} /></label><label>الاسم العلني<input name="public_name" required value={author?.public_name || ''} /></label>
	<label class="wide">الصفة المهنية<input name="headline" value={author?.headline || ''} placeholder="معلم لغة عربية وباحث تربوي" /></label><label class="wide">السيرة<textarea name="biography" rows="4">{author?.biography || ''}</textarea></label>
	<label>مجالات الخبرة<textarea name="expertise" rows="3">{author?.expertise || ''}</textarea></label><label>الاعتمادات<textarea name="credentials" rows="3">{author?.credentials || ''}</textarea></label><label>التعليم<textarea name="education" rows="3">{author?.education || ''}</textarea></label><label>الجوائز<textarea name="awards" rows="3">{author?.awards || ''}</textarea></label>
	<label>جهة العمل<input name="employer" value={author?.employer || ''} /></label><label>رابط الملف<input name="profile_url" type="url" dir="ltr" value={author?.profile_url || ''} /></label><label class="wide">الصورة<input name="image_url" type="url" dir="ltr" value={author?.image_url || ''} /></label>
	<label class="wide">الروابط الاجتماعية JSON<textarea name="social_links_json" rows="3" dir="ltr" placeholder='{"linkedin":"https://..."}'>{author?.social_links_json || ''}</textarea></label><label class="wide">knowsAbout JSON<textarea name="knows_about_json" rows="3" dir="ltr" placeholder='["التربية","اللغة العربية"]'>{author?.knows_about_json || ''}</textarea></label>
	<label class="check"><input name="active" type="checkbox" value="true" checked={author?.active ?? true} />ملف نشط</label><button>حفظ الملف</button>
</form>
<style>.author-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;border-top:1px solid #edf1f5;padding:.6rem}.author-form label{display:grid;gap:.18rem;color:#536a80;font-size:.52rem}.author-form .wide{grid-column:1/-1}.author-form input,.author-form textarea{width:100%;min-height:2.2rem;border:1px solid #d8e2ec;border-radius:.38rem;background:#fff;padding:.4rem .5rem;font-family:inherit;font-size:.57rem}.author-form textarea{resize:vertical}.author-form .check{display:flex;align-items:center}.author-form .check input{width:auto;min-height:0}.author-form button{border:0;border-radius:.38rem;background:#1a4d8f;padding:.45rem;color:#fff;font-family:inherit;font-size:.58rem;font-weight:850}:global(.dark) .author-form{border-color:#30465e}:global(.dark) .author-form input,:global(.dark) .author-form textarea{border-color:#3a5069;background:#0e223b;color:#e7eef6}@media(max-width:560px){.author-form{grid-template-columns:1fr}.author-form .wide{grid-column:auto}}</style>
