---
// Server-side redirect OAuth flow (back/internal/handlers/auth/handler.go GoogleRedirect/
// FacebookRedirect + GoogleCallback/FacebookCallback), not a client-side SDK token exchange.
// This is what the dashboard's google_client_secret/google_redirect_uri/facebook_app_secret/
// facebook_redirect_uri settings actually configure — a previous client-side-only
// implementation (Google Identity Services' initTokenClient + the Facebook JS SDK) never
// touched those four fields at all, so they had no effect on the real login experience despite
// being fully wired into working backend code.
interface Props {
	googleClientId?: string;
	facebookAppId?: string;
	redirectTo?: string;
	action?: 'login' | 'register';
}

const { googleClientId = '', facebookAppId = '', redirectTo = '/', action = 'login' } = Astro.props;
const enabled = Boolean(googleClientId || facebookAppId);
const actionLabel = action === 'register' ? 'المتابعة عبر' : 'الدخول عبر';
const encodedRedirect = encodeURIComponent(redirectTo);
---

{enabled && (
	<div class="social-login space-y-3">
		<div class="grid gap-3 sm:grid-cols-2">
			{googleClientId && (
				<a href={`/api/auth/google/redirect?redirect_to=${encodedRedirect}`} class="social-login__button">
					<svg viewBox="0 0 24 24" class="size-5 shrink-0" aria-hidden="true">
						<path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.43 3.58v2.98h3.86c2.26-2.09 3.59-5.17 3.59-8.8z" />
						<path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-2.98c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z" />
						<path fill="#FBBC05" d="M5.27 14.31c-.24-.72-.38-1.49-.38-2.31s.14-1.59.38-2.31V6.6H1.29A11.96 11.96 0 0 0 0 12c0 1.94.46 3.77 1.29 5.4l3.98-3.09z" />
						<path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.94 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.6l3.98 3.09c.95-2.85 3.6-4.94 6.73-4.94z" />
					</svg>
					<span>{actionLabel} Google</span>
				</a>
			)}
			{facebookAppId && (
				<a href={`/api/auth/facebook/redirect?redirect_to=${encodedRedirect}`} class="social-login__button">
					<svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="#1877F2" aria-hidden="true">
						<path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 5.99 4.39 10.96 10.13 11.87v-8.38H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.94h-1.51c-1.49 0-1.95.93-1.95 1.89v2.28h3.32l-.53 3.49h-2.79v8.38C19.61 23.03 24 18.06 24 12.07z" />
					</svg>
					<span>{actionLabel} Facebook</span>
				</a>
			)}
		</div>
	</div>
)}

<style>
	.social-login__button {
		display: inline-flex;
		min-height: 3rem;
		align-items: center;
		justify-content: center;
		gap: .65rem;
		border: 1px solid var(--color-graphite-200);
		border-radius: .85rem;
		background: white;
		padding: .7rem 1rem;
		color: var(--color-graphite-800);
		font-size: .875rem;
		font-weight: 700;
		transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
	}
	.social-login__button:hover { transform: translateY(-1px); border-color: var(--color-royal-300); box-shadow: 0 8px 22px rgb(26 77 143 / .1); }
	.social-login__button:focus-visible { outline: 3px solid color-mix(in srgb, var(--color-royal-500) 25%, transparent); outline-offset: 2px; }
	:global(.dark) .social-login__button { border-color: var(--color-graphite-700); background: var(--color-graphite-950); color: var(--color-graphite-100); }
	:global(.dark) .social-login__button:hover { border-color: var(--color-royal-500); }
</style>
