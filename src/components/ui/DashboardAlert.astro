---
const params = Astro.url.searchParams;
const error = params.get('error');
const success = params.get('success');
const warning = params.get('warning') || params.get('seo_warning');
---

{error && <div class="alert-error mb-6" role="alert">{error}</div>}
{warning && <div class="alert-warning mb-6" role="status">{warning}</div>}
{success && <div class="alert-success mb-6" role="status">{success === '1' ? 'تم تنفيذ العملية بنجاح.' : success}</div>}
