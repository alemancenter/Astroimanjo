---
interface Crumb { label: string; href?: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---

<nav aria-label="مسار التصفح" class="container-shell pt-5 sm:pt-6">
	<ol class="flex min-w-0 flex-wrap items-center gap-2 text-xs font-semibold text-graphite-500 sm:text-sm dark:text-graphite-400">
		<li><a href="/" class="rounded-md transition hover:text-royal-700 dark:hover:text-royal-300">الرئيسية</a></li>
		{items.map((item, i) => <><li aria-hidden="true" class="text-graphite-300 dark:text-graphite-600">/</li><li class="min-w-0">{item.href && i < items.length - 1 ? <a href={item.href} class="rounded-md transition hover:text-royal-700 dark:hover:text-royal-300">{item.label}</a> : <span class="line-clamp-1 font-bold text-graphite-800 dark:text-graphite-200" aria-current="page">{item.label}</span>}</li></>)}
	</ol>
</nav>
