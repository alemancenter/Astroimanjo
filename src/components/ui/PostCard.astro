---
import { assetUrl } from '../../lib/assets';
import type { Post } from '../../types/api';
interface Props { post: Post; href: string; index?: number; }
const { post, href } = Astro.props;
const imageSrc = assetUrl(post.image, 480);
---

<a href={href} class="interactive-card group flex flex-col overflow-hidden">
	<div class="relative h-44 overflow-hidden bg-gradient-to-br from-royal-100 to-emerald-brand-100 dark:from-royal-950 dark:to-emerald-brand-950">
		{imageSrc ? <img src={imageSrc} alt={post.alt || post.title} width="480" height="320" class="size-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" onerror="this.style.display='none'" /> : <div class="flex size-full items-center justify-center text-royal-600 dark:text-royal-300"><svg class="size-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2ZM8 10h.01M21 15l-5-5L5 20" /></svg></div>}
		<span class="absolute top-4 right-4 badge bg-white/90 text-royal-700 shadow-sm backdrop-blur dark:bg-graphite-950/90 dark:text-royal-200">{post.category?.name || 'مقال'}</span>
	</div>
	<div class="flex flex-grow flex-col p-6">
		<h3 class="mb-3 line-clamp-2 text-lg font-extrabold leading-7 text-graphite-950 transition group-hover:text-royal-700 dark:text-white dark:group-hover:text-royal-300">{post.title}</h3>
		<p class="mb-6 line-clamp-2 text-sm leading-6 text-graphite-600 dark:text-graphite-300">{post.meta_description || 'محتوى تعليمي مختصر ومفيد.'}</p>
		<div class="mt-auto flex items-center justify-between border-t border-graphite-100 pt-4 text-xs text-graphite-500 dark:border-graphite-800 dark:text-graphite-400">
			<span>{new Date(post.created_at || Date.now()).toLocaleDateString('ar-EG')}</span><span>{post.views || 0} مشاهدة</span>
		</div>
	</div>
</a>
