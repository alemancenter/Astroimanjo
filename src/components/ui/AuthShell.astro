---
interface Props { title: string; description: string; eyebrow: string; }
const { title, description, eyebrow } = Astro.props;
---
<div class="container-shell py-12 sm:py-16">
	<div class="mx-auto grid max-w-5xl overflow-hidden rounded-[2rem] border border-graphite-200 bg-white shadow-lifted lg:grid-cols-[.9fr_1.1fr] dark:border-graphite-700 dark:bg-graphite-900">
		<aside class="relative hidden overflow-hidden bg-graphite-950 p-10 text-white lg:flex lg:flex-col lg:justify-between">
			<div class="absolute -right-28 -top-24 size-72 rounded-full bg-royal-600/40 blur-3xl" aria-hidden="true"></div>
			<div class="absolute -bottom-28 -left-20 size-64 rounded-full bg-emerald-brand-600/30 blur-3xl" aria-hidden="true"></div>
			<div class="relative"><span class="inline-flex rounded-full bg-sunset-400 px-3 py-1.5 text-xs font-extrabold text-graphite-950">موقع الإيمان التعليمي</span><h2 class="mt-6 text-3xl font-black leading-tight">كل ما تحتاجه للتعلم في مكان واحد.</h2><p class="mt-4 leading-8 text-graphite-300">وصول أسرع للمحتوى الدراسي، تجربة عربية واضحة، ومساحة خاصة تحفظ تفاصيلك.</p></div>
			<ul class="relative mt-12 space-y-4 text-sm text-graphite-200"><li class="flex gap-3"><span class="text-emerald-brand-300">✓</span>محتوى منظم حسب الصف والمادة</li><li class="flex gap-3"><span class="text-emerald-brand-300">✓</span>تعليقات وتفاعل مع المحتوى</li><li class="flex gap-3"><span class="text-emerald-brand-300">✓</span>أدوات خاصة للمعلمين</li></ul>
		</aside>
		<section class="p-6 sm:p-10 lg:p-12"><header class="mb-8"><span class="page-eyebrow">{eyebrow}</span><h1 class="text-3xl font-extrabold text-graphite-950 dark:text-white">{title}</h1><p class="mt-3 leading-7 text-graphite-600 dark:text-graphite-300">{description}</p></header><slot /></section>
	</div>
</div>
