---
interface Props {
	index?: number;
	class?: string;
}

const { index = 0, class: className = 'size-7' } = Astro.props;
const icon = index % 7;
---

{
	icon === 0 ? (
		<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21.5v-17Z"/><path stroke-linecap="round" stroke-width="1.8" d="M5 19V4.5A2.5 2.5 0 0 0 2.5 2H2v17h.5A2.5 2.5 0 0 1 5 21.5M9 7h7M9 11h5"/></svg>
	) : icon === 1 ? (
		<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 5h14M5 19h14M8 5v14M16 5v14M8 9h8M8 15h8"/><path stroke-linecap="round" stroke-width="1.8" d="m11 12 1-2 1 2-1 2-1-2Z"/></svg>
	) : icon === 2 ? (
		<svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18.5 14.5A7.5 7.5 0 1 1 11 4a6 6 0 0 0 7.5 10.5Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m17 5 .5 1.5L19 7l-1.5.5L17 9l-.5-1.5L15 7l1.5-.5L17 5Z"/></svg>
	) : icon === 3 ? (
