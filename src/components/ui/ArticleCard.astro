---
interface Props {
	article: any;
	href: string;
	index?: number;
}
const { article, href } = Astro.props;
const publishedAt = new Date(article.published_at || article.created_at || Date.now()).toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a href={href} class="interactive-card group flex min-h-64 flex-col overflow-hidden border-t-4 border-t-royal-600 p-6">
	<div class="mb-5 flex items-center justify-between gap-3">
		<span class="badge-primary">{article.subject?.subject_name || 'مادة تعليمية'}</span>
		<span class="flex size-9 items-center justify-center rounded-xl bg-emerald-brand-50 text-emerald-brand-700 transition group-hover:bg-emerald-brand-600 group-hover:text-white dark:bg-emerald-brand-950 dark:text-emerald-brand-300" aria-hidden="true">
			<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.8 5.48 9.25 5 7.5 5S4.17 5.48 3 6.253v13C4.17 18.48 5.75 18 7.5 18s3.33.48 4.5 1.253m0-13C13.17 5.48 14.75 5 16.5 5s3.33.48 4.5 1.253v13C19.83 18.48 18.25 18 16.5 18s-3.33.48-4.5 1.253" /></svg>
		</span>
	</div>
	<h3 class="mb-3 line-clamp-2 text-base font-bold leading-7 text-graphite-950 transition group-hover:text-royal-700 dark:text-white dark:group-hover:text-royal-300">{article.title}</h3>
	<p class="mb-6 line-clamp-2 text-sm leading-6 text-graphite-600 dark:text-graphite-300">{article.meta_description || 'اطّلع على محتوى هذا الملف التعليمي وتفاصيله.'}</p>
	<div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-graphite-100 pt-4 text-xs text-graphite-500 dark:border-graphite-800 dark:text-graphite-400">
		<span class="flex items-center gap-1.5"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z" /></svg>{publishedAt}</span>
		<span class="flex items-center gap-1.5"><svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.46 12C3.73 7.94 7.52 5 12 5s8.27 2.94 9.54 7c-1.27 4.06-5.06 7-9.54 7s-8.27-2.94-9.54-7Z" /></svg>{article.visit_count || 0} مشاهدة</span>
	</div>
</a>
