---
interface Props {
	title: string;
	description?: string;
	lastUpdated?: string;
	eyebrow?: string;
}

const {
	title,
	description,
	lastUpdated,
	eyebrow = 'معلومات المنصة',
} = Astro.props;
---
<div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
	<header class="relative mb-7 overflow-hidden rounded-[1.75rem] bg-graphite-950 px-6 py-9 text-white shadow-lifted sm:px-10 sm:py-12">
		<div class="absolute -left-16 -top-20 size-56 rounded-full bg-royal-600/35 blur-3xl" aria-hidden="true"></div>
		<div class="absolute -bottom-24 right-10 size-52 rounded-full bg-emerald-brand-600/20 blur-3xl" aria-hidden="true"></div>
		<div class="relative max-w-3xl">
			<span class="mb-4 inline-flex rounded-full border border-white/10 bg-white/10 px-3 py-1.5 text-xs font-bold text-sunset-200">{eyebrow}</span>
			<h1 class="text-3xl font-black leading-tight tracking-tight sm:text-4xl">{title}</h1>
			{description && <p class="mt-4 text-sm leading-7 text-graphite-200 sm:text-base sm:leading-8">{description}</p>}
			{lastUpdated && <p class="mt-5 inline-flex rounded-lg bg-black/20 px-3 py-2 text-xs font-bold text-graphite-300">آخر تحديث: {lastUpdated}</p>}
		</div>
	</header>
	<article class="surface-card overflow-hidden">
		<div class="h-1 bg-gradient-to-l from-royal-600 via-emerald-brand-600 to-sunset-400"></div>
		<div class="prose-edu p-6 sm:p-9 lg:p-11"><slot /></div>
	</article>
</div>
