---
interface AdConfig {
	ad_slot: string;
	format?: string;
	responsive?: boolean;
	ad_layout?: string;
	ad_layout_key?: string;
	ad_type?: string;
	matched_content_ui_type?: string;
	matched_content_rows_num?: string;
	matched_content_columns_num?: string;
}

interface Props {
	client?: string;
	desktopConfig?: string;
	mobileConfig?: string;
	placement: string;
	label?: string;
	class?: string;
	/** Set only for a page/account path that Google has classified as child-directed. */
	childDirectedTreatment?: boolean;
}

const {
	client = '',
	desktopConfig = '',
	mobileConfig = '',
	placement,
	label = 'إعلان',
	class: className = '',
	childDirectedTreatment = false,
} = Astro.props;

const allowedKeys = new Set([
	'ad_slot', 'format', 'responsive', 'ad_layout', 'ad_layout_key', 'ad_type',
	'matched_content_ui_type', 'matched_content_rows_num', 'matched_content_columns_num',
]);

function parseConfig(raw: string): AdConfig | null {
	if (!raw.trim()) return null;
	try {
		const parsed = JSON.parse(raw);
		if (!parsed || typeof parsed !== 'object' || !/^\d+$/.test(String(parsed.ad_slot || ''))) return null;
		const clean: Record<string, string | boolean> = {};
		for (const [key, value] of Object.entries(parsed)) {
			if (!allowedKeys.has(key) || !['string', 'boolean', 'number'].includes(typeof value)) continue;
			clean[key] = typeof value === 'number' ? String(value) : value as string | boolean;
		}
		return clean as unknown as AdConfig;
	} catch {
		return null;
	}
}

const desktop = parseConfig(desktopConfig);
const mobile = parseConfig(mobileConfig) || desktop;
const validClient = /^ca-pub-\d+$/.test(client.trim());
const shouldRender = validClient && Boolean(desktop || mobile);
---

{shouldRender && (
	<aside
		class:list={['adsense-placement', className]}
		aria-label={label}
		data-adsense-placement={placement}
		data-ad-client={client}
		data-desktop-config={desktop ? JSON.stringify(desktop) : ''}
		data-mobile-config={mobile ? JSON.stringify(mobile) : ''}
		data-child-directed-treatment={childDirectedTreatment ? '1' : '0'}
	>
		<span class="adsense-placement__label">{label}</span>
		<div class="adsense-placement__mount" data-ad-mount></div>
	</aside>
)}

<script>
	const supportedDataKeys: Record<string, string> = {
		ad_slot: 'adSlot', format: 'adFormat', responsive: 'fullWidthResponsive',
		ad_layout: 'adLayout', ad_layout_key: 'adLayoutKey', ad_type: 'adType',
		matched_content_ui_type: 'matchedContentUiType', matched_content_rows_num: 'matchedContentRowsNum',
		matched_content_columns_num: 'matchedContentColumnsNum',
	};

	(() => {
		const consentEvent = 'imanjo:consent-updated';
		const canInitializeAds = () => {
			const consent = (window as typeof window & {
				__imanjoConsent?: { status?: string };
			}).__imanjoConsent;
			return consent?.status === 'granted' || consent?.status === 'denied';
		};

		const initializePlacements = (force = false) => {
			// Missing consent state is a soft stop, not permanent: outside EEA/UK/Switzerland
			// Google's CMP never shows a message at all, so canInitializeAds() would otherwise
			// never return true and this mount would stay empty forever. force=true (the
			// grace-window timeout below) proceeds anyway — data-npa-on-unknown-consent on each
			// unit makes that safe (non-personalized ads instead of none).
			if (!force && !canInitializeAds()) return false;
			const consent = (window as typeof window & {
				__imanjoConsent?: { status?: string };
			}).__imanjoConsent;
			const consentState = consent?.status || 'pending';
			document.querySelectorAll<HTMLElement>('[data-adsense-placement]').forEach((placement) => {
				// A unit already created under a *resolved* consent state (granted/denied) is
				// done — never touch it again. But one created earlier by the grace-window
				// force-path (consentState was still 'pending' at the time) already consumed its
				// one adsbygoogle.push({}) call — Google doesn't re-fill an <ins> it already
				// processed, even once real consent arrives — so once a genuine decision comes
				// in, that placeholder <ins> is swapped for a fresh one to get a real ad request.
				if (placement.dataset.adInitialized === '1') {
					if (placement.dataset.adConsentState !== 'pending' || consentState === 'pending') return;
					const mount = placement.querySelector<HTMLElement>('[data-ad-mount]');
					if (mount) mount.innerHTML = '';
				}
				const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
				const raw = isDesktop ? placement.dataset.desktopConfig : placement.dataset.mobileConfig;
				const mount = placement.querySelector<HTMLElement>('[data-ad-mount]');
				if (!raw || !mount) {
					placement.hidden = true;
					return;
				}

				try {
					const config = JSON.parse(raw) as Record<string, string | boolean>;
					const unit = document.createElement('ins');
					unit.className = 'adsbygoogle';
					unit.style.display = 'block';
					unit.dataset.adClient = placement.dataset.adClient || '';
					unit.dataset.npaOnUnknownConsent = '1';
					unit.dataset.consentState = consentState;
					if (placement.dataset.childDirectedTreatment === '1') {
						// data-tag-for-child-directed-treatment is deprecated by Google in favor
						// of this attribute; same "treat this ad request as child-directed" intent.
						unit.dataset.tagForAgeTreatment = '1';
					}
					for (const [key, value] of Object.entries(config)) {
						const dataKey = supportedDataKeys[key];
						if (dataKey) unit.dataset[dataKey] = String(value);
					}
					if (!unit.dataset.adFormat) unit.dataset.adFormat = 'auto';
					if (!unit.dataset.fullWidthResponsive) unit.dataset.fullWidthResponsive = 'true';
					mount.append(unit);
					placement.dataset.adInitialized = '1';
					placement.dataset.adConsentState = consentState;
					const adsWindow = window as typeof window & { adsbygoogle?: Record<string, unknown>[] };
					(adsWindow.adsbygoogle = adsWindow.adsbygoogle || []).push({});
				} catch {
					placement.hidden = true;
				}
			});
			return true;
		};

		if (!initializePlacements()) {
			// Stays subscribed even after the grace-window force-fill below: a unit built under
			// 'pending' consent has already used up its one ad request, so when the real
			// decision arrives afterward, initializePlacements() needs this event to know to
			// swap it for a fresh one (see the adConsentState check inside).
			const onConsent = () => initializePlacements();
			window.addEventListener(consentEvent, onConsent);
			setTimeout(() => {
				initializePlacements(true);
			}, 800);
		}
	})();
</script>

<style>
	.adsense-placement {
		position: relative;
		isolation: isolate;
		width: 100%;
		min-height: 7.5rem;
		padding: 1.75rem 1rem 1rem;
		border: 1px solid var(--color-graphite-200);
		border-radius: 1rem;
		background: color-mix(in srgb, var(--color-white) 88%, var(--color-graphite-50));
		overflow: hidden;
	}

	.adsense-placement__label {
		position: absolute;
		top: .55rem;
		inset-inline-start: 50%;
		transform: translateX(50%);
		font-size: .625rem;
		font-weight: 700;
		letter-spacing: .04em;
		color: var(--color-graphite-400);
	}

	.adsense-placement__mount {
		width: 100%;
		min-height: 5rem;
	}

	:global(.dark) .adsense-placement {
		border-color: var(--color-graphite-700);
		background: var(--color-graphite-900);
	}

	@media (max-width: 639px) {
		.adsense-placement { min-height: 6.5rem; padding-inline: .5rem; }
	}
</style>
