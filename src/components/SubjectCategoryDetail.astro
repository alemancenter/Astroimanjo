---
import Breadcrumbs from './ui/Breadcrumbs.astro';
import EmptyState from './ui/EmptyState.astro';
import ErrorState from './ui/ErrorState.astro';
import Pagination from './ui/Pagination.astro';
import SubjectCategoryIcon from './ui/SubjectCategoryIcon.astro';
import { filterFilesByCategory, type SubjectFileCategory } from '../lib/subject-categories';

interface Props {
	countryCode: string;
	subject: any;
	semester: any;
	schoolClass: any;
	category: SubjectFileCategory;
	articles: any[];
	articlesOk: boolean;
	articlesMessage: string;
	currentPage: number;
	lastPage: number;
	pageUrl: URL;
}

const {
	countryCode,
	subject,
	semester,
	schoolClass,
	category,
	articles,
	articlesOk,
	articlesMessage,
	currentPage,
	lastPage,
	pageUrl,
} = Astro.props;

const subjectPath = `/${countryCode}/lesson/subjects/${subject.id}`;
const formatDate = (value?: string) => value
	? new Date(value).toLocaleDateString('ar-JO', { year: 'numeric', month: 'long', day: 'numeric' })
	: 'غير محدد';
// A file can be revised (e.g. a corrected worksheet re-uploaded) long after the article's
// original publish date — showing only that old publish date here reads as "this is stale"
// even when the attached file is current. Same >24h threshold as the article detail page, to
// avoid flagging routine same-day edits as a real "update".
//
// published_at is a nullable pointer on the backend (omitted from the JSON entirely when
// unset — see models/article.go) — articles that were never explicitly "published" only ever
// have created_at. Gating on `article.published_at` truthiness directly (as an earlier version
// of this did) meant every such article silently never showed the update badge, no matter how
// much later updated_at was than created_at. Falling back the same way the article detail page
// already does (publishedAt = published_at || created_at) before comparing fixes that.
const wasArticleUpdated = (article: any) => {
	const baseDate = article.published_at || article.created_at;
	return Boolean(baseDate && article.updated_at && new Date(article.updated_at).getTime() - new Date(baseDate).getTime() > 24 * 60 * 60 * 1000);
};
---

<section class="border-b border-graphite-200 bg-white dark:border-graphite-800 dark:bg-graphite-950">
	<div class="container-shell flex flex-col gap-6 py-9 sm:py-12 md:flex-row md:items-end md:justify-between">
		<div class="max-w-3xl">
			<span class="mb-3 inline-flex items-center gap-2 text-sm font-extrabold text-royal-600 dark:text-royal-300">
				<SubjectCategoryIcon category={category.key} class="size-4" />
				ملفات المادة
			</span>
			<h1 class="text-3xl font-black leading-tight text-graphite-950 sm:text-4xl dark:text-white">{category.label}</h1>
			<p class="mt-3 text-sm font-medium leading-7 text-graphite-600 sm:text-base dark:text-graphite-300">ملفات {category.label} لمادة {subject.subject_name} — {semester.semester_name}.</p>
		</div>
		<a href={`/${countryCode}/articles?class_id=${schoolClass?.id || subject.grade_level}&subject_id=${subject.id}`} class="btn-outline shrink-0 border-royal-200 bg-royal-50 text-royal-700 hover:bg-royal-100 dark:border-royal-800 dark:bg-royal-950 dark:text-royal-200">
			<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m20 20-4-4"/></svg>
			ابحث في الملفات
		</a>
	</div>
</section>

<Breadcrumbs items={[
	{ label: 'الصفوف الدراسية', href: `/${countryCode}/classes` },
	...(schoolClass ? [{ label: schoolClass.grade_name, href: `/${countryCode}/lesson/${schoolClass.id}` }] : []),
	{ label: subject.subject_name, href: subjectPath },
	{ label: category.label },
]} />

<div class="page-shell pt-7 sm:pt-9">
	<section class="mb-7 rounded-2xl border border-graphite-200 bg-white p-5 shadow-soft sm:p-6 dark:border-graphite-700 dark:bg-graphite-900">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<span class="badge-primary">{semester.semester_name}</span>
				<h2 class="mt-3 text-xl font-black text-graphite-950 sm:text-2xl dark:text-white">{category.label}</h2>
				<p class="mt-1 text-sm leading-7 text-graphite-500 dark:text-graphite-400">{category.description}</p>
			</div>
			<a href={subjectPath} class="btn-outline shrink-0">العودة للتصنيفات</a>
		</div>
	</section>

	{!articlesOk ? (
		<ErrorState message={articlesMessage || 'تعذر تحميل الملفات لهذا التصنيف.'} />
	) : articles.length === 0 ? (
		<EmptyState message="لا توجد ملفات متاحة حالياً لهذا التصنيف." />
	) : (
		<div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
			{articles.map((article: any) => {
				const matchedFiles = filterFilesByCategory(article.files, category);
				const updated = wasArticleUpdated(article);
				return (
					<article class="rounded-2xl border border-graphite-200 bg-white p-5 shadow-soft transition duration-200 hover:-translate-y-0.5 hover:border-royal-300 hover:shadow-lifted dark:border-graphite-700 dark:bg-graphite-900 dark:hover:border-royal-700">
						<div class="mb-3 flex flex-wrap items-center gap-2">
							<span class="badge-primary">{subject.subject_name}</span>
							<span class="badge border border-graphite-200 bg-white text-graphite-600 dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-300">{article.semester?.semester_name || semester.semester_name}</span>
							{updated && <span class="badge border border-emerald-brand-200 bg-emerald-brand-50 text-emerald-brand-700 dark:border-emerald-brand-800 dark:bg-emerald-brand-950 dark:text-emerald-brand-200"><svg class="me-1 inline size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 13 4 4L19 7" /></svg>محدَّثة</span>}
						</div>
						<a href={`/${countryCode}/lesson/articles/${article.id}`} class="group block">
							<h3 class="line-clamp-2 text-lg font-black leading-8 text-graphite-950 transition group-hover:text-royal-600 dark:text-white dark:group-hover:text-royal-300">{article.title}</h3>
						</a>
						{article.meta_description && <p class="mt-2 line-clamp-2 text-sm leading-7 text-graphite-500 dark:text-graphite-400">{article.meta_description}</p>}
						<div class="mt-4 flex flex-wrap items-center gap-4 border-t border-graphite-200 pt-3 text-xs text-graphite-500 dark:border-graphite-700 dark:text-graphite-400">
							{updated ? (
								<span class="inline-flex items-center gap-1.5 font-bold text-emerald-brand-700 dark:text-emerald-brand-300"><svg class="size-3.5 text-emerald-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h5M20 20v-5h-5M5.5 9a7 7 0 0 1 12.3-2.7M18.5 15a7 7 0 0 1-12.3 2.7" /></svg>آخر تحديث: {formatDate(article.updated_at)}</span>
							) : (
								<span class="inline-flex items-center gap-1.5"><svg class="size-3.5 text-royal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M5 11h14M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /></svg>{formatDate(article.published_at || article.created_at)}</span>
							)}
							<span class="inline-flex items-center gap-1.5"><svg class="size-3.5 text-royal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5" stroke-width="2"/></svg>{Number(article.visit_count || 0).toLocaleString('ar-JO')} مشاهدة</span>
						</div>

						{matchedFiles.length > 0 && (
							<div class="mt-4 space-y-2">
								{matchedFiles.map((file: any) => (
									<a href={`/${countryCode}/lesson/articles/${article.id}`} class="flex items-center gap-3 rounded-xl border border-graphite-200 bg-graphite-50/80 p-3 text-sm transition hover:border-royal-300 hover:bg-royal-50 dark:border-graphite-700 dark:bg-graphite-800/60 dark:hover:border-royal-700 dark:hover:bg-royal-950/50">
										<span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-white text-royal-600 shadow-sm dark:bg-graphite-900 dark:text-royal-300"><SubjectCategoryIcon category={category.key} class="size-4" /></span>
										<span class="min-w-0 flex-1 truncate font-bold text-graphite-800 dark:text-graphite-100">{file.file_name || `ملف ${file.id}`}</span>
										<span class="shrink-0 text-xs font-black text-royal-600 dark:text-royal-300">تفاصيل التنزيل</span>
									</a>
								))}
							</div>
						)}
					</article>
				);
			})}
		</div>
	)}

	{articlesOk && <Pagination currentPage={currentPage} lastPage={lastPage} url={pageUrl} />}
</div>
