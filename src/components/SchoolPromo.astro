<!--
	Cross-promotion for "خدمتك" (khadmatak.com), a sister platform — not a Google AdSense
	unit. Styled around their own brand teal (#14B8A6, from their site.webmanifest theme_color
	and the dominant accent in their compiled CSS) and their real logo, rather than our own
	royal/emerald-brand tokens or a generic mock dashboard, so this reads as "their product"
	rather than blending into our own design system.
-->
<section class="bg-white py-16 dark:bg-graphite-950/60 sm:py-20">
	<div class="container-shell">
		<div class="relative overflow-hidden rounded-[2rem] border border-[#14B8A6]/25 bg-gradient-to-l from-[#ECFDF9] via-white to-royal-50 p-6 shadow-soft dark:border-[#14B8A6]/25 dark:from-[#0B3B37] dark:via-graphite-900 dark:to-royal-950/45 sm:p-9 lg:p-11">
			<div class="absolute -right-20 -top-24 size-64 rounded-full bg-[#14B8A6]/20 blur-3xl dark:bg-[#14B8A6]/10" aria-hidden="true"></div>
			<div class="relative grid items-center gap-10 lg:grid-cols-[1.15fr_.85fr] lg:gap-14">
				<div>
					<div class="mb-4 flex flex-wrap items-center gap-2">
						<span class="rounded-full bg-[#14B8A6] px-3 py-1.5 text-xs font-extrabold text-white">نظام إداري للمدارس</span>
						<span class="rounded-full border border-[#14B8A6]/30 bg-white/70 px-3 py-1.5 text-xs font-bold text-[#0F766E] dark:border-[#14B8A6]/40 dark:bg-graphite-900/60 dark:text-[#5EEAD4]">منظومة متكاملة</span>
					</div>
					<p class="mb-2 flex items-center gap-2 text-sm font-extrabold text-[#0F766E] dark:text-[#5EEAD4]">
						<img src="https://khadmatak.com/favicon.svg" alt="" width="18" height="18" class="size-[18px]" loading="lazy" decoding="async" />
						خدمتك
					</p>
					<h2 class="max-w-3xl text-2xl font-black leading-[1.45] text-graphite-950 sm:text-3xl dark:text-white">نظّم سجلات الطلبة والعمل المدرسي من مكان واحد</h2>
					<p class="mt-4 max-w-3xl text-sm leading-8 text-graphite-600 sm:text-base dark:text-graphite-300">حل يساعد إدارات المدارس والمعلمين على تنظيم البيانات، متابعة السجلات، ومعالجة ملفات Excel ضمن تجربة واضحة توفر الوقت والجهد.</p>
					<ul class="mt-6 flex flex-wrap gap-3 text-xs font-bold text-graphite-700 dark:text-graphite-200">
						<li class="rounded-xl bg-white/80 px-3 py-2 shadow-sm dark:bg-graphite-900">معالجة ملفات Excel</li>
						<li class="rounded-xl bg-white/80 px-3 py-2 shadow-sm dark:bg-graphite-900">سجلات منظمة</li>
						<li class="rounded-xl bg-white/80 px-3 py-2 shadow-sm dark:bg-graphite-900">متابعة أسهل للطلبة</li>
					</ul>
					<a
						href="https://khadmatak.com/"
						target="_blank"
						rel="noopener"
						class="mt-7 inline-flex min-h-11 items-center gap-2 rounded-xl bg-[#14B8A6] px-7 text-sm font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-[#0F9C8C]"
					>
						تجربة نظام خدمتك
						<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7" /></svg>
					</a>
				</div>

				<a
					href="https://khadmatak.com/"
					target="_blank"
					rel="noopener"
					aria-label="زيارة موقع خدمتك"
					class="mx-auto flex w-full max-w-md items-center justify-center rounded-[1.5rem] border border-[#14B8A6]/20 bg-gradient-to-br from-[#F0FDFA] to-white p-10 shadow-2xl transition hover:-translate-y-1 dark:border-[#14B8A6]/25 dark:from-graphite-900 dark:to-graphite-950 sm:p-14"
				>
					<img
						src="https://khadmatak.com/logo.svg"
						alt="شعار خدمتك"
						width="220"
						height="212"
						class="w-full max-w-[220px] object-contain"
						loading="lazy"
						decoding="async"
					/>
				</a>
			</div>
		</div>
	</div>
</section>
