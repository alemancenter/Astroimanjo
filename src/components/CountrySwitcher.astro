---
import { COUNTRIES, type Country } from '../lib/countries';

const currentCountry = Astro.locals.countryId;
const current = COUNTRIES.find((country) => country.id === currentCountry);

// On country-scoped pages (/{countryCode}/lesson/**, /{countryCode}/posts/**) the country
// is the first path segment. For pure listing/collection pages and free-text keyword search
// — the same "kind" of page, regionally varied — swapping that segment in place is correct
// (mirrors the hreflangSafe distinction in SeoHead.astro). But for ID-keyed detail pages
// (a specific class/subject/article/post/category), each country is a fully separate
// database with no shared row identity — the same ID in another country is an unrelated
// row, so swapping it in place could silently land the reader on completely different
// content. Those fall back to that country's nearest safe listing page instead of guessing.
// Elsewhere (bare pages like /classes, /articles) keep the existing ?country=
// query/cookie mechanism.
const pathCountryCode = Astro.params.countryCode as string | undefined;
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const restSegments = pathSegments.slice(1); // path after the country code

const getCountryUrl = (target: Country) => {
	if (pathCountryCode) {
		const isListingOrKeyword =
			restSegments.length === 1 ||
			(restSegments[0] === 'lesson' && restSegments[1] === 'articles' && restSegments[2] === 'keyword') ||
			(restSegments[0] === 'posts' && restSegments[1] === 'keyword');
		if (isListingOrKeyword) {
			return `/${target.code}/${restSegments.join('/')}${Astro.url.search}`;
		}
		if (restSegments[0] === 'posts') {
			return `/${target.code}/${restSegments[1] === 'category' ? 'categories' : 'posts'}`;
		}
		if (restSegments[0] === 'lesson' && restSegments[1] === 'articles') {
			return `/${target.code}/articles`;
		}
		return `/${target.code}/classes`; // lesson/{classId}, lesson/{classId}/subjects/{id}, lesson/subjects/{id}, ...
	}
	const newUrl = new URL(Astro.request.url);
	newUrl.searchParams.set('country', target.id);
	return newUrl.pathname + newUrl.search;
};
---

<details class="country-switcher group relative">
	<summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-xl border border-graphite-200 bg-white px-3 py-2 text-sm font-bold text-graphite-700 transition hover:border-royal-300 hover:bg-royal-50 marker:hidden dark:border-graphite-700 dark:bg-graphite-900 dark:text-graphite-200 dark:hover:border-royal-500 dark:hover:bg-graphite-800">
		<span class="text-lg" aria-hidden="true">{current?.flag || '🌍'}</span>
		<span>{current?.name || 'اختر الدولة'}</span>
		<svg class="size-4 text-graphite-400 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7" />
		</svg>
	</summary>

	<div class="absolute left-0 z-50 mt-2 w-52 overflow-hidden rounded-2xl border border-graphite-200 bg-white p-1.5 shadow-lifted dark:border-graphite-700 dark:bg-graphite-900">
		<p class="px-3 py-2 text-xs font-bold text-graphite-400">اختر المنهج حسب الدولة</p>
		{
			COUNTRIES.map((country) => (
				<a
					href={getCountryUrl(country)}
					aria-current={country.id === currentCountry ? 'true' : undefined}
					class={`flex min-h-11 items-center gap-3 rounded-xl px-3 py-2 text-sm transition ${
						country.id === currentCountry
							? 'bg-royal-50 font-bold text-royal-700 dark:bg-royal-950 dark:text-royal-200'
							: 'text-graphite-700 hover:bg-graphite-50 dark:text-graphite-200 dark:hover:bg-graphite-800'
					}`}
				>
					<span class="text-lg" aria-hidden="true">{country.flag}</span>
					<span>{country.name}</span>
					{country.id === currentCountry && <span class="mr-auto text-emerald-brand-600" aria-label="الدولة الحالية">✓</span>}
				</a>
			))
		}
	</div>
</details>

<script>
	document.addEventListener('click', (event) => {
		document.querySelectorAll<HTMLDetailsElement>('.country-switcher[open]').forEach((details) => {
			if (!details.contains(event.target as Node)) details.removeAttribute('open');
		});
	});
</script>
