---
// Server Island: the only per-visitor part of the article page (login state gates the
// comment form and reaction buttons). Deferred out of the main render so the article body
// itself has zero per-visitor personalization and can be cached via astro.config.mjs
// routeRules — this section re-renders fresh per request regardless.
import { apiFetchList } from '../lib/api';
import { getCurrentUser } from '../lib/auth';

const ARTICLE_TYPE = 'App\\Models\\Article';
const reactionEmojis = ['👍', '❤️', '😂', '😮', '😢'];

interface Props {
	articleId?: number | string;
	contentId?: number | string;
	commentableType?: string;
	inputId?: string;
	countryCode: string;
	countryId: string | undefined;
	currentUrl: string;
	formError?: string | null;
	commentSent?: boolean;
}

const {
	articleId,
	contentId,
	commentableType = ARTICLE_TYPE,
	inputId = 'content-comment',
	countryCode,
	countryId,
	currentUrl,
	formError,
	commentSent,
} = Astro.props;
const resolvedContentId = contentId ?? articleId;

const [currentUser, { items: comments }] = await Promise.all([
	getCurrentUser(Astro),
	apiFetchList<any>(`/comments/${countryCode}`, {
		countryId,
		params: { commentable_type: commentableType, commentable_id: resolvedContentId, per_page: 50 },
	}),
]);
---

<section id="comments" class="surface-card mt-10 scroll-mt-28 p-5 sm:p-7">
	<div class="mb-6 flex items-center justify-between gap-4">
		<h2 class="text-xl font-extrabold text-graphite-950 dark:text-white">التعليقات</h2>
		<span class="badge-primary">{comments.length.toLocaleString('ar-EG')}</span>
	</div>
	{formError && <div class="alert-error mb-6" role="alert">{formError}</div>}
	{commentSent && <div class="alert-success mb-6" role="status">تم إرسال تعليقك وسيظهر بعد مراجعته من قِبل الإدارة.</div>}

	{currentUser ? (
		<form method="post" action={`/api/comments/${countryCode}`} class="mb-9">
			<input type="hidden" name="commentable_id" value={resolvedContentId} />
			<input type="hidden" name="commentable_type" value={commentableType} />
			<input type="hidden" name="redirect_to" value={currentUrl} />
			<label for={inputId} class="form-label">أضف تعليقك</label>
			<textarea id={inputId} name="body" required minlength="2" maxlength="2000" rows="4" placeholder="اكتب تعليقك باحترام ووضوح..." class="form-control mb-3" />
			<button type="submit" class="btn-primary">إرسال التعليق</button>
		</form>
	) : (
		<div class="mb-9 rounded-xl border border-royal-100 bg-royal-50 px-4 py-4 text-sm text-graphite-600 dark:border-royal-900 dark:bg-royal-950 dark:text-graphite-300">
			<a href={`/login?redirect_to=${encodeURIComponent(currentUrl)}#comments`} class="font-bold text-royal-600 hover:underline dark:text-royal-300">سجّل الدخول</a>{' '}للمشاركة في النقاش.
		</div>
	)}

	{comments.length > 0 ? (
		<ul class="space-y-6">
			{comments.map((comment: any) => (
				<li class="flex gap-3">
					<div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-royal-100 text-sm font-bold text-royal-700 dark:bg-royal-950 dark:text-royal-200">{(comment.user?.name || '?').charAt(0)}</div>
					<div class="min-w-0 flex-1">
						<div class="rounded-2xl bg-graphite-50 px-4 py-3 dark:bg-graphite-800/60"><p class="mb-1 text-sm font-bold text-graphite-950 dark:text-white">{comment.user?.name || 'مستخدم'}</p><p class="text-sm leading-6 text-graphite-600 dark:text-graphite-300">{comment.body}</p></div>
						{currentUser && <form method="post" action="/api/reactions" class="mr-1 mt-1.5 flex gap-1"><input type="hidden" name="comment_id" value={comment.id} /><input type="hidden" name="redirect_to" value={currentUrl} />{reactionEmojis.map((emoji) => <button type="submit" name="emoji" value={emoji} class="rounded-md px-1.5 py-0.5 text-sm transition hover:bg-graphite-100 dark:hover:bg-graphite-800">{emoji}</button>)}</form>}
					</div>
				</li>
			))}
		</ul>
	) : <p class="rounded-xl bg-graphite-50 px-4 py-6 text-center text-sm text-graphite-500 dark:bg-graphite-800/50 dark:text-graphite-400">لا توجد تعليقات بعد — كن أول من يعلّق!</p>}
</section>
