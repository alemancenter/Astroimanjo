---
// Server Island: the only visitor-specific part of the header. Deferred out of the
// main render so the rest of a page (Header included) can be safely cached via
// astro.config.mjs routeRules — this piece re-renders fresh per request regardless.
import { getCurrentUser, isAdmin, hasPermission } from '../lib/auth';
import { apiFetch } from '../lib/api';
import { getCountryById } from '../lib/countries';
import { resolveNotificationTarget } from '../lib/notification-links';

interface HeaderNotification {
	id: string;
	type: string;
	data: Record<string, unknown> | string | null;
	read_at?: string | null;
	created_at: string;
}

interface Props {
	variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;
const currentUser = await getCurrentUser(Astro);
const canAccessDashboard = !!currentUser && (isAdmin(currentUser) || hasPermission(currentUser, 'access dashboard'));
const notificationToken = Astro.cookies.get('token')?.value;
const notificationResult = currentUser && variant === 'desktop'
	? await apiFetch<HeaderNotification[]>('/dashboard/notifications', {
		countryId: Astro.locals.countryId,
		cookieHeader: notificationToken ? `token=${notificationToken}` : '',
		params: { status: 'unread', page: 1, per_page: 6 },
	})
	: null;
const parseNotificationData = (value: HeaderNotification['data']): Record<string, unknown> => {
	if (value && typeof value === 'object') return value;
	if (typeof value === 'string') {
		try { return JSON.parse(value); } catch { return {}; }
	}
	return {};
};
const countryCode = getCountryById(Astro.locals.countryId).code;
const headerNotifications = (notificationResult?.data ?? []).map((notification) => {
	const data = parseNotificationData(notification.data);
	return {
		...notification,
		data,
		target: resolveNotificationTarget(data.action_url, countryCode, Astro.url.origin),
	};
});
const unreadNotifications = Math.max(0, Number(notificationResult?.meta?.total ?? headerNotifications.length));
const unreadLabel = unreadNotifications > 99 ? '99+' : String(unreadNotifications);
const currentLocation = `${Astro.url.pathname}${Astro.url.search}`;
const relativeTime = new Intl.RelativeTimeFormat('ar', { numeric: 'auto' });
const timeAgo = (value: string) => {
	const timestamp = new Date(value).getTime();
	if (!Number.isFinite(timestamp)) return '';
	const seconds = Math.round((timestamp - Date.now()) / 1000);
	if (Math.abs(seconds) < 60) return 'الآن';
	const minutes = Math.round(seconds / 60);
	if (Math.abs(minutes) < 60) return relativeTime.format(minutes, 'minute');
	const hours = Math.round(minutes / 60);
	if (Math.abs(hours) < 24) return relativeTime.format(hours, 'hour');
	return relativeTime.format(Math.round(hours / 24), 'day');
};
const notificationTone = (typeValue: string) => {
	const type = String(typeValue || '').toLowerCase();
	if (type.includes('message')) return 'message';
	if (type.includes('article')) return 'article';
	if (type.includes('post')) return 'post';
	if (type.includes('subscription') || type.includes('teacher')) return 'subscription';
	return 'general';
};
---

{
	variant === 'desktop' ? (
		currentUser ? (
			<div class="flex items-center gap-0.5 lg:gap-2">
				<details class="notification-menu group relative">
					<summary
						class="icon-button relative cursor-pointer list-none marker:hidden"
						aria-label={unreadNotifications > 0 ? `الإشعارات، ${unreadNotifications} غير مقروء` : 'الإشعارات'}
						title="الإشعارات"
					>
						<svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
						{unreadNotifications > 0 && (
							<span class="absolute -left-1 -top-1 flex min-h-4 min-w-4 items-center justify-center rounded-full border-2 border-white bg-sunset-500 px-0.5 text-[9px] font-extrabold leading-none text-white shadow-sm dark:border-graphite-950">
								{unreadLabel}
							</span>
						)}
					</summary>

					<section class="absolute left-0 z-[70] mt-2 w-[calc(100vw-1rem)] max-w-[23rem] overflow-hidden rounded-2xl border border-graphite-200 bg-white shadow-lifted dark:border-graphite-700 dark:bg-graphite-900" aria-label="قائمة الإشعارات غير المقروءة">
						<header class="flex items-center justify-between gap-3 border-b border-graphite-100 px-4 py-3 dark:border-graphite-800">
							<div><strong class="block text-sm font-extrabold text-graphite-950 dark:text-white">الإشعارات</strong><span class="mt-0.5 block text-[11px] text-graphite-400">{unreadNotifications > 0 ? `${unreadNotifications} بانتظار القراءة` : 'لا توجد تنبيهات جديدة'}</span></div>
							{unreadNotifications > 0 && (
								<form method="post" action="/api/account/notifications/mark-all-read">
									<input type="hidden" name="redirect_to" value={currentLocation} />
									<button type="submit" class="inline-flex items-center gap-1 text-[11px] font-extrabold text-royal-700 transition hover:text-royal-900 dark:text-royal-300 dark:hover:text-white">
										<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m3 12 4 4L17 6m-7 6 4 4 7-7" /></svg>
										تعليم الكل كمقروء
									</button>
								</form>
							)}
						</header>

						<div class="max-h-[22rem] overflow-y-auto overscroll-contain">
							{headerNotifications.length > 0 ? headerNotifications.map((notification) => {
								const tone = notificationTone(notification.type);
								const title = String(notification.data.title || 'إشعار جديد');
								const message = String(notification.data.message || 'اضغط لعرض تفاصيل الإشعار.');
								return (
									<form method="post" action={`/api/account/notifications/${notification.id}/open`} class="border-b border-graphite-100 last:border-b-0 dark:border-graphite-800">
										<input type="hidden" name="redirect_to" value={notification.target} />
										<button type="submit" class="group/item flex w-full items-start gap-3 px-4 py-3 text-right transition hover:bg-royal-50/70 focus:bg-royal-50/70 focus:outline-none dark:hover:bg-graphite-800 dark:focus:bg-graphite-800">
											<span class:list={['mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-xl', { 'bg-emerald-brand-50 text-emerald-brand-700 dark:bg-emerald-brand-950 dark:text-emerald-brand-300': tone === 'message', 'bg-royal-50 text-royal-700 dark:bg-royal-950 dark:text-royal-300': tone === 'article' || tone === 'post' || tone === 'general', 'bg-sunset-50 text-sunset-700 dark:bg-sunset-950 dark:text-sunset-300': tone === 'subscription' }]}>
												{tone === 'message' ? <svg class="size-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5h16v14H4zM4 7l8 6 8-6" /></svg> : <svg class="size-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>}
											</span>
											<span class="min-w-0 flex-1">
												<span class="flex items-start gap-2"><strong class="line-clamp-1 flex-1 text-xs font-extrabold text-graphite-900 dark:text-white">{title}</strong><i class="mt-1.5 size-1.5 shrink-0 rounded-full bg-royal-600 not-italic"></i></span>
												<span class="mt-1 line-clamp-2 text-[11px] leading-5 text-graphite-500 dark:text-graphite-400">{message}</span>
												<time class="mt-1.5 block text-[10px] font-bold text-graphite-400" datetime={notification.created_at}>{timeAgo(notification.created_at)}</time>
											</span>
											<svg class="mt-3 size-3.5 shrink-0 text-graphite-300 transition group-hover/item:-translate-x-0.5 group-hover/item:text-royal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg>
										</button>
									</form>
								);
							}) : (
								<div class="px-6 py-8 text-center"><span class="mx-auto flex size-11 items-center justify-center rounded-full bg-emerald-brand-50 text-emerald-brand-700 dark:bg-emerald-brand-950 dark:text-emerald-brand-300"><svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m4 12 5 5L20 6" /></svg></span><strong class="mt-3 block text-sm font-extrabold text-graphite-900 dark:text-white">أنت على اطلاع بكل شيء</strong><p class="mt-1 text-xs leading-5 text-graphite-400">لا توجد إشعارات غير مقروءة حاليًا.</p></div>
							)}
						</div>

						<footer class="border-t border-graphite-100 bg-graphite-50/70 p-2 dark:border-graphite-800 dark:bg-graphite-950/40">
							<a href="/account/notifications" class="flex min-h-9 items-center justify-center gap-1.5 rounded-xl text-xs font-extrabold text-royal-700 transition hover:bg-white dark:text-royal-300 dark:hover:bg-graphite-800">عرض جميع الإشعارات<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg></a>
						</footer>
					</section>
				</details>
				<details class="dropdown-menu group relative hidden lg:block">
				<summary class="btn-outline max-w-40 cursor-pointer list-none marker:hidden" title={currentUser.name}>
					<span class="flex size-7 flex-none items-center justify-center rounded-lg bg-royal-600 text-xs text-white">{currentUser.name.charAt(0)}</span>
					<span class="truncate">{currentUser.name}</span>
					<svg class="size-4 flex-none text-graphite-400 transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7" /></svg>
				</summary>
				<div class="absolute left-0 z-50 mt-2 w-56 overflow-hidden rounded-2xl border border-graphite-200 bg-white p-1.5 shadow-lifted dark:border-graphite-700 dark:bg-graphite-900">
					<p class="truncate px-3 py-2 text-xs font-bold text-graphite-400">{currentUser.email}</p>
					{canAccessDashboard && (
						<a href="/dashboard" class="flex min-h-11 items-center gap-3 rounded-xl px-3 py-2 text-sm font-bold text-graphite-700 transition hover:bg-graphite-50 dark:text-graphite-200 dark:hover:bg-graphite-800">
							<svg class="size-4 flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 13h6V4H4v9Zm0 7h6v-3H4v3Zm10 0h6v-9h-6v9Zm0-13h6V4h-6v3Z" /></svg>
							لوحة التحكم
						</a>
					)}
					<a href="/account" class="flex min-h-11 items-center gap-3 rounded-xl px-3 py-2 text-sm text-graphite-700 transition hover:bg-graphite-50 dark:text-graphite-200 dark:hover:bg-graphite-800">
						<svg class="size-4 flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /></svg>
						حسابي
					</a>
					<hr class="my-1.5 border-graphite-100 dark:border-graphite-800" />
					<form method="post" action="/api/auth/logout">
						<button type="submit" class="flex min-h-11 w-full items-center gap-3 rounded-xl px-3 py-2 text-sm font-bold text-red-600 transition hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/40">
							<svg class="size-4 flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0-4-4m4 4H7m6 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1" /></svg>
							تسجيل الخروج
						</button>
					</form>
				</div>
				</details>
			</div>

			<script>
				document.addEventListener('click', (event) => {
					document.querySelectorAll<HTMLDetailsElement>('.dropdown-menu[open], .notification-menu[open]').forEach((details) => {
						if (!details.contains(event.target as Node)) details.removeAttribute('open');
					});
				});
				document.querySelectorAll<HTMLDetailsElement>('.dropdown-menu, .notification-menu').forEach((details) => {
					details.addEventListener('toggle', () => {
						if (!details.open) return;
						document.querySelectorAll<HTMLDetailsElement>('.dropdown-menu[open], .notification-menu[open]').forEach((other) => {
							if (other !== details) other.removeAttribute('open');
						});
					});
				});
			</script>
		) : (
			<div class="hidden items-center gap-1 lg:flex">
				<a href="/login" class="btn-ghost px-4">دخول</a>
				<a href="/register" class="btn-primary px-4">حساب جديد</a>
			</div>
		)
	) : currentUser ? (
		<div class="flex w-full flex-col gap-2">
			{canAccessDashboard && (
				<a href="/dashboard" class="btn-outline w-full">لوحة التحكم</a>
			)}
			<a href="/account" class="btn-primary w-full">حسابي</a>
			<form method="post" action="/api/auth/logout" class="w-full">
				<button type="submit" class="btn-ghost w-full text-red-600 dark:text-red-400">تسجيل الخروج</button>
			</form>
		</div>
	) : (
		<>
			<a href="/login" class="btn-outline flex-1">تسجيل الدخول</a>
			<a href="/register" class="btn-primary flex-1">حساب جديد</a>
		</>
	)
}
