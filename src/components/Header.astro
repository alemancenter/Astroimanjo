---
import CountrySwitcher from './CountrySwitcher.astro';
import BrandMark from './ui/BrandMark.astro';
import UserMenu from './UserMenu.astro';
import { getCountryById } from '../lib/countries';

interface Props {
	siteName?: string;
	siteLogo?: string | null;
}

const { siteName = 'موقع الإيمان التعليمي', siteLogo = null } = Astro.props;
// Header renders on both bare pages (Astro.locals.countryCode unset) and /{countryCode}/...
// pages (set from the URL path) — countryId is always set by middleware either way.
const countryCode = getCountryById(Astro.locals.countryId).code;
const navLinks = [
	{ name: 'الرئيسية', url: '/' },
	{ name: 'الدروس والمواد', url: `/${countryCode}/classes` },
	{ name: 'المقالات والملفات', url: `/${countryCode}/articles` },
	{ name: 'التقويم الدراسي', url: '/calendar' },
	{ name: 'المعلمون', url: '/teachers' },
];

const pathname = Astro.url.pathname;

const countryNeutralPaths = new Set([
        '/about',
        '/about-us',
        '/cookie-policy',
        '/copyright',
        '/disclaimer',
        '/editorial-policy',
        '/faq',
        '/privacy-policy',
        '/terms-of-service',
]);

const showCountrySwitcher = !countryNeutralPaths.has(pathname.replace(/\/$/, '') || '/');
const isActive = (url: string) => (url === '/' ? pathname === '/' : pathname.startsWith(url));
---

<header class="sticky top-0 z-50 w-full border-b border-graphite-200/80 bg-white/95 shadow-sm backdrop-blur-xl dark:border-graphite-800 dark:bg-graphite-950/95">
	<div class="hidden bg-graphite-950 text-graphite-300 md:block">
		<div class="container-shell flex h-9 items-center justify-between text-[11px] font-bold">
			<a href="/contact-us" class="inline-flex items-center gap-1.5 transition hover:text-white">
				<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .95.68l1.5 4.49a1 1 0 0 1-.5 1.21l-2.26 1.13a11 11 0 0 0 5.52 5.52l1.13-2.26a1 1 0 0 1 1.21-.5l4.49 1.5a1 1 0 0 1 .68.95V19a2 2 0 0 1-2 2h-1C9.72 21 3 14.28 3 6V5Z" /></svg>
				تواصل معنا
			</a>
			<nav class="flex items-center gap-5" aria-label="روابط مساندة">
				<a href="/about-us" class="transition hover:text-white">من نحن</a>
				<a href="/faq" class="transition hover:text-white">الأسئلة الشائعة</a>
				<a href="/privacy-policy" class="transition hover:text-white">الخصوصية</a>
			</nav>
		</div>
	</div>

	<div class="container-shell">
		<div class="flex h-[74px] min-w-0 items-center justify-between gap-3">
			<a href="/" class="flex min-w-0 flex-shrink-0 items-center gap-2.5 rounded-xl" aria-label={`${siteName} - الرئيسية`}>
				{siteLogo ? <img src={siteLogo} alt="" class="size-11 flex-none rounded-xl object-contain sm:size-12" width="48" height="48" decoding="async" /> : <BrandMark class="size-11 sm:size-12" />}
				<span class="max-w-52 truncate text-sm font-extrabold tracking-tight text-graphite-950 min-[390px]:text-base sm:max-w-64 sm:text-[17px] dark:text-white">{siteName}</span>
			</a>

			<nav class="hidden items-center gap-0.5 lg:flex" aria-label="التنقل الرئيسي">
				{navLinks.map((link) => (
					<a href={link.url} aria-current={isActive(link.url) ? 'page' : undefined} class={`whitespace-nowrap rounded-xl px-3 py-2.5 text-[13px] font-bold transition ${isActive(link.url) ? 'bg-royal-50 text-royal-700 dark:bg-royal-950 dark:text-royal-200' : 'text-graphite-600 hover:bg-graphite-50 hover:text-graphite-950 dark:text-graphite-300 dark:hover:bg-graphite-900 dark:hover:text-white'}`}>{link.name}</a>
				))}
			</nav>

			<div class="flex flex-none items-center gap-0.5 lg:gap-2">
				{showCountrySwitcher && <div class="hidden lg:block"><CountrySwitcher /></div>}
				<button type="button" class="theme-toggle icon-button" aria-label="تبديل الوضع الليلي" title="تبديل الوضع الليلي">
					<svg class="theme-dark-icon hidden size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M17.293 13.293A8 8 0 0 1 6.707 2.707a8 8 0 1 0 10.586 10.586Z" /></svg>
					<svg class="theme-light-icon hidden size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm4 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm2.657-5.657a1 1 0 0 1 0 1.414l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0ZM18 9a1 1 0 1 1 0 2h-1a1 1 0 1 1 0-2h1ZM10 15a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1Z" /></svg>
				</button>
				<UserMenu variant="desktop" server:defer>
					<div slot="fallback" class="hidden items-center gap-1 lg:flex"><a href="/login" class="btn-ghost px-4">دخول</a><a href="/register" class="btn-primary px-4">حساب جديد</a></div>
				</UserMenu>
				<button id="mobile-menu-toggle" type="button" class="icon-button lg:hidden" aria-label="فتح القائمة" aria-controls="mobile-menu" aria-expanded="false">
					<svg class="menu-open-icon size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
					<svg class="menu-close-icon hidden size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 6 12 12M18 6 6 18" /></svg>
				</button>
			</div>
		</div>
	</div>

	<div id="mobile-menu" class="hidden border-t border-graphite-200 bg-white lg:hidden dark:border-graphite-800 dark:bg-graphite-950">
		<div class="container-shell py-4">
			<nav class="grid gap-1" aria-label="التنقل على الهاتف">
				{navLinks.map((link) => <a href={link.url} aria-current={isActive(link.url) ? 'page' : undefined} class={`rounded-xl px-4 py-3 text-sm font-bold ${isActive(link.url) ? 'bg-royal-50 text-royal-700 dark:bg-royal-950 dark:text-royal-200' : 'text-graphite-700 hover:bg-graphite-50 dark:text-graphite-200 dark:hover:bg-graphite-900'}`}>{link.name}</a>)}
				<a href="/faq" class="rounded-xl px-4 py-3 text-sm font-bold text-graphite-700 hover:bg-graphite-50 dark:text-graphite-200 dark:hover:bg-graphite-900">الأسئلة الشائعة</a>
				<a href="/contact-us" class="rounded-xl px-4 py-3 text-sm font-bold text-graphite-700 hover:bg-graphite-50 dark:text-graphite-200 dark:hover:bg-graphite-900">اتصل بنا</a>
			</nav>
			<div class="mt-4 flex flex-wrap items-center gap-2 border-t border-graphite-200 pt-4 dark:border-graphite-800">
				{showCountrySwitcher && <CountrySwitcher />}
				<UserMenu variant="mobile" server:defer>
					<Fragment slot="fallback"><a href="/login" class="btn-outline flex-1">تسجيل الدخول</a><a href="/register" class="btn-primary flex-1">حساب جديد</a></Fragment>
				</UserMenu>
			</div>
		</div>
	</div>
</header>

<script>
	const syncThemeControls = () => {
		const isDark = document.documentElement.classList.contains('dark');
		document.querySelectorAll<HTMLElement>('.theme-dark-icon').forEach((icon) => icon.classList.toggle('hidden', !isDark));
		document.querySelectorAll<HTMLElement>('.theme-light-icon').forEach((icon) => icon.classList.toggle('hidden', isDark));
		document.querySelectorAll<HTMLElement>('.theme-toggle').forEach((button) => button.setAttribute('aria-label', isDark ? 'تفعيل الوضع النهاري' : 'تفعيل الوضع الليلي'));
	};

	syncThemeControls();
	document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
		button.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
			syncThemeControls();
		});

	});

	const menuButton = document.getElementById('mobile-menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');
	const setMenuOpen = (open: boolean) => {
		mobileMenu?.classList.toggle('hidden', !open);
		menuButton?.setAttribute('aria-expanded', String(open));
		menuButton?.setAttribute('aria-label', open ? 'إغلاق القائمة' : 'فتح القائمة');
		menuButton?.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
		menuButton?.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
	};
	menuButton?.addEventListener('click', () => setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true'));
	document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenuOpen(false); });
</script>
